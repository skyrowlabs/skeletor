#!/usr/bin/env python3
"""Scaffold a new project from the skeletor template.

    bin/skeletor-new ../my-project --name "My Project" --cli mp --tier governed

Copies the requested tier's overlays in order, substitutes every placeholder,
and leaves you a tree that runs its own gates from the first commit.

The tiers are cumulative — see docs/TIERS.md for what each one buys and, more
importantly, what it costs. **Do not take a tier you will not maintain**: an
unmaintained gate is worse than an absent one, because it is red for reasons
nobody remembers and therefore ignored.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import keyword
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Dict, Iterable, List, Optional, Set, Tuple

sys.path.insert(0, str(Path(__file__).resolve().parent))

from render_guard import render_dirt  # noqa: E402

SKELETOR = Path(__file__).resolve().parents[1]
TEMPLATE = SKELETOR / "template"

#: Tier -> the overlay directories it composes, in application order. Later
#: overlays overwrite earlier ones, so a tier can specialise a core file.
TIERS: Dict[str, List[str]] = {
    "core": ["core"],
    "governed": ["core", "governed"],
    "agentic": ["core", "governed", "agentic"],
}

LANGUAGE_OVERLAYS = {"python": "python", "node": "node", "both": "python,node"}

#: Files whose bytes must not be touched by substitution.
#: Agent -> the overlay directory holding that tool's files, applied after each
#: tier it specialises. Everything in here is tooling for one vendor: settings,
#: hooks, subagents, skills. The *conventions* are never in here — they live in
#: `docs/rules/`, are plain markdown, and are read because `AGENTS.md` names
#: them. Segmenting by vendor would otherwise put the testing rules behind a
#: flag, and `--agent none` would silently ship a tree with no testing rules.
AGENTS = {"claude": "agent-claude", "none": None}

#: Versioning mode -> the relative paths it does NOT ship. `release-please` is
#: the default and omits nothing.
#:
#: The question this answers is a fact about the project rather than a taste:
#: **does anything install this?** A published artifact needs a tracked
#: `VERSION`, because a tarball carries no git history and has no other way to
#: say what it is. A repository run from a checkout has the tag, and `VERSION`
#: is then a second home for a number whose first home is `git describe` — the
#: copy this project refuses everywhere else, kept in step by a bot.
#:
#: It is a **subtraction and nothing else**, which is the only shape a flag here
#: gets. Nothing is reconfigured, no file is written differently, and every
#: sentence and workflow step that depends on one of these paths is guarded on
#: the path rather than on the flag — see `drop_absent_prose` and the
#: `if this repository has one` steps in `ci.yml`. A mode that edited files
#: would need a verification grid this repository cannot afford, and would put a
#: conditional in every doc describing the workflow.
VERSIONING: Dict[str, Set[str]] = {
    "release-please": set(),
    "tag": {
        ".github/release-please-config.json",
        ".github/.release-please-manifest.json",
        "VERSION",
        # The release train is a Release Please state machine — open a release
        # PR, babysit it, stop for a human to merge. With no release PR to open
        # it is a procedure for machinery that is not here.
        ".claude/skills/release/SKILL.md",
    },
}

MANIFEST_NAME = ".skeletor.json"

#: The literal `--org` default. A badge is a claim about a repository that
#: exists, and `OWNER` names one that does not — so the default scaffold ships
#: no badges at all rather than opening every README with a broken image, which
#: is the cosmetic form of shipping a gate that is red on arrival.
ORG_UNSET = "OWNER"

BINARY_SUFFIXES = {".png", ".jpg", ".jpeg", ".gif", ".pdf", ".ico", ".woff", ".woff2"}


def setup_commands(language: str) -> List[str]:
    """The install steps a fresh clone needs, by language.

    One source for both the closing instructions this prints and the README it
    writes. They were two separate copies once, and the one people actually read
    — the README — was the stale one: it omitted `npm install`, so `check lint`
    failed on `eslint: command not found` and read as a broken scaffold.

    Every step here runs a tool by **path**, never through a PATH lookup, and
    both halves of that shipped broken. A bare `pip install` is refused outright
    on any distribution carrying an `EXTERNALLY-MANAGED` marker — Arch, Debian
    12+, Ubuntu 23.04+, Fedora, Homebrew macOS — so PEP 668 made line one of the
    generated quick start exit non-zero, which reads as user error at exactly
    the moment a new reader has no way to tell. A bare `pre-commit` then fails
    on any machine at all, because the install that provides it puts it in
    `.venv/bin`, which is not on PATH and which nothing here activates.

    The venv is not a portability nicety either — it is what the tree already
    assumes. `CLI_WRAPPER` looks for `.venv/bin/python` first and only falls
    through to whatever `python3` it can find; a system-wide install left every
    `./<cli>` invocation resolving against an interpreter nobody chose, which is
    the same ambient-resolution bug the pyright gate was fixed for.

    **The python steps are unconditional, and `--language` only ever adds.**
    They used to be guarded by `language in ("python", "both")`, which reads as
    symmetry and is not: `cli/`, `tests/` and `scripts/` all ship at `core`, so
    every scaffold is a python project and the flag chooses whether a *second*
    toolchain joins it. A `--language node` tree therefore documented
    `npm install` alone, and line two of its own quick start — `./<cli> check
    pre-push` — ran a python CLI whose interpreter and dependencies the block
    never installed. It failed with *"requires 'click'. Install with: pip
    install -r scripts/requirements.txt"*, naming a step the README had not
    given, and only on a host without a system-wide `click`: the wrapper falls
    through to whatever `python3` it finds, so the developer box that wrote it
    was green and a clean machine was not. That is the ambient-resolution
    hazard in the paragraph above, arriving on the language axis.
    """
    steps = [
        "python -m venv .venv && .venv/bin/pip install -r scripts/requirements.txt",
        ".venv/bin/pre-commit install --install-hooks",
    ]
    if language in ("node", "both"):
        steps.append("npm install")
    return steps


def badges(args, slug: str) -> str:
    """The README badge row — empty unless `--org` names a real owner.

    Two badges, and neither one *stores* a value. That is the whole constraint:
    a hard-coded `version-0.1.0` badge would be a third home for a number whose
    first two are the git tag and `VERSION`, and Release Please bumps both
    without ever touching the README — so it would be correct until the first
    release and wrong forever after. The release badge is instead a *view* of
    the latest GitHub release, which is the same tag `get_version()` reads
    through `git describe`. There is nothing to keep in sync because there is no
    copy.

    The CI badge is pinned to `--release-branch` and labelled for it. A bare
    workflow badge reports the repository's DEFAULT branch, which is the
    `--base-branch` this scaffolder actually creates (`git init -b`) — and a
    badge answers "should I expect this to work", which is a question about
    what was released, not about what is being worked on. Pinning it is what
    makes the label honest.

    That pin used to be load-bearing for a second and much worse reason: `ci.yml`
    had no `push` trigger for the base branch at all, so an unpinned badge read
    "no status" for the life of a perfectly healthy project. It now does have
    one, and that hazard is gone — recorded here because the remaining reason is
    a preference about meaning where the old one was a defect, and somebody
    re-reading this should know which kind of rule they are looking at.

    The trailing blank line is part of the return value: an empty row must leave
    the tagline sitting directly under the title, with no double blank line for
    `prettier` to reformat on the first commit.
    """
    if args.org == ORG_UNSET:
        return ""
    repo = f"{args.org}/{slug}"
    if args.versioning == "tag":
        # `git tag -a` creates a TAG, not a GitHub Release — that object only
        # exists when somebody makes one, and Release Please is what was making
        # them. A `v/release` badge on a tag-versioned repository is therefore
        # grey forever, which is this file's own rule about a broken badge:
        # a gate red on arrival wearing a cosmetic hat.
        release = (
            f"[![Tag](https://img.shields.io/github/v/tag/{repo}?sort=semver&label=tag)]"
            f"(https://github.com/{repo}/tags)"
        )
    else:
        release = (
            f"[![Release](https://img.shields.io/github/v/release/{repo}?sort=semver)]"
            f"(https://github.com/{repo}/releases)"
        )
    ci = (
        f"[![Release CI](https://img.shields.io/github/actions/workflow/status/{repo}/ci.yml"
        f"?branch={args.release_branch}&label=release%20ci)]"
        f"(https://github.com/{repo}/actions/workflows/ci.yml)"
    )
    return f"{release} {ci}\n\n"


def long_lived_branches(base: str, release: str) -> List[str]:
    """The repository's long-lived branches, deduplicated, in order.

    A single-branch project passes the same name twice — which is every repo
    while it is one person — and every site that spelled the pair rendered it
    twice: `branches: [main, main]` in three workflows, and "never on `main` or
    `main`" in `AGENTS.md`, the file an agent reads first. The YAML duplicate is
    harmless; the sentence is not, because a document that establishes the rules
    cannot afford to read like a typo.

    Deduplicating here rather than at each site is not tidiness — the sites
    *cannot* do it. One is YAML and one is prose, and neither language can ask
    whether two substitutions came out equal. This is the only place that
    knows.

    The default is `develop`/`main`, so the grid never rendered the equal case
    and the bug shipped in the one configuration nothing here produced. Found
    by node-zero, whose tree is single-branch.
    """
    return [base] if base == release else [base, release]


def substitutions(args) -> Dict[str, str]:
    slug = args.slug or Path(args.target).resolve().name
    cli = args.cli or re.sub(r"[^a-z0-9]", "", slug.lower())[:8] or "run"
    prefix = args.env_prefix or re.sub(r"[^A-Z0-9]", "", cli.upper()) or "APP"
    branches = long_lived_branches(args.base_branch, args.release_branch)
    return {
        "PROJECT_NAME": args.name or slug.replace("-", " ").replace(".", " ").title(),
        "PROJECT_SLUG": slug,
        "TAGLINE": args.tagline,
        "BADGES": badges(args, slug),
        "CLI": cli,
        "CLI_ENV_PREFIX": prefix,
        "CI_ENV_VAR": f"{prefix}_CI",
        "AGENT_PREFIX": slug.replace(".", "-"),
        "BASE_BRANCH": args.base_branch,
        "RELEASE_BRANCH": args.release_branch,
        # The versioning MODE, for prose that has to say which of two
        # behaviours the reader's tree got. `--versioning` is otherwise a
        # subtraction — it decides which files ship and is then gone — and the
        # `SCAFFOLD-IF <path>` markers ask about it by testing for a file. That
        # works for *swapping a paragraph* and not for *naming the mode inside
        # one*, which is what `docs-only.cjs` needs: its reason differs by mode
        # in the middle of a sentence about branches. Two versions of that
        # comment each keyed a two-flag question to one flag before this
        # existed.
        "VERSIONING": args.versioning,
        # The pair as a set, for the two sites that mean "both of them" rather
        # than "this one" — see `long_lived_branches`.
        "CI_BRANCHES": "[" + ", ".join(branches) + "]",
        "PROTECTED_BRANCHES": " or ".join(f"`{name}`" for name in branches),
        "PY": args.python,
        # The floor and the ceiling as a YAML list, for `ci.yml`'s unit-test
        # matrix. `PY` remains the floor everywhere it means "at least this" —
        # pyright's pythonVersion, black's target-version — and only CI takes
        # the pair, because CI is the one place where testing the ends is
        # different from declaring them.
        "PYTHON_MATRIX": python_matrix(args.python, args.python_ceiling),
        "SHELL_PACKAGE": args.shell_package,
        "PY_NODOT": args.python.replace(".", ""),
        "LINE_LENGTH": str(args.line_length),
        "ORG": args.org,
        "TZ": args.timezone,
        "LANG_RULES": "python" if args.language in ("python", "both") else "javascript",
        "SETUP_COMMANDS": "\n".join(setup_commands(args.language)),
        # The shared head of the three setup blocks is exactly what was
        # substituted into all three, since every document's next line is its
        # own. `tests/test_setup_blocks_agree.py` ratchets on it and cannot
        # derive it: by the time that test runs, the placeholder is gone and
        # the only thing left to measure is the answer.
        "SETUP_SHARED_PREFIX": str(len(setup_commands(args.language))),
    }


def render(text: str, values: Dict[str, str]) -> str:
    def replace(match: re.Match) -> str:
        key = match.group(1)
        if key not in values:
            raise KeyError(key)
        return values[key]

    return re.sub(r"\{\{(\w+)\}\}", replace, text)


def copy_overlay(
    source: Path,
    target: Path,
    values: Dict[str, str],
    cli_name: str,
    report: List[str],
    omit: Set[str] = frozenset(),
) -> None:
    """Render one overlay into `target`, appending what it wrote to `report`.

    `omit` subtracts at COPY time rather than deleting afterwards, and the
    difference is the manifest: `report` is what `.skeletor.json` records, so a
    file copied and then removed would be recorded as skeletor output that no
    render produces — and `cross_check` refuses exactly that, permanently, on
    every later upgrade. Never shipping it keeps the record true by construction.
    """
    for path in sorted(source.rglob("*")):
        if path.is_dir():
            continue
        relative = path.relative_to(source)
        if "__pycache__" in relative.parts or relative.suffix == ".pyc":
            continue
        if relative.as_posix() in omit:
            continue
        # The wrapper is named after the project's CLI, so it cannot live in the
        # template under its final name.
        if relative.name == "CLI_WRAPPER":
            relative = Path(cli_name)
        # The shell's package, likewise. `cli` is the most collided-with package
        # name in a python monorepo, and this is the whole of the rename:
        # **the package never spells its own name**, so nothing inside it has to
        # change. `__init__.py` discovers its command groups through `__name__`
        # and `__path__`, `__main__.py` imports relatively, and `scripts/paths.py`
        # finds the directory rather than naming it. That was paid for already,
        # by sky.boss, whose own rename cost 119 failing tests and a `sed` that
        # turned `from cli import cli` into `from x import x` — the package and
        # the click group share a name and only one of them was moving.
        elif relative.parts and relative.parts[0] == "cli":
            relative = Path(values["SHELL_PACKAGE"], *relative.parts[1:])

        destination = target / relative
        destination.parent.mkdir(parents=True, exist_ok=True)

        if path.suffix.lower() in BINARY_SUFFIXES:
            shutil.copy2(path, destination)
        else:
            try:
                rendered = render(path.read_text(encoding="utf-8"), values)
            except KeyError as exc:
                raise SystemExit(f"❌ {path}: unknown placeholder {{{{{exc.args[0]}}}}}")
            destination.write_text(rendered, encoding="utf-8")
            shutil.copymode(path, destination)

        report.append(str(relative))


def register_shipped_docs(target: Path, values: Dict[str, str]) -> None:
    """Add a routing row for every `docs/*.md` an overlay shipped.

    A higher tier brings its own reference docs, and a doc registered in neither
    index table is a doc no agent will load. Rather than duplicating the tables
    per overlay — two copies of a table drift, which is the failure mode the
    tables exist to prevent — they are completed here from what is on disk.
    """
    index = target / ".github" / "DOCS_INDEX.md"
    if not index.exists():
        return
    text = index.read_text(encoding="utf-8")

    marker = "<!-- SCAFFOLD: extend as docs are added."
    rows = []
    for doc in sorted((target / "docs").glob("*.md")):
        ref = f"docs/{doc.name}"
        if doc.name == "README.md" or ref in text:
            continue
        heading = next(
            (line[2:].strip() for line in doc.read_text(encoding="utf-8").splitlines() if line.startswith("# ")),
            doc.stem,
        )
        rows.append(f"| **{heading}** | {doc.name} | `{ref}` |")

    if not rows:
        return
    # Insert INSIDE the table (immediately after its last row), not before the
    # marker — a blank line between rows ends the table in every renderer.
    text = text.replace("\n\n" + marker, "\n" + "\n".join(rows) + "\n\n" + marker, 1)
    index.write_text(text, encoding="utf-8")


#: Delimiters around prose that only holds when a given path shipped. The opener
#: NAMES the path, so the condition is a fact about the tree rather than a flag:
#:
#:     <!-- SCAFFOLD-IF .github/release-please-config.json -->
#:     ... prose about the release train ...
#:     <!-- /SCAFFOLD-IF -->
#:
#:     <!-- SCAFFOLD-IF-DIFFER {{BASE_BRANCH}} {{RELEASE_BRANCH}} -->
#:     ...open a pull request from one to the other...
#:     <!-- /SCAFFOLD-IF -->
#:
#: `<!-- SCAFFOLD-IF-NOT <path> -->` is the same marker inverted, and it exists
#: because subtraction alone leaves a lie behind. `--versioning tag` removes the
#: release machinery and a "## Releases" heading with nothing under it is worse
#: than the wrong paragraph — the mode still HAS a release procedure, it is just
#: `git tag -a` by hand. So the pair ships the true half of every alternative,
#: never a sentence hedged to be true in both, which helps nobody in either.
#:
#: This started as one hard-coded `.claude/` case for `--agent none`, and
#: `--versioning tag` is what showed the shape: the question is never "which
#: flag was passed", it is "did those files arrive". Keying on the flag means a
#: renamed overlay or a new mode silently keeps prose about a directory nobody
#: shipped, and there is then no gate that can tell — the paths still resolve in
#: the configuration the author was looking at.
CONDITIONAL_OPEN = "<!-- SCAFFOLD-IF "
CONDITIONAL_OPEN_NOT = "<!-- SCAFFOLD-IF-NOT "
#: Keep the block only when its two arguments render to different strings.
#:
#: The other two ask whether a PATH is in the tree, which is the right question
#: for machinery a flag subtracts. It is the wrong question for a block whose
#: validity turns on two substituted VALUES being distinct — the release skill's
#: `gh pr create --base X --head Y`, which `gh` refuses when X and Y are one
#: branch. No file's presence answers that.
#:
#: General rather than a named predicate, deliberately. `render()` runs during
#: the copy and this runs after it, so a marker arrives here already
#: substituted — `SCAFFOLD-IF-DIFFER main main` — and comparing two words needs
#: no knowledge of which placeholders produced them. A registry of condition
#: names would be the list this project refuses; two rendered strings and `!=`
#: is a pattern.
CONDITIONAL_OPEN_DIFFER = "<!-- SCAFFOLD-IF-DIFFER "
#: Its inverse. Present because the pair is how the true half of an alternative
#: gets shipped without hedging either half — the same reason
#: `SCAFFOLD-IF-NOT` exists beside `SCAFFOLD-IF`.
CONDITIONAL_OPEN_SAME = "<!-- SCAFFOLD-IF-SAME "
CONDITIONAL_CLOSE = "<!-- /SCAFFOLD-IF -->"
#: Every opener, so a third one cannot be added and then missed by one of
#: the two places that scan for them.
OPENERS = (CONDITIONAL_OPEN_DIFFER, CONDITIONAL_OPEN_SAME, CONDITIONAL_OPEN_NOT, CONDITIONAL_OPEN)
#: The value-comparing subset.
COMPARERS = (CONDITIONAL_OPEN_DIFFER, CONDITIONAL_OPEN_SAME)

#: `drop_absent_prose` resolves a marker line by taking the first opener that
#: appears in it, which is sound only because no opener contains another — the
#: character after `SCAFFOLD-IF` is a space in one and a hyphen in the other
#: three. That is a property of four string literals rather than of the loop,
#: so it is asserted where the literals are, and the ordering of `OPENERS`
#: carries no weight.
#:
#: **The trailing space is what does the work**, and it narrows what this can
#: catch to exactly one mistake — which is the mistake. A new marker cannot
#: collide by being longer: `SCAFFOLD-IF-DIFFER-BY` does not contain
#: `SCAFFOLD-IF-DIFFER ` because the space is a hyphen. It collides by putting
#: a space where the convention puts a hyphen — `SCAFFOLD-IF SAME` contains
#: `SCAFFOLD-IF `, so every one of its blocks would be resolved as a plain
#: `SCAFFOLD-IF` testing for a path named `SAME`, silently, with the only
#: symptom a block kept or dropped for the wrong reason.
#:
#: The first version of this comment claimed the longer-name case, and the
#: plant written to prove it passed green — which is this repository's own rule
#: arriving on the guard that states it: a plant that did not land is
#: indistinguishable from a gate that works.
for _opener in OPENERS:
    for _other in OPENERS:
        if _opener is not _other and _opener in _other:
            raise SystemExit(f"❌ marker `{_opener.strip()}` is a substring of `{_other.strip()}`")


def drop_absent_prose(target: Path) -> None:
    """Remove every marked block whose condition this tree does not satisfy.

    Two conditions, and they ask about different kinds of thing. `SCAFFOLD-IF
    <path>` and its inverse ask whether a FILE is here, which is the right
    question for machinery a flag subtracts — the flag is gone by now and the
    tree is what remains. `SCAFFOLD-IF-DIFFER <a> <b>` and its inverse compare
    two RENDERED VALUES, for a block whose validity turns on two substitutions
    being distinct rather than on anything existing.

    A doc describing machinery a configuration omitted is not merely untidy: the
    index tables and the rules files are ROUTING, so a surviving block is a
    promise that a path is here, and `check_doc_tables.py` states why that is
    worse than a shorter table — it implies the subject is still covered.

    Found by `bin/skeletor-verify`'s tier-composition gate on the axis it was
    nearly not given. `--agent none` is documented, is tested for having no
    `.claude/` anywhere, and shipped a `.github/DOCS_INDEX.md` routing readers to
    three paths inside it. The tree's own gate cannot see that one: it walks
    `docs/`, and `.claude/` is not in `docs/`.

    Blocks are dropped, never reworded, because these are all-or-nothing: the
    machinery is entirely present or entirely absent, and a sentence hedged to be
    true either way is one that helps nobody in either.

    **Markdown only.** The delimiter is an HTML comment, which is a comment in
    markdown and plain text everywhere else — a `<!-- -->` in a YAML workflow is
    a syntax error, not a marker. Workflows answer the same question with a file
    test in the step itself (`if this repository has one`), which is the same
    condition in the language that file speaks.
    """
    for path in sorted(target.rglob("*")):
        if not path.is_file() or path.suffix != ".md":
            continue
        try:
            original = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        if not any(marker in original for marker in OPENERS):
            continue

        lines = original.splitlines(keepends=True)
        out: List[str] = []
        index = 0
        while index < len(lines):
            line = lines[index]
            if not any(marker in line for marker in OPENERS):
                out.append(line)
                index += 1
                continue

            opener = next(marker for marker in OPENERS if marker in line)
            compares = opener in COMPARERS
            inverted = opener in (CONDITIONAL_OPEN_NOT, CONDITIONAL_OPEN_SAME)
            needed = line.split(opener, 1)[1].split("-->")[0].strip()
            close = index + 1
            while close < len(lines) and CONDITIONAL_CLOSE not in lines[close]:
                close += 1
            if close >= len(lines):
                raise SystemExit(f"❌ {path}: `{opener}{needed}` has no closing marker")

            if compares:
                words = needed.split()
                if len(words) != 2:
                    raise SystemExit(
                        f"❌ {path}: `{opener.strip()}` takes exactly two rendered values, got {needed!r}"
                    )
                keep = (words[0] == words[1]) is inverted
            else:
                keep = (target / needed).exists() is not inverted
            if keep:
                # Keep the body, drop the scaffolder's bookkeeping. A leftover
                # marker in a generated tree invites somebody to add a second by
                # hand, in a tree this scaffolder will never run against again.
                out.extend(lines[index + 1 : close])
            else:
                # Take one blank line with the block when it is surrounded by
                # them, or the removal leaves a double blank that `prettier`
                # reformats on the first commit — a scaffold whose first hook
                # run rewrites a file it just wrote.
                while (
                    close + 1 < len(lines)
                    and not lines[close + 1].strip()
                    and out
                    and not out[-1].strip()
                ):
                    close += 1
            index = close + 1

        path.write_text("".join(out), encoding="utf-8")


def refuse_a_dirty_render(allow: bool) -> None:
    """A manifest must not record a render that exists in no commit.

    This is the guard `bin/skeletor-upgrade` has always had, on the door that
    writes the record rather than the one that reads it. Until `v0.10.3` only
    the reading end asked, and the scaffold end is the worse of the two:

    * The upgrade refuses **before** writing. The scaffold writes first, and the
      adopter then commits the result in their own first commit.
    * The upgrade's damage is a wasted run. The scaffold's is a file in somebody
      else's git history.
    * An **untracked** render input leaves `git describe --dirty` clean, because
      it is untracked-blind — so the poisoned tree records an ordinary-looking
      ref and carries no sign a dirty checkout was ever involved. `cross_check`
      then refuses every later upgrade, permanently, in a different tree for a
      different person, and `--repair-manifest` fixes the symptom without the
      cause ever surfacing.

    Reported by stash.flow, who reproduced all three properties; the trace
    reached `skeletor_ref()` from this end because skyrow-workspace followed it
    backwards from the write.

    `--allow-dirty` rather than a warning, and the asymmetry is deliberate: a
    warning is the right answer where nothing is recorded, and everything here
    is recorded. `bin/skeletor-verify` passes it, which is honest — it scaffolds
    from a working tree on purpose, into throwaway directories, and is the one
    caller for which an unreproducible base costs nothing.
    """
    dirty = render_dirt(SKELETOR)
    if not dirty or allow:
        if dirty:
            print(f"⚠️  --allow-dirty: {len(dirty)} uncommitted change(s) reach this render.")
            print(f"   {MANIFEST_NAME} will name a base no other checkout can reproduce.")
        return
    print(f"❌ {len(dirty)} uncommitted change(s) in this checkout reach what it renders:")
    for path in dirty:
        print(f"   · {path}")
    print()
    print(f"   {MANIFEST_NAME} would record hashes of a render that exists in no commit, so")
    print("   every later `skeletor-upgrade` resolves the recorded ref, renders something")
    print("   else, and refuses — permanently, in a tree you will have committed by then.")
    print("   An untracked file here is the quiet case: `git describe` still says clean, so")
    print("   nothing in the scaffolded tree records that this happened.")
    print()
    print("   Commit them first, or pass --allow-dirty for a throwaway tree.")
    raise SystemExit(1)


def skeletor_ref() -> str:
    """The commit of THIS checkout, so an upgrade can render the same base.

    `--always` because a checkout with no tags still has a sha, and a sha is
    what `skeletor-upgrade` actually renders from.

    **`--dirty` alone is not enough, and the gap it left is the one that cost a
    manifest.** git's suffix is untracked-blind, so an untracked file under
    `template/` renders into the tree, is recorded in the manifest, and leaves
    the ref looking ordinary — a base no checkout can reproduce, with nothing in
    the record to say so. The docstring here used to claim *"a dirty tree is
    recorded as dirty and warned about"*, and stash.flow measured both clauses
    false: there was no warning at all, and the recording missed exactly the
    case that does the damage. The true half is what would have made the missing
    half survivable, which is why this is fixed at the same time as the warning
    rather than after it.

    So the suffix is added when `render_dirt()` finds anything, whatever git
    thinks. `--allow-dirty` is then a decision that leaves a trace instead of a
    silence: the tree records `-dirty`, and `skeletor-upgrade` says so on its
    first run.
    """
    result = subprocess.run(
        ["git", "describe", "--tags", "--always", "--dirty"],
        cwd=str(SKELETOR), capture_output=True, text=True,
    )
    if result.returncode != 0:
        return ""
    ref = result.stdout.strip()
    if render_dirt(SKELETOR) and not ref.endswith("-dirty"):
        ref += "-dirty"
    return ref


#: Never part of the manifest: scratch, history, and bytecode. `__pycache__` is
#: the only thing a scaffold produces that differs between two identical runs —
#: `regen.py` runs at scaffold time and leaves it behind — so a hash of it would
#: make the manifest disagree with its own tree immediately.
MANIFEST_SKIP = ("tmp/", ".git/", "node_modules/", ".venv/")


def hash_tree(target: Path) -> Dict[str, str]:
    """sha256 of every file under `target`, keyed by relative path.

    Everything on disk, including files this scaffold had nothing to do with.
    Used twice: once to hash what the scaffold produced, and once on each side
    of the post-copy steps to find out what they wrote.
    """
    out: Dict[str, str] = {}
    for path in sorted(target.rglob("*")):
        if not path.is_file() or "__pycache__" in path.parts:
            continue
        rel = path.relative_to(target).as_posix()
        if rel == MANIFEST_NAME or rel.startswith(MANIFEST_SKIP):
            continue
        out[rel] = hashlib.sha256(path.read_bytes()).hexdigest()
    return out


def produced_files(written: List[str], after_copy: Dict[str, str], final: Dict[str, str]) -> Set[str]:
    """What this scaffold rendered or generated — never simply what is on disk.

    `--force` writes into a directory that already has files in it, and
    `AGENTS.md` calls that the usual case: the interesting target is a repo
    somebody already works in. Hashing the tree therefore recorded the user's
    own source as skeletor output. proto.pilot, the first real consumer, got a
    manifest of 228 files of which 114 were its own — its product source, its
    tests, its build artifacts, a gitignored `prototypes/` tree — and every
    later `skeletor-upgrade` on it refused outright, because `cross_check`
    correctly reported 114 files "recorded, but the base render does not
    produce it". The guard held; the manifest was the thing that was wrong.

    So the set is computed from what the scaffolder did, in two parts. The copy
    phase reports every file it renders, collisions included — a README the
    scaffold overwrote *is* skeletor output and must be recorded, which is why
    this cannot be "everything that was not here before". The post-copy steps
    are found by comparing the tree either side of them rather than by naming
    the four files they currently write: a list would go stale the next time
    `regen.py` learns to emit an index, and it would go stale silently, since
    a file missing from the manifest reads exactly like a file the user edited.
    """
    produced = {Path(rel).as_posix() for rel in written}
    produced |= {rel for rel, digest in final.items() if after_copy.get(rel) != digest}
    return {rel for rel in produced if rel in final}


def post_copy_steps(tree: Path, values: Dict[str, str]) -> None:
    """Everything the scaffolder does after the overlays are on disk.

    Register whatever docs the chosen overlays actually shipped, then generate
    the indexes, so the tree's own checks pass on the first run. A scaffold whose
    first `check docs` is red teaches that red is normal, and a gate people have
    learned to expect red from is a gate that has stopped working.

    It is a function rather than two lines inlined at the call site **because
    there are two call sites** — here on the real tree, and again in
    `pristine_post_copy` on a copy holding only the render. Written out twice
    they would be two sequences that merely look alike, and a third step added to
    one of them would go in silently: the manifest would record a hash the base
    render cannot produce, every upgrade would refuse, and the failure would
    surface in somebody else's repository weeks later. That is exactly the defect
    this pass exists to fix, so the shape that reintroduces it does not get to
    live here.
    """
    register_shipped_docs(tree, values)
    drop_absent_prose(tree)
    subprocess.run([sys.executable, "scripts/docs/regen.py"], cwd=str(tree), capture_output=True)
    # The editor's issue and pull-request views, rendered from `scripts/lanes.py`
    # and — where the tier ships one — the job registry. It belongs here rather
    # than in the overlay because its output is a function of BOTH, and only the
    # assembled tree knows which of them it got: the same two lanes render
    # "nothing drains this yet" at `core` and a clock time at a tier that has
    # claimed their keys. A static file in `template/core/` would be right for
    # one tier and quietly wrong for the rest.
    subprocess.run([sys.executable, "scripts/gen_vscode_queries.py"], cwd=str(tree), capture_output=True)


def pristine_post_copy(target: Path, written: List[str], values: Dict[str, str]) -> Dict[str, str]:
    """Hashes of the post-copy steps run against the render ALONE, with nothing
    of the target's own in the tree.

    The manifest has to record what the base render produces, because that is
    what `skeletor-upgrade` re-renders and compares against — and for most files
    the render is simply what was written. Two steps break that: both
    `register_shipped_docs` and `regen.py` read the tree they are writing into,
    so in a `--force` scaffold they read the user's files too. proto.pilot had a
    `docs/hosted.md` of its own, `register_shipped_docs` dutifully gave it a row
    in `.github/DOCS_INDEX.md` — correctly, that is the step's whole job — and
    the recorded hash was then of a file no render of those arguments can ever
    produce. Every later upgrade refused, on a hash rather than a surplus entry,
    which pruning cannot repair.

    Recording the *contaminated* hash is not a near miss either. In the
    hash-only fallback the recorded value stands in for the old render on both
    sides of the matrix, so a file the user never touched would read as
    "template moved, user untouched" and get overwritten with a render that has
    no row for their doc. Silent loss of exactly the content the step was
    written to add.

    So `post_copy_steps` runs twice on a populated target: once on the tree,
    which is what the user wants, and once here on a copy holding only the
    rendered files — which at this moment is byte-for-byte the pristine render,
    since the steps have not run yet. The second pass costs a file copy and one
    subprocess, and is skipped entirely for the empty-directory case, where the
    two are the same tree by definition.
    """
    with tempfile.TemporaryDirectory(prefix="skeletor-pristine-") as scratch:
        clean = Path(scratch)
        for rel in written:
            source = target / rel
            if not source.is_file():
                continue
            destination = clean / rel
            destination.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, destination)
        (clean / "tmp").mkdir(exist_ok=True)
        (clean / "tmp" / ".gitkeep").touch()
        post_copy_steps(clean, values)
        return hash_tree(clean)


def write_manifest(target: Path, args, overlays: List[str], files: Dict[str, str]) -> Path:
    """Record how this tree was generated, so an upgrade can reproduce it.

    The **arguments** are the primary record: `bin/skeletor-upgrade` re-renders
    the base from `skeletor_ref` plus these, and three-way merges against it.
    The resolved `--slug`, `--cli` and `--env-prefix` are written out even when
    they were defaulted, because their defaults derive from the *target
    directory name* — and an upgrade renders into a temporary directory with a
    different one.

    The **hashes** are a fallback, and only that. They answer one question the
    render also answers — "has anybody touched this file?" — for the case where
    the render is out of reach: a shallow clone, a tarball, a collected ref.
    They cannot be used to merge, because merging needs the base *text*.

    A hash is a derived value with a second home, which is normally the thing
    this project refuses. It is allowed here because it is checked against its
    source on every ordinary run: whenever `skeletor-upgrade` renders the base
    it re-hashes it and fails loudly if the manifest disagrees. A cache that is
    validated against its source every time it is bypassed cannot rot unnoticed.

    Note what a match proves. `sha256(on disk) == recorded` means the file *is*
    byte-for-byte what skeletor generated, so replacing it with a newer render
    loses nothing — that is a proof, not a heuristic, which is why the fallback
    is allowed to write files at all.

    `files` is therefore `produced_files()`, and never a walk of the tree: what
    is recorded has to be exactly what the base render produces, or the very
    check that makes the fallback trustworthy fails on every run.
    """
    values = substitutions(args)
    recorded = manifest_args(args, values)
    manifest = target / MANIFEST_NAME
    manifest.write_text(
        json.dumps(
            {
                "_comment": (
                    "Generated by skeletor-new; read by skeletor-upgrade. Do not hand-edit. "
                    "It records how this tree was rendered, so an upgrade can reproduce the "
                    "same base and three-way merge against it."
                ),
                "skeletor_ref": skeletor_ref(),
                "args": recorded,
                "files": files,
            },
            indent=2,
        )
        + "\n",
        encoding="utf-8",
    )
    return manifest


def build_parser() -> argparse.ArgumentParser:
    """The flags, in one place something else can read.

    Extracted from `main()` so `write_manifest` can derive what to record from
    the parser rather than repeating it — see `NOT_RENDERED`.
    """
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("target", help="directory to create")
    parser.add_argument("--name", help='human name, e.g. "Order Service"')
    parser.add_argument("--slug", help="repo slug (defaults to the directory name)")
    parser.add_argument(
        "--cli",
        help="name of the wrapper for this repo's own commands — check/docs/test, e.g. `ord`; "
        "defaults from the slug. Not the product's command if the product is itself a CLI: see AGENTS.md",
    )
    parser.add_argument("--env-prefix", help="env-var prefix, e.g. ORD (defaults from the CLI name)")
    #: Required, and deliberately without a default. This is the only rendered
    #: field that cannot be derived from anything else: `--name` falls back to
    #: the slug, `--cli` and `--env-prefix` to the target directory name. So a
    #: default here can only ever be placeholder text, and this one was
    #: `<one line: what this project is>`. Omitting the flag rendered that
    #: literal into five files plus `.skeletor.json`, green, because by the time
    #: `render()` sees it it is a substituted string like any other — the check
    #: for an *unsubstituted* `{{PLACEHOLDER}}` cannot see a placeholder that
    #: substituted correctly. dream-doll scaffolded at v0.13.1 without passing
    #: it and reached `cli/__init__.py`'s docstring, i.e. rendered `--help`
    #: output. The manifest is the durable half: it is the upgrade base, so
    #: every later `skeletor-upgrade` re-renders the placeholder, and
    #: `--repair-manifest` re-derives it faithfully.
    #:
    #: Requiring it is the whole fix, and it is subtraction rather than
    #: validation: it turns a silent wrong render into an argparse error at the
    #: only moment the missing information exists, and deletes the string that
    #: was its own copy-paste source. A `^<.*>$` guard would treat the symptom
    #: and leave a scaffolder judging a user's prose; presence is checkable,
    #: content is not.
    parser.add_argument("--tagline", required=True, help="one line: what this project is")
    parser.add_argument(
        "--tier",
        choices=sorted(TIERS),
        default="core",
        help="how much governance ships. Cumulative: governed adds core, agentic adds both.",
    )
    parser.add_argument(
        "--versioning",
        choices=sorted(VERSIONING),
        default="release-please",
        help=(
            "release-please (default): a bot owns the version, writes CHANGELOG.md and bumps "
            "VERSION. tag: the annotated git tag is the only version, and none of that ships. "
            "Pick by asking whether THE THING YOU HAND SOMEBODY has a .git directory — a "
            "tarball, an image or a desktop build does not, so `git describe` answers nothing "
            "there and VERSION is the only thing that knows. A checkout has the tag, and the "
            "file is then a second copy of a number git already holds."
        ),
    )
    parser.add_argument(
        "--language",
        choices=["python", "node", "both", "none"],
        default="python",
        help=(
            "which language your PRODUCT is in, and nothing more. This does not choose the "
            "shell's language: cli/, scripts/ and tests/ are python and ship at every tier, "
            "with the toolchain that lints them, whatever you pass here. So this flag only "
            "ever ADDS — `node` appends eslint, package.json and the javascript rule doc; "
            "`none` subtracts nothing."
        ),
    )
    parser.add_argument(
        "--agent",
        choices=sorted(AGENTS),
        default="claude",
        help="which agent's tooling to ship (settings, hooks, subagents, skills). "
        "The conventions in docs/rules/ are shipped either way.",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="render into a temporary directory and report what a real run would write "
             "and which of your files it would overwrite; writes nothing",
    )
    parser.add_argument("--base-branch", default="develop", help="the integration branch")
    parser.add_argument(
        "--release-branch",
        default="main",
        help="the branch a release is cut from; the CI badge is pinned to it",
    )
    parser.add_argument(
        "--python",
        default="3.12",
        help=(
            "the OLDEST python this project must stay valid for, not the interpreter you "
            "happen to be running. It renders into pyrightconfig.json's pythonVersion and "
            "black's target-version, which are floors — and into CI's setup-python, which "
            "is not, so CI tests on the floor. Naming a version newer than your floor lets "
            "BLACK REWRITE YOUR CODE into syntax older interpreters cannot parse."
        ),
    )
    parser.add_argument(
        "--reproducing",
        action="store_true",
        help=(
            "re-render a tree that already exists, for comparison — suppresses the checks that are "
            "about CREATING one. `bin/skeletor-upgrade` passes it; nothing else should."
        ),
    )
    parser.add_argument(
        "--python-ceiling",
        default=None,
        help=(
            "the NEWEST interpreter CI runs the unit suite on. `--python` is the floor and this is "
            "the ceiling; CI runs a matrix over the pair. Defaults to `--python`, which is a "
            "one-leg matrix — the same coverage a single-version job gave, so a scaffold that says "
            "nothing changes nothing but the status context's name. The two failure modes a matrix "
            "catches both live at the ends: a deprecation at the ceiling, a syntax feature below the floor."
        ),
    )
    parser.add_argument(
        "--shell-package",
        default="cli",
        help=(
            "the python package the shell's commands live in (default: `cli`). Rename it when "
            "your PRODUCT already owns that name — `cli` is the most collided-with package name "
            "in a python monorepo, and a shell that cannot move out of the way costs an adopter "
            "a rename mid-flight."
        ),
    )
    parser.add_argument(
        "--line-length",
        type=int,
        default=120,
        help="the column limit black, isort and flake8 all enforce (floor: what this template's own files need)",
    )
    parser.add_argument(
        "--org",
        default=ORG_UNSET,
        help="the GitHub owner: CODEOWNERS, and the README badges, which are omitted without it",
    )
    parser.add_argument("--timezone", default="UTC", help="the timezone the crontab fires in (agentic tier)")
    # Not the flag to reach for when scaffolding into a repository that already
    # exists: the guard below already skips a tree with a `.git`, so `--no-git`
    # is a no-op there and only bites in the case it looks safest in — an empty
    # directory, where it leaves a tree with no repository at all. This is for a
    # render that must never become one (`skeletor-upgrade`'s base, a probe).
    parser.add_argument("--no-git", action="store_true", help="render a tree that is not a repository at all")
    parser.add_argument(
        "--allow-dirty",
        action="store_true",
        help="scaffold from a checkout whose uncommitted work reaches the render (throwaway trees)",
    )
    parser.add_argument("--force", action="store_true", help="write into an existing non-empty directory")
    return parser


#: Declared, and deliberately not recorded, because not one of them reaches a
#: render. They govern the *act* of scaffolding: `--force` gates the refusal on
#: a populated target, `--no-git` gates `git init`, `--allow-dirty` and
#: `--reproducing` suppress checks about creating a tree. A base render wants
#: none of them, and `render_with` supplies the two it does want itself.
#:
#: Every other flag is recorded by existing, which is the point — this set is
#: the only thing anybody has to keep, and `bin/skeletor-verify` fails if an
#: entry stops being a real flag.
#:
#: `--reproducing` is the entry that cost something. It arrived as a store_true
#: and was not exempted, so every manifest recorded `--reproducing False` and
#: every re-render died on `unrecognized arguments: False` — a fresh scaffold,
#: permanently unupgradable, which is the exact failure `--versioning` caused
#: from the other direction. `manifest_args_gate` asked which flags reach the
#: record and never whether the record parses back; it does both now.
NOT_RENDERED = {"force", "no_git", "dry_run", "allow_dirty", "reproducing"}

#: Flags whose recorded value is the **derived** one rather than the raw
#: argument. All four default from the target directory name, and an upgrade
#: re-renders into a temporary directory with a different one — so recording
#: `None` here makes a manifest that cannot reproduce its own tree.
DERIVED_FROM_TARGET = {
    "name": "PROJECT_NAME",
    "slug": "PROJECT_SLUG",
    "cli": "CLI",
    "env_prefix": "CLI_ENV_PREFIX",
}


def manifest_args(args, values: Dict[str, str]) -> List[str]:
    """The `args` a manifest records, derived from the parser's own flags.

    This was a hand-written list of fourteen, and it went stale exactly the way
    Rule 2 says a registry does: `--versioning` was added, changed what ships,
    and was never added here. Every `--versioning tag` tree therefore recorded
    arguments that re-render as a release-please tree, so `cross_check` refused
    four wrong hashes and three unrecorded files, and **every such tree was
    permanently unupgradable**. Release-please trees were fine only because the
    default happened to match. Found by node-zero, who proved it differentially
    — same ref, recorded args versus recorded args plus `--versioning tag`, 4/3
    against 0/0 with all 102 hashes reproducing.

    A flag is recorded by existing now. `--repair-manifest` was a trap for the
    affected trees for the same reason and is fixed by the same change: it
    re-derives from a base render, and the base render was the wrong tree.

    **The record has to parse back**, and the first version of this could emit
    something that does not. It wrote `flag value` for every action, which is
    wrong for a `store_true`: `--reproducing` arrived, every manifest recorded
    `--reproducing False`, and every re-render of every tree scaffolded that
    hour died on `unrecognized arguments: False`. That flag is exempt now —
    it is about the act, not the render — but the shape is handled here as
    well, because the exemption is a judgement about one flag and the next
    render-affecting `store_true` is entitled to be recorded correctly rather
    than to be remembered about.

    A `None` is dropped rather than stringified for the same reason one level
    over: `str(None)` is `"None"`, which parses back as a value and renders as
    one. Nothing render-affecting reaches here as `None` today — the four that
    default from the target directory come through `DERIVED_FROM_TARGET`
    resolved, and `--python-ceiling` through `resolve()` — so this is the
    guard, not the mechanism, and the flag simply falls back to its own default.
    """
    recorded: List[str] = []
    for action in build_parser()._actions:
        if not action.option_strings or action.dest in NOT_RENDERED or action.dest == "help":
            continue
        key = DERIVED_FROM_TARGET.get(action.dest)
        value = values[key] if key else getattr(args, action.dest)
        if action.nargs == 0:
            # A flag that takes no value records as presence or absence.
            recorded += [action.option_strings[0]] if value != action.default else []
        elif value is not None:
            recorded += [action.option_strings[0], str(value)]
    return recorded


def lost_entries(before: str, after: str, limit: int = 12) -> List[str]:
    """Keys in `before` that `after` does not have, for a file that is JSON in both.

    The warning above names files. This names what was *in* one, because the
    expensive case is a manifest: replacing `package.json` removes an adopter's
    `build`, `test` and `typecheck` while keeping the two scripts CI happens to
    invoke, so nothing anywhere goes red. The file's name in a list of 102 is
    not what tells somebody that.

    One level into nested maps and no further. `scripts` and `dependencies` are
    the entries that get lost and they are exactly one level down; recursing
    deeper would report every changed compiler option in a `tsconfig.json` as a
    loss, which is noise about a file the adopter can diff.

    **Non-JSON is not a failure and returns nothing.** This is an extra sentence
    on a warning, not a gate: a YAML workflow or a markdown file that cannot be
    parsed here still gets its name printed by the caller, which is the
    behaviour that existed before. Silence is the honest answer for a shape
    this cannot read, and inventing a diff for one would be worse than the
    filename alone.
    """
    try:
        old, new = json.loads(before), json.loads(after)
    except (ValueError, TypeError):
        return []
    if not isinstance(old, dict) or not isinstance(new, dict):
        return []
    lost = []
    for key, value in sorted(old.items()):
        if key not in new:
            lost.append(key)
        elif isinstance(value, dict) and isinstance(new[key], dict):
            lost += [f"{key}.{inner}" for inner in sorted(set(value) - set(new[key]))]
    return lost[:limit] + ([f"…and {len(lost) - limit} more"] if len(lost) > limit else [])


def existing_files(target: Path) -> Set[str]:
    """What is in the tree before skeletor touches anything.

    Not "before this overlay": a later overlay overwriting an earlier one is
    the composition working, and only a file predating the whole scaffold is
    somebody's own. `.git/` is excluded because it is not content.

    One function because there are two callers — the real run, which uses it to
    name what it overwrote, and `--dry-run`, which uses it to name what a real
    run *would*. Two copies of this would be two answers to "is that yours?",
    and the dry run's job is to predict the other one exactly.
    """
    return {
        path.relative_to(target).as_posix()
        for path in target.rglob("*")
        if path.is_file() and ".git/" not in path.relative_to(target).as_posix()
    }


def copy_overlays(
    target: Path, overlays: List[str], values: Dict[str, str], cli_name: str, omit: Iterable[str]
) -> Optional[List[str]]:
    """Render every overlay into `target`, and report what was written.

    Extracted so `--dry-run` renders through *this* code rather than a
    description of it. A dry run that reproduced the loop would be a second
    reading of the same intent, and the two would answer differently the first
    time an overlay grew a rule — which is the failure this repository keeps
    finding in other people's registries.

    Returns `None` after reporting a missing overlay, which is always a bug in
    the template rather than in the invocation.
    """
    written: List[str] = []
    for overlay in overlays:
        source = TEMPLATE / overlay
        if not source.exists():
            print(f"❌ missing overlay: {source}")
            return None
        copy_overlay(source, target, values, cli_name, written, omit=omit)

    (target / cli_name).chmod(0o755)
    (target / "tmp").mkdir(exist_ok=True)
    (target / "tmp" / ".gitkeep").touch()
    return written


def report_a_dry_run(
    target: Path, pre_existing: Set[str], overlays: List[str], values: Dict[str, str], args
) -> int:
    """Say what a real run would write, and what of yours it would replace.

    Every adopter so far took `--force` into a repository they already worked
    in — `AGENTS.md` calls that the usual case — and learned what it had
    destroyed from a list printed **after** the write. `CLAUDE.md` collided in
    four adoptions out of four: every one of them overwrote the file holding
    their previous agent instructions, on step 1 of the setup guide. That is
    not a risk profile, it is a certainty, and it is the reason this exists.

    The render happens in a temporary directory, so the answer is measured
    rather than predicted, and `target` is not so much as created. The set is
    the **pristine** render — copy plus the post-copy steps — because
    `regen.py` and `register_shipped_docs` write files too, and a report that
    counted only the copied ones would understate what it is warning about.
    """
    with tempfile.TemporaryDirectory(prefix="skeletor-dry-") as tmp:
        preview = Path(tmp) / "tree"
        preview.mkdir()
        written = copy_overlays(preview, overlays, values, values["CLI"], VERSIONING[args.versioning])
        if written is None:
            return 1
        post_copy_steps(preview, values)
        produced = set(hash_tree(preview))
        # Read inside the block, because `preview` is a temporary directory and
        # the report below runs after it is removed. Only the collisions — the
        # rest of the render is not being compared against anything.
        would_write = {}
        for rel in pre_existing & produced:
            try:
                would_write[rel] = (preview / rel).read_text(encoding="utf-8")
            except (OSError, UnicodeDecodeError):
                pass

    collides = sorted(pre_existing & produced)
    print()
    print(f"→ dry run — nothing is written, and {target} is not created or modified")
    print()
    print(f"   {len(produced)} file(s) would be written into {target}")
    print(f"   {args.tier} tier, --language {args.language}, --agent {args.agent}, "
          f"--versioning {args.versioning}")
    print()

    if collides:
        # The same entry-level report as the real run, and this is the place it
        # is worth most: here nothing has been lost yet. A dry run that named
        # only the filenames would be the weaker half of a pair whose whole
        # purpose is to be read BEFORE the destructive one.
        print(f"⚠️  {len(collides)} of them already exist here and WOULD BE OVERWRITTEN:")
        for rel in collides:
            print(f"   · {rel}")
            try:
                lost = lost_entries((target / rel).read_text(encoding="utf-8"), would_write.get(rel, ""))
            except (OSError, UnicodeDecodeError):
                lost = []
            if lost:
                print(f"       {len(lost)} entr(y/ies) of yours would not survive:")
                print(f"       {', '.join(lost)}")
        print()
        print("   Save what you mean to keep first. Whatever survives a real run is")
        print("   recorded as skeletor's, so every later `skeletor-upgrade` three-way")
        print("   merges it — a file you kept is a standing merge point, not a one-off.")
    elif pre_existing:
        print(f"✅ none of the {len(pre_existing)} file(s) already here would be overwritten")
    else:
        print("✅ the target is empty — nothing of yours is at risk")

    if pre_existing and not args.force:
        print()
        print("   The target is not empty, so a real run needs --force as well.")
    return 0


def version_key(version: str) -> Tuple[int, ...]:
    """`"3.9"` sorts below `"3.12"`, which string comparison gets backwards."""
    return tuple(int(part) for part in version.split(".") if part.isdigit())


def python_matrix(floor: str, ceiling: str) -> str:
    """The `strategy.matrix.python` list, as YAML flow sequence.

    One entry when the two agree, which is the default. A scaffold that says
    nothing about a ceiling gets exactly the coverage a single-version job gave
    it — this is not a mode, it is a range whose ends happen to coincide, and
    that is what keeps the matrix from being red on arrival for anybody.
    """
    versions = [floor] if floor == ceiling else [floor, ceiling]
    return "[" + ", ".join(f"'{version}'" for version in versions) + "]"


def line_length_floor() -> Tuple[int, str]:
    """The strictest column limit the files this generator copies can satisfy.

    `--line-length` renders into black, isort and flake8, and it used to accept
    any integer while this template's own python sat **exactly on the default**
    — 120 against a default of 120, zero margin. So `--line-length 88`, which is
    both black's default and ruff's and therefore the most likely non-default
    value anybody types, produced a tree whose vendored files failed its own
    lint on the first `pre-commit run`. A scaffold that is red on arrival is the
    one outcome this repository treats as unacceptable, and the flag walked
    straight to it.

    **Measured, never written down.** A floor as a constant would be a number
    with a second home, going stale the day somebody adds a longer line — and
    stale in the silent direction, since the constant would keep accepting a
    value the template can no longer meet. Reading the files is the same act as
    checking the number, which is this project's rule about a cache validated on
    every run.

    This measures the TEMPLATE, and the linted artefact is the RENDER. The two
    differ because a placeholder substitutes to a different width, so this is a
    close approximation and not the guarantee; `bin/skeletor-verify` scaffolds
    at this floor and runs the tree's own formatters, which is where the claim
    is actually settled. Found by mind.head, at `--line-length 100`, on files
    they had not written.
    """
    widest, where = 0, ""
    for path in sorted(TEMPLATE.rglob("*.py")):
        if "__pycache__" in path.parts:
            continue
        for line in path.read_text(encoding="utf-8").splitlines():
            if len(line) > widest:
                widest, where = len(line), path.relative_to(TEMPLATE).as_posix()
    return widest, where


def resolve(args):
    """Defaults that depend on another flag, applied in one place.

    `main()` and anything asking what a manifest *would* record have to agree
    about these, or the two describe a tree neither has built. Doing it inline
    in `main()` meant `manifest_args_gate` parsed arguments and got
    `python_ceiling=None`, so it modelled a record no scaffold ever writes —
    a gate reasoning about a shape the product does not produce.

    Validation stays in `main()`: this only fills a blank, and refusing is the
    caller's business.
    """
    args.python_ceiling = args.python_ceiling or args.python
    return args


def main() -> int:
    args = resolve(build_parser().parse_args())

    # The shell's package must be importable and must not land on top of
    # something the template already puts at the root. The taken set is
    # DISCOVERED — every top-level entry in every overlay, minus the shell's own
    # default, which is the one name it is allowed to keep — because a list here
    # would be right about the directories that existed the day it was written
    # and silent about the next one.
    # An agent value in AGENTS names a CONTAINER of overlays, not an overlay, so
    # its children are descended one level further. Getting that wrong would put
    # the tier names into the set and forbid `--shell-package core`.
    overlays = [d for d in TEMPLATE.iterdir() if d.is_dir() and d.name not in AGENTS.values()]
    overlays += [d for parent in AGENTS.values() if parent for d in (TEMPLATE / parent).iterdir() if d.is_dir()]
    taken = {entry.name for overlay in overlays for entry in overlay.iterdir()} - {"cli"}
    name = args.shell_package
    if not name.isidentifier() or keyword.iskeyword(name) or name in taken:
        print(
            f"❌ --shell-package {name!r} is not usable. It must be a python identifier that is not "
            "a keyword — the tree imports it by name — and must not be a path this template already "
            f"ships at the root: {', '.join(sorted(taken))}."
        )
        return 1

    if version_key(args.python_ceiling) < version_key(args.python):
        print(
            f"❌ --python-ceiling {args.python_ceiling} is below --python {args.python}. `--python` is "
            "the FLOOR (pyrightconfig's pythonVersion, black's target-version) and this is the "
            "ceiling; a ceiling under the floor is an empty range, and CI would test a version your "
            "own config says you do not support."
        )
        return 1

    # **A generator may constrain what it creates. It may not retroactively
    # constrain what it has already created**, because by then the thing being
    # validated is no longer only its own work. That is mind.head's rule and it
    # cost them an upgrade to find.
    #
    # The floor's whole premise is *red on arrival* — a tree nobody has touched
    # yet, failing its own first `pre-commit run`. An existing adopter has
    # already met that problem and may have solved it differently and correctly:
    # theirs deleted `.flake8`, runs ruff at 100, and carries an `E501`
    # per-file-ignore for the vendored files, which is the remedy this project
    # endorsed when they reported the nine findings. And `bin/skeletor-upgrade`
    # renders the base by running this scaffolder, so the refusal and the
    # evidence against it were produced by the same tool in the same
    # invocation: it printed `.flake8 — skeletor wrote and you deleted, NOT
    # restored` and then declined to render because the tree "would fail its
    # own flake8".
    #
    # A comparison render is thrown away — nobody runs `pre-commit` in it — so
    # the question is not merely relaxed here, it was never being asked.
    #
    # The flag rather than a special case, because the next scaffold-time
    # invariant belongs behind the same door instead of growing its own escape.
    floor, widest_file = line_length_floor()
    if args.line_length < floor and not args.reproducing:
        print(
            f"❌ --line-length {args.line_length} is below {floor}, which is what this template's own "
            f"files need ({widest_file} has a {floor}-column line).\n"
            f"   Every scaffold vendors those files, so the tree would fail its own black and flake8 "
            f"on the first `pre-commit run` — red on arrival, before you have written anything.\n"
            f"   Pass {floor} or more, or fork the template and reformat it at the width you want."
        )
        return 1

    # Before anything is written, and before `skeletor_ref()` is read: the
    # render is worthless the moment the ref is stamped, so this has to precede
    # the write rather than report after it. A dry run is exempt for the same
    # reason it is exempt from the populated-target refusal — it records
    # nothing, so the hazard cannot land — and the warning still prints.
    refuse_a_dirty_render(args.allow_dirty or args.dry_run)

    target = Path(args.target).expanduser().resolve()
    populated = target.exists() and any(target.iterdir())
    # A dry run is not refused here. Looking before you decide is the whole
    # point, and being told to pass `--force` in order to find out what
    # `--force` would destroy is the shape this flag exists to remove. The
    # report says so instead.
    if populated and not args.force and not args.dry_run:
        print(f"❌ {target} exists and is not empty (pass --force to write into it)")
        return 1

    values = substitutions(args)
    cli_name = values["CLI"]

    # Each overlay, then that overlay's agent files if the chosen agent ships
    # any. Applied per-overlay rather than once at the end because agent files
    # are tier-shaped: `.claude/skills/` describes the agentic workflow and has
    # no meaning at `core`. An agent overlay that does not exist is skipped —
    # most overlays have no vendor files at all — while a missing TIER overlay
    # stays a hard error, because that one is always a bug.
    agent_root = AGENTS[args.agent]
    overlays = []
    for name in list(TIERS[args.tier]) + (
        LANGUAGE_OVERLAYS[args.language].split(",") if args.language != "none" else []
    ):
        overlays.append(name)
        if agent_root and (TEMPLATE / agent_root / name).is_dir():
            overlays.append(f"{agent_root}/{name}")

    if args.dry_run:
        return report_a_dry_run(target, existing_files(target) if populated else set(), overlays, values, args)

    target.mkdir(parents=True, exist_ok=True)
    # What was here before skeletor touched anything. Not "before this overlay":
    # a later overlay overwriting an earlier one is the composition working, and
    # only a file predating the whole scaffold is somebody's own.
    pre_existing = existing_files(target) if populated else set()
    # The CONTENT of what is about to be replaced, for the report below. Read
    # here because after `copy_overlays` it is gone — and the alternative,
    # asking git, answers nothing in a target that is not a repository or whose
    # file was never committed.
    before_text = {}
    for rel in pre_existing:
        try:
            before_text[rel] = (target / rel).read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError):
            pass
    written = copy_overlays(target, overlays, values, cli_name, VERSIONING[args.versioning])
    if written is None:
        return 1

    after_copy = hash_tree(target)
    pristine = pristine_post_copy(target, written, values) if populated else {}
    post_copy_steps(target, values)

    # Last, and after the two steps above: both write files, and a manifest
    # hashed before them would describe a tree that no longer exists. The two
    # snapshots either side of them are what tells the files they generate
    # apart from files that were simply already here — see `produced_files`.
    final = hash_tree(target)
    # On a populated target the base render is standing right there, in
    # `pristine`, and it is the answer to the question the manifest asks — so
    # it decides membership and not only the hashes. `produced_files` answers a
    # different question, "did this run write it", and the two diverge in both
    # directions at once:
    #
    #   * An **idempotent generator.** `regen.py`'s four outputs are not shipped
    #     by any overlay, so they enter only by changing across `post_copy_steps`.
    #     On a second `--force` they already exist with identical content, regen
    #     no-ops, and all four silently leave the manifest — measured, 126 -> 122
    #     into a tree skeletor itself had just made. Every second `--force`, on
    #     any tree, whatever it looked like going in.
    #   * A **post-copy step reading the user's files**, which is what those
    #     steps are for. `add_frontmatter.py` stamps an adopter's own plan in
    #     `docs/TODO/`, its hash moves, and a document no render can produce is
    #     recorded as skeletor's. mind.head measured 124 recorded against a true
    #     105 and every later upgrade refused on a wrong hash, which is the worse
    #     refusal because a surplus entry can be deleted by hand and a wrong one
    #     cannot.
    #
    # Both were reported as separate bugs and both are this line. `pristine` is
    # `post_copy_steps` run against the render alone, so it is neither too small
    # on the first count nor too large on the second, by construction rather
    # than by correction. For an empty target it is `{}` and cannot be consulted
    # — but there the tree *is* the render, so `produced_files` is exact.
    produced = set(pristine) if populated else produced_files(written, after_copy, final)
    write_manifest(target, args, overlays, {rel: pristine.get(rel, final[rel]) for rel in sorted(produced)})

    # `produced`, not `written`. The copy phase is not the only thing that
    # writes: `regen.py` overwrote a user's own `docs/todo_index.json` and this
    # warning never named it, because `written` answers "did the copy phase
    # write it" and the question here is "what of yours did skeletor replace".
    # The manifest bug above, in the one place whose entire job is to be
    # complete. Found by building `--dry-run` and comparing its prediction
    # against this list; they are the same set by construction now, which is
    # what makes the prediction worth anything.
    overwritten = sorted(pre_existing.intersection(produced))
    if overwritten:
        # Loudly, and by name. `--force` writes over whatever is in its way and
        # the losses are silent by construction: a file that is gone raises
        # nothing, and the guidance ("review the diff file by file") points at a
        # 97-file diff in which these twelve are the only ones that matter.
        #
        # sky.boss measured what that costs on a real repository. Four of the
        # twelve were load-bearing and every one failed quietly: PYTHONSAFEPATH
        # in the CLI wrapper, whose absence let `python -m cli` import whatever
        # `cli/` happened to be in the cwd and generate a full set of systemd
        # units with the wrong WorkingDirectory, successfully; and a conftest
        # redirect whose loss pointed the suite at the operator's real state
        # directory. Neither announces itself. Naming the files is the whole fix
        # — it turns reviewing the scaffold into reviewing this list.
        #
        # And naming the file is not enough when the loss is INSIDE it, which
        # is the same finding one level down. `--force` over a node product
        # replaces `package.json` wholesale: the template's supplies
        # `lint:check` and `format:check`, and `build`, `typecheck`, `test`,
        # `dev` and `preview` are gone. **CI then goes green on a tree whose
        # build script no longer exists**, because every `npm run` in `ci.yml`
        # names a script the template's own manifest provides — there is no
        # configuration in which the workflow calls something the overwrite
        # removed. A generator that replaces a manifest and then tests only the
        # entries it wrote cannot detect what it destroyed. dream-doll lost
        # eight scripts that way and it was caught by a human reading a
        # 102-file diff.
        #
        # Reported by SHAPE, not by filename: a file that parses as JSON on
        # both sides gets its lost keys named, one level into any nested map,
        # which is where `scripts` and `dependencies` live. So `tsconfig.json`
        # and an `.eslintrc.json` are covered by the same code and no list
        # names any of them.
        print()
        print(f"⚠️  {len(overwritten)} file(s) you already had were OVERWRITTEN:")
        for rel in overwritten:
            lost = lost_entries(before_text.get(rel, ""), (target / rel).read_text(encoding="utf-8", errors="replace"))
            print(f"   · {rel}")
            if lost:
                print(f"       {len(lost)} entr(y/ies) of yours are not in skeletor's version:")
                print(f"       {', '.join(lost)}")
        print()
        print("   `git diff` them before anything else, and restore what you meant to keep.")
        print("   Whatever survives here is now recorded as skeletor's, so every future")
        print("   `skeletor-upgrade` three-way merges it — a file you kept is a standing")
        print("   merge point, not a one-off.")

    # A scaffold into a repository somebody already works in leaves 105 files
    # UNTRACKED, and three of the tests it just shipped are red on arrival for
    # exactly that: `tests/repo_files.py` enumerates with `git ls-files`, on
    # purpose — a walk reads `.venv/.../pyright/dist/README.md` and makes the
    # verdict depend on what the dependency tree happens to ship — so in a
    # `--force` target the scanners find nothing and their empty-scope guards
    # fire, correctly. `git add -A` in the tree turns three failures into six
    # passes, and the closing advice below ends with `check pre-push`, which is
    # the command that fails. This tool's last word was an instruction to run
    # the thing it had just broken.
    #
    # Staged, never committed. The commit is theirs to make and the printed
    # advice already says to read the diff first; staging is what makes
    # `ls-files` answer, and it is strictly less surprising than 105 loose
    # untracked files. Only what skeletor PRODUCED — `git add -A` here would
    # sweep up the user's own unstaged work into a changeset labelled ours.
    #
    # Reported by node-zero from a fresh scaffold and reproduced independently
    # by skyrow-workspace with unrelated arguments, byte-identical failures. It
    # survived four tags because `--dry-run` looks like it addressed this and
    # does not: that flag is about collisions at the moment of writing, this is
    # about the render being untracked afterwards. Two moments in one command,
    # and the first one landing made the second look handled.
    #
    # `produced` PLUS the manifest, and the manifest is the whole reason this
    # needs saying. It cannot appear in its own `files` list — `cross_check` is
    # a bijection between that list and the base render, and a hash of the
    # manifest would have to contain itself — so it sits beside the render by
    # construction. Staging the recorded set alone therefore left the one file
    # `skeletor-upgrade` reads outside git, on the path where the scaffolder
    # does not commit: an adopter who did the obvious next thing committed 100
    # files and no manifest. The same class as recording post-copy mutations,
    # facing the other way — *what skeletor wrote* and *what the manifest lists*
    # are different sets, and using the second as a proxy for the first breaks
    # exactly where they differ. Found by skyrow-workspace in one command
    # against a real tree; reading the code would not have shown it, because the
    # code was correct about the set it named.
    if populated and (target / ".git").exists() and produced:
        wrote = sorted(set(produced) | {MANIFEST_NAME})
        ignored = subprocess.run(
            ["git", "check-ignore", "--", *wrote],
            cwd=str(target), capture_output=True, text=True,
        ).stdout.split()
        stageable = sorted(set(wrote) - set(ignored))
        staged = subprocess.run(
            ["git", "add", "--", *stageable], cwd=str(target), capture_output=True, text=True
        ) if stageable else None
        if staged is not None and staged.returncode == 0:
            print()
            print(f"→  staged {len(stageable)} file(s) skeletor wrote. Nothing was committed.")
            print("   Untracked, the suites that enumerate with `git ls-files` find nothing and")
            print("   their empty-scope guards fire — `check pre-push` is red on a tree nobody")
            print("   has touched. Unstage with `git reset` if you want them separated.")
        elif staged is not None:
            print()
            print("⚠️  could not stage what was written:")
            print("   " + (staged.stderr or staged.stdout).strip().replace("\n", "\n   "))
        if ignored:
            print()
            print(f"⚠️  {len(ignored)} file(s) skeletor wrote are excluded by your .gitignore:")
            for rel in sorted(ignored):
                print(f"   · {rel}")
            print("   They are on disk and invisible to every check that asks git what exists.")

    committed = False
    if not args.no_git and not (target / ".git").exists():
        subprocess.run(["git", "init", "-q", "-b", args.base_branch], cwd=str(target), check=False)
        # Actually make the first commit. "Governs itself from its first commit"
        # is not true of a tree that has no commits: `git diff`, `check reports`
        # and every worktree command need a HEAD to compare against, and the
        # user's real first commit would otherwise bury the scaffold in it.
        # --no-verify because the hooks are not installed yet — the very next
        # step in the printed instructions is what installs them.
        subprocess.run(["git", "add", "-A"], cwd=str(target), check=False)
        first = subprocess.run(
            ["git", "commit", "-q", "--no-verify", "-m",
             f"chore: scaffold {values['PROJECT_SLUG']} from skeletor ({args.tier} tier)"],
            cwd=str(target), capture_output=True, text=True,
        )
        committed = first.returncode == 0
        if not committed:
            print("⚠️  git init succeeded but the first commit did not:")
            print("   " + (first.stderr or first.stdout).strip().replace("\n", "\n   "))
            print("   (usually an unset user.name/user.email — commit by hand once it is set)")

    # Install the merge driver whenever there IS a repo — the one just created,
    # or the one already there that the block above deliberately left alone. Its
    # definition lives in .git/config, which is not version controlled — without
    # it, .gitattributes points at a driver that does not exist and git silently
    # three-way-merges a generated JSON.
    if (target / ".git").exists():
        subprocess.run([sys.executable, "scripts/git/install_merge_drivers.py"], cwd=str(target), capture_output=True)

    print(f"✅ scaffolded {target}")
    print(f"   tier: {args.tier} ({' + '.join(overlays)})   files: {len(written)}")
    print(f"   CLI:  ./{cli_name}")
    if committed:
        print(f"   git:  first commit on '{args.base_branch}'")
    print()
    print("Next:")
    print(f"   cd {target}")
    for step in setup_commands(args.language):
        print(f"   {step}")
    print(f"   ./{cli_name} check pre-push")
    print()
    print("Then fill in the SCAFFOLD markers — they are the parts only you can write:")
    sys.stdout.flush()   # else the grep below prints above this line
    subprocess.run(["grep", "-rln", "SCAFFOLD", "--include=*.md", "--include=*.yml", "--include=*.py", "."], cwd=str(target))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
