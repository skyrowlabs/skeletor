#!/usr/bin/env python3
"""Scaffold a new project from the skeletor template.

    bin/skeletor-new ../my-project --name "My Project" --cli mp --tier governed

Copies the requested tier's overlays in order, substitutes every placeholder,
and leaves you a tree that runs its own gates from the first commit.

The tiers are cumulative — see docs/TIERS.md for what each one buys and, more
importantly, what it costs. **Do not take a tier you will not maintain**: an
unmaintained gate is worse than an absent one, because it is red for reasons
nobody remembers and therefore ignored.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Dict, List, Set

SKELETOR = Path(__file__).resolve().parents[1]
TEMPLATE = SKELETOR / "template"

#: Tier -> the overlay directories it composes, in application order. Later
#: overlays overwrite earlier ones, so a tier can specialise a core file.
TIERS: Dict[str, List[str]] = {
    "core": ["core"],
    "governed": ["core", "governed"],
    "agentic": ["core", "governed", "agentic"],
}

LANGUAGE_OVERLAYS = {"python": "python", "node": "node", "both": "python,node"}

#: Files whose bytes must not be touched by substitution.
#: Agent -> the overlay directory holding that tool's files, applied after each
#: tier it specialises. Everything in here is tooling for one vendor: settings,
#: hooks, subagents, skills. The *conventions* are never in here — they live in
#: `docs/rules/`, are plain markdown, and are read because `AGENTS.md` names
#: them. Segmenting by vendor would otherwise put the testing rules behind a
#: flag, and `--agent none` would silently ship a tree with no testing rules.
AGENTS = {"claude": "agent-claude", "none": None}

#: Versioning mode -> the relative paths it does NOT ship. `release-please` is
#: the default and omits nothing.
#:
#: The question this answers is a fact about the project rather than a taste:
#: **does anything install this?** A published artifact needs a tracked
#: `VERSION`, because a tarball carries no git history and has no other way to
#: say what it is. A repository run from a checkout has the tag, and `VERSION`
#: is then a second home for a number whose first home is `git describe` — the
#: copy this project refuses everywhere else, kept in step by a bot.
#:
#: It is a **subtraction and nothing else**, which is the only shape a flag here
#: gets. Nothing is reconfigured, no file is written differently, and every
#: sentence and workflow step that depends on one of these paths is guarded on
#: the path rather than on the flag — see `drop_absent_prose` and the
#: `if this repository has one` steps in `ci.yml`. A mode that edited files
#: would need a verification grid this repository cannot afford, and would put a
#: conditional in every doc describing the workflow.
VERSIONING: Dict[str, Set[str]] = {
    "release-please": set(),
    "tag": {
        ".github/release-please-config.json",
        ".github/.release-please-manifest.json",
        "VERSION",
        # The release train is a Release Please state machine — open a release
        # PR, babysit it, stop for a human to merge. With no release PR to open
        # it is a procedure for machinery that is not here.
        ".claude/skills/release/SKILL.md",
    },
}

MANIFEST_NAME = ".skeletor.json"

#: The literal `--org` default. A badge is a claim about a repository that
#: exists, and `OWNER` names one that does not — so the default scaffold ships
#: no badges at all rather than opening every README with a broken image, which
#: is the cosmetic form of shipping a gate that is red on arrival.
ORG_UNSET = "OWNER"

BINARY_SUFFIXES = {".png", ".jpg", ".jpeg", ".gif", ".pdf", ".ico", ".woff", ".woff2"}


def setup_commands(language: str) -> List[str]:
    """The install steps a fresh clone needs, by language.

    One source for both the closing instructions this prints and the README it
    writes. They were two separate copies once, and the one people actually read
    — the README — was the stale one: it omitted `npm install`, so `check lint`
    failed on `eslint: command not found` and read as a broken scaffold.

    Every step here runs a tool by **path**, never through a PATH lookup, and
    both halves of that shipped broken. A bare `pip install` is refused outright
    on any distribution carrying an `EXTERNALLY-MANAGED` marker — Arch, Debian
    12+, Ubuntu 23.04+, Fedora, Homebrew macOS — so PEP 668 made line one of the
    generated quick start exit non-zero, which reads as user error at exactly
    the moment a new reader has no way to tell. A bare `pre-commit` then fails
    on any machine at all, because the install that provides it puts it in
    `.venv/bin`, which is not on PATH and which nothing here activates.

    The venv is not a portability nicety either — it is what the tree already
    assumes. `CLI_WRAPPER` looks for `.venv/bin/python` first and only falls
    through to whatever `python3` it can find; a system-wide install left every
    `./<cli>` invocation resolving against an interpreter nobody chose, which is
    the same ambient-resolution bug the pyright gate was fixed for.

    **The python steps are unconditional, and `--language` only ever adds.**
    They used to be guarded by `language in ("python", "both")`, which reads as
    symmetry and is not: `cli/`, `tests/` and `scripts/` all ship at `core`, so
    every scaffold is a python project and the flag chooses whether a *second*
    toolchain joins it. A `--language node` tree therefore documented
    `npm install` alone, and line two of its own quick start — `./<cli> check
    pre-push` — ran a python CLI whose interpreter and dependencies the block
    never installed. It failed with *"requires 'click'. Install with: pip
    install -r scripts/requirements.txt"*, naming a step the README had not
    given, and only on a host without a system-wide `click`: the wrapper falls
    through to whatever `python3` it finds, so the developer box that wrote it
    was green and a clean machine was not. That is the ambient-resolution
    hazard in the paragraph above, arriving on the language axis.
    """
    steps = [
        "python -m venv .venv && .venv/bin/pip install -r scripts/requirements.txt",
        ".venv/bin/pre-commit install --install-hooks",
    ]
    if language in ("node", "both"):
        steps.append("npm install")
    return steps


def badges(args, slug: str) -> str:
    """The README badge row — empty unless `--org` names a real owner.

    Two badges, and neither one *stores* a value. That is the whole constraint:
    a hard-coded `version-0.1.0` badge would be a third home for a number whose
    first two are the git tag and `VERSION`, and Release Please bumps both
    without ever touching the README — so it would be correct until the first
    release and wrong forever after. The release badge is instead a *view* of
    the latest GitHub release, which is the same tag `get_version()` reads
    through `git describe`. There is nothing to keep in sync because there is no
    copy.

    The CI badge is pinned to `--release-branch` and labelled for it. A bare
    workflow badge reports the repository's DEFAULT branch, which is the
    `--base-branch` this scaffolder actually creates (`git init -b`) — and a
    badge answers "should I expect this to work", which is a question about
    what was released, not about what is being worked on. Pinning it is what
    makes the label honest.

    That pin used to be load-bearing for a second and much worse reason: `ci.yml`
    had no `push` trigger for the base branch at all, so an unpinned badge read
    "no status" for the life of a perfectly healthy project. It now does have
    one, and that hazard is gone — recorded here because the remaining reason is
    a preference about meaning where the old one was a defect, and somebody
    re-reading this should know which kind of rule they are looking at.

    The trailing blank line is part of the return value: an empty row must leave
    the tagline sitting directly under the title, with no double blank line for
    `prettier` to reformat on the first commit.
    """
    if args.org == ORG_UNSET:
        return ""
    repo = f"{args.org}/{slug}"
    if args.versioning == "tag":
        # `git tag -a` creates a TAG, not a GitHub Release — that object only
        # exists when somebody makes one, and Release Please is what was making
        # them. A `v/release` badge on a tag-versioned repository is therefore
        # grey forever, which is this file's own rule about a broken badge:
        # a gate red on arrival wearing a cosmetic hat.
        release = (
            f"[![Tag](https://img.shields.io/github/v/tag/{repo}?sort=semver&label=tag)]"
            f"(https://github.com/{repo}/tags)"
        )
    else:
        release = (
            f"[![Release](https://img.shields.io/github/v/release/{repo}?sort=semver)]"
            f"(https://github.com/{repo}/releases)"
        )
    ci = (
        f"[![Release CI](https://img.shields.io/github/actions/workflow/status/{repo}/ci.yml"
        f"?branch={args.release_branch}&label=release%20ci)]"
        f"(https://github.com/{repo}/actions/workflows/ci.yml)"
    )
    return f"{release} {ci}\n\n"


def substitutions(args) -> Dict[str, str]:
    slug = args.slug or Path(args.target).resolve().name
    cli = args.cli or re.sub(r"[^a-z0-9]", "", slug.lower())[:8] or "run"
    prefix = args.env_prefix or re.sub(r"[^A-Z0-9]", "", cli.upper()) or "APP"
    return {
        "PROJECT_NAME": args.name or slug.replace("-", " ").replace(".", " ").title(),
        "PROJECT_SLUG": slug,
        "TAGLINE": args.tagline,
        "BADGES": badges(args, slug),
        "CLI": cli,
        "CLI_ENV_PREFIX": prefix,
        "CI_ENV_VAR": f"{prefix}_CI",
        "AGENT_PREFIX": slug.replace(".", "-"),
        "BASE_BRANCH": args.base_branch,
        "RELEASE_BRANCH": args.release_branch,
        "PY": args.python,
        "PY_NODOT": args.python.replace(".", ""),
        "LINE_LENGTH": str(args.line_length),
        "ORG": args.org,
        "TZ": args.timezone,
        "LANG_RULES": "python" if args.language in ("python", "both") else "javascript",
        "SETUP_COMMANDS": "\n".join(setup_commands(args.language)),
        # The shared head of the three setup blocks is exactly what was
        # substituted into all three, since every document's next line is its
        # own. `tests/test_setup_blocks_agree.py` ratchets on it and cannot
        # derive it: by the time that test runs, the placeholder is gone and
        # the only thing left to measure is the answer.
        "SETUP_SHARED_PREFIX": str(len(setup_commands(args.language))),
    }


def render(text: str, values: Dict[str, str]) -> str:
    def replace(match: re.Match) -> str:
        key = match.group(1)
        if key not in values:
            raise KeyError(key)
        return values[key]

    return re.sub(r"\{\{(\w+)\}\}", replace, text)


def copy_overlay(
    source: Path,
    target: Path,
    values: Dict[str, str],
    cli_name: str,
    report: List[str],
    omit: Set[str] = frozenset(),
) -> None:
    """Render one overlay into `target`, appending what it wrote to `report`.

    `omit` subtracts at COPY time rather than deleting afterwards, and the
    difference is the manifest: `report` is what `.skeletor.json` records, so a
    file copied and then removed would be recorded as skeletor output that no
    render produces — and `cross_check` refuses exactly that, permanently, on
    every later upgrade. Never shipping it keeps the record true by construction.
    """
    for path in sorted(source.rglob("*")):
        if path.is_dir():
            continue
        relative = path.relative_to(source)
        if "__pycache__" in relative.parts or relative.suffix == ".pyc":
            continue
        if relative.as_posix() in omit:
            continue
        # The wrapper is named after the project's CLI, so it cannot live in the
        # template under its final name.
        if relative.name == "CLI_WRAPPER":
            relative = Path(cli_name)

        destination = target / relative
        destination.parent.mkdir(parents=True, exist_ok=True)

        if path.suffix.lower() in BINARY_SUFFIXES:
            shutil.copy2(path, destination)
        else:
            try:
                rendered = render(path.read_text(encoding="utf-8"), values)
            except KeyError as exc:
                raise SystemExit(f"❌ {path}: unknown placeholder {{{{{exc.args[0]}}}}}")
            destination.write_text(rendered, encoding="utf-8")
            shutil.copymode(path, destination)

        report.append(str(relative))


def register_shipped_docs(target: Path, values: Dict[str, str]) -> None:
    """Add a routing row for every `docs/*.md` an overlay shipped.

    A higher tier brings its own reference docs, and a doc registered in neither
    index table is a doc no agent will load. Rather than duplicating the tables
    per overlay — two copies of a table drift, which is the failure mode the
    tables exist to prevent — they are completed here from what is on disk.
    """
    index = target / ".github" / "DOCS_INDEX.md"
    if not index.exists():
        return
    text = index.read_text(encoding="utf-8")

    marker = "<!-- SCAFFOLD: extend as docs are added."
    rows = []
    for doc in sorted((target / "docs").glob("*.md")):
        ref = f"docs/{doc.name}"
        if doc.name == "README.md" or ref in text:
            continue
        heading = next(
            (line[2:].strip() for line in doc.read_text(encoding="utf-8").splitlines() if line.startswith("# ")),
            doc.stem,
        )
        rows.append(f"| **{heading}** | {doc.name} | `{ref}` |")

    if not rows:
        return
    # Insert INSIDE the table (immediately after its last row), not before the
    # marker — a blank line between rows ends the table in every renderer.
    text = text.replace("\n\n" + marker, "\n" + "\n".join(rows) + "\n\n" + marker, 1)
    index.write_text(text, encoding="utf-8")


#: Delimiters around prose that only holds when a given path shipped. The opener
#: NAMES the path, so the condition is a fact about the tree rather than a flag:
#:
#:     <!-- SCAFFOLD-IF .github/release-please-config.json -->
#:     ... prose about the release train ...
#:     <!-- /SCAFFOLD-IF -->
#:
#: `<!-- SCAFFOLD-IF-NOT <path> -->` is the same marker inverted, and it exists
#: because subtraction alone leaves a lie behind. `--versioning tag` removes the
#: release machinery and a "## Releases" heading with nothing under it is worse
#: than the wrong paragraph — the mode still HAS a release procedure, it is just
#: `git tag -a` by hand. So the pair ships the true half of every alternative,
#: never a sentence hedged to be true in both, which helps nobody in either.
#:
#: This started as one hard-coded `.claude/` case for `--agent none`, and
#: `--versioning tag` is what showed the shape: the question is never "which
#: flag was passed", it is "did those files arrive". Keying on the flag means a
#: renamed overlay or a new mode silently keeps prose about a directory nobody
#: shipped, and there is then no gate that can tell — the paths still resolve in
#: the configuration the author was looking at.
CONDITIONAL_OPEN = "<!-- SCAFFOLD-IF "
CONDITIONAL_OPEN_NOT = "<!-- SCAFFOLD-IF-NOT "
CONDITIONAL_CLOSE = "<!-- /SCAFFOLD-IF -->"


def drop_absent_prose(target: Path) -> None:
    """Remove every marked block whose named path is not in this tree.

    A doc describing machinery a configuration omitted is not merely untidy: the
    index tables and the rules files are ROUTING, so a surviving block is a
    promise that a path is here, and `check_doc_tables.py` states why that is
    worse than a shorter table — it implies the subject is still covered.

    Found by `bin/skeletor-verify`'s tier-composition gate on the axis it was
    nearly not given. `--agent none` is documented, is tested for having no
    `.claude/` anywhere, and shipped a `.github/DOCS_INDEX.md` routing readers to
    three paths inside it. The tree's own gate cannot see that one: it walks
    `docs/`, and `.claude/` is not in `docs/`.

    Blocks are dropped, never reworded, because these are all-or-nothing: the
    machinery is entirely present or entirely absent, and a sentence hedged to be
    true either way is one that helps nobody in either.

    **Markdown only.** The delimiter is an HTML comment, which is a comment in
    markdown and plain text everywhere else — a `<!-- -->` in a YAML workflow is
    a syntax error, not a marker. Workflows answer the same question with a file
    test in the step itself (`if this repository has one`), which is the same
    condition in the language that file speaks.
    """
    for path in sorted(target.rglob("*")):
        if not path.is_file() or path.suffix != ".md":
            continue
        try:
            original = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        if CONDITIONAL_OPEN not in original and CONDITIONAL_OPEN_NOT not in original:
            continue

        lines = original.splitlines(keepends=True)
        out: List[str] = []
        index = 0
        while index < len(lines):
            line = lines[index]
            if CONDITIONAL_OPEN not in line and CONDITIONAL_OPEN_NOT not in line:
                out.append(line)
                index += 1
                continue

            inverted = CONDITIONAL_OPEN_NOT in line
            opener = CONDITIONAL_OPEN_NOT if inverted else CONDITIONAL_OPEN
            needed = line.split(opener, 1)[1].split("-->")[0].strip()
            close = index + 1
            while close < len(lines) and CONDITIONAL_CLOSE not in lines[close]:
                close += 1
            if close >= len(lines):
                raise SystemExit(f"❌ {path}: `{CONDITIONAL_OPEN}{needed}` has no closing marker")

            if (target / needed).exists() is not inverted:
                # Keep the body, drop the scaffolder's bookkeeping. A leftover
                # marker in a generated tree invites somebody to add a second by
                # hand, in a tree this scaffolder will never run against again.
                out.extend(lines[index + 1 : close])
            else:
                # Take one blank line with the block when it is surrounded by
                # them, or the removal leaves a double blank that `prettier`
                # reformats on the first commit — a scaffold whose first hook
                # run rewrites a file it just wrote.
                while (
                    close + 1 < len(lines)
                    and not lines[close + 1].strip()
                    and out
                    and not out[-1].strip()
                ):
                    close += 1
            index = close + 1

        path.write_text("".join(out), encoding="utf-8")


def skeletor_ref() -> str:
    """The commit of THIS checkout, so an upgrade can render the same base.

    `--always` because a checkout with no tags still has a sha, and a sha is
    what `skeletor-upgrade` actually renders from. A dirty tree is recorded as
    dirty and warned about: the uncommitted half cannot be reproduced from
    history, so an upgrade would read those edits as template changes.
    """
    result = subprocess.run(
        ["git", "describe", "--tags", "--always", "--dirty"],
        cwd=str(SKELETOR), capture_output=True, text=True,
    )
    return result.stdout.strip() if result.returncode == 0 else ""


#: Never part of the manifest: scratch, history, and bytecode. `__pycache__` is
#: the only thing a scaffold produces that differs between two identical runs —
#: `regen.py` runs at scaffold time and leaves it behind — so a hash of it would
#: make the manifest disagree with its own tree immediately.
MANIFEST_SKIP = ("tmp/", ".git/", "node_modules/", ".venv/")


def hash_tree(target: Path) -> Dict[str, str]:
    """sha256 of every file under `target`, keyed by relative path.

    Everything on disk, including files this scaffold had nothing to do with.
    Used twice: once to hash what the scaffold produced, and once on each side
    of the post-copy steps to find out what they wrote.
    """
    out: Dict[str, str] = {}
    for path in sorted(target.rglob("*")):
        if not path.is_file() or "__pycache__" in path.parts:
            continue
        rel = path.relative_to(target).as_posix()
        if rel == MANIFEST_NAME or rel.startswith(MANIFEST_SKIP):
            continue
        out[rel] = hashlib.sha256(path.read_bytes()).hexdigest()
    return out


def produced_files(written: List[str], after_copy: Dict[str, str], final: Dict[str, str]) -> Set[str]:
    """What this scaffold rendered or generated — never simply what is on disk.

    `--force` writes into a directory that already has files in it, and
    `AGENTS.md` calls that the usual case: the interesting target is a repo
    somebody already works in. Hashing the tree therefore recorded the user's
    own source as skeletor output. proto.pilot, the first real consumer, got a
    manifest of 228 files of which 114 were its own — its product source, its
    tests, its build artifacts, a gitignored `prototypes/` tree — and every
    later `skeletor-upgrade` on it refused outright, because `cross_check`
    correctly reported 114 files "recorded, but the base render does not
    produce it". The guard held; the manifest was the thing that was wrong.

    So the set is computed from what the scaffolder did, in two parts. The copy
    phase reports every file it renders, collisions included — a README the
    scaffold overwrote *is* skeletor output and must be recorded, which is why
    this cannot be "everything that was not here before". The post-copy steps
    are found by comparing the tree either side of them rather than by naming
    the four files they currently write: a list would go stale the next time
    `regen.py` learns to emit an index, and it would go stale silently, since
    a file missing from the manifest reads exactly like a file the user edited.
    """
    produced = {Path(rel).as_posix() for rel in written}
    produced |= {rel for rel, digest in final.items() if after_copy.get(rel) != digest}
    return {rel for rel in produced if rel in final}


def post_copy_steps(tree: Path, values: Dict[str, str]) -> None:
    """Everything the scaffolder does after the overlays are on disk.

    Register whatever docs the chosen overlays actually shipped, then generate
    the indexes, so the tree's own checks pass on the first run. A scaffold whose
    first `check docs` is red teaches that red is normal, and a gate people have
    learned to expect red from is a gate that has stopped working.

    It is a function rather than two lines inlined at the call site **because
    there are two call sites** — here on the real tree, and again in
    `pristine_post_copy` on a copy holding only the render. Written out twice
    they would be two sequences that merely look alike, and a third step added to
    one of them would go in silently: the manifest would record a hash the base
    render cannot produce, every upgrade would refuse, and the failure would
    surface in somebody else's repository weeks later. That is exactly the defect
    this pass exists to fix, so the shape that reintroduces it does not get to
    live here.
    """
    register_shipped_docs(tree, values)
    drop_absent_prose(tree)
    subprocess.run([sys.executable, "scripts/docs/regen.py"], cwd=str(tree), capture_output=True)


def pristine_post_copy(target: Path, written: List[str], values: Dict[str, str]) -> Dict[str, str]:
    """Hashes of the post-copy steps run against the render ALONE, with nothing
    of the target's own in the tree.

    The manifest has to record what the base render produces, because that is
    what `skeletor-upgrade` re-renders and compares against — and for most files
    the render is simply what was written. Two steps break that: both
    `register_shipped_docs` and `regen.py` read the tree they are writing into,
    so in a `--force` scaffold they read the user's files too. proto.pilot had a
    `docs/hosted.md` of its own, `register_shipped_docs` dutifully gave it a row
    in `.github/DOCS_INDEX.md` — correctly, that is the step's whole job — and
    the recorded hash was then of a file no render of those arguments can ever
    produce. Every later upgrade refused, on a hash rather than a surplus entry,
    which pruning cannot repair.

    Recording the *contaminated* hash is not a near miss either. In the
    hash-only fallback the recorded value stands in for the old render on both
    sides of the matrix, so a file the user never touched would read as
    "template moved, user untouched" and get overwritten with a render that has
    no row for their doc. Silent loss of exactly the content the step was
    written to add.

    So `post_copy_steps` runs twice on a populated target: once on the tree,
    which is what the user wants, and once here on a copy holding only the
    rendered files — which at this moment is byte-for-byte the pristine render,
    since the steps have not run yet. The second pass costs a file copy and one
    subprocess, and is skipped entirely for the empty-directory case, where the
    two are the same tree by definition.
    """
    with tempfile.TemporaryDirectory(prefix="skeletor-pristine-") as scratch:
        clean = Path(scratch)
        for rel in written:
            source = target / rel
            if not source.is_file():
                continue
            destination = clean / rel
            destination.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(source, destination)
        (clean / "tmp").mkdir(exist_ok=True)
        (clean / "tmp" / ".gitkeep").touch()
        post_copy_steps(clean, values)
        return hash_tree(clean)


def write_manifest(target: Path, args, overlays: List[str], files: Dict[str, str]) -> Path:
    """Record how this tree was generated, so an upgrade can reproduce it.

    The **arguments** are the primary record: `bin/skeletor-upgrade` re-renders
    the base from `skeletor_ref` plus these, and three-way merges against it.
    The resolved `--slug`, `--cli` and `--env-prefix` are written out even when
    they were defaulted, because their defaults derive from the *target
    directory name* — and an upgrade renders into a temporary directory with a
    different one.

    The **hashes** are a fallback, and only that. They answer one question the
    render also answers — "has anybody touched this file?" — for the case where
    the render is out of reach: a shallow clone, a tarball, a collected ref.
    They cannot be used to merge, because merging needs the base *text*.

    A hash is a derived value with a second home, which is normally the thing
    this project refuses. It is allowed here because it is checked against its
    source on every ordinary run: whenever `skeletor-upgrade` renders the base
    it re-hashes it and fails loudly if the manifest disagrees. A cache that is
    validated against its source every time it is bypassed cannot rot unnoticed.

    Note what a match proves. `sha256(on disk) == recorded` means the file *is*
    byte-for-byte what skeletor generated, so replacing it with a newer render
    loses nothing — that is a proof, not a heuristic, which is why the fallback
    is allowed to write files at all.

    `files` is therefore `produced_files()`, and never a walk of the tree: what
    is recorded has to be exactly what the base render produces, or the very
    check that makes the fallback trustworthy fails on every run.
    """
    values = substitutions(args)
    recorded = [
        "--name", values["PROJECT_NAME"],
        "--slug", values["PROJECT_SLUG"],
        "--cli", values["CLI"],
        "--env-prefix", values["CLI_ENV_PREFIX"],
        "--tagline", args.tagline,
        "--tier", args.tier,
        "--language", args.language,
        "--agent", args.agent,
        "--base-branch", args.base_branch,
        "--release-branch", args.release_branch,
        "--python", args.python,
        "--line-length", str(args.line_length),
        "--org", args.org,
        "--timezone", args.timezone,
    ]
    manifest = target / MANIFEST_NAME
    manifest.write_text(
        json.dumps(
            {
                "_comment": (
                    "Generated by skeletor-new; read by skeletor-upgrade. Do not hand-edit. "
                    "It records how this tree was rendered, so an upgrade can reproduce the "
                    "same base and three-way merge against it."
                ),
                "skeletor_ref": skeletor_ref(),
                "args": recorded,
                "files": files,
            },
            indent=2,
        )
        + "\n",
        encoding="utf-8",
    )
    return manifest


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("target", help="directory to create")
    parser.add_argument("--name", help='human name, e.g. "Order Service"')
    parser.add_argument("--slug", help="repo slug (defaults to the directory name)")
    parser.add_argument("--cli", help="name of the CLI wrapper, e.g. `ord` (defaults from the slug)")
    parser.add_argument("--env-prefix", help="env-var prefix, e.g. ORD (defaults from the CLI name)")
    parser.add_argument("--tagline", default="<one line: what this project is>")
    parser.add_argument("--tier", choices=sorted(TIERS), default="core")
    parser.add_argument(
        "--versioning",
        choices=sorted(VERSIONING),
        default="release-please",
        help=(
            "release-please (default): a bot owns the version, writes CHANGELOG.md and bumps "
            "VERSION. tag: the annotated git tag is the only version, and none of that ships. "
            "Pick by asking whether THE THING YOU HAND SOMEBODY has a .git directory — a "
            "tarball, an image or a desktop build does not, so `git describe` answers nothing "
            "there and VERSION is the only thing that knows. A checkout has the tag, and the "
            "file is then a second copy of a number git already holds."
        ),
    )
    parser.add_argument("--language", choices=["python", "node", "both", "none"], default="python")
    parser.add_argument(
        "--agent",
        choices=sorted(AGENTS),
        default="claude",
        help="which agent's tooling to ship (settings, hooks, subagents, skills). "
        "The conventions in docs/rules/ are shipped either way.",
    )
    parser.add_argument("--base-branch", default="develop", help="the integration branch")
    parser.add_argument("--release-branch", default="main")
    parser.add_argument("--python", default="3.12")
    parser.add_argument("--line-length", type=int, default=120)
    parser.add_argument(
        "--org",
        default=ORG_UNSET,
        help="the GitHub owner: CODEOWNERS, and the README badges, which are omitted without it",
    )
    parser.add_argument("--timezone", default="UTC", help="the timezone the crontab fires in (agentic tier)")
    # Not the flag to reach for when scaffolding into a repository that already
    # exists: the guard below already skips a tree with a `.git`, so `--no-git`
    # is a no-op there and only bites in the case it looks safest in — an empty
    # directory, where it leaves a tree with no repository at all. This is for a
    # render that must never become one (`skeletor-upgrade`'s base, a probe).
    parser.add_argument("--no-git", action="store_true", help="render a tree that is not a repository at all")
    parser.add_argument("--force", action="store_true", help="write into an existing non-empty directory")
    args = parser.parse_args()

    target = Path(args.target).expanduser().resolve()
    populated = target.exists() and any(target.iterdir())
    if populated and not args.force:
        print(f"❌ {target} exists and is not empty (pass --force to write into it)")
        return 1

    values = substitutions(args)
    cli_name = values["CLI"]

    # Each overlay, then that overlay's agent files if the chosen agent ships
    # any. Applied per-overlay rather than once at the end because agent files
    # are tier-shaped: `.claude/skills/` describes the agentic workflow and has
    # no meaning at `core`. An agent overlay that does not exist is skipped —
    # most overlays have no vendor files at all — while a missing TIER overlay
    # stays a hard error, because that one is always a bug.
    agent_root = AGENTS[args.agent]
    overlays = []
    for name in list(TIERS[args.tier]) + (
        LANGUAGE_OVERLAYS[args.language].split(",") if args.language != "none" else []
    ):
        overlays.append(name)
        if agent_root and (TEMPLATE / agent_root / name).is_dir():
            overlays.append(f"{agent_root}/{name}")

    target.mkdir(parents=True, exist_ok=True)
    # What was here before skeletor touched anything. Not "before this overlay":
    # a later overlay overwriting an earlier one is the composition working, and
    # only a file predating the whole scaffold is somebody's own.
    pre_existing = {
        path.relative_to(target).as_posix()
        for path in target.rglob("*")
        if path.is_file() and ".git/" not in path.relative_to(target).as_posix()
    } if populated else set()
    written: List[str] = []
    for overlay in overlays:
        source = TEMPLATE / overlay
        if not source.exists():
            print(f"❌ missing overlay: {source}")
            return 1
        copy_overlay(source, target, values, cli_name, written, omit=VERSIONING[args.versioning])

    (target / cli_name).chmod(0o755)
    (target / "tmp").mkdir(exist_ok=True)
    (target / "tmp" / ".gitkeep").touch()

    after_copy = hash_tree(target)
    pristine = pristine_post_copy(target, written, values) if populated else {}
    post_copy_steps(target, values)

    # Last, and after the two steps above: both write files, and a manifest
    # hashed before them would describe a tree that no longer exists. The two
    # snapshots either side of them are what tells the files they generate
    # apart from files that were simply already here — see `produced_files`.
    final = hash_tree(target)
    produced = produced_files(written, after_copy, final)
    # `pristine` wins where it has an answer: it is what the base render makes,
    # and `final` is what this tree ended up with. They differ only for a file a
    # post-copy step derived from something that was already here.
    write_manifest(target, args, overlays, {rel: pristine.get(rel, final[rel]) for rel in sorted(produced)})

    overwritten = sorted(pre_existing.intersection(written))
    if overwritten:
        # Loudly, and by name. `--force` writes over whatever is in its way and
        # the losses are silent by construction: a file that is gone raises
        # nothing, and the guidance ("review the diff file by file") points at a
        # 97-file diff in which these twelve are the only ones that matter.
        #
        # sky.boss measured what that costs on a real repository. Four of the
        # twelve were load-bearing and every one failed quietly: PYTHONSAFEPATH
        # in the CLI wrapper, whose absence let `python -m cli` import whatever
        # `cli/` happened to be in the cwd and generate a full set of systemd
        # units with the wrong WorkingDirectory, successfully; and a conftest
        # redirect whose loss pointed the suite at the operator's real state
        # directory. Neither announces itself. Naming the files is the whole fix
        # — it turns reviewing the scaffold into reviewing this list.
        print()
        print(f"⚠️  {len(overwritten)} file(s) you already had were OVERWRITTEN:")
        for rel in overwritten:
            print(f"   · {rel}")
        print()
        print("   `git diff` them before anything else, and restore what you meant to keep.")
        print("   Whatever survives here is now recorded as skeletor's, so every future")
        print("   `skeletor-upgrade` three-way merges it — a file you kept is a standing")
        print("   merge point, not a one-off.")

    committed = False
    if not args.no_git and not (target / ".git").exists():
        subprocess.run(["git", "init", "-q", "-b", args.base_branch], cwd=str(target), check=False)
        # Actually make the first commit. "Governs itself from its first commit"
        # is not true of a tree that has no commits: `git diff`, `check reports`
        # and every worktree command need a HEAD to compare against, and the
        # user's real first commit would otherwise bury the scaffold in it.
        # --no-verify because the hooks are not installed yet — the very next
        # step in the printed instructions is what installs them.
        subprocess.run(["git", "add", "-A"], cwd=str(target), check=False)
        first = subprocess.run(
            ["git", "commit", "-q", "--no-verify", "-m",
             f"chore: scaffold {values['PROJECT_SLUG']} from skeletor ({args.tier} tier)"],
            cwd=str(target), capture_output=True, text=True,
        )
        committed = first.returncode == 0
        if not committed:
            print("⚠️  git init succeeded but the first commit did not:")
            print("   " + (first.stderr or first.stdout).strip().replace("\n", "\n   "))
            print("   (usually an unset user.name/user.email — commit by hand once it is set)")

    # Install the merge driver whenever there IS a repo — the one just created,
    # or the one already there that the block above deliberately left alone. Its
    # definition lives in .git/config, which is not version controlled — without
    # it, .gitattributes points at a driver that does not exist and git silently
    # three-way-merges a generated JSON.
    if (target / ".git").exists():
        subprocess.run([sys.executable, "scripts/git/install_merge_drivers.py"], cwd=str(target), capture_output=True)

    print(f"✅ scaffolded {target}")
    print(f"   tier: {args.tier} ({' + '.join(overlays)})   files: {len(written)}")
    print(f"   CLI:  ./{cli_name}")
    if committed:
        print(f"   git:  first commit on '{args.base_branch}'")
    print()
    print("Next:")
    print(f"   cd {target}")
    for step in setup_commands(args.language):
        print(f"   {step}")
    print(f"   ./{cli_name} check pre-push")
    print()
    print("Then fill in the SCAFFOLD markers — they are the parts only you can write:")
    sys.stdout.flush()   # else the grep below prints above this line
    subprocess.run(["grep", "-rln", "SCAFFOLD", "--include=*.md", "--include=*.yml", "--include=*.py", "."], cwd=str(target))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
