#!/usr/bin/env python3
"""Generate every tier and run the resulting tree's own gates against it.

    bin/skeletor-verify                 # every tier, every language
    bin/skeletor-verify --tier core     # one tier
    bin/skeletor-verify --keep          # leave the trees behind to poke at

There is no test suite for skeletor. **The scaffold is the test**: a template
change is verified by generating a tree and running that tree's own checks, and
the definition of done is that a fresh tree passes them. A scaffold whose first
check is red teaches the user that red is normal, and a gate people have learned
to expect red from has stopped working.

That procedure used to live only as a recipe in CLAUDE.md — which made it a
second copy of itself, running only when somebody remembered to type it and
drifting the moment the tiers changed. This file is the copy that runs.

Nothing here holds a list of tiers or languages: both are read from
``bin/skeletor-new``, so a tier added there is verified by existing.
"""

from __future__ import annotations

import argparse
import ast
import hashlib
import importlib.machinery
import importlib.util
import io
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Dict, List, Optional, Tuple

SKELETOR = Path(__file__).resolve().parents[1]
SCAFFOLDER = SKELETOR / "bin" / "skeletor-new"

#: What the toolchain needs beyond the template's own exact pins.
#:
#: `pytest-timeout` is here not because a gate calls it but because the tree's
#: pytest config *sets* `timeout`. Without the plugin pytest warns and ignores
#: it, so the suite would be verified under a config the tree does not have.
#: `actionlint-py` is a pip wrapper around a Go binary, and it is the only entry
#: here that no generated tree installs. It checks what skeletor SHIPS rather
#: than what a tree runs on itself — see `actionlint_gate`. Pinned, so
#: `bin/skeletor-check-pins` reports it going stale like every other pin.
#: `pytest-cov` is here for the same reason as `pytest-timeout` and a sharper
#: one: `coverage_gate` runs the tree's own `test coverage`, which is the
#: command that could not pass in any tree. Without the plugin that gate fails
#: on a missing argument rather than on the thing it is asking about, which is
#: a false red — and a false red on a gate about a false green is the worst
#: possible pair to be reading at once.
EXTRA_PACKAGES = ["pytest", "pytest-timeout", "pytest-cov", "click", "actionlint-py==1.7.12.24"]

#: Lint hooks whose args are read out of the generated tree's own
#: `.pre-commit-config.yaml` rather than repeated here. Copying the args would
#: mean verifying against a config the tree does not have, which is the exact
#: failure this file exists to catch — and it would go wrong silently, since
#: both copies would still be green.
LINT_HOOKS = ["black", "isort", "flake8"]

CLI_NAME = "probe"


@dataclass
class Result:
    label: str
    ok: bool
    seconds: float
    output: str = ""

    @property
    def mark(self) -> str:
        return "✅" if self.ok else "❌"


def load_scaffolder():
    """Import ``bin/skeletor-new`` for its TIERS and LANGUAGE_OVERLAYS maps.

    It has no ``.py`` suffix, so the import is by path. Everything at its module
    level is a definition; ``main()`` is guarded.
    """
    loader = importlib.machinery.SourceFileLoader("skeletor_new", str(SCAFFOLDER))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


#: A git identity for every subprocess — see `run()`. Held here rather than
#: inline so the values have one home.
GIT_IDENTITY = {
    "GIT_AUTHOR_NAME": "skeletor-verify",
    "GIT_AUTHOR_EMAIL": "verify@skeletor.invalid",
    "GIT_COMMITTER_NAME": "skeletor-verify",
    "GIT_COMMITTER_EMAIL": "verify@skeletor.invalid",
}


def subprocess_env(env_extra: Optional[dict] = None) -> dict:
    """The environment every subprocess here gets.

    Split out of `run()` because a gate that needs stdout and stderr APART
    cannot use `run()` — it merges them — and would otherwise build its own
    environment and drop the identity below. That is the forgetting `run()`'s
    own comment warns about, one level up.
    """
    import os

    env = dict(os.environ)
    # Every subprocess, not just the ones that obviously commit. Nothing here may
    # depend on the host having a git identity: a GitHub runner has none, and the
    # failure is not a git error but a *tree* that has a repository and no HEAD —
    # so it surfaces as 97 uncommitted files in an unrelated gate, pointing at
    # the wrong subsystem.
    #
    # `scaffold()` learned this on its first CI run and carried it alone. The
    # gates added later called `git commit` bare, or invoked the scaffolder
    # directly, and went red on CI while passing here — three sites, one rule,
    # applied once. Putting it in `run()` is the only version that cannot be
    # forgotten by the next gate, which is the same argument as `scanned()`.
    env.update(GIT_IDENTITY)
    if env_extra:
        env.update(env_extra)
    return env


def run(cmd: List[str], cwd: Path, env_extra: Optional[dict] = None) -> Tuple[int, str]:
    proc = subprocess.run(
        cmd, cwd=str(cwd), capture_output=True, text=True, env=subprocess_env(env_extra)
    )
    return proc.returncode, (proc.stdout or "") + (proc.stderr or "")


def git_in(tree: Path, *args: str) -> Tuple[int, str]:
    """A git command in `tree`. The identity comes from `run()`."""
    return run(["git", *args], cwd=tree)


def toolchain() -> List[str]:
    """The template's own exact pins, so the gates run the versions it ships.

    Read from `template/core/scripts/requirements.txt` rather than listed here:
    a bump has to reach the verifier, and a second list is a second thing to
    forget.

    `pyright` used to be filtered out of this as uninstallable — a node package
    wearing a Python name, said to cost a toolchain download for one gate. The
    number was never measured. Its pip wrapper caches node in
    `~/.cache/pyright-python` keyed by version, so the download is once per
    machine rather than once per tree, and a warm run over a governed tree is
    about a second. What the exemption actually bought was two
    `reportAssignmentType` errors that shipped red in every `governed` and
    `agentic` scaffold while this file stayed green.
    """
    requirements = SKELETOR / "template" / "core" / "scripts" / "requirements.txt"
    pinned = [
        line.strip()
        for line in requirements.read_text(encoding="utf-8").splitlines()
        if re.match(r"^[A-Za-z0-9_.-]+==", line.strip())
    ]
    return pinned + EXTRA_PACKAGES


def make_venv(workdir: Path, quiet: bool) -> Path:
    """One venv, shared by every tree.

    The packages are tree-independent, and a venv per tier is three pip installs
    to learn the same thing once.
    """
    VENV_PACKAGES = toolchain()
    venv = workdir / ".venv-shared"
    if not quiet:
        print(f"   creating shared venv ({', '.join(VENV_PACKAGES)}) …")
    subprocess.run([sys.executable, "-m", "venv", str(venv)], check=True, capture_output=True)
    python = venv / "bin" / "python"
    proc = subprocess.run(
        [str(python), "-m", "pip", "install", "-q", "--disable-pip-version-check", *VENV_PACKAGES],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        print(proc.stdout + proc.stderr)
        raise SystemExit("❌ could not install the verify toolchain")
    return python


def scaffold(tier: str, language: str, workdir: Path, name: Optional[str] = None) -> Tuple[Result, Path]:
    target = workdir / (name or f"{tier}-{language}")
    started = time.time()
    code, output = run(
        [
            sys.executable,
            str(SCAFFOLDER),
            str(target),
            # This checkout is dirty whenever somebody is working in it, and
            # that is the condition this grid exists to run under. The
            # scaffolder refuses a dirty render to protect the manifest an
            # adopter commits; these trees are throwaway, so the flag is the
            # honest answer rather than a workaround.
            "--allow-dirty",
            "--name",
            "Probe",
            "--cli",
            CLI_NAME,
            "--tier",
            tier,
            "--language",
            language,
            "--tagline",
            "a scaffold under test",
            "--force",
        ],
        cwd=SKELETOR,
        # A git identity, because the machine may not have one and the scaffolder
        # makes a commit. A GitHub runner ships no `user.name`/`user.email`, so
        # without this the scaffolder takes its own "commit did not happen"
        # fallback and every tree arrives with a repository but no HEAD — which
        # is a real path it handles and warns about, and not the one the gates
        # below are written for. Controlling the variable is the same fix as
        # `--pythonpath` in `pyright_gate`: this was green here and red on the
        # first CI run, decided by config nobody set on purpose.
        env_extra={
            "GIT_AUTHOR_NAME": "skeletor-verify",
            "GIT_AUTHOR_EMAIL": "verify@skeletor.invalid",
            "GIT_COMMITTER_NAME": "skeletor-verify",
            "GIT_COMMITTER_EMAIL": "verify@skeletor.invalid",
        },
    )
    return Result(f"scaffold {tier}/{language}", code == 0, time.time() - started, output), target


def expected_command_names(tree: Path) -> List[str]:
    """The command names ``./probe --help`` must list, derived the way the tree
    derives them: one per ``cli/*.py`` that is neither private nor ``helpers``.

    The alias map is read out of the generated ``cli/__init__.py`` rather than
    copied here — a second copy of it would be the registry this whole shell
    exists to avoid.
    """
    init = (tree / "cli" / "__init__.py").read_text(encoding="utf-8")
    match = re.search(r"^_ALIASES = (\{[^}]*\})", init, re.MULTILINE)
    aliases = ast.literal_eval(match.group(1)) if match else {}

    names = []
    for module in sorted((tree / "cli").glob("*.py")):
        stem = module.stem
        if stem.startswith("_") or stem == "helpers":
            continue
        names.append(aliases.get(stem, stem))
    return names


def check_groups_register(tree: Path) -> Result:
    started = time.time()
    code, output = run([f"./{CLI_NAME}", "--help"], cwd=tree)
    if code != 0:
        return Result("cli --help", False, time.time() - started, output)

    expected = expected_command_names(tree)
    missing = [name for name in expected if not re.search(rf"^\s+{re.escape(name)}\b", output, re.MULTILINE)]
    ok = not missing
    detail = output if ok else f"{output}\n\nmodules present in cli/ but absent from --help: {missing}"
    return Result(f"cli --help registers {len(expected)} groups", ok, time.time() - started, detail)


def hook_args(tree: Path, hook: str) -> List[str]:
    """The args the tree's own pre-commit config passes to a lint hook."""
    config = (tree / ".pre-commit-config.yaml").read_text(encoding="utf-8")
    match = re.search(rf"- id: {re.escape(hook)}\b[^\n]*\n(?:\s+[^\n]*\n)*?\s+args: \[([^\]]*)\]", config)
    if not match:
        return []
    # Split on the YAML list's quotes, not on commas: `--select=E9,F63,F7` is
    # one argument that happens to contain commas, and splitting it produces a
    # flake8 invocation that fails in a way that looks like a broken gate.
    return [single or double for single, double in re.findall(r"'([^']*)'|\"([^\"]*)\"", match.group(1))]


#: Directories a fresh scaffold can contain that pre-commit would never hand a
#: hook, because git does not track them. Everything else that is a `.py` is.
UNTRACKED_DIRS = {".git", ".venv", ".venv-ci", "node_modules", "__pycache__", "tmp"}


def python_files(tree: Path) -> List[str]:
    """Every Python file in the tree, as the filenames pre-commit would pass."""
    return [
        str(path.relative_to(tree))
        for path in sorted(tree.rglob("*.py"))
        if not UNTRACKED_DIRS & set(path.relative_to(tree).parts)
    ]


def lint_gates(tree: Path, venv_python: Path) -> List[Result]:
    """The formatters and the linter, run exactly as the tree's hooks run them.

    This is the gate that was missing when a scaffold shipped 19 files black
    would rewrite and 20 unused imports flake8 rejects: `pre-commit run
    --all-files`, the first command the README tells a new user to run, was red
    on a tree nobody had touched.

    "Exactly" is carried by the **filenames**, and it used to be a lie: this ran
    each hook against `.`, which is how the tree's own `check lint` invokes
    them and not how pre-commit does. The difference is not cosmetic — flake8 applies its
    `exclude` list when it walks a directory and ignores it for a file named on
    the command line, so the two invocations answer differently about exactly
    the files somebody chose to exclude. A `docs` entry in `.flake8` matched the
    `scripts/docs/` component, and four dead imports shipped: green here and in
    `check lint`, red in the pre-commit hook that runs on a user's first commit.
    Passing filenames is also the strictly stronger of the two, since an exclude
    can only ever remove files — so this being green implies `flake8 .` is.
    """
    files = python_files(tree)
    results = [
        Result(
            f"lint sees {len(files)} python files",
            # A lint over nothing is green and worth nothing. The lower bound is
            # loose on purpose — it is here to catch an enumeration that broke,
            # not to be a file count somebody has to update.
            len(files) > 20 and any(f.startswith("scripts/docs/") for f in files),
            0.0,
            "\n".join(files),
        )
    ]
    for hook in LINT_HOOKS:
        args = hook_args(tree, hook)
        checkish = ["--check-only"] if hook == "isort" else ["--check"] if hook == "black" else []
        started = time.time()
        code, output = run([str(venv_python), "-m", hook, *args, *checkish, *files], cwd=tree)
        results.append(Result(f"{hook} {' '.join(args)}", code == 0, time.time() - started, output))
    return results


def pyright_entry(tree: Path) -> List[str]:
    """The arguments the tree's own pyright hook runs with.

    Read, not repeated, for the same reason as `hook_args`: the pyright hook
    names its config with `entry:` rather than `args:`, and a copy here would
    verify the template against an invocation the template does not use.
    """
    config = (tree / ".pre-commit-config.yaml").read_text(encoding="utf-8")
    match = re.search(r"- id: pyright\b[^\n]*\n(?:\s+[^\n]*\n)*?\s+entry: pyright ([^\n]*)", config)
    return match.group(1).split() if match else ["--project", "pyrightconfig.json"]


def warm_pyright(venv_python: Path) -> Tuple[bool, str]:
    """Fetch pyright's node toolchain once, before any tree is gated.

    The download happens on first run and is cached per machine, so doing it
    here keeps it out of the first tree's timing and — the point — turns "no
    network" into one honest skip rather than three type checks that fail for a
    reason that has nothing to do with the template.
    """
    code, output = run([str(venv_python), "-m", "pyright", "--version"], cwd=venv_python.parent)
    return code == 0, output.strip()


def pyright_gate(tree: Path, venv_python: Path, available: bool) -> List[Result]:
    """Whole-project type checking, the gate whose absence shipped red scaffolds.

    Skipped loudly, never silently, when the toolchain could not be fetched: a
    gate that quietly reports success when it did not run is worse than no gate,
    because it is indistinguishable from one that did.

    `filesAnalyzed` is asserted for the same reason the lint gate counts its
    files. pyright prints `0 errors` just as happily when its `include` paths
    match nothing, and this whole file exists because a check that inspected an
    empty set stayed green through the bug it was written to catch.
    """
    if not available:
        return [Result("pyright", True, 0.0, "skipped: toolchain unavailable (offline?)")]

    started = time.time()
    # The one gate that does not use `run()`, which merges the two streams.
    # `--outputjson` puts its report on stdout and everything else on stderr —
    # an unreadable config, an include path that resolves to nothing — so
    # merging them makes the JSON unparseable exactly when it carries the
    # explanation. Keeping them apart is what lets a bad config report itself.
    proc = subprocess.run(
        # `--pythonpath` is not optional here, and leaving it off is a green that
        # means nothing. pyright resolves imports against an interpreter it picks
        # off PATH — it does NOT read the tree's `.venv`, symlinked or otherwise
        # — so this gate silently checked whatever python the machine happened to
        # offer. On a developer box with `click` installed system-wide that is
        # every decorator resolved and a clean run; on a CI runner whose
        # setup-python has no `click` it is 24 errors, because
        # `reportMissingImports` is `none`, so an unresolved `click.group` leaves
        # the function undecorated and `@group.command()` becomes an attribute
        # access on a plain function. Same tree, same pyright, opposite answers,
        # decided by a package nobody installed on purpose.
        [str(venv_python), "-m", "pyright", *pyright_entry(tree), "--pythonpath", str(venv_python), "--outputjson"],
        cwd=str(tree),
        capture_output=True,
        text=True,
    )
    code, noise = proc.returncode, (proc.stderr or "").strip()
    try:
        report = json.loads(proc.stdout)
        summary = report["summary"]
        analyzed, errors = summary["filesAnalyzed"], summary["errorCount"]
    except (ValueError, KeyError):
        return [Result("pyright", False, time.time() - started, f"unreadable --outputjson:\n{noise}\n{proc.stdout}")]

    if errors:
        # Rendered from the JSON rather than dumped as it: the raw report is a
        # screenful of spans and rule metadata per finding, and a gate nobody
        # can read the output of is one people learn to skip.
        detail = "\n".join(
            f"{Path(d['file']).relative_to(tree)}:{d['range']['start']['line'] + 1} "
            f"{d.get('rule', 'error')} — {d['message'].splitlines()[0]}"
            for d in report.get("generalDiagnostics", [])
            if d.get("severity") == "error"
        )
    elif analyzed <= 20:
        detail = (
            f"pyright analyzed only {analyzed} files — its include paths have stopped matching the tree"
            f"{chr(10) + noise if noise else ''}"
        )
    else:
        detail = f"{analyzed} files analyzed, no errors"

    ok = code == 0 and errors == 0 and analyzed > 20
    return [Result(f"pyright ({analyzed} files)", ok, time.time() - started, detail)]


def node_gates(tree: Path) -> List[Result]:
    """eslint and prettier, once, on the one tree that has a package.json.

    The node overlay is identical across tiers, so this is one `npm install`
    rather than one per tier — and it is skipped loudly, never silently, when
    npm is absent.
    """
    if not shutil.which("npm"):
        return [Result("node gates", True, 0.0, "skipped: npm not on PATH")]

    started = time.time()
    code, output = run(["npm", "install", "--no-audit", "--no-fund", "--silent"], cwd=tree)
    if code != 0:
        return [Result("npm install", False, time.time() - started, output)]
    results = [Result("npm install", True, time.time() - started)]

    for script in ("lint:check", "format:check"):
        started = time.time()
        code, output = run(["npm", "run", "--silent", script], cwd=tree)
        results.append(Result(f"npm run {script}", code == 0, time.time() - started, output))
    return results


def gates(tree: Path, venv_python: Path, pyright_ok: bool) -> List[Result]:
    """The tree's own checks, run the way its user would run them."""
    results = []

    started = time.time()
    code, output = run(
        [str(venv_python), "-m", "pytest", "tests/", "-m", "unit", "-q"],
        cwd=tree,
        env_extra={"PYTHONPATH": str(tree)},
    )
    results.append(Result("pytest -m unit", code == 0, time.time() - started, output))

    # `check output` is here and not only in `pre-push` because it is the gate
    # that keeps every OTHER gate's `--json` readable, and pre-push is not one of
    # the commands this script runs.
    for command in (["check", "docs"], ["check", "merge-drivers"], ["check", "output"]):
        started = time.time()
        code, output = run([f"./{CLI_NAME}", *command], cwd=tree)
        results.append(Result(f"{CLI_NAME} {' '.join(command)}", code == 0, time.time() - started, output))

    results.append(check_docs_gate_sees_the_tree(tree))
    results += check_empty_suite_is_not_red(tree, venv_python)
    results.append(check_upgrade_is_noop(tree))
    results.append(check_upgrade_json_is_pure(tree))
    results.append(check_groups_register(tree))
    results.append(check_script_targets(tree))
    results.append(check_version_resolves(tree))
    results.append(check_no_baked_paths(tree))
    results.append(check_setup_block_is_self_contained(tree))
    results.append(check_scaffold_is_its_own_repo(tree))
    results += lint_gates(tree, venv_python)
    results += pyright_gate(tree, venv_python, pyright_ok)
    results += actionlint_gate(tree, venv_python.parent)
    # Last, because it is the only gate here that WRITES into the tree — a
    # module and a test of its own, to move the one variable the refusal turns
    # on. It puts them back, and running it after everything else means a
    # cleanup that ever fails is a failure of this gate rather than a puzzle in
    # the next one.
    results += check_the_baseline_is_refused_on_a_fresh_tree(tree, venv_python)
    return results


def workflow_files(tree: Path) -> List[str]:
    """Every workflow a scaffold ships, as paths relative to the tree."""
    workflows = tree / ".github" / "workflows"
    return sorted(
        str(path.relative_to(tree))
        for path in list(workflows.glob("*.yml")) + list(workflows.glob("*.yaml"))
    )


def actionlint_gate(tree: Path, venv_bin: Path) -> List[Result]:
    """The workflows a scaffold ships are valid GitHub Actions.

    Four of them ship — `ci.yml`, `docs-validation.yml`, `pr-draft-discipline.yml`
    and, from `governed`, `coverage-nightly.yml` — and until this gate not one had
    ever been executed, or read by anything that understands Actions.
    `tests/test_ci_draft_gate.py` asserts the pieces of `ci.yml` that are
    load-bearing, but it does it with a regex over the file as text.

    What this adds, each one confirmed by planting it: an expression whose syntax
    is wrong, a `needs.<job>` naming a job that does not exist, a job output
    somebody renamed, an unknown runner label, and — where shellcheck is on PATH
    — the `run:` blocks.

    What it does not add, checked rather than assumed: it does not verify that an
    action reference resolves. `actions/checkout@v99` passes this green, because
    knowing better takes a network call. That belongs to an end-to-end test that
    actually runs these workflows, and its absence here is why this gate is
    milliseconds.

    This is the one lint here that does **not** read its arguments out of the
    tree's `.pre-commit-config.yaml`. Two reasons are available for that and only
    one of them survives: the tree has no actionlint hook to read (a fact about
    today, which shipping such a hook would falsify), and this gate is not asking
    the tree's question anyway (a fact about what it is for, which nothing
    falsifies). The second is the load-bearing one. black, isort, flake8 and
    pyright ask "does this tree govern itself", and are read from its config so
    the answer is the tree's own; this asks "is what skeletor ships valid at
    all" — the same question `check_no_baked_paths` asks, and equally not the
    tree's business. So shipping actionlint as a hook in the generated tree
    would be a different and also good change, since it would check a user's own
    edits to these files — and it would **not** make this gate read its
    arguments from there.

    The reasons are separated because the first kind expires silently. A rule
    whose stated reason names something broken or absent loses that reason the
    day somebody fixes it, and nothing goes red to say so — see the CI badge in
    `docs/DESIGN_RATIONALE.md`, which was pinned for a defect that no longer
    exists and is still pinned, correctly, for a different reason entirely.
    """
    started = time.time()
    workflows = workflow_files(tree)
    if not workflows:
        # The `filesAnalyzed` lesson, in the tool that has no equivalent field:
        # bare `actionlint` walks for workflows and exits 0 having found none.
        return [Result("actionlint", False, time.time() - started,
                       "no workflows under .github/workflows — a green here would mean nothing")]

    binary = venv_bin / "actionlint"
    if not binary.exists():
        return [Result("actionlint", True, 0.0, "skipped: toolchain unavailable (offline?)")]

    code, output = run([str(binary), *workflows], cwd=tree)
    # actionlint lints `run:` blocks by shelling out to shellcheck, and when it
    # is absent it simply does not, without saying so. GitHub's ubuntu runners
    # ship shellcheck and a developer box may not, so the two answer differently
    # about the same file — the pyright lesson wearing a different tool. Which
    # check actually ran goes in the label rather than being left to be assumed.
    depth = "with shellcheck" if shutil.which("shellcheck") else "no shellcheck"
    return [Result(f"actionlint ({len(workflows)} workflows, {depth})", code == 0,
                   time.time() - started, output)]

def check_docs_gate_sees_the_tree(tree: Path) -> Result:
    """`check docs` passing is worth nothing if its source→doc checker looked at
    no files.

    This exists because it happened. `check_source_doc_refs.py` matched its skip
    list against the ABSOLUTE path, and every tree this script generates lives
    under `/tmp` — so `tmp` matched an ancestor, every file was skipped, and the
    checker reported "0 references, all resolve" while the same tree in the
    user's home directory failed on three references the template itself ships.
    Verify was green for as long as that bug existed, which is the whole reason
    it reached a user's first CI run.

    A gate that cannot report how much it inspected cannot be trusted to have
    inspected anything, so the assertion here is on the count, not the exit code.
    """
    started = time.time()
    code, output = run([sys.executable, "scripts/check_source_doc_refs.py", "--json"], cwd=tree)
    match = re.search(r'"checked"\s*:\s*(\d+)', output)
    checked = int(match.group(1)) if match else 0
    passed = code == 0 and checked > 0
    if not match:
        output = f"--json emitted no `checked` count\n{output}"
    elif checked == 0:
        output = f"source -> doc refs inspected 0 references: the walk skipped the whole tree\n{output}"
    return Result(f"check docs inspects the tree ({checked} source refs)", passed, time.time() - started, output)


#: Print the markers whose row says a scaffold ships no tests for them. Read
#: from the tree rather than named here for the reason the lint arguments are:
#: a copy would verify the template against a registry the template does not
#: have, and would stay green while doing it.
_TOLERANT_SUITES = (
    "import sys; sys.path.insert(0, '.'); "
    "from cli.test_cmds import SUITES; "
    "print(' '.join(m for m, s in SUITES.items() if not s.ships_tests))"
)


def check_empty_suite_is_not_red(tree: Path, venv_python: Path) -> List[Result]:
    """Every suite the scaffold ships no tests for must not fail on arrival.

    pytest exits 5 when a marker selects nothing, and no scaffold can ship a
    test that needs a stack, a browser or a display it does not know about — so
    `test integration` and the CI job running the same selection were red on
    every fresh tree, and stayed red until somebody wrote their first
    integration test.

    This ran nowhere before: verify ran `pytest -m unit` directly and never the
    CLI's own suite commands, so the one selection guaranteed to be empty was
    the one nothing exercised.

    It named `integration` for as long as that was the only such suite, which is
    the shape Rule 2 is about: `ui` arrived, took the identical code path, and
    this gate would not have noticed either way. The set is discovered now, and
    an empty one fails — a loop over nothing passes every assertion in it.
    """
    started = time.time()
    code, listed = run([str(venv_python), "-c", _TOLERANT_SUITES], cwd=tree)
    markers = listed.split()
    if code != 0 or not markers:
        return [
            Result(
                "test on an empty suite: which suites tolerate one",
                False,
                time.time() - started,
                f"could not read SUITES out of the tree's cli/test_cmds.py\n{listed}",
            )
        ]

    results = []
    for marker in markers:
        started = time.time()
        code, output = run([f"./{CLI_NAME}", "test", marker], cwd=tree)
        results.append(Result(f"test {marker} on an empty suite", code == 0, time.time() - started, output))
    return results


def check_the_baseline_is_refused_on_a_fresh_tree(tree: Path, venv_python: Path) -> List[Result]:
    """A fresh scaffold measures none of its own code, and must refuse to
    baseline that.

    The tree ships a unit test for this and it cannot ask this question. That
    one feeds `check_coverage_budget.py` a synthetic report and a synthetic
    manifest, so it proves the classification is right about the data it is
    handed — and it would pass unchanged on a generator whose manifest omitted
    half the files it wrote, because the omission is in the data, not the code.
    Whether a **real** manifest covers a **real** coverage run of a tree nobody
    has touched is the generator's question, and only a live run answers it.

    What it protects is small and permanent. `coverage_budget.json` ships at
    `0.00%` because Invariant 6 says a ratchet is never red on arrival — and
    then the first coverage run of every scaffold printed `Lock it in:
    --update`, because a fresh tree is always above its own floor. The number on
    offer is the template's coverage of the template. Measured: `--update`
    recorded 69.69%, five lightly-tested product modules took the tree to
    63.72%, and the ratchet went red with nothing regressed. The invariant was
    enforced at scaffold time and contradicted at run time by the same
    repository.

    Both directions run, because a rule that only ever refuses is being agreed
    with rather than applied: the same tree with one module and one test of its
    own must record the baseline it just refused.
    """
    started = time.time()
    report = tree / "tmp" / "coverage.xml"

    def measure() -> Tuple[int, dict, str]:
        code, output = run(
            [
                str(venv_python),
                "-m",
                "pytest",
                "tests/",
                "-m",
                "unit",
                "-q",
                "--cov",
                "--cov-report=",
                f"--cov-report=xml:{report}",
            ],
            cwd=tree,
            env_extra={"PYTHONPATH": str(tree)},
        )
        if code != 0:
            return code, {}, output
        code, envelope = run(
            [str(venv_python), "scripts/check_coverage_budget.py", "--suite", "unit", "--json", "--update"],
            cwd=tree,
        )
        try:
            payload = json.JSONDecoder().raw_decode(envelope[envelope.index("{") :])[0]
        except (ValueError, json.JSONDecodeError):
            payload = {}
        return code, payload, output + envelope

    def baseline() -> float:
        return float(json.loads((tree / "tests" / "coverage_budget.json").read_text())["suites"]["unit"]["baseline_pct"])

    code, payload, output = measure()
    fresh_refused = code == 1 and payload.get("own_statements") == 0 and baseline() == 0.0
    results = [
        Result(
            "coverage baseline: refused while the tree measures none of its own code",
            fresh_refused,
            time.time() - started,
            f"exit {code}, envelope {payload}, baseline {baseline()}\n{output}",
        )
    ]

    # The other direction, in the same tree, so the only thing that changed is
    # the population. A module alone is not enough and that is the point: an
    # unimported file is invisible to coverage, so what lifts a tree out of the
    # degenerate case is the first test of its own — which is exactly the act
    # the refusal is waiting for.
    started = time.time()
    (tree / "app").mkdir(exist_ok=True)
    (tree / "app" / "engine.py").write_text('"""Ours."""\n\n\ndef add(a: int, b: int) -> int:\n    return a + b\n')
    (tree / "tests" / "test_engine.py").write_text(
        '"""Ours."""\n\nimport pytest\n\nfrom app.engine import add\n\n'
        "pytestmark = pytest.mark.unit\n\n\ndef test_add() -> None:\n    assert add(1, 1) == 2\n"
    )
    code, payload, output = measure()
    recorded = code == 0 and (payload.get("own_statements") or 0) > 0 and baseline() > 0.0
    results.append(
        Result(
            "coverage baseline: recorded once the tree measures code of its own",
            recorded,
            time.time() - started,
            f"exit {code}, envelope {payload}, baseline {baseline()}\n{output}",
        )
    )

    # Planted files and a moved baseline would make every later gate in this
    # tree answer about a tree the scaffolder did not produce.
    (tree / "tests" / "test_engine.py").unlink()
    shutil.rmtree(tree / "app")
    subprocess.run(["git", "checkout", "--", "tests/coverage_budget.json"], cwd=tree, capture_output=True)
    return results


def check_upgrade_is_noop(tree: Path) -> Result:
    """`skeletor-upgrade` against the checkout that just generated the tree must
    find nothing to do.

    It is the cheapest possible test of `.skeletor.json`, and it fails on the
    two things that actually break: the recorded arguments must round-trip
    through `substitutions()` to the same values — `--slug`, `--cli` and
    `--env-prefix` all default from the *target directory name*, and an upgrade
    renders into a temporary directory with a different one — and the render
    must be deterministic. A manifest that cannot reproduce its own tree makes
    every later upgrade a diff against the wrong base, which is worse than no
    upgrade at all because it looks like it worked.
    """
    started = time.time()
    code, output = run(
        [sys.executable, str(SKELETOR / "bin" / "skeletor-upgrade"), str(tree), "--dry-run", "--from-dir", str(SKELETOR)],
        cwd=tree,
    )
    passed = code == 0 and "already current" in output

    # And again from the recorded hashes alone, which is the path taken when
    # skeletor's history is out of reach. It exercises a different comparison
    # entirely, and it is the one nobody runs by hand — so it is the one that
    # would rot. A mismatch here means the manifest cannot describe the tree it
    # was written from, which is exactly when the fallback would misclassify an
    # edited file as untouched and overwrite it.
    offline_code, offline_output = run(
        [sys.executable, str(SKELETOR / "bin" / "skeletor-upgrade"), str(tree), "--dry-run", "--no-base"],
        cwd=tree,
    )
    passed = passed and offline_code == 0 and "already current" in offline_output
    return Result(
        "skeletor-upgrade is a no-op on a fresh tree (rendered and offline)",
        passed,
        time.time() - started,
        output + "\n" + offline_output,
    )


def check_upgrade_json_is_pure(tree: Path) -> Result:
    """`skeletor-upgrade --json` puts a parseable object on stdout and the human
    report on stderr — on every path a fresh tree can reach, refusals included.

    The template ships `tests/test_output_contract.py`, which asserts exactly
    this over every `scripts/check_*.py` in a generated tree. skeletor's own
    tools were never held to it. stash.flow reported the envelope as unparseable
    from outside, and answering took a hand audit of every `subprocess.run` in
    the tool, because there was nothing standing to ask. It did not reproduce;
    the hole that made it expensive to check is real either way, and it is this
    repository's recurring one — a rule shipped to everybody and not applied
    here.

    **The second gate that cannot use `run()`**, for the same reason as the
    pyright one: `run()` merges the streams, and stream separation is the entire
    question. A gate built on it would report the contract satisfied by
    construction. `subprocess_env()` exists so that does not also mean losing
    the git identity.

    Both directions, because "nothing but JSON on stdout" is equally satisfied
    by a tool that says nothing at all — the human half must still reach stderr.
    """
    started = time.time()
    upgrade = [sys.executable, str(SKELETOR / "bin" / "skeletor-upgrade"), str(tree), "--dry-run", "--json"]
    manifest = tree / ".skeletor.json"
    recorded = manifest.read_text(encoding="utf-8")

    def check(label: str, extra: List[str]) -> List[str]:
        proc = subprocess.run(upgrade + extra, cwd=str(tree), capture_output=True, text=True, env=subprocess_env())
        problems = []
        try:
            json.loads(proc.stdout)
        except ValueError as exc:
            problems.append(f"{label}: stdout is not one JSON object ({exc})\n{proc.stdout[:400]}")
        if not proc.stderr.strip():
            problems.append(f"{label}: nothing reached stderr — the human half went missing")
        return problems

    problems = check("rendered base", ["--from-dir", str(SKELETOR)])
    problems += check("offline", ["--no-base"])

    # The refusal, and the path a consumer is likeliest to be parsing when
    # something has gone wrong. Manufactured the way `sidecar_gate` manufactures
    # skew — one recorded hash tampered — and restored in a `finally`, because
    # every gate after this one reads the same tree.
    payload = json.loads(recorded)
    payload["files"][sorted(payload["files"])[0]] = "0" * 64
    try:
        manifest.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
        problems += check("manifest-drift refusal", ["--from-dir", str(SKELETOR)])
    finally:
        manifest.write_text(recorded, encoding="utf-8")

    return Result(
        "skeletor-upgrade --json: stdout parses, the report stays on stderr (3 paths)",
        not problems,
        time.time() - started,
        "\n".join(problems),
    )


def check_version_resolves(tree: Path) -> Result:
    """`--version` reports a release, and never a tag that is not one.

    Nothing here exercised the generated tree's `--version`, and it was wrong on
    every scaffold from the first commit: `git describe --tags --always` returns
    an abbreviated sha when no tag exists, so a fresh tree reported
    `version 4f2a91c` while shipping a `VERSION` file that said `0.1.0` — the
    docstring's own fallback made unreachable by its own arguments.

    A fresh tree is exactly why the gap survived. It has no tags, so the sha path
    looked like a plausible answer rather than a broken one, and the two states
    that expose it — a non-release tag, and a release tag — need a repository
    with a history that no generated tree has. stash.flow found it by tagging
    `archive/v1` to mark where their v1 left off, and getting
    `version archive/v1-3-ga363012` back.

    So the gate manufactures the history: no tags, then a non-release tag, then a
    release tag. All three assertions are needed — with only the first, `--match`
    is unobservable; with only the last, `--always` is.
    """
    started = time.time()
    # On a COPY. This gate manufactures history — two tags and a commit — and the
    # tree is shared with every other gate in the sequence, one of which asserts
    # the scaffold is still at its first commit. It broke that one on the first
    # run. A gate that mutates shared state is order-dependent by construction,
    # which is a worse property than the bug it was written to catch.
    work = tree.parent / f"{tree.name}-version"
    shutil.rmtree(work, ignore_errors=True)
    shutil.copytree(tree, work, symlinks=True)

    def version() -> str:
        return run([f"./{CLI_NAME}", "--version"], cwd=work, env_extra={"PYTHONPATH": str(work)})[1].strip()

    declared = (work / "VERSION").read_text(encoding="utf-8").strip()

    untagged = version()
    git_in(work, "tag", "archive/v1")
    git_in(work, "commit", "-q", "--allow-empty", "-m", "chore: past the archive marker")
    non_release = version()
    git_in(work, "tag", f"v{declared}")
    released = version()

    # And that it names the COMMAND. `prog_name` shipped as the wordmark, so a
    # tree announced itself with the product's name — which in an adopted repo
    # is a second command claiming to report the same product's version and
    # disagreeing with the first. Asserted on the rendered output rather than on
    # the source line, because the defect is what a reader sees; and both
    # directions, since `--cli` and `--name` are distinct arguments here only
    # because this gate passes them that way.
    # click's format is exactly `{prog_name}, version {version}`, so this is the
    # whole claim rather than a substring search. The fixture's two candidates —
    # `--name Probe` and `--cli probe` — differ only in case, which is a weaker
    # discriminator than this repository likes; the plant is what settles it,
    # and putting `{{PROJECT_NAME}}` back into `prog_name=` turns this red.
    announces = f"{CLI_NAME}, version "
    names_the_command = untagged.startswith(announces)

    ok = (
        declared in untagged  # the VERSION fallback is reachable
        and "archive/v1" not in non_release  # a non-release tag is not a version
        and declared in non_release
        and f"v{declared}" in released  # a release tag wins when there is one
        and names_the_command
    )
    return Result(
        f"--version reports a release, not any tag, and names `{CLI_NAME}` ({declared})",
        ok,
        time.time() - started,
        f"untagged: {untagged}\nnon-release tag: {non_release}\nreleased: {released}",
    )


def check_script_targets(tree: Path) -> Result:
    """Every `script(...)` call in the tree's CLI must name a file that exists.

    `script()` joins its first argument onto `PROJECT_ROOT`, so a *flag* passed
    to it — `script("-m", "pytest", ...)` — becomes the path `<root>/-m` and the
    command fails on a file that was never going to exist. That shipped: it made
    `check pre-push`, the first command the scaffolder tells a user to run,
    impossible to pass at every tier.

    Discovered by parsing, not listed here: any new `script()` call is checked by
    existing. `module()` is the door for flags, so its argument is only required
    not to look like one.
    """
    started = time.time()
    problems = []
    for source in sorted((tree / "cli").glob("*.py")):
        tree_ast = ast.parse(source.read_text(encoding="utf-8"))
        for node in ast.walk(tree_ast):
            if not isinstance(node, ast.Call) or not isinstance(node.func, ast.Name):
                continue
            if not node.args or not isinstance(node.args[0], ast.Constant):
                continue
            first = node.args[0].value
            if not isinstance(first, str):
                continue
            if node.func.id == "script" and not (tree / first).exists():
                problems.append(f"{source.name}:{node.lineno}: script({first!r}) → no such file in the tree")
            elif node.func.id == "module" and first.startswith("-"):
                problems.append(f"{source.name}:{node.lineno}: module({first!r}) is a flag, not a module")

    return Result(
        "cli script()/module() targets resolve",
        not problems,
        time.time() - started,
        "\n".join(problems),
    )


def check_no_baked_paths(tree: Path) -> Result:
    """No generated source may contain the tree's own absolute path.

    A substitution that bakes the scaffold-time location into a file is wrong
    the moment the repo is cloned or moved, and it fails silently — `CRON_CWD`
    shipped that way and would have written crontab lines pointing at a
    directory the user had renamed. Derive from `__file__` instead.

    This is the length-independent half of the guard. The formatter alone was
    not enough: `black` rewrites an over-long string assignment only when
    wrapping it in parentheses would actually fit, so the same bug is visible
    for one narrow band of path lengths and invisible on either side of it.
    """
    started = time.time()
    needle = str(tree)
    hits = []
    for path in sorted(tree.rglob("*")):
        if not path.is_file() or ".git" in path.parts or "node_modules" in path.parts:
            continue
        if path.suffix.lower() in {".png", ".jpg", ".jpeg", ".gif", ".pdf", ".ico", ".woff", ".woff2"}:
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        if needle in text:
            line = next((i for i, ln in enumerate(text.splitlines(), 1) if needle in ln), 0)
            hits.append(f"{path.relative_to(tree)}:{line}: contains the scaffold-time absolute path")

    return Result("no scaffold-time paths baked into the tree", not hits, time.time() - started, "\n".join(hits))


#: Tools the generated Setup block is allowed to look up on PATH, with the
#: reason each one has no in-tree path to be run by.
#:
#: `python` only ever bootstraps the venv — at that line there is by definition
#: no `.venv/bin/python` to use instead. `npm` ships with node and has no
#: per-tree copy. Everything else must be run by path.
SETUP_PATH_LOOKUPS = {"npm"}


#: A fenced ``bash`` block that installs dependencies, and the two toolchains a
#: scaffold can carry. Kept in step with ``tests/test_setup_blocks_agree.py``,
#: which asks the *other* question about the same blocks — see below.
SETUP_FENCE = re.compile(r"```bash\n(?P<body>.*?)```", re.DOTALL)
SETUP_INSTALLS = re.compile(r"pip install\s+-r\s+[\w./-]+|npm install")
SETUP_REQUIREMENTS = re.compile(r"pip install\s+-r\s+(?P<target>[\w./-]+)")


def setup_blocks_in(tree: Path) -> Dict[str, List[str]]:
    """`{document: [command lines]}`, the same enrolment the shipped test uses."""
    found: Dict[str, List[str]] = {}
    code, listing = git_in(tree, "ls-files", "*.md")
    if code != 0:
        return found
    for name in listing.split():
        document = tree / name
        for match in SETUP_FENCE.finditer(document.read_text(encoding="utf-8")):
            lines = [line.split("#", 1)[0].rstrip() for line in match.group("body").splitlines()]
            lines = [line for line in lines if line.strip()]
            if not any(SETUP_INSTALLS.search(line) for line in lines):
                continue
            if any(line.strip().startswith("cd ") for line in lines):
                continue
            found[name] = lines
    return found


def check_setup_blocks_agree(tree: Path, tier: str, language: str) -> Result:
    """The shipped drift check's two inputs are right *for this language*.

    `tests/test_setup_blocks_agree.py` runs in the tree and is the real check.
    It cannot run here for every configuration — `gated_language` is `python`,
    so a node tree's own suite is never executed by this verifier — and both of
    its inputs vary along exactly the axis it does not cover.

    So this asks the generator's half of the question, which is the half no
    tree can ask about itself:

    * `{{SETUP_SHARED_PREFIX}}` is rendered from `len(setup_commands())` and the
      shipped ratchet asserts equality with the measured depth. If a document's
      first *unshared* line ever became shared, the rendered floor would sit one
      below the truth and every fresh scaffold would be red on arrival — the one
      outcome this repository refuses. That is an assumption about template
      prose, held here where all three languages are generated.
    * Every enrolled block installs the host toolchain. `cli/`, `tests/` and
      `scripts/` ship at the base tier, so a scaffold is a python project at
      every `--language`; `node` documented `npm install` alone and its own
      quick start could not run past line two.

    Both halves were established by planting the bug they claim to catch.
    """
    started = time.time()
    label = f"setup blocks: rendered floor and toolchain ({language})"
    blocks = setup_blocks_in(tree)
    if len(blocks) < 2:
        return Result(label, False, time.time() - started,
                      f"enrolled {len(blocks)} setup block(s) — a drift check needs at least two, "
                      "and a scan that finds nothing passes having looked at nothing")

    budget = tree / "tests" / "setup_block_budget.json"
    if not budget.exists():
        return Result(label, False, time.time() - started, "tests/setup_block_budget.json is missing")
    floor = json.loads(budget.read_text(encoding="utf-8"))["min_shared_prefix"]

    depth = 0
    for column in zip(*blocks.values()):
        if len(set(column)) != 1:
            break
        depth += 1

    problems = []
    if depth != floor:
        problems.append(
            f"the rendered floor is {floor} and the blocks actually agree on {depth} leading "
            f"line(s); a fresh {language} scaffold is red on arrival"
        )
    for name, lines in sorted(blocks.items()):
        installed = {
            match.group("target")
            for line in lines
            if (match := SETUP_REQUIREMENTS.search(line))
        }
        if "scripts/requirements.txt" not in installed:
            problems.append(
                f"{name} never installs scripts/requirements.txt — it installs "
                f"{sorted(installed) or 'nothing'}, so the CLI its next line calls is absent"
            )

    return Result(
        f"setup blocks: {len(blocks)} blocks, floor {floor} ({language})",
        not problems,
        time.time() - started,
        "\n".join(problems),
    )


def check_setup_block_is_self_contained(tree: Path) -> Result:
    """Every command in the generated README's Setup block runs a tool by path.

    This is the first thing a new reader runs, and it shipped failing on line
    one. The block said `pip install -r scripts/requirements.txt && pre-commit
    install --install-hooks`: on Arch, Debian 12+, Ubuntu 23.04+, Fedora or
    Homebrew macOS, pip refuses an externally-managed environment outright (PEP
    668) and the reader is stopped at the first line of the file that exists to
    onboard them; everywhere else it installs system-wide, and then `pre-commit`
    is not on PATH because the venv that would have provided it was never made.

    It is checked here rather than in `setup_commands()` because the README is
    the artifact — the thing a user reads and pastes — and because the failure
    is platform-dependent. Actually running the block would find this on this
    developer's box and never on a CI runner, whose `setup-python` is not
    externally managed. A static rule finds it on both.
    """
    started = time.time()
    readme = (tree / "README.md").read_text(encoding="utf-8")
    match = re.search(r"^## Setup\n+```bash\n(.*?)^```", readme, re.MULTILINE | re.DOTALL)
    if not match:
        return Result("README Setup block runs tools by path", False, time.time() - started,
                      "no '## Setup' bash block in the generated README")

    commands = [
        segment.strip()
        for line in match.group(1).splitlines()
        if line.strip() and not line.strip().startswith("#")
        for segment in line.split("&&")
        if segment.strip()
    ]
    if not commands:
        return Result("README Setup block runs tools by path", False, time.time() - started,
                      "the Setup block is empty — nothing was checked")

    bare = []
    for command in commands:
        tool = command.split()[0]
        if tool.startswith(("./", ".venv/bin/")) or tool in SETUP_PATH_LOOKUPS:
            continue
        if tool in ("python", "python3") and command.split()[1:3] == ["-m", "venv"]:
            continue
        bare.append(f"{command!r} resolves {tool!r} through PATH")

    return Result(
        f"README Setup block runs {len(commands)} commands by path",
        not bare,
        time.time() - started,
        "\n".join(bare),
    )


def check_scaffold_is_its_own_repo(tree: Path) -> Result:
    """A fresh scaffold is a repository of its own, with its first commit made.

    "Governs itself from its first commit" is not true of a tree that has none,
    and three shipped consequences say so. isort's `skip_gitignore` shells out
    to `git ls-files`, so the very first `check pre-push` a new user runs opened
    with `fatal: not a git repository` three times — on the run the setup guide
    prescribes specifically to show that a scaffold is green. The `regen-docs`
    merge driver is defined in `.git/config` and so cannot be installed at all.
    And `check reports` and every worktree command need a HEAD to diff against.

    All three came from the documented invocation carrying `--no-git`, which
    reads as the careful choice for scaffolding into a repo that already exists
    and is a no-op in exactly that case — the scaffolder skips a tree with a
    `.git` regardless. It only ever bit the empty directory it looked safest in.

    The toplevel assertion is the other half, and it is the one that would go
    unnoticed: a tree generated *inside* another repository has git answering
    every question about the parent, so `check merge-drivers` passes by reading
    a driver installed for something else entirely. Green, and about the wrong
    repository.
    """
    started = time.time()
    problems = []

    code, top = run(["git", "rev-parse", "--show-toplevel"], cwd=tree)
    if code != 0:
        problems.append("not a git repository at all — the scaffold made no `git init`")
    elif Path(top.strip()).resolve() != tree.resolve():
        problems.append(f"git resolves this tree to {top.strip()} — it is borrowing an enclosing repository")
    else:
        code, count = run(["git", "rev-list", "--count", "HEAD"], cwd=tree)
        if code != 0:
            problems.append(
                "the repository has no HEAD — the first commit was never made. "
                "Usually no git identity on this machine: the scaffolder warns and carries on, "
                "so check for `user.name`/`user.email` before suspecting the template"
            )
        elif count.strip() != "1":
            problems.append(f"expected exactly one scaffold commit, found {count.strip()}")

    return Result("scaffold is its own repo, at its first commit", not problems, time.time() - started,
                  "\n".join(problems))


def agentless_gate(tier: str, workdir: Path, venv_python: Path) -> List[Result]:
    """`--agent none` must produce a tree with no vendor directory that still
    passes its own gates.

    This is the separability claim, and it was false until it was checked. With
    the rule files under `.claude/rules/`, deleting that directory left six
    broken links in `docs/DEVELOPMENT.md`, `docs/README.md`, `.github/
    CONTRIBUTING.md` and a *generated* `docs/TODO/README.md` — so the tree could
    not survive losing tooling that nothing in it actually depended on, and the
    generator recreated one of the dead links on every run.

    Asserted at the fullest tier because that is where the vendor files are:
    lower tiers ship two, `agentic` ships seven.
    """
    results = []
    target = workdir / "agentless"
    started = time.time()
    code, output = run(
        [sys.executable, str(SCAFFOLDER), str(target), "--allow-dirty", "--name", "Agentless", "--slug", "agentless", "--tagline", "t",
         "--cli", CLI_NAME, "--tier", tier, "--language", "python", "--agent", "none", "--no-git"],
        cwd=workdir,
    )
    if code != 0:
        return [Result(f"--agent none: scaffold {tier}", False, time.time() - started, output)]
    results.append(Result(f"--agent none: scaffold {tier}", True, time.time() - started, output))

    started = time.time()
    # A file, not only a directory. `CLAUDE.md` shipped at `core` for a long
    # while, so `--agent none` produced a tree with no `.claude/` and a
    # vendor-named file at its root — the most visible vendor artifact there is,
    # in a tree whose author had just said no vendor tooling. This gate asked
    # only about the directory, which is why the flag looked honoured. It is a
    # pointer rather than tooling, which is what made it easy to leave: the
    # question the flag asks is not "does this do anything" but "is this
    # somebody's brand", and a pointer answers the second one too.
    stray = sorted(
        p.relative_to(target).as_posix()
        for p in [*target.rglob(".claude"), *target.rglob("CLAUDE.md")]
    )
    results.append(
        Result(
            "--agent none: no vendor directory or file",
            not stray,
            time.time() - started,
            f"unexpected: {stray}" if stray else "",
        )
    )

    # The rules are conventions, not tooling — they ship either way. A tree that
    # dropped them with the vendor directory would be the segmentation bug this
    # gate exists to catch, not a smaller tree.
    started = time.time()
    rules = sorted(p.name for p in (target / "docs" / "rules").glob("*.md"))
    results.append(
        Result(
            f"--agent none: keeps {len(rules)} rule file(s)",
            len(rules) >= 5,
            time.time() - started,
            f"found: {rules}",
        )
    )

    # The wrapper needs an interpreter with click on it, the same borrowed venv
    # every other generated tree here uses.
    (target / ".venv").symlink_to(venv_python.parents[1])
    started = time.time()
    code, output = run([f"./{CLI_NAME}", "check", "docs"], cwd=target, env_extra={"PYTHONPATH": str(target)})
    results.append(Result("--agent none: check docs", code == 0, time.time() - started, output))
    return results


#: A checker that cannot run on a bare host, in the three states that matter.
#: Written here rather than shipped, because a tree that SHIPPED one would be a
#: tree whose own `check pre-push` is red on arrival.
_CONTAINER_CHECKER = '''#!/usr/bin/env python3
"""A checker that only runs with the repository mounted in a container."""
{declaration}
import sys

sys.path.insert(0, "/nonexistent-container-mount")
import definitely_not_installed  # noqa: F401
'''


def host_exemption_gate(tier: str, workdir: Path, venv_python: Path) -> List[Result]:
    """`CANNOT_RUN_ON_HOST` excuses a checker, and only while it is true.

    `tests/test_output_contract.py` runs every `scripts/check_*.py` as a host
    subprocess, which is right for a fresh scaffold and false for a tree that
    grows a checker needing a container mount, a service, or a credential.
    jam.sense hit it on their first adoption and had nowhere to put the
    exemption: `output_allowlist.yaml` answers the *source-shape* question, and
    its staleness check deletes an entry the moment the source check passes — so
    a container-only checker that correctly declares `--json` has its exemption
    reported stale, and removing it re-breaks the behavioural test. One file,
    two consumers, two questions.

    Every branch of the fix ships untested in a scaffold, because a scaffold has
    no such checker — the exempt path exists for trees this repository cannot
    see. That is `declined_gate`'s lesson exactly: report text written for a
    branch nothing exercises. So it is planted here, in all three states.
    """
    results: List[Result] = []
    started = time.time()
    target = workdir / "host-exemption"
    code, output = run(
        [sys.executable, str(SCAFFOLDER), str(target), "--allow-dirty", "--name", "Hosted", "--slug", "hosted", "--tagline", "t",
         "--cli", CLI_NAME, "--tier", tier, "--language", "python"],
        cwd=workdir,
    )
    if code != 0:
        return [Result("host exemption: scaffold", False, time.time() - started, output)]
    (target / ".venv").symlink_to(venv_python.parents[1])

    planted = target / "scripts" / "check_planted_container_only.py"
    suite = ["-m", "pytest", "tests/test_output_contract.py", "-q", "--no-header"]

    def outcome(declaration: str) -> Tuple[bool, str]:
        planted.write_text(_CONTAINER_CHECKER.format(declaration=declaration), encoding="utf-8")
        assert planted.exists(), "the plant did not land"
        code, output = run([str(venv_python), *suite], cwd=target, env_extra={"PYTHONPATH": str(target)})
        return code == 0, output

    cases = [
        ("", False, "an undeclared container-only checker fails"),
        ('CANNOT_RUN_ON_HOST = "needs the container mount"', True, "a declared one is excused"),
        ('CANNOT_RUN_ON_HOST = ""', False, "an empty reason buys nothing"),
    ]
    for declaration, expected_green, label in cases:
        started = time.time()
        green, output = outcome(declaration)
        results.append(
            Result(
                f"host exemption: {label}",
                green is expected_green,
                time.time() - started,
                f"suite was {'green' if green else 'red'}, expected {'green' if expected_green else 'red'}\n{output}",
            )
        )

    # The staleness direction: the container dependency goes, the claim stays.
    started = time.time()
    planted.write_text(
        "#!/usr/bin/env python3\n"
        '"""It runs on the host now, and still says it cannot."""\n'
        'CANNOT_RUN_ON_HOST = "needs the container mount"\n'
        "import argparse, json, sys\n"
        'parser = argparse.ArgumentParser()\n'
        'parser.add_argument("--json", action="store_true")\n'
        "if parser.parse_args().json:\n"
        "    json.dump({\"ok\": True}, sys.stdout)\n",
        encoding="utf-8",
    )
    code, output = run([str(venv_python), *suite], cwd=target, env_extra={"PYTHONPATH": str(target)})
    results.append(
        Result(
            "host exemption: a claim that stopped being true is reported stale",
            code != 0 and "outlived its reason" in output,
            time.time() - started,
            output,
        )
    )
    planted.unlink()
    return results


def versioning_gate(tier: str, workdir: Path, venv_python: Path) -> List[Result]:
    """`--versioning tag` produces a tree that passes its own gates.

    The flag is a **subtraction and nothing else**, which is the only shape a
    scaffold flag gets here: the scaffold is skeletor's only test, so a mode
    that wrote files differently would need a verification grid this repository
    cannot afford, and it would put a conditional in every doc describing the
    workflow. What it removes is the machinery that owns a version — the Release
    Please config and manifest, `VERSION`, and the release-train skill, which is
    a state machine for a release PR nobody will open.

    Three things are asserted and the second is the one that would otherwise rot:

    * The omitted files are gone, **and present in the default mode**. Without
      the second half an empty omit set passes the first trivially, which is
      this repository's own rule about a negative over an empty set.

      Scoped to the tier under test, which took two passes to get right.
      `VERSIONING["tag"]` names paths from several overlays — the release skill
      is `agentic`'s — so requiring the default to ship all four made
      `--tier core` and `--tier governed` permanently red on a check that is
      correct at `agentic`. The grid never saw it, because `fullest` is
      `agentic` when every tier is selected; only the documented debug loop
      reaches it, which is the worst place for a standing red.

      Narrowing it lost the other half in the same motion: an entry no overlay
      ships at all had been caught by "the default must ship it", and became
      "out of scope at this tier" — silently. Both are asserted now, from
      different sources, because they are different questions. The template
      answers the second directly.
    * The prose swapped rather than merely shrank. `--versioning tag` still HAS
      a release procedure — `git tag -a`, which is how skeletor itself is
      versioned — so a `## Releases` heading with nothing under it would be a
      worse outcome than the wrong paragraph. `drop_absent_prose` ships the true
      half of each alternative.
    * The tree is green: `check docs`, and the unit suite, which is where a
      dangling link or a doc-table row for a file nobody shipped surfaces.

    Tier composition covers the references across all 36 configurations and
    cannot cover these: it asks whether a path resolves, not whether the
    sentence around it is true, and not whether the tree still runs.
    """
    results: List[Result] = []
    scaffolder = load_scaffolder()
    omitted = sorted(scaffolder.VERSIONING["tag"])

    started = time.time()
    target = workdir / "versioning-tag"
    code, output = run(
        [sys.executable, str(SCAFFOLDER), str(target), "--allow-dirty", "--name", "Tagged", "--slug", "tagged", "--tagline", "t",
         "--cli", CLI_NAME, "--tier", tier, "--language", "python", "--versioning", "tag"],
        cwd=workdir,
    )
    if code != 0:
        return [Result("--versioning tag: scaffold", False, time.time() - started, output)]
    results.append(Result("--versioning tag: scaffold", True, time.time() - started, output))

    started = time.time()
    default = workdir / "versioning-default"
    run(
        [sys.executable, str(SCAFFOLDER), str(default), "--allow-dirty", "--name", "Default", "--slug", "defaulted", "--tagline", "t",
         "--cli", CLI_NAME, "--tier", tier, "--language", "python"],
        cwd=workdir,
    )
    # `VERSIONING["tag"]` names paths from several tiers — the release skill is
    # `agentic`'s — so the set to assert is the omitted files THIS tier's
    # default actually ships, measured rather than assumed. Asserting the whole
    # map made `--tier core` and `--tier governed` permanently red on a check
    # that is right about `agentic`, which is the documented debug loop teaching
    # a reader that red is normal. The grid never saw it: `fullest` is `agentic`
    # when every tier is selected, and `core` when only `core` is.
    #
    # It keeps both halves — the applicable set is required to be non-empty, so
    # narrowing cannot make this pass by having nothing left to check — and the
    # tier-absent files are named rather than dropped in silence.
    applicable = [rel for rel in omitted if (default / rel).exists()]
    elsewhere = [rel for rel in omitted if rel not in applicable]
    # An entry this tier's default does not ship is out of scope *here*; an
    # entry NO overlay ships is stale, and that is a different question with a
    # different answer. Dropping the second when the first was fixed is the
    # mistake that produced the first: a term set corrected in one direction
    # and overshot. The template is asked directly rather than by scaffolding
    # the fullest tier — a path is shipped if some overlay contains it, which is
    # the question itself instead of a proxy for it.
    template = SKELETOR / "template"
    stale = [
        rel
        for rel in elsewhere
        if not any(next(template.glob(depth + rel), None) for depth in ("*/", "*/*/"))
    ]
    present = [rel for rel in applicable if (target / rel).exists()]
    results.append(
        Result(
            f"--versioning tag: omits {len(applicable)} of {len(omitted)} file(s) the {tier} default ships",
            bool(applicable) and not present and not stale,
            time.time() - started,
            f"still present under tag: {present}\n"
            f"not shipped by the {tier} default, so out of scope here: {elsewhere}\n"
            f"named by VERSIONING and shipped by no overlay at all: {stale}",
        )
    )

    # The swap, not the shrink. Both directions, because a `drop_absent_prose`
    # that dropped every block would leave the heading bare and pass a check
    # that only looked for the absence of the wrong words.
    started = time.time()
    development = (target / "docs" / "DEVELOPMENT.md").read_text(encoding="utf-8")
    default_dev = (default / "docs" / "DEVELOPMENT.md").read_text(encoding="utf-8")
    swapped = (
        "Release Please" not in development
        and "git tag -a" in development
        and "Release Please" in default_dev
        and "git tag -a" not in default_dev
    )
    results.append(
        Result(
            "--versioning tag: the release prose swapped, it did not just vanish",
            swapped,
            time.time() - started,
            f"tag tree names Release Please: {'Release Please' in development}\n"
            f"tag tree names `git tag -a`: {'git tag -a' in development}\n"
            f"default tree names Release Please: {'Release Please' in default_dev}",
        )
    )

    (target / ".venv").symlink_to(venv_python.parents[1])
    for command, label in (
        (["check", "docs"], "check docs"),
        (["test", "unit"], "unit suite"),
    ):
        started = time.time()
        code, output = run([f"./{CLI_NAME}", *command], cwd=target, env_extra={"PYTHONPATH": str(target)})
        results.append(Result(f"--versioning tag: {label}", code == 0, time.time() - started, output))

    # `unknown` is the honest answer before the first tag, and the tag after it.
    # A tree with no VERSION file to fall back on is exactly where `get_version`
    # had been describing a fallback it could not take.
    started = time.time()
    before = run([f"./{CLI_NAME}", "--version"], cwd=target)[1].strip()
    git_in(target, "tag", "-a", "v0.3.0", "-m", "first")
    after = run([f"./{CLI_NAME}", "--version"], cwd=target)[1].strip()
    results.append(
        Result(
            "--versioning tag: --version is `unknown` until tagged, then the tag",
            before.endswith("unknown") and after.endswith("v0.3.0"),
            time.time() - started,
            f"untagged: {before}\ntagged:   {after}",
        )
    )
    return results


def badge_gate(tier: str, workdir: Path, venv_python: Path) -> List[Result]:
    """`--org` decides whether the README carries badges, and the default is none.

    Both halves are the check, and the absent half is the one that matters. A
    badge names a repository; the `--org` default names one that does not exist,
    so a scaffold that shipped badges unconditionally would open every README
    with a broken image — a gate that is red on arrival, wearing a cosmetic hat.

    The CI badge is asserted to carry `?branch=<release branch>`, against a
    release branch deliberately NOT left at its default so that a hard-coded
    `main` in the scaffolder fails here. Without that parameter a workflow badge
    reports the repository's default branch — the `--base-branch` that
    `skeletor-new` creates with `git init -b` — where `ci.yml` has no `push`
    trigger at all, and the badge reads "no status" for the life of the project.

    The empty case is checked byte-for-byte rather than by absence, because the
    way it breaks is whitespace: a `{{BADGES}}` that renders to nothing on its
    own line leaves a double blank line under the title, which `prettier`
    rewrites on a tree nobody has touched.
    """
    results = []

    # The trees the main loop generated all take the `--org` default.
    plain = workdir / f"{tier}-python" / "README.md"
    started = time.time()
    if not plain.exists():
        results.append(Result("badges: absent without --org", True, 0.0, "skipped: no python tree at this tier"))
    else:
        head = plain.read_text()[:64]
        expected_head = "# Probe\n\na scaffold under test\n"
        results.append(
            Result(
                "badges: absent without --org",
                head.startswith(expected_head),
                time.time() - started,
                f"README opens with: {head!r}",
            )
        )

    target = workdir / "badged"
    started = time.time()
    code, output = run(
        [sys.executable, str(SCAFFOLDER), str(target), "--allow-dirty", "--name", "Badged", "--slug", "badged", "--tagline", "t",
         "--cli", CLI_NAME, "--tier", tier, "--language", "both", "--org", "acme",
         "--release-branch", "trunk", "--no-git"],
        cwd=workdir,
    )
    if code != 0:
        results.append(Result("badges: scaffold --org", False, time.time() - started, output))
        return results
    results.append(Result("badges: scaffold --org", True, time.time() - started, output))

    started = time.time()
    readme = (target / "README.md").read_text()
    required = [
        "https://img.shields.io/github/v/release/acme/badged",
        "https://github.com/acme/badged/releases",
        "/acme/badged/ci.yml?branch=trunk",
        "https://github.com/acme/badged/actions/workflows/ci.yml",
    ]
    missing = [needle for needle in required if needle not in readme]
    results.append(
        Result(
            "badges: present with --org, pinned to the release branch",
            not missing,
            time.time() - started,
            f"missing from README: {missing}" if missing else readme[:400],
        )
    )

    # A badge is markup in a file two checkers read. `check docs` is what says
    # the row did not cost the tree its own docs gate.
    (target / ".venv").symlink_to(venv_python.parents[1])
    started = time.time()
    code, output = run([f"./{CLI_NAME}", "check", "docs"], cwd=target, env_extra={"PYTHONPATH": str(target)})
    results.append(Result("badges: check docs", code == 0, time.time() - started, output))

    # The badge row is one very long markdown line, and every OTHER tree checked
    # here takes the `--org` default — so without this, `prettier` never forms an
    # opinion about the one line badges actually add. It is `proseWrap:
    # preserve` in `template/node/package.json` that makes the row survivable;
    # this is what would go red if that setting ever changed.
    if not shutil.which("npm"):
        results.append(Result("badges: prettier", True, 0.0, "skipped: npm not on PATH"))
        return results
    started = time.time()
    code, output = run(["npm", "install", "--no-audit", "--no-fund", "--silent"], cwd=target)
    if code != 0:
        results.append(Result("badges: npm install", False, time.time() - started, output))
        return results
    started = time.time()
    code, output = run(["npm", "run", "--silent", "format:check"], cwd=target)
    results.append(Result("badges: prettier accepts the badge row", code == 0, time.time() - started, output))
    return results


def long_path_gate(tier: str, workdir: Path, venv_python: Path) -> List[Result]:
    """Scaffold once into a long path and re-run the formatter on the result.

    Every other tree here is generated into a short temp path, which hides any
    line whose length depends on where the tree lives.

    The length is derived, not picked: `black` only rewrites an over-long string
    assignment when the parenthesised form would fit, so the bug is visible only
    while the path is longer than the limit minus the assignment and shorter
    than the limit minus an indent. A path of `line_length - 8` sits inside that
    band. A round number like 120 `d`s sits past it, and this gate was green
    against a reintroduced `CRON_CWD` until the length was worked out.
    """
    line_length = 120
    for arg in hook_args_for_tree(workdir, tier):
        if arg.startswith("--line-length="):
            line_length = int(arg.split("=", 1)[1])

    tail = "/tree"
    padding = line_length - 8 - len(str(workdir)) - len(tail) - 1
    deep = workdir / ("d" * max(padding, 1)) / "tree"
    result, target = scaffold(tier, "python", deep.parent, name=deep.name)
    label = f"long path ({len(str(deep))} chars)"
    results = [Result(f"{label}: {result.label}", result.ok, result.seconds, result.output)]
    if not result.ok:
        return results

    args = hook_args(target, "black")
    started = time.time()
    code, output = run([str(venv_python), "-m", "black", *args, "--check", "."], cwd=target)
    results.append(Result(f"{label}: black {' '.join(args)}", code == 0, time.time() - started, output))
    return results


def populated_tree_gate(tier: str, workdir: Path) -> List[Result]:
    """Scaffold into a directory that already has files in it, and require the
    manifest to describe skeletor's output and nothing else.

    Every other tree here is generated into a fresh directory, where every file
    present is by definition skeletor's — so the manifest was only ever built
    on the one path that cannot tell the two apart. `--force` into a populated
    repository is the other path, and `AGENTS.md` Step 2 calls it *the usual
    case*: the interesting target is a repo somebody already works in.

    It shipped broken, and an outside consumer found it in ten minutes.
    proto.pilot's manifest recorded 228 files of which 114 were its own source,
    tests and build artifacts, and `skeletor-upgrade` then refused on that tree
    forever — `cross_check` doing exactly its job against a manifest that could
    not describe its own base.

    The expected set is **recomputed, not listed**: the same arguments are
    scaffolded into an empty directory and the two manifests must have the same
    keys. A list of decoy paths would pin the decoys this file happens to plant
    and stay green for the next thing that leaks in. The decoys themselves are
    chosen to cover the three shapes that leaked: tracked source, a gitignored
    directory, and a file the scaffold overwrites — that last one must be
    *present*, since a collision is skeletor output and dropping it fails
    `cross_check` from the other direction.

    Both assertions below are needed, and planting each bug is how that was
    established rather than assumed. Comparing the two manifests catches what
    leaked *in* — but it is two readings of the same scaffolder, so a manifest
    that under-records leaves both sides equally short and the comparison stays
    green. Only the upgrade, which compares against an independently rendered
    base, sees that one. Two copies of a mistake agree with each other; that is
    the whole reason this gate exists at all.
    """
    results: List[Result] = []
    started = time.time()
    manifest_name = load_scaffolder().MANIFEST_NAME

    populated = workdir / "populated"
    (populated / "src").mkdir(parents=True, exist_ok=True)
    (populated / ".pytest_cache").mkdir(parents=True, exist_ok=True)
    (populated / "src" / "app.py").write_text("VALUE = 1\n", encoding="utf-8")
    (populated / ".pytest_cache" / "lastfailed").write_text("{}\n", encoding="utf-8")
    (populated / "README.md").write_text("# Theirs\n\nnot skeletor's.\n", encoding="utf-8")
    # The fourth shape, and the one the first three decoys could not reach: a
    # doc of the user's own, which `register_shipped_docs` correctly registers
    # into `.github/DOCS_INDEX.md`. That makes a SHIPPED file's content depend
    # on a file the base render has never heard of — so the manifest can hold a
    # hash no render of those arguments reproduces, which pruning cannot repair
    # and which only the upgrade below can see. proto.pilot hit it; the three
    # decoys above were all files skeletor ignores, and this one it reads.
    (populated / "docs").mkdir(parents=True, exist_ok=True)
    (populated / "docs" / "adopted.md").write_text("# Adopted\n\nours, from before.\n", encoding="utf-8")

    result, target = scaffold(tier, "python", workdir, name="populated")
    results.append(Result(f"populated: {result.label}", result.ok, result.seconds, result.output))
    if not result.ok:
        return results

    # `--force` writes over whatever is in its way and every loss is silent: a
    # file that is gone raises nothing. The guidance used to be "review the diff
    # file by file", which on a real repository points at ~100 files of which a
    # handful matter — sky.boss measured twelve overwrites, four of them
    # load-bearing, including a CLI wrapper that lost `PYTHONSAFEPATH` and a
    # conftest that lost the redirect keeping the suite out of the operator's
    # real state directory. Naming them is the fix, so the naming is asserted.
    #
    # Both directions. `README.md` is a decoy this gate plants *and* a file the
    # template ships, so it must be named; `src/app.py` is a decoy the template
    # never touches, so naming it would mean the report is reporting the tree
    # rather than the overwrites.
    overwrite_report = result.output[result.output.find("OVERWRITTEN") :] if "OVERWRITTEN" in result.output else ""
    results.append(
        Result(
            "populated: --force names the files it overwrote",
            "README.md" in overwrite_report and "src/app.py" not in overwrite_report,
            0.0,
            result.output,
        )
    )

    reference, clean = scaffold(tier, "python", workdir, name="populated-reference")
    results.append(Result(f"populated: reference {reference.label}", reference.ok, reference.seconds, reference.output))
    if not reference.ok:
        return results

    theirs = set(json.loads((target / manifest_name).read_text(encoding="utf-8"))["files"])
    expected = set(json.loads((clean / manifest_name).read_text(encoding="utf-8"))["files"])
    extra = sorted(theirs - expected)
    missing = sorted(expected - theirs)
    detail = ""
    if extra:
        detail += "recorded, but not part of a scaffold:\n  " + "\n  ".join(extra) + "\n"
    if missing:
        detail += "scaffolded, but not recorded:\n  " + "\n  ".join(missing) + "\n"
    results.append(
        Result(
            f"populated: the manifest records only what was scaffolded ({len(expected)} files)",
            not extra and not missing,
            time.time() - started,
            detail,
        )
    )

    # The consequence, not just the symptom: a manifest carrying the user's own
    # files fails `cross_check` and makes every later upgrade on that tree an
    # outright refusal. This is the assertion that would have caught it.
    results.append(check_upgrade_is_noop(target))
    results[-1].label = f"populated: {results[-1].label}"
    return results


def dry_run_gate(tier: str, workdir: Path) -> List[Result]:
    """`--dry-run` writes nothing, and predicts the real run exactly.

    Every adoption so far was a `--force` into a repository somebody already
    worked in, and every one learned what it had destroyed from a list printed
    **after** the write. `CLAUDE.md` collided in four of four: each adopter
    overwrote the file holding their previous agent instructions, on step 1 of
    `SETUP_GUIDE.md`. That is not a risk profile, it is a certainty.

    Two assertions, and the second is the one with teeth. "Writes nothing" is
    easy to satisfy and easy to satisfy uselessly — a dry run that printed a
    plausible number would pass it. The prediction must equal what a real run
    then reports, file for file, or it is a reassurance rather than a report.

    That comparison earned itself immediately. The first version predicted from
    the pristine render while the real run's warning intersected `written` —
    the copy phase alone — so `regen.py` silently overwrote a user's own
    `docs/todo_index.json` and the warning whose entire job is completeness did
    not name it. The manifest's bug, in the warning about the manifest's bug.
    They are the same set by construction now, which is what makes the
    prediction worth anything.

    The decoys are chosen to cover both writers: `CLAUDE.md` and `README.md`
    are copy-phase collisions, `docs/todo_index.json` is a post-copy one, and
    `src/app.py` is a file skeletor never touches — named by neither, or the
    report is reporting the tree instead of the overwrites.
    """
    results: List[Result] = []
    started = time.time()

    target = workdir / "dryrun"
    (target / "docs").mkdir(parents=True, exist_ok=True)
    (target / "src").mkdir(parents=True, exist_ok=True)
    (target / "CLAUDE.md").write_text("# Mine\n\nmy agent instructions.\n", encoding="utf-8")
    (target / "README.md").write_text("# Mine\n", encoding="utf-8")
    (target / "docs" / "todo_index.json").write_text('{"mine": true}\n', encoding="utf-8")
    (target / "src" / "app.py").write_text("VALUE = 1\n", encoding="utf-8")

    def state() -> Dict[str, str]:
        return {
            path.relative_to(target).as_posix(): hashlib.sha256(path.read_bytes()).hexdigest()
            for path in sorted(target.rglob("*"))
            if path.is_file()
        }

    def named(output: str) -> List[str]:
        return sorted(line.strip()[2:].strip() for line in output.splitlines() if line.strip().startswith("· "))

    def invoke(*extra: str) -> Tuple[int, str]:
        return run(
            [sys.executable, str(SCAFFOLDER), str(target), "--allow-dirty", "--name", "Dry", "--slug", "dryrun", "--tagline", "t",
             "--cli", CLI_NAME, "--tier", tier, "--language", "python", *extra],
            cwd=workdir,
        )

    before = state()
    assert before, "the decoys did not land — this gate would be measuring an empty directory"
    code, dry = invoke("--dry-run")
    after = state()

    predicted = named(dry)
    results.append(
        Result(
            f"dry-run: writes nothing and needs no --force ({len(predicted)} collision(s) predicted)",
            code == 0 and after == before and bool(predicted),
            time.time() - started,
            f"exit {code}, tree unchanged: {after == before}, predicted: {predicted}\n{dry}",
        )
    )

    # An untouched target is the other half of "writes nothing": a dry run that
    # created the directory would leave a repository behind on a machine whose
    # owner had decided not to scaffold.
    started = time.time()
    absent = workdir / "dryrun-absent"
    code, output = run(
        [sys.executable, str(SCAFFOLDER), str(absent), "--allow-dirty", "--name", "Dry", "--slug", "dryabsent", "--tagline", "t",
         "--cli", CLI_NAME, "--tier", tier, "--language", "python", "--dry-run"],
        cwd=workdir,
    )
    results.append(
        Result(
            "dry-run: a target that does not exist is not created",
            code == 0 and not absent.exists(),
            time.time() - started,
            f"exit {code}, created: {absent.exists()}\n{output}",
        )
    )

    started = time.time()
    code, real = invoke("--force")
    reported = named(real)
    off_limits = [rel for rel in predicted + reported if rel == "src/app.py"]
    results.append(
        Result(
            f"dry-run: the prediction is what the real run then reports ({len(reported)} overwritten)",
            code == 0 and predicted == reported and bool(reported) and not off_limits,
            time.time() - started,
            f"predicted: {predicted}\nreported : {reported}\n"
            f"named a file skeletor never writes: {off_limits}\n{real}",
        )
    )
    return results


def branch_gate(tier: str, workdir: Path) -> List[Result]:
    """A single-branch repository does not get told a name twice.

    `--base-branch` defaults to `develop` and `--release-branch` to `main`, so
    every tree this file has ever generated had two distinct names — and the
    bug lives entirely in the case where they are equal, which is every repo
    while it is one person. `branches: [main, main]` in three workflows, and
    "never on `main` or `main`" in `AGENTS.md`. A duplicated YAML entry is
    harmless. A duplicated clause in the document that establishes the rules
    reads as a typo, in the file an agent opens first.

    Both configurations are asserted, and the second is the one that keeps the
    first honest: a substitution that collapsed unconditionally would satisfy
    "no duplicate" while silently dropping the integration branch from every
    two-branch repo's CI triggers — the same fix, failing the other way, with
    nothing red to say so.

    The sites are found by pattern rather than listed. A fifth place that
    spells the pair would otherwise be exempt by having been written after
    this gate. Found by node-zero, whose tree is single-branch.
    """
    results: List[Result] = []
    started = time.time()

    def build(name: str, base: str, release: str) -> Optional[Path]:
        target = workdir / name
        code, output = run(
            [sys.executable, str(SCAFFOLDER), str(target), "--allow-dirty", "--name", "Branchy", "--slug", name, "--tagline", "t",
             "--cli", CLI_NAME, "--tier", tier, "--language", "python",
             "--base-branch", base, "--release-branch", release],
            cwd=workdir,
        )
        results.append(Result(f"branches: scaffold {base}/{release}", code == 0, time.time() - started, output))
        return target if code == 0 else None

    def spellings(tree: Path) -> List[str]:
        """Every rendered line that names a long-lived branch, wherever it is."""
        found = []
        for rel in ("AGENTS.md", ".github/workflows/ci.yml", ".github/workflows/docs-validation.yml"):
            path = tree / rel
            if not path.exists():
                continue
            for n, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
                if "branches:" in line or "never on" in line:
                    found.append(f"{rel}:{n}: {line.strip()}")
        return found

    single = build("branchy-one", "main", "main")
    if single is None:
        return results
    lines = spellings(single)
    doubled = [line for line in lines if line.count("main") > 1]
    results.append(
        Result(
            f"branches: a single-branch tree names it once ({len(lines)} site(s))",
            bool(lines) and not doubled,
            time.time() - started,
            ("the scan found no site at all — it is looking in the wrong place\n" if not lines else "")
            + "\n".join(doubled),
        )
    )

    started = time.time()
    pair = build("branchy-two", "develop", "main")
    if pair is None:
        return results
    both = spellings(pair)
    missing = [line for line in both if "develop" not in line and "main" not in line]
    incomplete = [line for line in both if "branches:" in line and ("develop" not in line or "main" not in line)]
    results.append(
        Result(
            f"branches: a two-branch tree still names both ({len(both)} site(s))",
            bool(both) and not missing and not incomplete,
            time.time() - started,
            "\n".join(missing + incomplete) or "",
        )
    )
    return results


def rescaffold_gate(tier: str, workdir: Path) -> List[Result]:
    """Scaffold twice into the same tree, and require the manifest not to move.

    `populated_tree_gate` already compares a `--force` manifest against an
    empty-directory one — and could not see either of the two bugs below,
    because its populated tree is decoys and its `--force` is a *first* one.
    That is the fixture rule again: the tree you reach for first is a tree with
    no skeletor history, and the whole defect is about what the second run
    thinks it did.

    Two failures were reported separately, from different repositories, with
    different symptoms and opposite signs. They are one line.

    **Under-record.** `regen.py`'s four outputs are shipped by no overlay, so
    they enter the manifest only by changing across `post_copy_steps`. On a
    second `--force` they already exist with identical bytes, regen no-ops, and
    all four leave the manifest silently. Measured 126 -> 122 into a tree
    skeletor itself had just made, with `--agent none` and no adopter content
    anywhere. sky.boss's sentence is the one to keep: `produced_files()` asks
    *did this run write it*, `cross_check` asks *does the base render produce
    it*, and an idempotent generator is exactly where those two diverge.

    **Over-record.** `add_frontmatter.py` stamps lifecycle frontmatter onto the
    adopter's own plans in `docs/TODO/`, which is its job. Their hashes move
    across the same two snapshots, so documents no render can produce are
    recorded as skeletor's — mind.head measured 124 against a true 105, and
    every later upgrade refused on a *wrong hash*, which is worse than a
    surplus entry because a surplus entry can be deleted by hand.

    Both directions are asserted here, in one tree, because a fix for either
    alone would leave the other and look complete. The remedy is that on a
    populated target the manifest's membership comes from `pristine`, which is
    `post_copy_steps` run against the render alone and is therefore the base
    render by construction. The upgrade at the end is the independent reading:
    the comparison above is two readings of the same scaffolder and would stay
    green if both went equally wrong, which is the reason this file's own
    docstrings keep saying two copies of a mistake agree with each other.
    """
    results: List[Result] = []
    started = time.time()
    manifest_name = load_scaffolder().MANIFEST_NAME

    first, tree = scaffold(tier, "python", workdir, name="rescaffold")
    results.append(Result(f"rescaffold: {first.label}", first.ok, first.seconds, first.output))
    if not first.ok:
        return results
    before = set(json.loads((tree / manifest_name).read_text(encoding="utf-8"))["files"])

    # The adopter using the lifecycle the scaffold ships, which is the whole
    # point of shipping it. Planted after the first run and before the second,
    # because a plan written before adoption is `populated_tree_gate`'s case and
    # was already covered — this is the one that only exists after a scaffold.
    plan = tree / "docs" / "TODO" / "a-plan-of-my-own.md"
    assert plan.parent.is_dir(), "the scaffold no longer ships docs/TODO/ — this plant is aimed at nothing"
    plan.write_text("# A Plan Of My Own\n\nWritten after adoption.\n", encoding="utf-8")

    second, _ = scaffold(tier, "python", workdir, name="rescaffold")
    results.append(Result(f"rescaffold: second {second.label}", second.ok, second.seconds, second.output))
    if not second.ok:
        return results
    after = set(json.loads((tree / manifest_name).read_text(encoding="utf-8"))["files"])

    dropped, gained = sorted(before - after), sorted(after - before)
    results.append(
        Result(
            f"rescaffold: a second --force records the same {len(before)} files",
            not dropped and not gained,
            time.time() - started,
            (("dropped by the second run:\n  " + "\n  ".join(dropped) + "\n") if dropped else "")
            + (("gained by the second run:\n  " + "\n  ".join(gained) + "\n") if gained else ""),
        )
    )
    results.append(
        Result(
            "rescaffold: the adopter's own plan is not recorded as skeletor's",
            "docs/TODO/a-plan-of-my-own.md" not in after and plan.read_text(encoding="utf-8").startswith("---"),
            0.0,
            "the plant only proves anything if the step really stamped it: "
            f"stamped={plan.read_text(encoding='utf-8').startswith('---')}, "
            f"recorded={'docs/TODO/a-plan-of-my-own.md' in after}",
        )
    )

    # The consequence. Both bugs above surface to a user as one sentence —
    # `.skeletor.json` disagrees with the base it names — and this is the only
    # assertion here that renders that base independently.
    results.append(check_upgrade_is_noop(tree))
    results[-1].label = f"rescaffold: {results[-1].label}"
    return results


def sidecar_gate(tier: str, workdir: Path) -> List[Result]:
    """`tmp/upgrade/` describes one run, and `--dry-run` says it wrote nothing.

    The conflict and collision reports are the only place this tool tells a
    reader to go **open a file**, and nothing here had ever executed them: every
    other upgrade gate runs against a fresh tree, where the answer is "already
    current" and neither branch is reached. So both of their sentences shipped
    unconditional. Under `--dry-run` the tool printed "what the template changed
    in each is in `tmp/upgrade/<path>.patch`" and then wrote nothing there — and
    the directory is not empty, because a real run never cleared it either. A
    reader following the instruction opened a four-day-old patch against a
    template HEAD that had since moved, with nothing in the output to say so.
    Reported by proto.pilot, from the reader's side, which is the only side it is
    visible from.

    Two halves, and they are the same bug. The prose half is asserted **by
    pattern, not by sentence**: every output line naming `tmp/upgrade/` must be
    hypothetical under a dry run and indicative under a real one. A list of the
    two sentences would pin the two and stay green for the third somebody adds.

    The skew is manufactured through `--no-base`, which classifies from the
    recorded hashes alone: tamper one recorded hash and the tool sees a file the
    template moved *and* the user edited (a conflict), delete another entry and
    it sees a path the user held before the template claimed it (a collision).
    That reaches both branches with no second checkout and no version skew to
    arrange — and `--no-base` skips `cross_check`, which is what makes tampering
    a legitimate way in rather than an immediate refusal.
    """
    results: List[Result] = []
    started = time.time()
    manifest_name = load_scaffolder().MANIFEST_NAME

    result, tree = scaffold(tier, "python", workdir, name="sidecars")
    results.append(Result(f"sidecars: {result.label}", result.ok, result.seconds, result.output))
    if not result.ok:
        return results

    manifest = json.loads((tree / manifest_name).read_text(encoding="utf-8"))
    files = manifest["files"]
    conflict, collision = sorted(files)[:2]
    files[conflict] = "0" * 64  # the template moved it — and so did the user, below
    del files[collision]  # never recorded, so it reads as a file they already had
    (tree / manifest_name).write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
    for rel in (conflict, collision):
        (tree / rel).write_text("theirs, edited\n", encoding="utf-8")

    # A previous run's sidecars, and one file that is not ours. The foreign file
    # is the point of the suffix rule: this deletes what it wrote and nothing else.
    patches = tree / "tmp" / "upgrade"
    (patches / "sub").mkdir(parents=True, exist_ok=True)
    (patches / "stale.patch").write_text("from a run four days ago\n", encoding="utf-8")
    (patches / "sub" / "gone.new").write_text("for a file not in today's plan\n", encoding="utf-8")
    (patches / "notes.md").write_text("mine, not skeletor's\n", encoding="utf-8")

    def snapshot() -> dict:
        return {
            str(f.relative_to(tree)): hashlib.sha256(f.read_bytes()).hexdigest()
            for f in sorted(tree.rglob("*"))
            if f.is_file() and ".git/" not in str(f.relative_to(tree))
        }

    def directions(output: str) -> List[str]:
        """Blank-line-separated blocks that direct the reader at a sidecar.

        `tmp/upgrade/<path>` — the *placeholder* form — is what a direction is:
        the bare directory appears in the footer and in the stale listing, which
        are statements about the run rather than instructions to open anything,
        and only a sentence sending somebody to a file of their own has to spell
        the file as a variable. That is the discriminator, and it holds by
        construction rather than by enumerating the two sentences that exist
        today, which would stay green for the third somebody adds.

        Blocks, not lines: these sentences wrap, and the tense sits on whichever
        line it fell on. A per-line rule flags the continuation of a correct
        sentence — which is how this predicate was found to be wrong.
        """
        return [b for b in output.split("\n\n") if "tmp/upgrade/<path>" in b]

    upgrade = [sys.executable, str(clean_skeletor(workdir) / "bin" / "skeletor-upgrade"), str(tree), "--no-base"]

    before = snapshot()
    code, output = run([*upgrade, "--dry-run"], cwd=tree)
    said = directions(output)
    reached = "merge conflicts" in output and "you already had" in output
    unwritten = snapshot() == before
    hypothetical = bool(said) and all("would" in block for block in said)
    results.append(
        Result(
            f"sidecars: --dry-run wrote nothing and said so ({len(said)} direction(s))",
            code == 1 and reached and unwritten and hypothetical,
            time.time() - started,
            f"reached both branches: {reached}\ntree unchanged: {unwritten}\n"
            f"all hypothetical: {hypothetical}\n{output}",
        )
    )

    # Committed, because an upgrade refuses a dirty tree — and rightly: the
    # tampering above is exactly the "in-progress edits" that refusal protects.
    git_in(tree, "add", "-A")
    git_in(tree, "commit", "-m", "tamper")

    started = time.time()
    code, output = run(upgrade, cwd=tree)
    said = directions(output)
    left = sorted(str(f.relative_to(patches)) for f in patches.rglob("*") if f.is_file())
    results.append(
        Result(
            "sidecars: a real run clears its own and keeps yours",
            code == 1
            and bool(said)
            and not any("would" in block for block in said)
            and "stale.patch" not in left
            and "sub/gone.new" not in left
            and "notes.md" in left
            and f"{collision}.new" in left,
            time.time() - started,
            "tmp/upgrade/ holds:\n  " + "\n  ".join(left) + "\n" + output,
        )
    )

    # The third way out, and the one both of the above walk past: a dry run that
    # finds nothing to do. It `return`s before the footer, so the stale warning
    # was unreachable from the case that needs it most — there is no plan above,
    # so every sidecar on disk is stale by definition rather than merely
    # possibly — printed under the most reassuring line this tool has. And that
    # line named no version, so "current with HEAD" and "current with the ref
    # your manifest records" read identically. Both reported by stash.flow, from
    # a tree at v0.6.0 against skeletor v0.6.1; neither is visible from a gate
    # that only ever reaches the branches with something to report.
    started = time.time()
    result, clean = scaffold(tier, "python", workdir, name="current")
    results.append(Result(f"current: {result.label}", result.ok, result.seconds, result.output))
    if not result.ok:
        return results

    planted = clean / "tmp" / "upgrade"
    planted.mkdir(parents=True, exist_ok=True)
    (planted / "stale.patch").write_text("from a run four days ago\n", encoding="utf-8")
    (planted / "gone.new").write_text("for a file not in today's plan\n", encoding="utf-8")
    left_behind = sorted(f"tmp/upgrade/{f.name}" for f in planted.iterdir())

    # `--from-dir SKELETOR` rather than the committed clone: this asserts the
    # tree is current, and it was scaffolded by the live checkout, so a dirty
    # working tree would otherwise make the two disagree and the branch under
    # test would never be reached. That is `check_upgrade_is_noop`'s reasoning.
    code, output = run(
        [sys.executable, str(SKELETOR / "bin" / "skeletor-upgrade"), str(clean), "--dry-run", "--from-dir", str(SKELETOR)],
        cwd=clean,
    )
    named = re.search(r"already current with skeletor @ (\S+)", output)
    recorded = json.loads((clean / manifest_name).read_text(encoding="utf-8"))["skeletor_ref"]
    # Every planted sidecar by path, not one of them and not a sentence: the
    # listing truncates at ten, so "it mentioned something" would pass on a
    # report that dropped the rest.
    listed = [rel for rel in left_behind if rel in output]
    results.append(
        Result(
            f"sidecars: 'already current' names its version and its {len(left_behind)} stale sidecar(s)",
            code == 0
            and named is not None
            and named.group(1) == recorded
            and listed == left_behind,
            time.time() - started,
            f"named: {named.group(1) if named else None} (manifest records {recorded})\n"
            f"listed {listed} of {left_behind}\n{output}",
        )
    )
    return results


def collect_diff_gate(tier: str, workdir: Path, venv_python: Path) -> List[Result]:
    """The footer that tells a reader not to verify an upgrade by counting.

    proto.pilot's v0.3.6 → v0.4.2 run collected 633 tests before and after, and
    five had changed — five removed, five added, the equality a coincidence. A
    total is a negative assertion over a set wearing a number's clothes, which
    is the rule `scanned()` states for enumerations, and nothing in the upgrade
    output said so.

    Three things are asserted, and the second and third are why this is a gate
    rather than a line of prose somebody eyeballed once:

    * A real run that wrote under `tests/` prints it, naming the target's HEAD
      **as it was before the run** — the value of the line is that it is
      paste-able, and a footer naming the wrong commit is worse than none.
    * A run that wrote nothing under `tests/` does not. Always-on prose in this
      output gets skimmed, and this instruction earns attention by being rare.
    * A dry run does not, for the reason the sidecar rule exists: a dry run must
      not send anybody to inspect a state it did not produce.

    The skew is `sidecar_gate`'s, one classification over. An `updated` needs the
    recorded hash to MATCH what is on disk — the user touched nothing — while the
    head render differs, so the tamper is to edit the file *and* record the edit.
    Editing without recording is a conflict, which is written nowhere and would
    reach none of this.

    ## Why the recipe is executed and not read

    The first draft of that footer printed a pipeline that fails silently, which
    is the joke this gate exists to stop repeating: a wrong interpreter path or a
    collection error leaves `grep` writing an empty file, `diff` reports no
    change, and the reader takes a clean bill off two files containing nothing.
    A negative assertion over an empty set — delivered by the command whose whole
    purpose is to say that counting is not looking.

    Reading the block would not have caught it and did not. Running it did, on
    the first try. So the gate extracts the commands the tool actually printed
    and executes them.

    ## The first fix was `wc -l`, and it was wrong

    That is worth keeping because this gate then made the same mistake, and for
    the same reason. `wc -l` asks whether the two files are empty; this gate
    asked `len(collected) > 0`. One question, two homes, and node-zero found the
    failure neither could see: an unscoped `pytest` descends into the
    `tmp/pre-upgrade` worktree the recipe just created, collides on every module
    basename, and Interrupts at exit 2 — **after** writing the right ids. Both
    files come out correct and non-empty, `diff` reports no change and is
    telling the truth about them, and `grep :: | sort` has thrown the exit code
    away. This gate ran that command on every verify and passed.

    That is the repository's own empty-scope rule arriving inside the gate
    written to enforce it, one level up: the recipe and its guard were written
    by one hand, so the guard was written against the failure that was imagined
    rather than the one the recipe causes. A doc-and-check pair agreeing with
    each other by construction — node-zero's framing, and it is the workspace's
    two-consumers rule applied to a procedure and its own safety check.

    So the recipe is scoped to `tests/` and announces its own failure, and this
    gate requires the announcement to be **absent** — then plants the unscoped
    form and requires it to be **present**. Without that second run the first is
    a negative assertion over a set nobody proved non-empty, which is precisely
    the reading that shipped.

    `$PY` is not repointed: `$(pwd)/.venv/bin/python` is a path the recipe names
    out loud, and a gate that swapped it in could not catch a path pointing at
    nothing. A verify tree never runs the README's setup, so the venv is
    symlinked to the shared one and the line executes as printed.
    """
    results: List[Result] = []
    manifest_name = load_scaffolder().MANIFEST_NAME
    upgrade_bin = clean_skeletor(workdir) / "bin" / "skeletor-upgrade"

    def manufacture(tree: Path, rel: str) -> None:
        """Make `rel` read as "the template moved it, the user did not"."""
        path = tree / rel
        path.write_text(path.read_text(encoding="utf-8") + "\n# theirs, from the base render\n", encoding="utf-8")
        manifest = json.loads((tree / manifest_name).read_text(encoding="utf-8"))
        manifest["files"][rel] = hashlib.sha256(path.read_bytes()).hexdigest()
        (tree / manifest_name).write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")

    def written_marker(output: str) -> bool:
        return "do not verify by counting" in output

    started = time.time()
    result, tree = scaffold(tier, "python", workdir, name="collect-diff")
    results.append(Result(f"collect-diff: {result.label}", result.ok, result.seconds, result.output))
    if not result.ok:
        return results

    manifest = json.loads((tree / manifest_name).read_text(encoding="utf-8"))
    test_file = next(r for r in sorted(manifest["files"]) if r.startswith("tests/") and r.endswith(".py"))
    manufacture(tree, test_file)

    # Dry run first, while the tree is still dirty — a dry run is never refused.
    code, dry_output = run([sys.executable, str(upgrade_bin), str(tree), "--no-base", "--dry-run"], cwd=tree)
    reached = test_file in dry_output

    git_in(tree, "add", "-A")
    git_in(tree, "commit", "-m", "tamper")
    # The commit the footer must name: the scaffold's first commit is also
    # sitting right there, so naming *a* sha proves nothing.
    head = run(["git", "-C", str(tree), "rev-parse", "HEAD"], cwd=tree)[1].strip()

    real_code, real_output = run([sys.executable, str(upgrade_bin), str(tree), "--no-base"], cwd=tree)
    results.append(
        Result(
            "collect-diff: a real run that touched tests/ names the pre-upgrade commit",
            reached
            and written_marker(real_output)
            and head in real_output
            and not written_marker(dry_output)
            and "--allow-dirty" not in real_output,
            time.time() - started,
            f"the manufacture reached the tool: {reached}\n"
            f"real run printed it: {written_marker(real_output)}\n"
            f"named HEAD {head[:12]}: {head in real_output}\n"
            f"dry run stayed silent: {not written_marker(dry_output)}\n"
            f"--- dry ---\n{dry_output}\n--- real ---\n{real_output}",
        )
    )

    # The recipe, run. Its lines are the ones the tool printed, with `$PY`
    # repointed at the shared venv — a verify tree never runs the README's setup.
    started = time.time()
    recipe = [
        line.strip()
        for line in real_output.splitlines()
        if line.startswith("     ") and not line.strip().startswith("#") and line.strip()
    ]
    # `/tmp/` is the recipe's own suggestion and is wrong for a gate — two trees
    # would collide on it. Everything else is executed as printed.
    scratch = workdir / "collect-diff-run"
    scratch.mkdir(exist_ok=True)

    # The interpreter is NOT substituted. `$(pwd)/.venv/bin/python` is a path the
    # recipe names out loud, and a gate that swapped it in would be unable to
    # catch the one thing that actually went wrong first — a path pointing at
    # nothing. A verify tree never runs the README's setup, so the venv is
    # symlinked to the shared one and the line is executed exactly as printed.
    if not (tree / ".venv").exists():
        (tree / ".venv").symlink_to(venv_python.parent.parent)

    def rehome(line: str) -> str:
        """The recipe's own two scratch files, moved out of a shared `/tmp/`.

        By name, not by prefix: a blanket `/tmp/` rewrite also caught the
        interpreter path, since a verify workdir lives under `/tmp/` too. The
        gate then ran nothing and reported a clean comparison — the failure mode
        under test, arriving inside the thing testing for it.
        """
        for name in ("before.txt", "after.txt", "before.raw", "after.raw"):
            line = line.replace(f"/tmp/{name}", str(scratch / name))
        return line

    script = "\n".join(rehome(line) for line in recipe)
    code, ran = run(["bash", "-c", script], cwd=tree)
    before = scratch / "before.txt"
    collected = [ln for ln in before.read_text().splitlines() if "::" in ln] if before.exists() else []
    # The recipe's own marker, read out of the recipe rather than spelled here:
    # a second copy would keep passing after somebody reworded the echo.
    marker = "collection FAILED"
    assert any(marker in line for line in recipe), "the recipe no longer announces a failed collection"
    results.append(
        Result(
            f"collect-diff: the printed recipe runs and reports no failure ({len(collected)} ids)",
            code == 0 and len(collected) > 0 and len(recipe) >= 5 and marker not in ran,
            time.time() - started,
            f"{len(recipe)} command line(s) extracted, exit {code}, {len(collected)} collected ids\n"
            f"the recipe's own failure marker fired: {marker in ran}\n"
            f"--- script ---\n{script}\n--- output ---\n{ran}",
        )
    )

    # The plant, in the gate, because the assertion above is a negative one and
    # a negative over a set nobody sized is what shipped here. Strip the `tests/`
    # scope back out — the exact defect node-zero reported — and the marker must
    # fire. If it does not, the assertion above is decoration.
    started = time.time()
    unscoped = script.replace("-m pytest tests/ ", "-m pytest ")
    planted = unscoped != script
    prune = "rm -rf tmp/pre-upgrade; git worktree prune\n"
    plant_code, plant_ran = run(["bash", "-c", prune + unscoped], cwd=tree)
    results.append(
        Result(
            "collect-diff: unscoping the recipe makes it say so",
            planted and marker in plant_ran,
            time.time() - started,
            f"the plant changed the script: {planted}\n"
            f"the marker fired: {marker in plant_ran}\n"
            f"--- output ---\n{plant_ran}",
        )
    )
    run(["bash", "-c", "rm -rf tmp/pre-upgrade; git worktree prune"], cwd=tree)

    # And the other direction, which is the one an unconditional footer passes.
    started = time.time()
    result, other = scaffold(tier, "python", workdir, name="collect-diff-none")
    if not result.ok:
        results.append(Result(f"collect-diff: {result.label}", False, result.seconds, result.output))
        return results

    manifest = json.loads((other / manifest_name).read_text(encoding="utf-8"))
    doc = next(r for r in sorted(manifest["files"]) if r.endswith(".md") and not r.startswith("tests/"))
    manufacture(other, doc)
    git_in(other, "add", "-A")
    git_in(other, "commit", "-m", "tamper")

    code, output = run([sys.executable, str(upgrade_bin), str(other), "--no-base"], cwd=other)
    results.append(
        Result(
            "collect-diff: a run that touched no test file stays quiet",
            doc in output and not written_marker(output),
            time.time() - started,
            f"the manufacture reached the tool: {doc in output}\n{output}",
        )
    )
    return results


#: A reference to a file in this tree: at least one slash, and an extension
#: beginning with a letter. Both halves earn their place — without the slash a
#: version string (`1.2.3`) and a sentence-ending word match; without the letter
#: rule so does `v0.4.4`. The lookbehind keeps it off the tail of a URL, whose
#: path segments are preceded by `/`.
_TREE_REF = re.compile(r"(?<![\w/.-])((?:[\w.-]+/)+[\w.-]+\.[A-Za-z]\w*)")

#: A file declaring that it HANDLES a path's absence, rather than sending a
#: reader to it:
#:
#:     # SCAFFOLD-OPTIONAL .github/release-please-config.json
#:
#: The two are indistinguishable to a predicate over paths — `[ ! -f X ]` and
#: "see X" both mention X — and the difference is the whole finding. So the file
#: says which it is, at the site, in the comment syntax it already has.
#:
#: Beside a list here because that is the shape every other exemption in this
#: session settled on: an exemption held somewhere else is a question somebody
#: can finish without answering, and it goes stale where nobody is looking. Both
#: staleness directions are checked below, so a declaration cannot outlive its
#: reason quietly.
_OPTIONAL = re.compile(r"SCAFFOLD-OPTIONAL\s+(\S+)")


def configurations(scaffolder) -> List[Tuple[str, str, str, str]]:
    """Every (tier, language, agent, versioning) this scaffolder can produce.

    Read from its own maps, so an axis added to `bin/skeletor-new` is covered by
    this gate on the next run rather than the next time somebody remembers. Each
    one is a configuration a user is documented to pick, and a reference that
    only resolves when the omitted files ship is the same defect one axis over —
    which is how `--agent none` was found routing readers into `.claude/`.
    """
    return [
        (tier, language, agent, versioning)
        for tier in sorted(scaffolder.TIERS)
        for language in sorted(scaffolder.LANGUAGE_OVERLAYS)
        for agent in sorted(scaffolder.AGENTS)
        for versioning in sorted(scaffolder.VERSIONING)
    ]


def superset_of(scaffolder, a: Tuple[str, str, str, str], b: Tuple[str, str, str, str]) -> bool:
    """Does configuration `b` ship everything `a` does, and more?

    Containment of what each axis contributes — never a hand-written ordering,
    which would go stale the day a tier is inserted in the middle. Versioning is
    the one axis expressed as a SUBTRACTION, so its containment runs the other
    way: `b` ships more when it omits less.
    """
    if a == b:
        return False
    a_tier, a_lang, a_agent, a_version = a
    b_tier, b_lang, b_agent, b_version = b
    tiers = set(scaffolder.TIERS[a_tier]) <= set(scaffolder.TIERS[b_tier])
    langs = set(scaffolder.LANGUAGE_OVERLAYS[a_lang].split(",")) <= set(
        scaffolder.LANGUAGE_OVERLAYS[b_lang].split(",")
    )
    agents = scaffolder.AGENTS[a_agent] is None or scaffolder.AGENTS[a_agent] == scaffolder.AGENTS[b_agent]
    versions = scaffolder.VERSIONING[b_version] <= scaffolder.VERSIONING[a_version]
    return tiers and langs and agents and versions


def tier_composition_gate(workdir: Path) -> List[Result]:
    """A shipped file must not name a shipped file that is not shipped *here*.

    stash.flow reported the class: `template/core/AGENTS.md` and
    `template/core/scripts/paths.py` both cited `tests/test_state_paths.py`,
    which shipped only at `agentic`. A `core` reader following either citation
    finds nothing, and the sentence around it — "this test enforces it" — is
    then a claim about a file that is not there.

    No tree's own suite can see this. `check_source_doc_refs.py` runs inside one
    configuration, where a reference either resolves or does not; the defect is
    that it resolves in a *different* one. That makes it the generator's
    question, which is why the fix went here and not into the template.

    ## The predicate, and why it needs no allowlist

    A reference is a finding only when it is **absent here and present in a
    configuration that ships strictly more**. Everything else is out of scope by
    construction rather than by exemption:

    * `.env`, `tmp/upgrade/<path>`, a file the user is told to create — absent
      everywhere, so never flagged.
    * A URL, a version string, a dotted module name — not matched at all.
    * Another repository's path — absent from every configuration here.

    Measured, not asserted: the first run found 11 references across `core` and
    `governed`, all six distinct sites real, and every one had a fix better than
    an exemption. Four were live citations pointing a `core` reader at a module
    only `agentic` ships; two were history about the repository this was
    extracted from. The allowlist is empty and there is no mechanism to add one.

    ## The one thing it cannot see

    A path belonging to **another repo** that happens to collide with one of
    ours. `scripts/yaml_text.py` cited jam.sense's `cli/worktree.py`, which is
    not a file here at any tier — except that `agentic` ships a `cli/worktree.py`
    of its own, so the collision made it look like a local dangling reference.
    It was reworded rather than exempted, because spelling another repo's file
    as a repo-relative path is misleading in its own right. A predicate over
    paths cannot tell the two apart, and this is written down instead of guarded.
    """
    started = time.time()
    scaffolder = load_scaffolder()
    configs = configurations(scaffolder)

    trees: Dict[Tuple[str, str, str, str], Path] = {}
    for tier, language, agent, versioning in configs:
        name = f"compose-{tier}-{language}-{agent}-{versioning}"
        target = workdir / name
        code, output = run(
            [
                sys.executable,
                str(SCAFFOLDER),
                str(target),
                "--allow-dirty",
                "--name",
                "Compose",
                "--cli",
                "cc",
                "--tagline",
                "composition",
                "--tier",
                tier,
                "--language",
                language,
                "--agent",
                agent,
                "--versioning",
                versioning,
            ],
            cwd=workdir,
        )
        if code != 0:
            return [Result(f"tier composition: scaffold {name}", False, time.time() - started, output)]
        trees[(tier, language, agent, versioning)] = target

    def shipped(root: Path) -> set:
        return {
            str(f.relative_to(root))
            for f in root.rglob("*")
            if f.is_file() and ".git" not in f.relative_to(root).parts
        }

    files = {config: shipped(root) for config, root in trees.items()}

    findings: Dict[str, List[str]] = {}
    declarations: Dict[str, set] = {}
    scanned_refs = 0
    for config, root in trees.items():
        mine = files[config]
        elsewhere = set().union(
            *(files[other] for other in configs if superset_of(scaffolder, config, other))
        ) or set()
        for rel in sorted(mine):
            path = root / rel
            try:
                text = path.read_text(encoding="utf-8")
            except (UnicodeDecodeError, OSError):
                continue
            handled = set(_OPTIONAL.findall(text))
            for declared in handled:
                declarations.setdefault(declared, set()).add(rel)
            for match in _TREE_REF.finditer(text):
                ref = match.group(1)
                scanned_refs += 1
                if ref in mine or ref not in elsewhere or ref in handled:
                    continue
                where = "/".join(config)
                findings.setdefault(f"{ref}  (missing at {where})", []).append(rel)

    # Every declaration is checked against the thing it exempts, both ways. One
    # naming a path no configuration omits is describing a hazard that no longer
    # exists; one naming a path its own file never mentions is describing a
    # reference somebody deleted. Both are stale, and a stale exemption is worse
    # than none — the path can come back for something else and arrive
    # pre-exempted, which is an exemption nobody chose.
    everywhere = set.intersection(*files.values()) if files else set()
    stale = []
    for declared, sites in sorted(declarations.items()):
        if declared in everywhere:
            stale.append(f"{declared} — shipped in every configuration, so nothing to handle")
        for site in sorted(sites):
            holder = next(root for cfg, root in trees.items() if site in files[cfg])
            if declared not in (holder / site).read_text(encoding="utf-8", errors="ignore"):
                stale.append(f"{declared} — declared in {site}, which does not mention it")

    # A negative over an empty scan is a tautology: a `_TREE_REF` that matched
    # nothing would report every configuration clean. The trees hold hundreds of
    # references between them, so a number this small means the extractor broke.
    enumerated = scanned_refs >= 100
    report = "\n".join(
        f"  {ref}\n" + "\n".join(f"      cited by {c}" for c in sorted(set(citers)))
        for ref, citers in sorted(findings.items())
    )
    return [
        Result(
            f"tier composition: every reference resolves where it is read "
            f"({len(configs)} configs, {scanned_refs} refs, {len(declarations)} handled)",
            not findings and not stale and enumerated,
            time.time() - started,
            (f"extracted only {scanned_refs} references — the extractor is broken\n" if not enumerated else "")
            + ("a shipped file names a file that is not shipped in that configuration:\n" + report if findings else "")
            + ("\nstale SCAFFOLD-OPTIONAL declaration(s):\n  " + "\n  ".join(stale) if stale else ""),
        )
    ]


def clean_skeletor(workdir: Path) -> Path:
    """A committed clone of this checkout, cloned once and reused.

    `skeletor-upgrade` refuses a dirty base on any run that writes, because the
    manifest it would record names a render that exists in no commit. This
    checkout is dirty whenever somebody is working in it, so every gate that
    performs a REAL upgrade has to come from somewhere clean.

    That is not a workaround for the refusal — it is the condition being tested.
    A user upgrades from a released skeletor; a gate that ran from the working
    tree would be exercising the refusal and calling it an upgrade.

    **The working tree's changes are carried in and committed inside the clone**,
    which is the part that took three repeats to get right. A plain clone holds
    only committed state, so every gate built on one silently tested the previous
    version: a new tool failed until it was committed, and a planted bug passed
    because the plant was not. Both happened here, twice each, and each time the
    gate was correct and the verification of it was not.

    `git stash create` is what makes this cheap — it writes a commit object for
    the working tree without touching it, so the clone can fetch that one object
    and check it out. The result is a checkout that is genuinely clean, carries
    the edits under test, and keeps the tags `describe` and `base_checkout` need.
    """
    clone = workdir / "skeletor-clean"
    if clone.exists():
        return clone
    run(["git", "clone", "--quiet", "--no-hardlinks", str(SKELETOR), str(clone)], cwd=workdir)
    working = run(["git", "-C", str(SKELETOR), "stash", "create"], cwd=SKELETOR)[1].strip()
    if working:
        run(["git", "-C", str(clone), "fetch", "--quiet", "origin", working], cwd=workdir)
        run(["git", "-C", str(clone), "checkout", "--quiet", working, "--", "."], cwd=workdir)
        git_in(clone, "commit", "--quiet", "-am", "verify: the working tree under test")
    return clone


def upgrade_applied(tree: Path, manifest_name: str) -> List[str]:
    """Which files an upgrade actually wrote — asked of git, not of its output.

    A scaffold is its own repository at its first commit, so anything the
    upgrade touched is a modification against it. Two exclusions, both because
    they would make the question answer itself: the manifest is rewritten
    *because* something applied, and `tmp/` holds the sidecars written for a
    conflict, which are a report about what was NOT applied.
    """
    lines = [line for line in git_in(tree, "status", "--porcelain")[1].splitlines() if line.strip()]
    paths = [line[3:].strip() for line in lines]
    return [path for path in paths if path != manifest_name and not path.startswith("tmp/")]


def shadow_gate(workdir: Path, venv_python: Path) -> Result:
    """One scaffold's wrapper, run from inside another, is still itself.

    `python -m` prepends the current directory to `sys.path` **ahead of**
    PYTHONPATH, and every scaffold contains a `cli/` package — so a wrapper run
    from inside a second skeletor tree imported that tree's CLI and came up
    under the other project's name, with the other project's commands, exit 0
    and not a word. Anything that then wrote a path recorded the wrong tree.
    sky.boss found it and had been bitten by the same thing once before, which
    is the reason to gate rather than to fix and move on: their systemd units
    were all generated with the wrong `WorkingDirectory`, successfully.

    The triggering condition is a workspace of sibling checkouts, which is the
    ordinary case rather than a corner: two projects from this shell are two
    `cli/` packages and one terminal in the wrong directory.

    Both directions are asserted. A wrapper that answered correctly from its own
    root proved nothing about the bug — that is the case that was always green —
    and a gate that only ran the cross-tree invocation could be satisfied by a
    wrapper too broken to run at all.
    """
    started = time.time()
    trees = {}
    for name, cli in (("shadow-a", "shadowa"), ("shadow-b", "shadowb")):
        target = workdir / name
        code, output = run(
            [sys.executable, str(SCAFFOLDER), str(target), "--allow-dirty", "--name", name.title(),
             "--cli", cli, "--tagline", "t", "--tier", "core"],
            cwd=SKELETOR,
        )
        if code != 0:
            return Result(f"cli shadowing: scaffold {name}", False, time.time() - started, output)
        (target / ".venv").symlink_to(venv_python.parents[1])
        trees[cli] = target

    problems = []
    for cli, target in trees.items():
        other = next(path for name, path in trees.items() if name != cli)
        for where, label in ((target, "its own root"), (other, "the other tree")):
            code, output = run([str(target / cli), "--help"], cwd=where)
            if code != 0:
                problems.append(f"./{cli} from {label} exited {code}: {output.strip()[:200]}")
            elif f"Usage: {cli}" not in output:
                problems.append(
                    f"./{cli} run from {label} announced itself as "
                    f"{output.splitlines()[0] if output else '(nothing)'} — it imported the "
                    "wrong tree's cli/ package, and said so only in its own name"
                )

    return Result(
        "cli shadowing: a wrapper run from a sibling scaffold is still itself",
        not problems,
        time.time() - started,
        "\n".join(problems),
    )


def coverage_gate(workdir: Path, venv_python: Path) -> Result:
    """`<cli> test coverage` passes, and fails when the budget is breached.

    It could not pass in any tree, and the reason it survived is the second
    half. `coverage` asked pytest for `term-missing` only while
    `check_coverage_budget.py` three lines below looked for `tmp/coverage.xml`
    — two literals in one function that did not match, the checker's own
    docstring giving the correct invocation. So the ratchet had nothing to read
    and said so, **and the command exited 0 anyway**, because `sys.exit(code)`
    carried pytest's result and the checker's was discarded.

    That ordering is the lesson: a gate reporting its own failure as success is
    worse than one that never runs, since the output says it looked. And with
    nothing to measure, the ratchet never disagreed — so nothing ever tested
    whether disagreement was reported. The first bug is why the second was
    invisible.

    Both halves are asserted, and the breach is planted by raising the tree's
    own baseline above what it measures. A green run alone would pass on a
    command that had stopped checking anything, which is exactly the state this
    was in.
    """
    started = time.time()
    target = workdir / "coverage-probe"
    code, output = run(
        [sys.executable, str(SCAFFOLDER), str(target), "--allow-dirty", "--name", "Probe",
         "--cli", CLI_NAME, "--tagline", "t", "--tier", "core"],
        cwd=SKELETOR,
    )
    if code != 0:
        return Result("coverage: scaffold", False, time.time() - started, output)
    (target / ".venv").symlink_to(venv_python.parents[1])

    code, output = run([str(target / CLI_NAME), "test", "coverage"], cwd=target)
    if code != 0:
        return Result(
            "coverage: `test coverage` passes on a fresh tree", False, time.time() - started,
            f"exited {code}\n{output[-1500:]}",
        )
    report = target / "tmp" / "coverage.xml"
    if not report.exists():
        return Result(
            "coverage: the run wrote the report the ratchet reads", False, time.time() - started,
            f"{report} was not written, so the ratchet measured nothing and the command still passed",
        )

    budget = target / "tests" / "coverage_budget.json"
    data = json.loads(budget.read_text(encoding="utf-8"))
    assert "unit" in data.get("suites", {}), f"no unit suite in {budget} — the plant would prove nothing"
    data["suites"]["unit"]["baseline_pct"] = 99.9
    budget.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    breached, output = run([str(target / CLI_NAME), "test", "coverage"], cwd=target)

    return Result(
        "coverage: `test coverage` measures, and a breach is reported",
        breached != 0,
        time.time() - started,
        "" if breached else "a baseline raised to 99.9% still exited 0 — the checker's result is discarded",
    )


def dirty_scope_gate(workdir: Path) -> Result:
    """Only dirt a render reads refuses an upgrade; the rest is not the tool's business.

    The guard counted every uncommitted file in the base checkout, including
    untracked ones. The justification was always narrower than the code — the
    scaffolder walks `template/`, so an untracked file *there* is rendered into
    the base and is exactly as absent from history — and applying it to the whole
    repository meant one untracked `notes.md` at this repo's root refused every
    adopter in a five-repository round. Two cloned at a tag to get past it and
    two more were warned off. Nothing in that file can reach a render.

    Both directions, on the same clone, because the guard is only useful if it
    still refuses: an untracked file under `template/` must refuse, which is
    proto.pilot's `ci.yml` case and the reason the guard exists at all.

    Untracked plants specifically, so cleanup is an unlink and the shared clone
    other gates reuse is left exactly as found.
    """
    started = time.time()
    clean = clean_skeletor(workdir)
    target = workdir / "dirty-scope" / "probe"
    if not target.exists():
        code, output = run(
            [sys.executable, str(clean / "bin" / "skeletor-new"), str(target),
             "--name", "Probe", "--cli", CLI_NAME, "--tagline", "t", "--tier", "core", "--force"],
            cwd=SKELETOR,
        )
        if code != 0:
            return Result("dirty scope: scaffold", False, time.time() - started, output)

    problems = []
    for rel, reaches in ((Path("scope-probe-notes.md"), False), (Path("template") / "core" / "scope-probe.txt", True)):
        plant = clean / rel
        assert not plant.exists(), f"{rel} already exists in the clone — the plant would prove nothing"
        plant.write_text("planted\n", encoding="utf-8")
        try:
            code, output = run(
                [sys.executable, str(clean / "bin" / "skeletor-upgrade"), str(target), "--dry-run",
                 "--from-dir", str(clean)],
                cwd=target,
            )
        finally:
            plant.unlink()
        refused = "uncommitted change" in output
        if refused != reaches:
            problems.append(
                f"an untracked {rel} {'was not' if reaches else 'was'} treated as reaching a render"
                + (" — the guard has stopped catching the case it exists for" if reaches else
                   " — dirt a render cannot read is refusing adopters")
            )
        if reaches and code == 0:
            problems.append(f"a dirty {rel} exited 0; the base is unreproducible and must refuse")

    return Result(
        "dirty scope: an untracked file under template/ refuses, one at the root does not",
        not problems,
        time.time() - started,
        "\n".join(problems),
    )


def manifest_args_gate() -> Result:
    """Every render-affecting flag reaches `.skeletor.json` by existing.

    `write_manifest` used a hand-written list of fourteen flags, and it went
    stale the way Rule 2 says a registry does: `--versioning` arrived, changed
    what ships, and was never added. Every `--versioning tag` tree recorded
    arguments that re-render as a release-please tree, so `cross_check` refused
    on four wrong hashes and three unrecorded files and the tree was
    **permanently unupgradable** — `--repair-manifest` included, since it
    re-derives from that same wrong base. Release-please trees were unaffected
    only because the default happened to match.

    The record is derived from the parser now, so this gate guards the one list
    that is left: `NOT_RENDERED`, the flags deliberately excluded. Both
    directions, because an exemption is checked against the thing it exempts —
    a declared flag that is neither recorded nor exempt is the original bug, and
    an exempt name that is no longer a flag is an exemption nobody chose,
    waiting to pre-exempt whatever claims that name next.

    The scan proves itself **differentially** rather than against a floor. The
    flags are read twice — out of `parser._actions` and out of the usage line
    the parser prints — and the two sets must be equal. A floor cannot tell a
    working scan from a mostly-blind one: proto.pilot's first pass at this
    counted the manifest list by reading to the first `]`, got 1 of 14, reported
    16 missing flags, and its `assert recorded` non-vacuity check passed,
    because one is not zero. Two independent readings disagreeing is a fact
    about the reading; one reading clearing a bar is a fact about the bar.
    """
    started = time.time()
    scaffolder = load_scaffolder()
    parser = scaffolder.build_parser()
    declared = {a.dest: a.option_strings[0] for a in parser._actions if a.option_strings and a.dest != "help"}

    usage = io.StringIO()
    parser.print_usage(usage)
    printed = set(re.findall(r"--[\w-]+", usage.getvalue())) - {"--help"}

    # `--tagline` is required, so the probe must supply it: this gate asks what
    # the parser declares, not what a caller may omit.
    args = parser.parse_args(["probe", "--tagline", "t"])
    recorded = set(scaffolder.manifest_args(args, scaffolder.substitutions(args))[::2])

    problems = []
    if printed != set(declared.values()):
        problems.append(
            f"the two readings of the flag set disagree: introspection {sorted(declared.values())}, "
            f"usage line {sorted(printed)} — one of them is blind, so nothing below means anything"
        )
    missing = sorted(opt for dest, opt in declared.items() if opt not in recorded and dest not in scaffolder.NOT_RENDERED)
    if missing:
        problems.append(
            f"{missing} are declared but never recorded, and are not in NOT_RENDERED. A tree "
            "scaffolded with one of them records arguments that re-render as a different tree, "
            "so cross_check refuses and the tree can never be upgraded."
        )
    stale = sorted(dest for dest in scaffolder.NOT_RENDERED if dest not in declared)
    if stale:
        problems.append(
            f"NOT_RENDERED exempts {stale}, which {'is' if len(stale) == 1 else 'are'} no longer a "
            "flag. Delete the entry: the name can come back for something else and would arrive "
            "pre-exempted."
        )
    recorded_but_exempt = sorted(declared[dest] for dest in scaffolder.NOT_RENDERED if dest in declared and declared[dest] in recorded)
    if recorded_but_exempt:
        problems.append(f"{recorded_but_exempt} are exempt from recording and recorded anyway")

    return Result(
        f"manifest args: {len(recorded)} of {len(declared)} flags recorded, {len(scaffolder.NOT_RENDERED)} exempt",
        not problems,
        time.time() - started,
        "\n".join(problems),
    )


def pending_ref_gate(workdir: Path) -> List[Result]:
    """A run that leaves a conflict does not advance the manifest past it.

    The manifest is a single-version snapshot — `cross_check` requires its
    hashes to be exactly the render at `skeletor_ref` — and a run that applies
    some files while refusing others leaves a tree that is not at one version.
    Copying the head manifest regardless recorded the head render's hash for a
    file the head render never reached, so the next run took that change as
    already in the base, the base→ours diff no longer contained it, and it was
    **never offered again**. Silent, permanent, and green in every gate.

    stash.flow reported it from a real upgrade and this gate reproduces it: a
    conflict on one file, four others applied, the ref advanced, and the second
    run answering "already current — nothing to carry over" about a change that
    had never been made. They had ported theirs by hand, from sidecars they
    happened to have already read — which is luck, not process, since `tmp/` is
    gitignored and the next real run clears it.

    Every other upgrade gate here runs against a fresh scaffold, where the
    answer is "already current" and the conflict branch is never reached;
    `sidecar_gate` manufactures the skew with `--no-base`, which cannot produce
    this one, because under that flag a fresh scaffold matches every recorded
    hash and nothing applies. **The manifest only moves when something applied
    AND something did not** — so this needs a real version gap and a real
    conflicting edit, and that combination is why the bug lived.

    The plant is derived rather than written: the same configuration is
    scaffolded at the tag and at HEAD, the first line that differs between a
    file's two renders is the line the template is about to change, and the tree
    gets a third value there. That is a conflict by construction at whatever the
    two versions happen to disagree about, instead of a quotation from one
    release that goes stale at the next.
    """
    started = time.time()
    scaffolder = load_scaffolder()
    tier = max(scaffolder.TIERS, key=lambda name: len(scaffolder.TIERS[name]))
    language = max(scaffolder.LANGUAGE_OVERLAYS, key=lambda name: len(scaffolder.LANGUAGE_OVERLAYS[name].split(",")))

    tags = run(["git", "-C", str(SKELETOR), "tag", "--sort=-creatordate"], cwd=SKELETOR)[1].split()
    candidates = [
        tag
        for tag in tags
        if run(["git", "-C", str(SKELETOR), "diff", "--quiet", tag, "HEAD", "--", "template/"], cwd=SKELETOR)[0] != 0
    ]
    if not candidates:
        why = "no tags are visible at all — a shallow clone?" if not tags else "no tag differs from HEAD under template/"
        return [Result(f"pending ref: {why}", False, time.time() - started, f"{len(tags)} tag(s) visible")]

    clean = clean_skeletor(workdir)
    # Both trees take the SAME final path component, because `--slug`,
    # `--cli` and `--env-prefix` all default from it — and the plant below is
    # derived by diffing the two renders. Scaffolded into differently-named
    # directories, the first differing line is `name: <dir>-documenter`, which
    # differs for a reason that has nothing to do with the template version, and
    # a plant there conflicts against an artefact of this gate's own workdir
    # layout. The convenient site could not discriminate; that was measured, by
    # watching it pick exactly that line for all 38 tags.
    head_tree = workdir / "pending-head" / "probe"
    if not head_tree.exists():
        run(
            [sys.executable, str(clean / "bin" / "skeletor-new"), str(head_tree),
             "--name", "Probe", "--cli", CLI_NAME, "--tagline", "t",
             "--tier", tier, "--language", language, "--force"],
            cwd=SKELETOR,
        )

    attempts: List[str] = []
    for index, tag in enumerate(candidates):
        old_checkout = workdir / f"pending-base-{index}"
        code, output = run(
            ["git", "-C", str(SKELETOR), "worktree", "add", "--detach", str(old_checkout), tag], cwd=SKELETOR
        )
        if code != 0:
            return [Result(f"pending ref: check out {tag}", False, time.time() - started, output)]
        try:
            target = workdir / f"pending-scaffold-{index}" / "probe"
            run(
                [sys.executable, str(old_checkout / "bin" / "skeletor-new"), str(target),
                 "--name", "Probe", "--cli", CLI_NAME, "--tagline", "t",
                 "--tier", tier, "--language", language, "--force"],
                cwd=SKELETOR,
            )

            # Derive the plant: a file both versions ship whose text differs.
            planted = None
            for rel in sorted(p.relative_to(target).as_posix() for p in target.rglob("*.md")):
                old_file, new_file = target / rel, head_tree / rel
                if not new_file.exists():
                    continue
                old_lines = old_file.read_text(encoding="utf-8").splitlines(keepends=True)
                new_lines = new_file.read_text(encoding="utf-8").splitlines(keepends=True)
                differing = [
                    i for i in range(min(len(old_lines), len(new_lines)))
                    if old_lines[i] != new_lines[i] and old_lines[i].strip()
                ]
                if not differing:
                    continue
                at = differing[0]
                old_lines[at] = "A THIRD VALUE, BELONGING TO NEITHER RENDER\n"
                old_file.write_text("".join(old_lines), encoding="utf-8")
                planted = (rel, at)
                break
            if planted is None:
                attempts.append(f"{tag}: no shipped markdown file differs between the two renders")
                continue

            # Committed, or the upgrade refuses the tree as dirty and every
            # assertion below is about a run that never happened. The first
            # draft of this gate was red for exactly that, on all 38 tags.
            run(["git", "-C", str(target), "add", "-A"], cwd=target)
            run(["git", "-C", str(target), "commit", "-q", "-m", "planted edit"], cwd=target)

            manifest = target / scaffolder.MANIFEST_NAME
            before = json.loads(manifest.read_text(encoding="utf-8"))["skeletor_ref"]
            _, first = run([sys.executable, str(clean / "bin" / "skeletor-upgrade"), str(target)], cwd=target)
            after = json.loads(manifest.read_text(encoding="utf-8"))["skeletor_ref"]
            _, second = run(
                [sys.executable, str(clean / "bin" / "skeletor-upgrade"), str(target), "--dry-run"], cwd=target
            )
            # `--ported` is warranted in exactly this state and no other — and
            # this state is dirty, because the run above wrote every file it
            # could apply. Nothing is committed between the two runs on
            # purpose: committing is what a careful reader does to get past the
            # refusal, and it is the record corruption the rest of this tool
            # exists to prevent, so a gate that commits here arranges away the
            # bug. The instruction said "port them, then re-run"; a plain
            # re-run cannot advance anything, since a hand-ported file
            # conflicts exactly like an unapplied one.
            _, ported = run(
                [sys.executable, str(clean / "bin" / "skeletor-upgrade"), str(target), "--ported"], cwd=target
            )
            ported_ref = json.loads(manifest.read_text(encoding="utf-8"))["skeletor_ref"]
        finally:
            run(["git", "-C", str(SKELETOR), "worktree", "remove", "--force", str(old_checkout)], cwd=SKELETOR)

        rel, at = planted
        conflicted = "LEFT ALONE" in first
        applied = "added" in first or "updated" in first
        attempts.append(f"{tag}: planted {rel}:{at + 1}, conflicted={conflicted}, applied={applied}")
        if not (conflicted and applied):
            # Neither outcome is this gate's subject: with nothing applied the
            # manifest was never going to move, and with nothing conflicted
            # there is nothing it could move past. Try the next tag.
            continue

        problems = []
        if before != after:
            problems.append(
                f"the manifest advanced {before} → {after} while {rel} was left alone, so the "
                "template's change to it is now recorded as this tree's base"
            )
        if "already current" in second:
            problems.append(
                f"the second run reports 'already current' — the pending change to {rel} was "
                "silently dropped rather than re-offered"
            )
        if "have uncommitted changes" in ported:
            problems.append(
                "--ported was refused for a dirty tree, which the flow that warrants it "
                "guarantees: the run above wrote every file it applied. The escape it names "
                "(--allow-dirty) describes in-progress edits of your own, and there are none"
            )
        elif ported_ref == before:
            problems.append(
                f"--ported left the manifest at {before}; the flag exists to advance it once "
                "the pending files are resolved, and without it the base can never move past "
                "a permanently diverged file"
            )
        return [
            Result(
                f"pending ref: a conflict holds the manifest at {before}, --ported moves it to {ported_ref}",
                not problems,
                time.time() - started,
                "\n".join(problems) or f"tried: {'; '.join(attempts)}",
            )
        ]

    return [
        Result(
            "pending ref: no tagged release produces both an applied file and a conflict",
            False,
            time.time() - started,
            "\n".join(attempts),
        )
    ]


def dirty_ref_gate(workdir: Path) -> List[Result]:
    """A `-dirty` scaffold ref clears on the first upgrade that applies anything.

    `skeletor-upgrade` told users this was permanent. It is not, and the wrong
    claim shipped for the ordinary reason: it was written from the one case that
    had been exercised — a `cross_check` refusal, where nothing is written and so
    nothing clears — and generalised to every case. proto.pilot measured a tree
    going `v0.2.0-dirty` to a clean tag across a single upgrade and reported it.

    The scaffold is deliberately dirtied **outside `template/`**, which is the
    whole point: an uncommitted edit to a shipped file is a genuinely
    unreproducible base and `cross_check` refuses it, so that path can never
    reach the manifest rewrite. Only an edit to something the scaffold does not
    ship produces a `-dirty` ref that is safe to move past — and that is exactly
    the case nobody had run.

    A version gap is needed too, since the manifest is only rewritten when the
    upgrade applies something — and *which* tag provides one is measured rather
    than predicted. "Its `template/` differs from HEAD" was the whole selector
    once, and it is a broader question than this gate needs: a `core` scaffold
    ships none of `template/governed/`, so a release that moved only that is a
    version gap the tree cannot see. The upgrade was then correctly a no-op and
    the gate went red on a true statement about the wrong scenario — this
    repository's own recurring failure, in the gate for a report about it.

    So the scaffold is the fullest configuration, read from the scaffolder's own
    maps, which makes nearly every template change a shipped one; and each
    candidate tag is tried until one actually applies something, which is what
    makes that "nearly" harmless rather than load-bearing. Running out of
    candidates is a loud failure naming what it tried, never a silent pass.
    """
    started = time.time()
    scaffolder = load_scaffolder()
    tier = max(scaffolder.TIERS, key=lambda name: len(scaffolder.TIERS[name]))
    language = max(scaffolder.LANGUAGE_OVERLAYS, key=lambda name: len(scaffolder.LANGUAGE_OVERLAYS[name].split(",")))

    tags = run(["git", "-C", str(SKELETOR), "tag", "--sort=-creatordate"], cwd=SKELETOR)[1].split()
    # A cheap pre-filter, not the decision: a tag whose template is identical to
    # HEAD's cannot possibly apply anything, so it is not worth a scaffold.
    candidates = [
        tag
        for tag in tags
        if run(["git", "-C", str(SKELETOR), "diff", "--quiet", tag, "HEAD", "--", "template/"], cwd=SKELETOR)[0] != 0
    ]
    if not candidates:
        # Loudly, never silently: no tag differs from HEAD under `template/`, so
        # there is no version gap to upgrade across and this gate cannot run.
        #
        # And say *which* nothing it found. An empty tag list is a shallow clone,
        # not a repository without releases — `actions/checkout` fetches neither
        # tags nor history by default, which is how this failed on CI for three
        # releases while passing here. "Looked and saw nothing" and "could not
        # see" are the same red until the message separates them.
        why = "no tags are visible at all — a shallow clone?" if not tags else "no tag differs from HEAD under template/"
        return [Result(f"dirty ref: {why}", False, time.time() - started, f"{len(tags)} tag(s) visible")]

    clean = clean_skeletor(workdir)
    attempts: List[str] = []
    results: List[Result] = []
    for index, tag in enumerate(candidates):
        old_checkout = workdir / f"dirty-base-{index}"
        code, output = run(
            ["git", "-C", str(SKELETOR), "worktree", "add", "--detach", str(old_checkout), tag], cwd=SKELETOR
        )
        if code != 0:
            return [Result(f"dirty ref: check out {tag}", False, time.time() - started, output)]
        try:
            # Dirty, but nothing the scaffold ships — see the docstring.
            marker = old_checkout / "bin" / "skeletor-verify"
            marker.write_text(marker.read_text(encoding="utf-8") + "\n# scratch\n", encoding="utf-8")

            target = workdir / f"dirty-scaffold-{index}"
            run(
                [sys.executable, str(old_checkout / "bin" / "skeletor-new"), str(target),
                 "--name", "Probe", "--cli", CLI_NAME, "--tagline", "t",
                 "--tier", tier, "--language", language, "--force"],
                cwd=SKELETOR,
            )
            manifest = target / scaffolder.MANIFEST_NAME
            before = json.loads(manifest.read_text(encoding="utf-8"))["skeletor_ref"]

            # From a CLONE, because an upgrade now refuses a dirty skeletor — and
            # this checkout is dirty whenever somebody is working in it. That is not
            # a workaround: a user upgrading from a clean skeletor is the condition
            # being tested, and running it from here would test the refusal instead.
            _, upgrade_output = run([sys.executable, str(clean / "bin" / "skeletor-upgrade"), str(target)], cwd=target)
            after = json.loads(manifest.read_text(encoding="utf-8"))["skeletor_ref"]
            applied = upgrade_applied(target, scaffolder.MANIFEST_NAME)
        finally:
            run(["git", "-C", str(SKELETOR), "worktree", "remove", "--force", str(old_checkout)], cwd=SKELETOR)

        attempts.append(f"{tag}: the upgrade applied {len(applied)} file(s)")
        if applied:
            results = [
                Result(
                    "dirty ref: clears on the first upgrade that applies anything",
                    before.endswith("-dirty") and not after.endswith("-dirty"),
                    time.time() - started,
                    f"tried: {'; '.join(attempts)}\n"
                    f"a {tier}/{language} scaffold upgraded across {tag}, applying {len(applied)} file(s)\n"
                    f"scaffolded at: {before}\nafter upgrade: {after}\n{upgrade_output}",
                )
            ]
            break
    if not results:
        return [
            Result(
                "dirty ref: no tagged release changes anything this scaffold ships",
                False,
                time.time() - started,
                "\n".join(attempts),
            )
        ]

    # And the guard that makes the above the only outcome. Two properties,
    # not one: the assertion above passes with the guard removed, because it
    # upgrades from a clean clone by construction. Planting proved that —
    # the gate was written for the claim and assumed it covered the refusal.
    #
    # The clone is dirtied here rather than testing this checkout, which is
    # dirty only when somebody happens to be working in it. A gate that
    # passes or fails on that is not a gate.
    started = time.time()
    # Cloned from the CLEAN clone, not from this checkout, so it inherits the
    # working tree under test rather than the last commit. Cloning SKELETOR
    # here is what made this assertion pass on a guard that had not been
    # written yet — the same mistake, in the gate for the mistake.
    dirty_clone = workdir / "skeletor-dirtied"
    run(["git", "clone", "--quiet", "--no-hardlinks", str(clean), str(dirty_clone)], cwd=workdir)
    shipped = dirty_clone / "template" / "core" / "AGENTS.md"
    shipped.write_text(shipped.read_text(encoding="utf-8") + "\n<!-- uncommitted -->\n", encoding="utf-8")

    second = workdir / "dirty-scaffold-refusal"
    run(
        [sys.executable, str(clean / "bin" / "skeletor-new"), str(second),
         "--name", "Probe", "--cli", CLI_NAME, "--tagline", "t", "--force"],
        cwd=SKELETOR,
    )
    code, refused = run([sys.executable, str(dirty_clone / "bin" / "skeletor-upgrade"), str(second)], cwd=second)
    dry_code, _ = run(
        [sys.executable, str(dirty_clone / "bin" / "skeletor-upgrade"), str(second), "--dry-run"], cwd=second
    )
    results.append(
        Result(
            "dirty ref: an upgrade from a dirty skeletor is refused, but --dry-run is not",
            code == 1 and "uncommitted change" in refused and dry_code != 1,
            time.time() - started,
            f"real run exit {code}, dry-run exit {dry_code}\n{refused}",
        )
    )
    return results


#: Path components that name a machine or a hosting convention rather than a
#: person or an organisation, so `author_leak_gate` does not treat them as
#: identifying. Not an exemption list — nothing is being excused. It is the
#: definition of the token population, and every entry is a word a CI runner or
#: a filesystem layout supplies for reasons that have nothing to do with who
#: wrote the template. `runner` and `work` are here because GitHub checks out to
#: `/home/runner/work/<repo>/<repo>`, and without them this gate would derive
#: two tokens on CI that appear all over any tree that mentions Actions.
GENERIC_PATH_WORDS = {
    "code", "data", "dev", "git", "home", "local", "media", "mnt", "opt", "projects", "repos", "root",
    "run", "runner", "src", "srv", "tmp", "usr", "users", "var", "work", "workspace",
}


def author_tokens() -> List[str]:
    """Who this checkout belongs to, as strings a render must not contain.

    Derived from the machine and the remote, never listed: the directories above
    this checkout, the home directory's name, the owner in `origin`'s URL, and
    the local part of the committer's email. Anything identifying is in at least
    one of those by construction, which is what makes this a population rather
    than a list of the leaks somebody already found.

    Comparison is on alphanumerics only, both sides, so `skyrow.labs`,
    `skyrow-labs` and `skyrowlabs` are one token. The checkout's own name is
    excluded — a scaffold says `skeletor` all over, correctly.
    """
    raw = {Path.home().name}
    raw.update(part for part in SKELETOR.resolve().parts if part != SKELETOR.name)
    origin = run(["git", "-C", str(SKELETOR), "remote", "get-url", "origin"], cwd=SKELETOR)[1].strip()
    match = re.search(r"[/:]([^/:]+)/[^/]+?(?:\.git)?$", origin)
    if match:
        raw.add(match.group(1))
    email = run(["git", "-C", str(SKELETOR), "config", "user.email"], cwd=SKELETOR)[1].strip()
    if "@" in email:
        raw.add(email.split("@", 1)[0])
    tokens = {
        re.sub(r"[^a-z0-9]", "", word.lower())
        for word in raw
        if word.lower() not in GENERIC_PATH_WORDS and word not in ("/", "")
    }
    return sorted(token for token in tokens if len(token) >= 4)


def author_leak_gate(tier: str, workdir: Path) -> Result:
    """A rendered tree names nobody's home directory, company or account.

    `template/core/scripts/paths.py` shipped `Path.home() / "skyrow.labs" /
    "sl-agent-logs"` as the default state root, in the tier every scaffold gets.
    Five adopters ran it and none could see it: all five live under
    `~/skyrow.labs`, so the default resolves, the state lands where it should,
    and every gate passes. **The trees best placed to report it are the ones
    that agree with it by construction.**

    The same homogeneity would hide a bad fix, which is node-zero's point and
    the reason this gate exists rather than a second inspection: in a tree under
    `~/skyrow.labs`, a correct substitution and a hardcoded literal produce the
    same string, so verifying there is vacuous. The outside coordinate has to be
    manufactured, and the only one available is the render itself, read by
    something that knows whose machine it was made on.

    stash.flow drew the line the shipped test cannot cross: `test_state_paths.py`
    enforces that the root is named in exactly one place, which is a good rule
    and is silent on whether that one place is right. **One definition and one
    correct definition are different properties, and only the first is checkable
    from inside.**

    What it does not claim: initials. `SL_AGENT_LOGS` leaked the same
    organisation in a form no derivation from `skyrow.labs` produces without
    guessing, and a gate that guessed would be a list again. That half is
    covered by the fix rather than by a check, and saying so is better than
    implying otherwise.
    """
    started = time.time()
    tokens = author_tokens()
    if not tokens:
        return Result(
            "author leak: no identifying token could be derived from this checkout",
            False,
            time.time() - started,
            "Nothing above the checkout, in origin's URL or in the committer's email survived "
            f"{sorted(GENERIC_PATH_WORDS)}. A scan for an empty token set is green and worth nothing.",
        )

    def leaks(text: str) -> List[str]:
        flat = re.sub(r"[^a-z0-9]", "", text.lower())
        return [token for token in tokens if token in flat]

    # The plant, and it is about the matcher rather than the tree: a detector
    # that found nothing is indistinguishable from one that cannot find
    # anything. Both halves are checked, because a normaliser that stripped too
    # much would match everything and this would still pass on the first.
    if not leaks(f"root = Path.home() / \"{tokens[0][:3]}.{tokens[0][3:]}\" / \"logs\""):
        return Result("author leak: the detector does not find a planted token", False, time.time() - started, "")
    if leaks("a tree that names nobody"):
        return Result("author leak: the detector fires on text naming nobody", False, time.time() - started, "")

    tree = workdir / f"{tier}-python"
    if not tree.exists():
        return Result(f"author leak: no {tier} tree to read", False, time.time() - started, "")

    findings = []
    for path in sorted(tree.rglob("*")):
        rel = path.relative_to(tree).as_posix()
        if not path.is_file() or rel.startswith((".git/", ".venv/", "node_modules/", "tmp/")):
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        for number, line in enumerate(text.splitlines(), 1):
            for token in leaks(line):
                findings.append(f"{rel}:{number} names `{token}`: {line.strip()[:90]}")

    return Result(
        f"author leak: nothing in the {tier} tree names {', '.join(tokens)}",
        not findings,
        time.time() - started,
        "\n".join(findings[:20]),
    )


def adopted_repo_gate(tier: str, workdir: Path, venv_python: Path) -> List[Result]:
    """A scaffold into a repository somebody already works in is not red on arrival.

    Every other tree here is scaffolded into a directory with no `.git`, where
    the scaffolder inits and commits — so the tree is tracked by the time
    anything reads it. `--force` into an existing repository is the case
    `AGENTS.md` calls *the usual case*, and there the scaffolder deliberately
    does not commit: the commit is the adopter's to make.

    The render was then left **untracked**, and three of the tests it had just
    shipped were red on arrival. `tests/repo_files.py` enumerates with `git
    ls-files` on purpose — a walk reads `.venv/.../pyright/dist/README.md` and
    makes the verdict depend on what the dependency tree happens to ship — so
    the scanners found nothing and their empty-scope guards fired, correctly.
    The closing advice ends with `check pre-push`, which is the command that
    fails: the tool's last word was an instruction to run the thing it had just
    broken.

    It survived four tags partly because `--dry-run` looks like it addressed
    this. It does not, and the distinction is node-zero's: that flag is about
    **collisions at the moment of writing**; this is about the render being
    **untracked afterwards**. Two moments in one command, and the first one
    landing made the second look handled.

    The plant is the second assertion and it is what makes the first mean
    anything: unstage, and the same suites must go red. Otherwise this gate
    passes on a tree that was green for some other reason and would keep passing
    if the staging were deleted.
    """
    started = time.time()
    scaffolder = load_scaffolder()
    target = workdir / "adopted-repo"
    if target.exists():
        shutil.rmtree(target)
    target.mkdir(parents=True)
    run(["git", "init", "-q", "-b", "main", "."], cwd=target)
    (target / "README.md").write_text("# Theirs\n\nfrom before.\n", encoding="utf-8")
    run(["git", "-C", str(target), "add", "-A"], cwd=target)
    run(["git", "-C", str(target), "commit", "-q", "-m", "pre-existing"], cwd=target)
    # Work in progress, deliberately left unstaged. node-zero planted for this
    # and the reason is that **file counts are identical whether or not `git add
    # -A` was used, unless something unstaged exists to be swept** — so both
    # remedies proposed for this bug would have co-opted an adopter's own work
    # into a changeset labelled as the scaffold's, and every count anybody
    # verified would have looked the same under either.
    (target / "mine.txt").write_text("work in progress\n", encoding="utf-8")

    code, output = run(
        [sys.executable, str(SKELETOR / "bin" / "skeletor-new"), str(target), "--allow-dirty",
         "--name", "Probe", "--cli", CLI_NAME, "--tagline", "t", "--tier", tier, "--language", "python", "--force"],
        cwd=SKELETOR,
    )
    if code != 0:
        return [Result("adopted repo: the scaffold failed", False, time.time() - started, output)]

    produced = set(json.loads((target / scaffolder.MANIFEST_NAME).read_text(encoding="utf-8"))["files"])
    listed = set(run(["git", "-C", str(target), "ls-files"], cwd=target)[1].split())
    untracked = sorted(produced - listed)

    # Asked of git rather than recomputed from `produced`, which would be two
    # readings of one expression and green whatever it said. This is the
    # coordinate outside the scaffolder's own idea of what it wrote — and it is
    # the assertion that would have caught `.skeletor.json`, which cannot be in
    # its own `files` list and so was staged by neither half of the set.
    loose = sorted(run(["git", "-C", str(target), "ls-files", "--others", "--exclude-standard"], cwd=target)[1].split())

    results = [
        Result(
            f"adopted repo: all {len(produced)} produced file(s) are tracked",
            not untracked,
            time.time() - started,
            "\n".join(untracked[:20]) or "",
        ),
        Result(
            "adopted repo: what is left untracked is the adopter's file and nothing else",
            loose == ["mine.txt"],
            0.0,
            # One assertion, two facts, no allowlist: anything else left behind
            # is skeletor's and was not staged, and a missing `mine.txt` means it
            # was swept into the staged set with everything the tool wrote.
            "expected exactly ['mine.txt'] — the planted work in progress, untouched — and got:\n"
            + "\n".join(loose[:20]) if loose != ["mine.txt"] else "",
        ),
    ]

    # The suite the enumeration feeds, run for real. `-p no:cacheprovider` so a
    # `.pytest_cache` does not appear in the tree between the two runs below and
    # make the plant's difference ambiguous.
    suite = ["-m", "pytest", "-q", "-p", "no:cacheprovider",
             "tests/test_docs_name_real_paths.py", "tests/test_setup_blocks_agree.py"]
    green, green_out = run([str(venv_python), *suite], cwd=target)
    results.append(
        Result("adopted repo: the suites that enumerate through git pass", green == 0, 0.0, green_out[-1500:])
    )

    run(["git", "-C", str(target), "reset", "-q"], cwd=target)
    red, red_out = run([str(venv_python), *suite], cwd=target)
    results.append(
        Result(
            "adopted repo: unstaged, those same suites go red",
            red != 0,
            0.0,
            "They passed with the render unstaged, so staging is not what makes them green and "
            f"this gate proves nothing:\n{red_out[-1000:]}" if red == 0 else "",
        )
    )
    return results


def scaffold_dirt_gate(workdir: Path) -> List[Result]:
    """The door that writes the record refuses a render nobody can reproduce.

    `bin/skeletor-upgrade` has refused a dirty base since `5230a7c`.
    `bin/skeletor-new` — the door that *creates* `.skeletor.json` — had no guard
    at all, and the scaffold end is the worse of the two:

    * the upgrade refuses before writing; the scaffold writes first, and the
      adopter commits the result in their own first commit;
    * the upgrade's damage is a wasted run; the scaffold's is a file in somebody
      else's git history;
    * an **untracked** render input left `git describe --dirty` clean, so the
      poisoned tree recorded an ordinary-looking ref and carried no sign a dirty
      checkout was ever involved. `cross_check` then refused every later
      upgrade, permanently, for a different person in a different tree.

    stash.flow reproduced all three properties; skyrow-workspace's trace opened
    it by following `skeletor_ref()` backwards from the write. `reaches_a_render`
    had said its own scoping was *"the one already accepted for the scaffold end
    of the same pipe"* — **the justification had travelled and the mechanism had
    not**, which is this repository's own recurring failure one file over.

    Three assertions, and the third is the one that makes the first two worth
    having: the untracked plant must be *recorded as dirty*. Refusing is easy to
    satisfy; the property that cost a manifest is that `--allow-dirty` leaves a
    trace instead of a silence, and git alone cannot supply it.
    """
    started = time.time()
    scaffolder = load_scaffolder()
    tier = min(scaffolder.TIERS, key=lambda name: len(scaffolder.TIERS[name]))
    clean = clean_skeletor(workdir)
    scratch = workdir / "scaffold-dirt-skeletor"
    if not scratch.exists():
        run(["git", "clone", "--quiet", "--no-hardlinks", str(clean), str(scratch)], cwd=workdir)

    def scaffold(name: str, *extra: str) -> Tuple[int, str, Path]:
        tree = workdir / name / "probe"
        if tree.exists():
            shutil.rmtree(tree.parent)
        code, output = run(
            [sys.executable, str(scratch / "bin" / "skeletor-new"), str(tree),
             "--name", "Probe", "--cli", CLI_NAME, "--tagline", "t",
             "--tier", tier, "--language", "python", *extra],
            cwd=SKELETOR,
        )
        return code, output, tree

    # Untracked, under an overlay this tier actually selects — stash.flow
    # measured that an unselected overlay is neither rendered nor recorded, so a
    # plant there would be refused for a hazard that cannot occur and would
    # prove nothing about the one that can.
    plant = scratch / "template" / tier / "ZZ_PLANT.md"
    plant.write_text("planted: untracked, rendered, recorded\n", encoding="utf-8")
    try:
        refused, output, _ = scaffold("scaffold-dirt-refused")
        allowed, allowed_output, tree = scaffold("scaffold-dirt-allowed", "--allow-dirty")
        ref = ""
        manifest = tree / scaffolder.MANIFEST_NAME
        if manifest.exists():
            ref = str(json.loads(manifest.read_text(encoding="utf-8"))["skeletor_ref"])
    finally:
        plant.unlink()

    clean_code, clean_output, _ = scaffold("scaffold-dirt-clean")

    return [
        Result(
            "scaffold dirt: an untracked render input refuses the scaffold",
            refused != 0 and "reach what it renders" in output,
            time.time() - started,
            output[-800:],
        ),
        Result(
            "scaffold dirt: --allow-dirty scaffolds and says what it recorded",
            allowed == 0 and "--allow-dirty" in allowed_output,
            0.0,
            allowed_output[-600:],
        ),
        Result(
            f"scaffold dirt: the recorded ref says -dirty where git would not ({ref or 'no manifest'})",
            ref.endswith("-dirty"),
            0.0,
            "git describe is untracked-blind, so without this the poisoned tree records an "
            f"ordinary ref and nothing in it says a dirty checkout was involved. Recorded: {ref!r}",
        ),
        Result(
            "scaffold dirt: a clean checkout is not refused",
            clean_code == 0 and "reach what it renders" not in clean_output,
            0.0,
            clean_output[-400:],
        ),
    ]


def dirty_signals_gate(workdir: Path) -> List[Result]:
    """The dirt a run reports, and the checkout it names, are both measured.

    Two defects with one shape, found by two trees in one evening.

    **The provisional note keyed on `git describe --dirty`.** That predicate is
    untracked-blind and repo-wide — precisely the two properties
    `reaches_a_render` was written to remove, after one untracked `notes.md` at
    this repository's root refused every adopter in a five-repository round —
    and it re-entered through a version string. stash.flow measured both
    directions: a tracked edit to `docs/`, which no render can read, printed
    *"includes uncommitted template edits"* when there were none; and an
    untracked file under `template/`, which a render really does read, printed
    nothing at all, not even the `-dirty` suffix the rationale had called the
    only signal. Too large in one direction and too small in the other, from one
    wrong predicate.

    The tell generalises past this: **the guard was derived from the text of the
    line rather than from the claim the line makes.** `head_ref` was already in
    that sentence, so reaching for it cost nothing and read as consistent.

    **And the dirty-checkout warning hardcoded "the base checkout"** while two
    different checkouts reach it — the base at `:912`, the renderer at `:948`,
    which are different trees whenever the base is a worktree at a tag. node-zero
    printed the contradiction in one invocation: their dirty `bin/skeletor-new`
    named as "the base checkout" three lines above a sentence that had to say
    *"the checkout that rendered this"* in order to be true.

    So the third case here is the one where base and renderer are genuinely
    different trees, because that is the only configuration in which the noun
    can be wrong — every other gate runs them as one directory, where a
    hardcoded name is indistinguishable from a correct one.

    A limit this gate stated was wrong and is kept as a correction. It said the
    pair *already current* **and** *provisional* was only reachable with
    render-reaching dirt that changes no rendered byte, because an untracked
    file under `template/` reaches the render by *adding* a file. False:
    `RENDER_INPUTS` matches `template/` at its **root**, and the root is not an
    overlay source — `copy_overlay` runs per overlay — so `template/ZZ_PLANT.md`
    is render-reaching and renders nothing, and one `echo >` produces all three
    lines. **A documented limit is read as a fact about the tool, and that one
    was a fact about the fixture I had tried.** stash.flow found it by planting
    the case I had written off; it is also the cheaper fixture, editing no
    tracked file and leaving the shared clone exactly as found.
    """
    started = time.time()
    scaffolder = load_scaffolder()
    tier = min(scaffolder.TIERS, key=lambda name: len(scaffolder.TIERS[name]))
    clean = clean_skeletor(workdir)
    scratch = workdir / "dirty-signals-skeletor"
    if not scratch.exists():
        run(["git", "clone", "--quiet", "--no-hardlinks", str(clean), str(scratch)], cwd=workdir)

    def scaffold_from(checkout: Path, name: str) -> Path:
        tree = workdir / name / "probe"
        if tree.exists():
            shutil.rmtree(tree.parent)
        run(
            [sys.executable, str(checkout / "bin" / "skeletor-new"), str(tree),
             "--name", "Probe", "--cli", CLI_NAME, "--tagline", "t",
             "--tier", tier, "--language", "python", "--force"],
            cwd=SKELETOR,
        )
        return tree

    def report(tree: Path, *extra: str) -> str:
        return run(
            [sys.executable, str(scratch / "bin" / "skeletor-upgrade"), str(tree), "--dry-run", *extra], cwd=tree
        )[1]

    tree = scaffold_from(scratch, "dirty-signals")
    results = []

    # Outside the render inputs. `docs/` is this repository's own prose: tracked,
    # so `git describe` calls the tree dirty, and unreadable by any render.
    outside = scratch / "docs" / "DESIGN_RATIONALE.md"
    original = outside.read_text(encoding="utf-8")
    outside.write_text(original + "\n", encoding="utf-8")
    quiet = report(tree)
    quiet_json = report(tree, "--json")
    outside.write_text(original, encoding="utf-8")
    results.append(
        Result(
            "dirty signals: a tracked edit no render reads is not called provisional",
            "already current" in quiet and "Provisional" not in quiet,
            time.time() - started,
            quiet,
        )
    )

    # Row 1's other half: the ref still carries git's `-dirty`, which is honest
    # about the checkout and answers the question this tool stopped asking. Said
    # so, in the only case where the suffix appears without the hazard.
    results.append(
        Result(
            "dirty signals: a `-dirty` ref with no render-reaching dirt says which case it is",
            "suffix is git's and repo-wide" in quiet,
            0.0,
            quiet,
        )
    )

    # Inside the render inputs and rendering nothing: `template/` root matches
    # `RENDER_INPUTS` and is not an overlay source, so this is the whole fixture
    # for "already current" AND the provisional note in one run. Untracked, so
    # cleanup is an unlink and the shared clone is left as found.
    started = time.time()
    plant = scratch / "template" / "ZZ_PLANT.md"
    plant.write_text("planted: reaches a render, renders nothing\n", encoding="utf-8")
    loud = report(tree)
    envelope = report(tree, "--json")
    plant.unlink()
    # From the first line that IS `{`, not the first `{` anywhere: the human
    # half can carry braces in prose (`tmp/upgrade/<path>`), and slicing from
    # one of those parses as nothing and reads as "no envelope" — which is the
    # same green-looking silence a missing field would give. The human half also
    # goes to stderr, so on this path the envelope starts at offset 0 and a
    # newline-anchored search finds nothing; both cases are handled because the
    # first draft handled only the other one and failed with `render_dirt: null`
    # against an envelope that carried it.
    machine = {}
    start = 0 if envelope.startswith("{") else envelope.find("\n{") + 1
    if start > 0 or envelope.startswith("{"):
        try:
            # `raw_decode`, because the envelope is not the end of the stream —
            # the human footer follows it. `json.loads` raises "Extra data" on
            # exactly the output this is meant to read, and an except clause
            # that swallows it leaves `machine` empty, which is
            # indistinguishable from a field that was never published. Two
            # drafts failed that way with `render_dirt: null` beside an envelope
            # visibly carrying it.
            machine = json.JSONDecoder().raw_decode(envelope[start:])[0]
        except json.JSONDecodeError:
            machine = {}
    results.append(
        Result(
            "dirty signals: render-reaching dirt is warned about and the verdict says provisional",
            "uncommitted change(s)" in loud and "already current" in loud and "Provisional" in loud,
            time.time() - started,
            loud,
        )
    )
    results.append(
        Result(
            "dirty signals: --json publishes the predicate for render-reaching dirt",
            machine.get("render_dirt") == ["template/ZZ_PLANT.md"],
            0.0,
            json.dumps({k: machine.get(k) for k in ("head_ref", "render_dirt")}, indent=2) + "\n" + envelope[:400],
        )
    )

    # The configuration where the suffix and the predicate disagree — and it
    # MOVED when `skeletor_ref()` started stamping `-dirty` for render-reaching
    # dirt git cannot see. Before that, an untracked template file gave a clean
    # ref beside a real hazard and the untracked case was the discriminator;
    # now the ref is honest in that direction and the remaining gap is the other
    # one: git's suffix is repo-wide, so a tracked edit no render reads still
    # sets it. A consumer filtering `head_ref` for `-dirty` gets a false positive
    # there and has nothing else in the envelope to ask.
    #
    # Worth stating because the first version of this assertion asserted the
    # clean-ref half and went red the moment the ref was fixed. A gate keyed on
    # the symptom expires when the symptom does; this one is keyed on the two
    # fields answering different questions, which is the property being kept.
    quiet_machine = {}
    start = 0 if quiet_json.startswith("{") else quiet_json.find("\n{") + 1
    if start > 0 or quiet_json.startswith("{"):
        try:
            quiet_machine = json.JSONDecoder().raw_decode(quiet_json[start:])[0]
        except json.JSONDecodeError:
            quiet_machine = {}
    results.append(
        Result(
            "dirty signals: --json separates the version string from the predicate",
            quiet_machine.get("render_dirt") == [] and quiet_machine.get("head_ref", "").endswith("-dirty"),
            0.0,
            json.dumps({k: quiet_machine.get(k) for k in ("head_ref", "render_dirt")}, indent=2),
        )
    )

    # Base and renderer as different trees, which is the only shape that can
    # catch a hardcoded noun.
    started = time.time()
    tags = run(["git", "-C", str(scratch), "tag", "--sort=-creatordate"], cwd=scratch)[1].split()
    if not tags:
        results.append(Result("dirty signals: no tag to render a separate base from", False, 0.0, ""))
        return results
    older = workdir / "dirty-signals-base"
    if older.exists():
        run(["git", "-C", str(scratch), "worktree", "remove", "--force", str(older)], cwd=scratch)
    run(["git", "-C", str(scratch), "worktree", "add", "--detach", "--quiet", str(older), tags[0]], cwd=scratch)
    try:
        split = scaffold_from(older, "dirty-signals-split")
        renderer = scratch / "bin" / "skeletor-new"
        was = renderer.read_text(encoding="utf-8")
        renderer.write_text(was + "\n# dirty in the RENDERER, while the base worktree is clean\n", encoding="utf-8")
        named = report(split)
        renderer.write_text(was, encoding="utf-8")
    finally:
        run(["git", "-C", str(scratch), "worktree", "remove", "--force", str(older)], cwd=scratch)
    results.append(
        Result(
            "dirty signals: a dirty renderer is not reported as the base checkout",
            "renders from has" in named and "the base checkout has" not in named,
            time.time() - started,
            named,
        )
    )
    return results


def normalise_gate(workdir: Path) -> List[Result]:
    """A conflict written by the adopter's own formatter is resolved by it.

    mind.head's only conflict taking `v0.9.0` was **one blank line** between two
    imports, placed by `ruff check --fix` during adoption — never decided, never
    noticed, adjacent to the line the template then rewrote. That is the third
    size of the collision class this repository has now seen, after a five-line
    comment and a single `#:` separator, and it is the one that breaks the
    guidance shipped for the other two: *audit per line* is correct and not
    sufficient, because **the population an adopter is asked to inspect is not
    the population they wrote.** A formatter is a second author with commit
    rights and no changelog.

    This gate reproduces that faithfully, which took one correction. The
    divergence has to be **produced by the tree's own formatter config**, not
    planted by hand — a hand-planted line the tree's formatter would remove is
    the opposite case, and normalising would correctly fail to match it. So the
    gate changes a real isort setting in the scaffolded tree (dropping a module
    from `known_first_party`), runs the tree's isort, and lets the divergence
    appear the way mind.head's did.

    Three assertions, and the middle one is the reason this is worth shipping
    rather than being a smaller conflict count. Without the flag the run
    conflicts **and advertises the flag** — an opt-in nobody hears about is a
    feature that never runs, and the population that needs it is the population
    that has already hit the conflict. With the flag the file does not merge, it
    **applies**: `normalise(base)` equals the user's file byte for byte, so the
    classification is "never touched" and there is nothing to merge at all.

    What it does not touch is the load-bearing part: hashes. `cross_check` and
    the `--no-base` fallback both compare `sha256` of the raw render, so a
    normalised merge is invisible to both — which is why the manifest objection
    to this design dissolved rather than being argued away.
    """
    started = time.time()
    scaffolder = load_scaffolder()
    tier = max(scaffolder.TIERS, key=lambda name: len(scaffolder.TIERS[name]))
    isort = shutil.which("isort")
    if not isort:
        return [Result("normalise: isort is not installed, so the tree's formatter cannot be run", True,
                       time.time() - started, "skipped loudly rather than silently")]

    clean = clean_skeletor(workdir)
    scratch = workdir / "normalise-skeletor"
    if not scratch.exists():
        run(["git", "clone", "--quiet", "--no-hardlinks", str(clean), str(scratch)], cwd=workdir)

    tree = workdir / "normalise-tree" / "probe"
    if tree.exists():
        shutil.rmtree(tree.parent)
    run(
        [sys.executable, str(scratch / "bin" / "skeletor-new"), str(tree),
         "--name", "Probe", "--cli", CLI_NAME, "--tagline", "t", "--tier", tier, "--language", "python", "--force"],
        cwd=SKELETOR,
    )

    # The adopter's config change, and the file it reformats. Derived from the
    # tree: whichever first-party module the config names that a test imports
    # bare, so this survives the fixture being renamed.
    config = tree / "pyproject.toml"
    settings = config.read_text(encoding="utf-8")
    match = re.search(r"known_first_party = \[([^\]]*)\]", settings)
    if not match:
        return [Result("normalise: the tree declares no known_first_party to diverge on", False,
                       time.time() - started, "")]
    names = [name.strip().strip('"') for name in match.group(1).split(",") if name.strip()]

    # Every candidate is TRIED, not the first one taken. Dropping a name from
    # `known_first_party` only moves a file if isort's sections actually change
    # there, and the convenient first pair — `cli` and `test_cli_smoke.py` — is
    # one where they do not. The example you reach for first cannot
    # discriminate, so the selector is a search whose failure names what it
    # tried rather than an assertion about the one it happened to pick.
    attempts, subject = [], None
    for name in names:
        for path in sorted((tree / "tests").glob("*.py")):
            text = path.read_text(encoding="utf-8")
            if not re.search(rf"^from {re.escape(name)} import", text, re.MULTILINE):
                continue
            config.write_text(
                settings.replace(match.group(0), "known_first_party = [%s]" % ", ".join(
                    f'"{other}"' for other in names if other != name)),
                encoding="utf-8",
            )
            run([isort, "--settings-path", str(config), str(path)], cwd=tree)
            if path.read_text(encoding="utf-8") != text:
                subject = (name, path)
                break
            attempts.append(f"{name} in {path.name}: isort did not move it")
            config.write_text(settings, encoding="utf-8")
        if subject:
            break
    if subject is None:
        # The plant asserts it landed. A formatter that changed nothing leaves
        # every assertion below testing the unmodified template against itself.
        return [Result("normalise: no known_first_party name has a test isort would re-section", False,
                       time.time() - started, "\n".join(attempts) or f"names: {names}")]
    dropped, path = subject
    rel = path.relative_to(tree).as_posix()
    run(["git", "-C", str(tree), "commit", "--quiet", "-am", "adopter: formatter config and its result"], cwd=tree)

    # The template must then change that same file, or there is no conflict to
    # have. A scratch commit does it, the way `ported_only_conflict_gate` does.
    source = scratch / "template" / "core" / rel
    if not source.exists():
        return [Result(f"normalise: {rel} does not ship from template/core", False, time.time() - started, "")]
    text = source.read_text(encoding="utf-8")
    hit = re.search(r"^from scripts\.[\w.]+ import .*$", text, re.MULTILINE)
    if not hit:
        return [Result(f"normalise: no scripts import to rewrite in {rel}", False, time.time() - started, "")]
    source.write_text(text.replace(hit.group(0), hit.group(0) + "  # rewritten by the template"), encoding="utf-8")
    git_in(scratch, "commit", "--quiet", "-am", "scratch: rewrite the import below the adopter's blank line")

    upgrade = [sys.executable, str(scratch / "bin" / "skeletor-upgrade"), str(tree), "--dry-run"]
    _, plain = run(upgrade, cwd=tree)
    _, normalised = run(upgrade + ["--normalise"], cwd=tree)

    problems = []
    if "LEFT ALONE" not in plain or rel not in plain.split("LEFT ALONE")[1]:
        problems.append(f"the plant did not conflict without --normalise:\n{plain}")
    elif "--normalise" not in plain:
        problems.append("the conflict does not advertise --normalise, so nobody who needs it hears about it")
    if "LEFT ALONE" in normalised:
        problems.append(f"--normalise did not resolve a conflict its own formatter wrote:\n{normalised}")
    elif rel not in normalised:
        problems.append(f"--normalise resolved the conflict by not classifying {rel} at all:\n{normalised}")

    return [
        Result(
            f"normalise: a formatter's own divergence in {rel} conflicts, and --normalise applies it",
            not problems,
            time.time() - started,
            "\n".join(problems) or f"diverged by dropping {dropped} from known_first_party",
        )
    ]


def ported_only_conflict_gate(workdir: Path) -> List[Result]:
    """`--ported` advances the base when a conflict is the ONLY pending work.

    The advance and the sentence announcing it were gated on different
    conditions. The write sat inside `if not args.dry_run and (added or updated
    or merged)`; the claim — *"--ported already advanced the base past them, so
    re-running will NOT regenerate these"* — sat 89 lines further on, keyed on
    `args.ported` alone. A conflict is in none of `added`, `updated`, `merged`,
    so an upgrade where **nothing applied and one file conflicted** printed the
    claim and left the manifest where it was. Permanent: the port is unrecorded,
    the same conflict returns every run, and the reader has been told not to
    re-run, which was the one action that would have got the sidecars back.

    `pending_ref_gate` could not see it, and the reason is this repository's own
    recurring lesson rather than an oversight — it `continue`s to the next tag
    unless `conflicted and applied`, so it selects for precisely the safe side of
    the boundary the bug lives on. **A gate that requires two things to be true
    cannot find a bug that fires when only one of them is.**

    Nor could the fleet: every real upgrade any adopter had run carried clean
    applies alongside the conflict, so the guard was always true. node-zero found
    it by *constructing* the input — a scratch commit touching one template
    file — instead of waiting for a template release to produce that shape, and
    then ran the controlled version, adding a second file that applies cleanly
    and watching the failure disappear. The window is exact.

    **The discriminating variable is that nothing applied, not that everything
    pending is a conflict.** proto.pilot forced a real conflict on a real tree
    and the base advanced correctly, because two other files applied alongside
    it — a negative result that reads as a refutation until you notice which
    half of the guard it turned. This gate asserts on the applied groups for
    that reason, and would be testing proto.pilot's scenario without it.

    The severity rises as the template settles: today's upgrades are large
    because the template is weeks old and changing daily, and a conflict-only
    upgrade is the ordinary shape of a mature one.

    So this gate manufactures the shape rather than hunting for a tag that has
    it. One scratch commit against a clone, one divergent edit in the tree, and
    the two assertions that matter: nothing applied (a plant that landed on the
    safe side would pass every assertion below while proving nothing), and the
    claim agrees with the deed.
    """
    started = time.time()
    scaffolder = load_scaffolder()
    tier = max(scaffolder.TIERS, key=lambda name: len(scaffolder.TIERS[name]))
    language = max(scaffolder.LANGUAGE_OVERLAYS, key=lambda name: len(scaffolder.LANGUAGE_OVERLAYS[name].split(",")))

    clean = clean_skeletor(workdir)
    scratch = workdir / "ported-only-skeletor"
    if not scratch.exists():
        run(["git", "clone", "--quiet", "--no-hardlinks", str(clean), str(scratch)], cwd=workdir)

    def scaffold(name: str) -> Path:
        tree = workdir / name / "probe"
        if tree.exists():
            shutil.rmtree(tree.parent)
        run(
            [sys.executable, str(scratch / "bin" / "skeletor-new"), str(tree),
             "--name", "Probe", "--cli", CLI_NAME, "--tagline", "t",
             "--tier", tier, "--language", language, "--force"],
            cwd=SKELETOR,
        )
        return tree

    # Both trees are scaffolded BEFORE the scratch commit, so their recorded ref
    # is the pre-scratch HEAD and the base render resolves to it.
    taken, left = scaffold("ported-only-taken"), scaffold("ported-only-left")

    # The file to diverge on is derived, not named: any markdown the core overlay
    # ships that this configuration renders. A path written into this gate would
    # be a second home for a fact `template/` already states, and would go stale
    # silently the day that file moved.
    core = scratch / "template" / "core"
    subject = next(
        (
            rel
            for rel in sorted(path.relative_to(core).as_posix() for path in core.rglob("*.md"))
            if (taken / rel).exists()
        ),
        None,
    )
    if subject is None:
        return [Result("ported-only: no core markdown file renders into the tree", False, time.time() - started, "")]

    (core / subject).write_text(
        (core / subject).read_text(encoding="utf-8") + "\nA SCRATCH LINE FROM THE TEMPLATE.\n", encoding="utf-8"
    )
    git_in(scratch, "commit", "--quiet", "-am", "scratch: one template file")
    head_ref = run(["git", "-C", str(scratch), "describe", "--tags", "--always", "--dirty"], cwd=scratch)[1].strip()

    for tree in (taken, left):
        (tree / subject).write_text(
            (tree / subject).read_text(encoding="utf-8") + "\nA THIRD VALUE, BELONGING TO NEITHER.\n", encoding="utf-8"
        )
        run(["git", "-C", str(tree), "commit", "--quiet", "-am", "local edit"], cwd=tree)

    def ref_of(tree: Path) -> str:
        return str(json.loads((tree / scaffolder.MANIFEST_NAME).read_text(encoding="utf-8"))["skeletor_ref"])

    before = ref_of(taken)
    _, with_flag = run([sys.executable, str(scratch / "bin" / "skeletor-upgrade"), str(taken), "--ported"], cwd=taken)
    _, without = run([sys.executable, str(scratch / "bin" / "skeletor-upgrade"), str(left)], cwd=left)

    problems = []
    # The plant, asserted before anything is read from it. A scratch commit that
    # happened to add a file as well would put an `added` in the batch, the guard
    # would be true for the ordinary reason, and every assertion below would pass
    # against the scenario this gate exists to avoid.
    if "LEFT ALONE" not in with_flag:
        problems.append(f"the plant did not conflict — {subject} was not left alone:\n{with_flag}")
    for word in ("added", "updated", "merged cleanly"):
        if f") {word}" in with_flag:
            problems.append(f"the plant applied something — {word} — so the guard is true for the ordinary reason")
    if not problems:
        if ref_of(taken) == before:
            problems.append(
                f"--ported left the manifest at {before} with a conflict as the only pending work; "
                f"the head render is {head_ref} and the run said it had advanced"
            )
        if "already advanced the base" in with_flag and ref_of(taken) == before:
            problems.append("the claim and the deed disagree: it announced an advance it did not perform")
        # The other half of the same defect. The instruction naming `--ported`
        # lives on the branch that holds the base back, which before this fix
        # could not fire when nothing applied — so a user meeting a real conflict
        # was told to port by hand and never told the flag that records it.
        if "--ported" not in without:
            problems.append("a plain conflict run never names --ported, the flag that resolves it")
        if ref_of(left) != before:
            problems.append(f"a plain conflict run advanced the base {before} → {ref_of(left)}")

    return [
        Result(
            f"ported-only: a lone conflict holds the base, --ported moves it to {head_ref}",
            not problems,
            time.time() - started,
            "\n".join(problems) or f"diverged on {subject}",
        )
    ]


def entangled_gate(workdir: Path) -> List[Result]:
    """A clean file that imports a conflicted one is named, not left quiet.

    The one reassuring line this tool prints — *"file(s) you never touched
    updated"* — is exactly wrong when the untouched file's behaviour is decided
    by one that conflicted. proto.pilot hit it: `check_doc_tables.py` conflicted,
    they kept theirs, and `tests/test_docs_pipeline.py` merged clean carrying a
    test written against a function that exists only here. Every step correct;
    the breakage one import away, in a file with no conflict *because they had
    never edited it*.

    Reproduced rather than simulated: scaffold at the newest tag whose template
    differs, rewrite the importee hard enough that the three-way merge cannot
    resolve it, and leave the importer alone so it takes the clean-update path.
    A hash-tampered version of this cannot exist — `updated` requires the live
    file to match the recorded hash while the head render does not, which no
    amount of manifest editing produces on a single HEAD.
    """
    started = time.time()
    tags = run(["git", "-C", str(SKELETOR), "tag", "--sort=-creatordate"], cwd=SKELETOR)[1].split()
    importer, importee = "tests/test_docs_pipeline.py", "scripts/check_doc_tables.py"
    def changed_py(t: str) -> List[str]:
        out = run(["git", "-C", str(SKELETOR), "diff", "--name-only", t, "HEAD", "--", "template/"], cwd=SKELETOR)[1]
        return [line for line in out.split() if line.endswith(".py")]

    # The pair must both have moved, AND at least one other Python file must
    # have moved with them. The `if hits:` filter — report only files that
    # actually import something conflicted — is unobservable when the upgrade
    # writes exactly one `.py`, because then "every written file" and "the
    # importer" are the same set. jam.sense's rule, met here as a fixture that
    # agrees with the real fix and the noisy one alike: the newest qualifying
    # tag is the convenient one, and it is the one that cannot discriminate.
    tag = next(
        (
            t
            for t in tags
            # BOTH must differ, checked one path at a time. `--quiet` over two
            # pathspecs is non-zero when *either* differs, so the pair predicate
            # silently became an "or" and picked a tag where the importee had
            # not moved — leaving nothing to conflict and the gate asserting
            # against an empty conflict set.
            if all(
                run(["git", "-C", str(SKELETOR), "diff", "--quiet", t, "HEAD", "--", f"template/core/{f}"],
                    cwd=SKELETOR)[0] != 0
                for f in (importer, importee)
            )
            and len(changed_py(t)) > 2
        ),
        "",
    )
    if not tag:
        why = (
            "no tags are visible at all — a shallow clone?"
            if not tags
            else f"no tag moves {importer}, {importee} and another .py"
        )
        return [Result(f"entangled: {why}", False, time.time() - started, f"{len(tags)} tag(s) visible")]

    old_checkout = workdir / "entangled-base"
    run(["git", "-C", str(SKELETOR), "worktree", "add", "--detach", str(old_checkout), tag], cwd=SKELETOR)
    try:
        target = workdir / "entangled-tree"
        run(
            [sys.executable, str(old_checkout / "bin" / "skeletor-new"), str(target),
             "--name", "Probe", "--cli", CLI_NAME, "--tagline", "t", "--force"],
            cwd=SKELETOR,
        )
        # Rewritten, not edited: a small change merges cleanly, and a clean merge
        # is not the case under test.
        clobber = target / importee
        clobber.write_text(
            "\n".join("### OURS ###" for _ in clobber.read_text(encoding="utf-8").splitlines()) + "\n",
            encoding="utf-8",
        )
        git_in(target, "add", "-A")
        git_in(target, "commit", "-m", "ours")

        code, output = run(
            [sys.executable, str(clean_skeletor(workdir) / "bin" / "skeletor-upgrade"), str(target), "--dry-run", "--json"],
            cwd=target,
        )
        payload = json.loads(output[output.index("{") : output.rindex("}") + 1]) if "{" in output else {}
        entangled = payload.get("entangled", {})
        return [
            Result(
                "entangled: a clean file importing a conflicted one is named",
                importee in payload.get("conflicted", [])
                and importer in payload.get("updated", [])
                and entangled == {importer: [importee]},
                time.time() - started,
                f"conflicted={payload.get('conflicted')}\nupdated={payload.get('updated')}\n"
                f"entangled={entangled}\n{output}",
            )
        ]
    finally:
        run(["git", "-C", str(SKELETOR), "worktree", "remove", "--force", str(old_checkout)], cwd=SKELETOR)


def components_gate(workdir: Path) -> List[Result]:
    """`skeletor-components` records what a tree copied, and reports what moved.

    It is the provenance half of adoption — for a repository that took files by
    hand and cannot honestly claim to be a skeletor scaffold. Nothing else here
    exercises it, and this repository's own history is that a path nothing
    generates ships broken: `--no-git`, `script()` taking a flag as a path, and a
    README setup block that had never once been executed.

    Two things are asserted and they need different setups.

    **`record` runs against a clone**, not against this checkout. It refuses a
    dirty skeletor — a recorded ref naming uncommitted work describes a source
    nobody else can resolve — and this checkout is usually dirty while somebody
    is working in it, so running it here would make the gate pass or fail on
    whether the author had saved. A clone at HEAD is deterministic.

    It used to test the committed tool rather than the working copy, which cost
    two false verifications before `clean_skeletor()` learned to carry the
    working tree in. See that function.

    **`report`'s four states are asserted by editing the record**, not by
    manufacturing history. The classification is two independent comparisons —
    `source_sha` against the template today, `local_sha` against the tree today —
    so falsifying either hash exercises exactly the branch it names, with no
    dependence on which template files happen to differ between two tags.
    """
    results: List[Result] = []
    started = time.time()

    clone = clean_skeletor(workdir)
    tool = clone / "bin" / "skeletor-components"

    # A consumer's tree: not a scaffold, holding copies taken by hand.
    consumer = workdir / "consumer"
    (consumer / "scripts").mkdir(parents=True, exist_ok=True)
    sources = ["template/core/scripts/output.py", "template/core/scripts/allowlist.py"]
    for source in sources:
        shutil.copy2(clone / source, consumer / "scripts" / Path(source).name)

    cmd = [sys.executable, str(tool), "record", str(consumer), "--component", "output-contract"]
    for source in sources:
        cmd += ["--file", source]
    code, output = run(cmd, cwd=workdir)
    recorded = consumer / ".skeletor-components.json"
    results.append(
        Result(
            "components: record writes a provenance file",
            code == 0 and recorded.exists(),
            time.time() - started,
            output,
        )
    )
    if not recorded.exists():
        return results

    def rows_of(where: Path, field: str) -> Dict[str, str]:
        code, out = run([sys.executable, str(tool), "report", str(where), "--json"], cwd=workdir)
        if code != 0 or "{" not in out:
            return {}
        payload = json.loads(out[out.index("{") : out.rindex("}") + 1])
        return {row["path"]: row[field] for rows in payload["components"].values() for row in rows}

    def states() -> Dict[str, str]:
        return rows_of(consumer, "state")

    def human() -> str:
        return run([sys.executable, str(tool), "report", str(consumer)], cwd=workdir)[1]

    started = time.time()
    fresh = states()
    fresh_prose = human()
    # Read BEFORE the falsifications below, which is the whole reason this line
    # is here and not beside the assertion that uses it. Every state after this
    # point is manufactured by zeroing a hash, and zeroing `local_sha` also
    # makes it differ from `source_sha` — so a verbatim file reads `forked`,
    # correctly, and a baseline read at the end would be measuring the gate's
    # own tampering. It said `forked` for a file copied byte for byte, and the
    # assertion caught it: a fixture mutated in place stops being a fixture.
    fresh_baselines = rows_of(consumer, "baseline")

    data = json.loads(recorded.read_text(encoding="utf-8"))
    files = data["components"]["output-contract"]["files"]
    # Falsify one hash each, and both on nothing — so every state below is
    # produced by exactly the comparison it is named for.
    files["scripts/output.py"]["source_sha"] = "0" * 64  # upstream moved
    files["scripts/allowlist.py"]["local_sha"] = "0" * 64  # we edited ours
    recorded.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    falsified = states()
    moved_prose = human()

    data["components"]["output-contract"]["files"]["scripts/output.py"]["local_sha"] = "0" * 64
    recorded.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    both = states()

    # `--fail-on-drift` is what lets this be a pre-push or a CI job at all; the
    # default exits 0 like `skeletor-check-pins`. Drift means movement on
    # SKELETOR's side: a file this repo adapted while upstream stayed still is a
    # steady state, and failing it would make the gate red forever for every
    # repo doing the thing components adoption exists to allow.
    def drift_exit() -> int:
        return run([sys.executable, str(tool), "report", str(consumer), "--fail-on-drift"], cwd=workdir)[0]

    upstream_moved = drift_exit()

    # A clean re-record puts every file back to current; drift must clear.
    run([sys.executable, str(tool), "record", str(consumer), "--component", "output-contract"], cwd=workdir)
    after_rerecord = drift_exit()

    # The discriminating case, and the reason the two above cannot stand alone:
    # with any upstream movement present, "drift = upstream moved" and "drift =
    # anything not current" give the same exit, so a gate that only tests those
    # passes under either rule. Only a LOCAL-EDIT-ONLY tree separates them.
    clean = json.loads(recorded.read_text(encoding="utf-8"))
    first = sorted(clean["components"]["output-contract"]["files"])[0]
    clean["components"]["output-contract"]["files"][first]["local_sha"] = "0" * 64
    recorded.write_text(json.dumps(clean, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    local_edit_only = drift_exit()

    # The report is the entire product — this tool never merges and never writes
    # — so a sentence a reader mis-takes is the whole failure surface. It said
    # *"this copy is untouched"*, which is true of the hash and false of the
    # file: the baseline is `record` time, so a file forked BEFORE recording
    # reads as pristine for ever. sky.boss found it on a copy they had cut from
    # 159 lines to 63, and it reproduced in jam.sense — two of three "untouched"
    # lines false, at a different ref for a different adopter. Adoption is when
    # nearly all forking happens, so the blind case is the common one.
    #
    # Asserted on both the ⬆️ line and the ✅ one, because the green state is the
    # same false claim on a line a reader skimming for drift never stops at.
    # Word-level and deliberately so: the record cannot support a stronger
    # assertion, and the fix was to stop claiming more than it measures.
    qualified = "since you recorded it"
    results.append(
        Result(
            "components: no report line claims the copy is untouched",
            qualified in fresh_prose
            and qualified in moved_prose
            and "untouched" not in fresh_prose
            and "untouched" not in moved_prose,
            0.0,
            f"current:\n{fresh_prose}\nupstream moved:\n{moved_prose}",
        )
    )

    results.append(
        Result(
            "components: --fail-on-drift gates upstream movement, and a local edit is not drift",
            upstream_moved == 1 and after_rerecord == 0 and local_edit_only == 0,
            0.0,
            f"upstream moved -> {upstream_moved} (want 1); after re-record -> {after_rerecord} (want 0); "
            f"local edit only -> {local_edit_only} (want 0)",
        )
    )

    # The one thing that CAN be said about the record baseline, and the reason it
    # is said only sometimes. A template file the scaffolder copies byte for byte
    # cannot differ at record time for any reason but somebody changing it, so
    # the fork is provable there; a file with placeholders differs for rendering
    # alone, so nothing can be said. Both directions in one fixture, because a
    # rule that only ever fires is being agreed with rather than applied —
    # sky.boss proposed this as a general rule, found `docs/rules/commits.md`
    # (fourteen placeholders, never edited) in their own manifest, and retracted
    # it. That file is the second half of this fixture.
    started = time.time()
    forked = workdir / "consumer-forked"
    for part in ("scripts", "docs/rules"):
        (forked / part).mkdir(parents=True, exist_ok=True)
    plain = clone / "template/core/scripts/allowlist.py"
    templated = clone / "template/core/docs/rules/commits.md"
    # Cut before recording: this is the shape the report used to call untouched.
    (forked / "scripts" / "allowlist.py").write_text(
        "\n".join(plain.read_text(encoding="utf-8").splitlines()[:20]) + "\n", encoding="utf-8"
    )
    # Rendered, not edited — every difference is a substitution.
    rendered = templated.read_text(encoding="utf-8")
    for token, value in (("{{BASE_BRANCH}}", "develop"), ("{{RELEASE_BRANCH}}", "main")):
        rendered = rendered.replace(token, value)
    (forked / "docs" / "rules" / "commits.md").write_text(rendered, encoding="utf-8")
    run(
        [sys.executable, str(tool), "record", str(forked), "--component", "mixed",
         "--file", "template/core/scripts/allowlist.py:scripts/allowlist.py",
         "--file", "template/core/docs/rules/commits.md:docs/rules/commits.md"],
        cwd=workdir,
    )
    _, mixed = run([sys.executable, str(tool), "report", str(forked)], cwd=workdir)
    # THREE sentences, not two, and the third is why this assertion grew. The
    # baseline has three states — provably clean, provably forked, and not
    # knowable — and the first version of the tool spelled the first and third
    # identically, so `✅ unchanged on both sides since you recorded it` meant
    # either "checked, clean" or "could not check". jam.sense found it on a real
    # fork of theirs rendering green beside a file that was genuinely pristine.
    # **Nobody investigates a ✅**, so the collapsed state costs most on exactly
    # the line that is silent; a `⬆️` at least sends a reader to a diff.
    #
    # Asserted across two fixtures because one cannot hold all three: `consumer`
    # copies verbatim, so every baseline there is `matched`, and only the
    # deliberately-forked tree produces the other two. A gate reading one tree
    # would have agreed with the bug.
    forked_says = "ALREADY differed from the template"
    unknowable_says = "is not knowable from this record"
    clean_says = "matched the template exactly when you recorded it"
    named = [line for line in mixed.splitlines() if forked_says in line]
    unnamed = [line for line in mixed.splitlines() if unknowable_says in line]
    baselines = rows_of(forked, "baseline")
    results.append(
        Result(
            "components: a provable fork, an unprovable one and a clean take read differently",
            len(named) == 1
            and "allowlist.py" in named[0]
            and len(unnamed) == 1
            and "commits.md" in unnamed[0]
            # The discriminating half: the clean sentence must NOT be what the
            # unprovable file prints, which is the bug as it shipped.
            and clean_says in fresh_prose
            and clean_says not in mixed
            and baselines == {"scripts/allowlist.py": "forked", "docs/rules/commits.md": "unknown"}
            and set(fresh_baselines.values()) == {"matched"},
            time.time() - started,
            f"{mixed}\nbaselines: {baselines}\nfresh baselines: {fresh_baselines}",
        )
    )

    results.append(
        Result(
            "components: report separates upstream movement from a local edit",
            fresh == {"scripts/output.py": "current", "scripts/allowlist.py": "current"}
            and falsified.get("scripts/output.py") == "upstream"
            and falsified.get("scripts/allowlist.py") == "local"
            and both.get("scripts/output.py") == "both",
            time.time() - started,
            f"fresh: {fresh}\nfalsified: {falsified}\nboth: {both}",
        )
    )
    return results


def allowlist_gate(tree: Path, venv_python: Path) -> Result:
    """Every allowlist in the tree fails when it holds an entry nobody needs.

    This is a sweep, and it exists because the first pass at this rule was not.
    Two allowlists got a staleness check because they were the two in front of
    me; the tree shipped four, and the two I missed were the two nothing would
    have complained about — one with no check at all, one with a single
    direction. That is the failure this repository's Invariant 2 is about,
    committed while writing the sentence that states it.

    So the set is **discovered**, not listed: any `*_allowlist.yaml` anywhere in
    the generated tree is enrolled by existing. A fifth one added next year is
    covered without anybody remembering, and one deleted stops being checked
    without a stale entry here.

    The method is to plant the bug rather than to inspect the source. A grep for
    "does this file mention staleness" would pass on a check that mentions it
    and does not do it — which is precisely the shape of the drift allowlist,
    whose docstring promised an escape hatch its reader could not parse. So each
    allowlist gets a deliberately meaningless entry and the tree's own gates must
    go red. What turns red is not this gate's business; that a consumer notices
    is the whole assertion.

    Cost is one suite run per allowlist, which is why it runs on one tier.
    """
    started = time.time()
    found = sorted(tree.rglob("*_allowlist.yaml"))
    checks = sorted((tree / "scripts").glob("check_*.py"))
    failures: List[str] = []

    def gates_are_red() -> bool:
        """Any consumer objecting is enough. None of them objecting is the bug."""
        code, _ = run([str(venv_python), "-m", "pytest", "-m", "unit", "-q", "-x"], cwd=tree)
        if code != 0:
            return True
        return any(run([str(venv_python), str(check)], cwd=tree)[0] != 0 for check in checks)

    for path in found:
        original = path.read_text(encoding="utf-8")
        rel = path.relative_to(tree).as_posix()
        try:
            # A key nothing in the tree can possibly resolve, with a reason — so
            # the only thing wrong with it is that it exempts nothing. An entry
            # without a reason would be caught by a different rule and would
            # make this gate pass for the wrong cause.
            path.write_text(
                original + "\n__skeletor_verify_planted__: a deliberately meaningless exemption\n",
                encoding="utf-8",
            )
            if not gates_are_red():
                failures.append(f"{rel}: a meaningless entry was accepted — nothing checks this allowlist")
        finally:
            path.write_text(original, encoding="utf-8")

    # A sweep over zero files is green and worth nothing — the same reason the
    # lint gates assert they found the tree.
    if not found:
        failures.append("no *_allowlist.yaml found — the discovery is broken, not the tree")

    return Result(
        f"every allowlist rejects a stale entry ({len(found)} found)",
        not failures,
        time.time() - started,
        "\n".join(failures),
    )


def declined_gate(tier: str, workdir: Path) -> List[Result]:
    """A file skeletor wrote and the user deleted is not put back.

    `AGENTS.md` calls a `--force` scaffold into a repo somebody already works in
    *the usual case*, and the whole point of that path is partial adoption: take
    the rules, keep your own CI, drop the parts that do not fit. Every one of
    those drops is a deletion — and an absent file was classified purely on
    being absent, so all of them came back on the next upgrade, reported as a
    green "new file added" and written without asking. A decision that has to be
    re-made on a schedule is not a decision, and one auto-reverted with a tick
    beside it is worse than a conflict, which at least stops.

    Reported by sky.boss, weighing a retrofit and asking whether six settled
    declines would become six recurring merge conflicts. They would have become
    something worse than conflicts.

    The discriminator needs no new bookkeeping and no decline list: an entry in
    the manifest means skeletor *wrote* that file here, so its absence is a
    deletion; no entry means the template has only just started shipping it, and
    adding it is what an upgrade is for. Both directions are asserted, because
    the fix trades one silent wrong answer for the other if it over-applies —
    a genuinely new file that stopped arriving would be invisible.

    The fourth assertion is the one sky.boss actually asked for: run it twice.
    The manifest is re-copied from the head render on every applying run, so a
    decline persists — but only as long as that copy keeps recording the file,
    which is a property of a different function and nothing here would notice it
    changing.
    """
    results: List[Result] = []
    started = time.time()
    manifest_name = load_scaffolder().MANIFEST_NAME

    result, tree = scaffold(tier, "python", workdir, name="declined")
    results.append(Result(f"declined: {result.label}", result.ok, result.seconds, result.output))
    if not result.ok:
        return results

    manifest = json.loads((tree / manifest_name).read_text(encoding="utf-8"))
    # Three files, and the third exists because jam.sense named the trap: the
    # example you reach for first is the one that cannot discriminate. The first
    # two here were `sorted(...)[:2]` — the most convenient files in the tree —
    # and with them the "template moved since you declined it" branch could
    # never fire, because this gate scaffolds and upgrades from one HEAD, so
    # every recorded hash equals the head render's by construction. That branch
    # had report text written for it and nothing exercising it.
    dropped, arriving, moved = sorted(manifest["files"])[:3]
    # `arriving` is deleted AND unrecorded: the shape of a file the template has
    # only just started shipping, which must still be added.
    del manifest["files"][arriving]
    # Falsified, not manufactured: a recorded hash that disagrees with the head
    # render is exactly what "the template changed since you declined it" means,
    # and it is the only way to reach that state without a second checkout.
    manifest["files"][moved] = "0" * 64
    (tree / manifest_name).write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
    for rel in (dropped, arriving, moved):
        (tree / rel).unlink()
    git_in(tree, "add", "-A")
    git_in(tree, "commit", "-m", "decline")

    upgrade = [sys.executable, str(clean_skeletor(workdir) / "bin" / "skeletor-upgrade"), str(tree), "--no-base", "--json"]

    def report(extra: List[str]) -> dict:
        """The envelope, or an empty one — never an exception.

        A gate that raises takes the whole verifier down with it and loses the
        forty checks after it, which is a worse failure than the one it was
        looking for. An upgrade that printed no JSON has already failed every
        assertion below on the merits.
        """
        _, output = run([*upgrade, *extra], cwd=tree)
        try:
            return json.loads(output[output.index("{") : output.rindex("}") + 1])
        except (ValueError, json.JSONDecodeError):
            return {"added": [], "declined": [], "no_json": output}

    seen = report(["--dry-run"])
    results.append(
        Result(
            "declined: a deleted file is declined, an unrecorded one still arrives",
            dropped in seen["declined"]
            and dropped not in seen["added"]
            and arriving in seen["added"]
            and arriving not in seen["declined"]
            and moved in seen["declined"],
            time.time() - started,
            json.dumps(seen, indent=2),
        )
    )

    # The actionable subset, and the branch two convenient files could not reach.
    # A decline the template has since changed gets a sidecar to look at; one it
    # has not gets silence. Both directions, because writing a sidecar for every
    # standing decline on every run is the noise this report is shaped to avoid.
    started = time.time()
    _, human = run([*upgrade[:-1], "--dry-run"], cwd=tree)
    code, _ = run(upgrade[:-1], cwd=tree)
    sidecars = tree / "tmp" / "upgrade"
    results.append(
        Result(
            "declined: a decline the template has moved past is itemised, the rest are not",
            "the template has changed since" in human
            and moved in human.split("the template has changed since")[1]
            and (sidecars / f"{moved}.new").exists()
            and not (sidecars / f"{dropped}.new").exists(),
            time.time() - started,
            human + "\n" + "\n".join(str(p.relative_to(sidecars)) for p in sidecars.rglob("*") if p.is_file()),
        )
    )

    started = time.time()
    report([])
    again = report(["--dry-run"])
    results.append(
        Result(
            "declined: it stays declined across a real upgrade",
            not (tree / dropped).exists() and dropped in again["declined"] and (tree / arriving).exists(),
            time.time() - started,
            f"{dropped} restored: {(tree / dropped).exists()}\n"
            f"{arriving} arrived: {(tree / arriving).exists()}\n" + json.dumps(again, indent=2),
        )
    )

    # Standing state is not work, and the currency test is about work. `declined`
    # and `dropped` sat in that `any()`, so a tree carrying one **never** saw
    # "already current" — not on that release and not on any future one. The
    # tree that most needs the sentence is exactly the tree that could not
    # receive it: an adopter whose manifest will read one ref for ever cannot
    # otherwise tell "I upgraded and there was nothing in it" from "I never ran
    # the upgrade", which is the ambiguity the sentence exists to resolve.
    #
    # mind.head reported it with a control — same render, same upgrade, four
    # standing declines the only difference. This asserts both halves in one
    # run, which is what makes it a statement about the condition rather than
    # about either line: the decline is still reported AND the verdict is still
    # printed.
    started = time.time()
    _, current = run([*upgrade[:-1], "--dry-run"], cwd=tree)
    results.append(
        Result(
            "declined: a standing decline does not suppress the currency verdict",
            "already current" in current and "NOT restored" in current,
            time.time() - started,
            current,
        )
    )
    return results


def hook_args_for_tree(workdir: Path, tier: str) -> List[str]:
    """black's args from any already-generated tree of this tier."""
    for candidate in (workdir / f"{tier}-python", workdir / f"{tier}-both"):
        if (candidate / ".pre-commit-config.yaml").exists():
            return hook_args(candidate, "black")
    return []


def entry_point_gate() -> Result:
    """`bin/skeletor --help` and the README name every tool, by discovery.

    This gate is about *this repository*, not about a generated tree, which puts
    it in the same small family as `check_no_baked_paths`: it asks whether what
    skeletor ships is coherent, a question no scaffold can ask about itself.

    It exists because the defect it prevents had already happened. The README
    advertised the generated CLI as "one discoverable entry point" whose groups
    are discovered rather than listed, three paragraphs below a hand-maintained
    table of skeletor's own eight tools that named five — and
    `bin/skeletor-components`, 339 lines, appeared in no document or workflow at
    all. A list where a pattern would do, in the file that advertises the rule.

    Two directions, because a generated block can be wrong in two ways and only
    one of them is visible by reading it. The block must be **current** — the
    regeneration produces no diff, which is invariant 4 — and it must be
    **complete**, every executable `bin/skeletor-*` present in both the dispatch
    listing and the README. Currency alone would stay green if the generator
    itself started skipping a file, since both sides would skip it together.
    That is the same two-readings-of-one-source trap the manifest gate is built
    around: two copies of a mistake agree with each other.
    """
    started = time.time()
    tools = sorted(
        p.name for p in (SKELETOR / "bin").glob("skeletor-*") if p.is_file() and os.access(p, os.X_OK)
    )
    dispatcher = SKELETOR / "bin" / "skeletor"
    listed_code, listed = run([str(dispatcher), "--help"], cwd=SKELETOR)
    block_code, block = run([str(dispatcher), "--markdown"], cwd=SKELETOR)

    readme = (SKELETOR / "README.md").read_text(encoding="utf-8")
    current = block.strip() and block.strip() in readme
    # Discovered independently of the generator, so this cannot be satisfied by
    # a generator that under-reports: the filesystem is the third opinion.
    missing_from_help = [t for t in tools if t[len("skeletor-"):] not in listed]
    missing_from_readme = [t for t in tools if f"`bin/{t}`" not in readme]
    enough = len(tools) >= 2

    return Result(
        f"bin/skeletor: --help and the README name all {len(tools)} tools",
        listed_code == 0
        and block_code == 0
        and enough
        and bool(current)
        and not missing_from_help
        and not missing_from_readme,
        time.time() - started,
        f"tools discovered: {tools}\nREADME block current: {bool(current)}\n"
        f"missing from --help: {missing_from_help}\nmissing from README: {missing_from_readme}\n"
        f"(run `bin/skeletor --markdown` and paste the block into README.md)",
    )


def unlinted_source_gate(workdir: Path) -> List[Result]:
    """Every language a configuration ships source for ships its linter too.

    `cli/check.py` runs a linter only when its config file exists. Written as
    tolerance, it reads as a claim, and the two come apart the moment a config
    ships at a different overlay than the source it governs. `.flake8`,
    `pyproject.toml` and `pyrightconfig.json` lived in `template/python/` while
    `cli/`, `scripts/` and `tests/` ship at `core` — so a `--language node`
    tree arrived with 52 python files, no python config, and a `check lint`
    that ran eslint alone and printed `✅ all 1 gates passed`.

    **This is the same defect as the setup-block one, on the same flag, one
    artifact over.** `docs/DESIGN_RATIONALE.md` already records that
    `--language` reads as three symmetric choices and is not: every scaffold is
    a python project and the flag only ever ADDS. That finding fixed
    `setup_commands()`, which is how the toolchain is *documented* — and left
    the toolchain's own *config* in the overlay the same argument had just
    shown was the wrong home. Naming a failure mode does not immunise you
    against it; the second instance was thirteen days after the first.

    Two more shipped behind it, both invisible for the same reason. The pyright
    hook's entry is `pyright --project pyrightconfig.json`, so
    `pre-commit run --all-files` — the README's first command — could not pass
    in a node tree; and `tests/test_marker_coverage.py` reads `pyproject.toml`
    unconditionally and raised `FileNotFoundError`. Both are invariant 5, and
    the second is a documented sync pair (`pyproject.toml` says *keep this
    block in step with tests/pytest.ini*) whose halves shipped at different
    overlays — the tier-composition class on the language axis.

    **Nothing here could see any of it.** `gated_language = "python"`: a node
    tree is scaffolded, so an unrendered placeholder is caught, and its own
    suite is never run. dream-doll found it by being the first `--language
    node` adopter. So this gate asks the structural question directly, for
    every language the parser offers rather than the one the grid executes.

    The table is READ from the tree's own `cli/check.py`, so a fourth linter
    added there is covered here on the next run. Its ten-line evaluation is
    deliberately re-implemented rather than imported: `cli.check` needs click
    and a venv, and a gate that depends on the tree being installed cannot run
    for the languages this one exists to reach. The plant below is what keeps
    that re-implementation honest, and the python trees run the real `_lint()`
    through `check pre-push` anyway.

    `--language none` is included, and is not in `configurations()` — that
    helper enumerates `LANGUAGE_OVERLAYS`, which has no `none` key because the
    choice ships no overlay. It is still a documented choice, and it is the one
    with the least shipped alongside the python that ships regardless.
    """
    started = time.time()
    scaffolder = load_scaffolder()
    parser = scaffolder.build_parser()
    languages = next(a.choices for a in parser._actions if a.dest == "language")

    def table(tree: Path):
        """`LANGUAGE_CONFIGS` out of the generated tree, as data."""
        source = (tree / "cli" / "check.py").read_text(encoding="utf-8")
        for node in ast.walk(ast.parse(source)):
            if isinstance(node, ast.Assign) and getattr(node.targets[0], "id", None) == "LANGUAGE_CONFIGS":
                return ast.literal_eval(node.value)
        return None

    def gaps(tree: Path, rows) -> List[str]:
        found = []
        for language, declares, configs in rows:
            if not any(next(tree.glob(pattern), None) for pattern in declares):
                continue
            found += [f"{language}: {config}" for config in configs if not (tree / config).exists()]
        return found

    results = []
    trees = {}
    for language in languages:
        result, tree = scaffold("core", language, workdir, name=f"unlinted-{language}")
        if not result.ok:
            results.append(result)
            continue
        rows = table(tree)
        if not rows:
            results.append(
                Result(
                    f"unlinted source: {language}",
                    False,
                    time.time() - started,
                    "cli/check.py declares no LANGUAGE_CONFIGS — the table this gate reads is gone",
                )
            )
            continue
        trees[language] = (tree, rows)
        missing = gaps(tree, rows)
        results.append(
            Result(
                f"unlinted source: --language {language} ships a linter for everything it ships",
                not missing,
                time.time() - started,
                "source ships that no gate reads:\n  " + "\n  ".join(missing) if missing else "",
            )
        )

    # The plant. A green negative above is identical whether every config ships
    # or the evaluation is blind, and this gate re-implements that evaluation —
    # so it asserts the target exists before removing it, and requires the
    # removal to be seen. `--language node` is the tree it actually shipped
    # broken in, which is why the plant is made there rather than in the
    # convenient one.
    planted = "node" if "node" in trees else next(iter(trees), None)
    if planted:
        tree, rows = trees[planted]
        victim = tree / ".flake8"
        if not victim.exists():
            results.append(
                Result(
                    "unlinted source: the plant lands",
                    False,
                    time.time() - started,
                    f"{victim.name} is not in the {planted} tree — the plant would prove nothing",
                )
            )
        else:
            victim.unlink()
            seen = gaps(tree, rows)
            victim.write_text("[flake8]\n", encoding="utf-8")
            results.append(
                Result(
                    f"unlinted source: removing .flake8 from the {planted} tree is seen",
                    bool(seen),
                    time.time() - started,
                    "" if seen else "the evaluation reported nothing with a config deleted",
                )
            )

    return results


def tagline_required_gate(workdir: Path) -> Result:
    """Omitting `--tagline` is refused, rather than rendering placeholder text.

    `--tagline` is the one rendered field with no derivation — `--name` falls
    back to the slug, `--cli` and `--env-prefix` to the target directory name —
    and it carried `default="<one line: what this project is>"`. A scaffold that
    omitted the flag wrote that literal into five files plus `.skeletor.json`,
    reaching `cli/__init__.py`'s docstring and therefore rendered `--help`
    output. `render()` structurally cannot catch it: the guard is for an
    *unsubstituted* `{{PLACEHOLDER}}`, and this one substituted correctly. The
    manifest is the durable half, being the upgrade base.

    **Nothing here caught it because every scaffold in this file passes the
    flag** — `--tagline "t"` at fourteen sites. The default was never once
    produced by the grid whose premise is that the scaffold is the test. That is
    `--no-git`'s shape mirrored: there the verifier omitted what the docs
    passed, here the verifier passes what a user omits, and both times the
    tested path and the real path were disjoint. A default no gate ever produces
    is not a tested default, and a flag every caller happens to pass is
    undistinguished rather than confirmed.

    The refusal must **name the flag**. A scaffold can fail for many reasons, so
    a gate satisfied by any non-zero exit would stay green if the failure moved
    to something unrelated — which is this file's own rule that a green negative
    looks identical whether the thing did not happen or nobody looked. It also
    asserts no tree was left behind, because a parser that rejected the run
    after writing files would be a different and worse bug.
    """
    started = time.time()
    target = workdir / "no-tagline"
    code, output = run(
        [
            sys.executable,
            str(SCAFFOLDER),
            str(target),
            "--allow-dirty",
            "--name",
            "Probe",
            "--cli",
            CLI_NAME,
            "--tier",
            "core",
        ],
        cwd=SKELETOR,
    )
    named = "--tagline" in output
    unwritten = not target.exists()
    return Result(
        "bin/skeletor-new: --tagline is required, not defaulted",
        code != 0 and named and unwritten,
        time.time() - started,
        f"exit: {code} (want non-zero)\nrefusal names --tagline: {named}\n"
        f"left no tree behind: {unwritten}\n{output[:400]}",
    )


def main() -> int:
    scaffolder = load_scaffolder()
    all_tiers = sorted(scaffolder.TIERS)
    all_languages = sorted(scaffolder.LANGUAGE_OVERLAYS) + ["none"]

    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--tier", action="append", choices=all_tiers, help="limit to a tier (repeatable)")
    parser.add_argument("--language", action="append", choices=all_languages, help="limit to a language (repeatable)")
    parser.add_argument("--keep", action="store_true", help="do not delete the generated trees")
    parser.add_argument("--workdir", help="where to generate (default: a temp dir)")
    parser.add_argument("-q", "--quiet", action="store_true", help="summary only")
    args = parser.parse_args()

    tiers = args.tier or all_tiers
    languages = args.language or all_languages
    #: Gates run against the language the template's own tests are written in.
    #: The others are scaffolded anyway, because an unrendered placeholder in an
    #: overlay nobody generates is a `render()` failure a user finds first.
    gated_language = "python"

    workdir = Path(args.workdir).resolve() if args.workdir else Path(tempfile.mkdtemp(prefix="skeletor-verify-"))
    workdir.mkdir(parents=True, exist_ok=True)
    print(f"🔎 verifying {len(tiers)} tier(s) × {len(languages)} language(s) in {workdir}")

    results: List[Result] = []
    try:
        # Before the venv: it needs no toolchain, and a repository whose own
        # entry points disagree with its README should say so in two seconds
        # rather than after a five-minute grid.
        results.append(entry_point_gate())
        results.append(manifest_args_gate())
        results.append(tagline_required_gate(workdir))
        results += unlinted_source_gate(workdir)
        venv_python = make_venv(workdir, args.quiet)
        results.append(shadow_gate(workdir, venv_python))
        results.append(dirty_scope_gate(workdir))
        results.append(coverage_gate(workdir, venv_python))
        pyright_ok, pyright_note = warm_pyright(venv_python)
        if not args.quiet:
            print(f"   pyright {pyright_note}" if pyright_ok else f"   ⚠️  pyright unavailable: {pyright_note}")
        for tier in tiers:
            for language in languages:
                result, tree = scaffold(tier, language, workdir)
                results.append(result)
                if not result.ok:
                    continue
                # Runs for EVERY language, unlike everything below it: both of
                # its inputs vary with `--language`, so gating it on `python`
                # would check the one configuration that cannot be wrong.
                setup_gate = check_setup_blocks_agree(tree, tier, language)
                setup_gate.label = f"{tier}: {setup_gate.label}"
                results.append(setup_gate)
                if language != gated_language:
                    continue
                (tree / ".venv").symlink_to(venv_python.parents[1])
                for gate in gates(tree, venv_python, pyright_ok):
                    gate.label = f"{tier}: {gate.label}"
                    results.append(gate)
                if not args.quiet:
                    print(f"   {tier}/{language} … {sum(1 for r in results if r.ok)} checks green so far")

        # The fullest tier, not the alphabetically last one — sorted(TIERS)
        # puts `governed` after `agentic`, which would have quietly gated the
        # wrong tree.
        fullest = max(tiers, key=lambda t: len(scaffolder.TIERS[t]))
        for gate in versioning_gate(fullest, workdir, venv_python):
            results.append(gate)

        for gate in host_exemption_gate(fullest, workdir, venv_python):
            results.append(gate)

        for gate in agentless_gate(fullest, workdir, venv_python):
            results.append(gate)

        for gate in badge_gate(fullest, workdir, venv_python):
            results.append(gate)

        for gate in populated_tree_gate(fullest, workdir):
            gate.label = f"{fullest}: {gate.label}"
            results.append(gate)

        # Beside `populated_tree_gate`, and after it, because it is the case
        # that gate's fixture cannot reach: a `--force` over a tree skeletor
        # itself made, rather than over decoys.
        for gate in adopted_repo_gate(fullest, workdir, venv_python):
            gate.label = f"{fullest}: {gate.label}"
            results.append(gate)

        for gate in rescaffold_gate(fullest, workdir):
            gate.label = f"{fullest}: {gate.label}"
            results.append(gate)

        for gate in branch_gate(fullest, workdir):
            gate.label = f"{fullest}: {gate.label}"
            results.append(gate)

        for gate in dry_run_gate(fullest, workdir):
            gate.label = f"{fullest}: {gate.label}"
            results.append(gate)

        allow_tree = workdir / f"{fullest}-python"
        if allow_tree.exists():
            gate = allowlist_gate(allow_tree, venv_python)
            gate.label = f"{fullest}: {gate.label}"
            results.append(gate)

        for gate in dirty_ref_gate(workdir):
            results.append(gate)

        for gate in pending_ref_gate(workdir):
            results.append(gate)

        leak = author_leak_gate(fullest, workdir)
        leak.label = f"{fullest}: {leak.label}"
        results.append(leak)

        for gate in ported_only_conflict_gate(workdir):
            results.append(gate)

        for gate in scaffold_dirt_gate(workdir):
            results.append(gate)

        for gate in dirty_signals_gate(workdir):
            results.append(gate)

        for gate in normalise_gate(workdir):
            results.append(gate)

        for gate in entangled_gate(workdir):
            results.append(gate)

        for gate in components_gate(workdir):
            results.append(gate)

        for gate in declined_gate(fullest, workdir):
            gate.label = f"{fullest}: {gate.label}"
            results.append(gate)

        for gate in sidecar_gate(fullest, workdir):
            gate.label = f"{fullest}: {gate.label}"
            results.append(gate)

        for gate in collect_diff_gate(fullest, workdir, venv_python):
            gate.label = f"{fullest}: {gate.label}"
            results.append(gate)

        # Not per-tier: it is a question ABOUT the tiers, so it scaffolds its own
        # grid and runs once.
        results += tier_composition_gate(workdir)

        for gate in long_path_gate(fullest, workdir, venv_python):
            gate.label = f"{fullest}: {gate.label}"
            results.append(gate)

        node_tree = workdir / f"{fullest}-both"
        if node_tree.exists():
            for gate in [*node_gates(node_tree), check_no_baked_paths(node_tree)]:
                gate.label = f"{fullest}/both: {gate.label}"
                results.append(gate)
    finally:
        if not args.keep:
            shutil.rmtree(workdir, ignore_errors=True)
        else:
            print(f"   trees kept in {workdir}")

    failed = [r for r in results if not r.ok]
    print()
    for result in results:
        print(f"  {result.mark} {result.label}  ({result.seconds:.1f}s)")
    print()

    if failed:
        for result in failed:
            print(f"── {result.label} ──")
            print(result.output.strip()[-4000:])
            print()
        print(f"❌ {len(failed)} of {len(results)} checks failed")
        return 1

    print(f"✅ {len(results)} checks green — every tier scaffolds and passes its own gates")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
