#!/usr/bin/env python3
"""Generate every tier and run the resulting tree's own gates against it.

    bin/skeletor-verify                 # every tier, every language
    bin/skeletor-verify --tier core     # one tier
    bin/skeletor-verify --keep          # leave the trees behind to poke at

There is no test suite for skeletor. **The scaffold is the test**: a template
change is verified by generating a tree and running that tree's own checks, and
the definition of done is that a fresh tree passes them. A scaffold whose first
check is red teaches the user that red is normal, and a gate people have learned
to expect red from has stopped working.

That procedure used to live only as a recipe in CLAUDE.md — which made it a
second copy of itself, running only when somebody remembered to type it and
drifting the moment the tiers changed. This file is the copy that runs.

Nothing here holds a list of tiers or languages: both are read from
``bin/skeletor-new``, so a tier added there is verified by existing.
"""

from __future__ import annotations

import argparse
import ast
import hashlib
import importlib.machinery
import importlib.util
import json
import re
import shutil
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass
from pathlib import Path
from typing import Dict, List, Optional, Tuple

SKELETOR = Path(__file__).resolve().parents[1]
SCAFFOLDER = SKELETOR / "bin" / "skeletor-new"

#: What the toolchain needs beyond the template's own exact pins.
#:
#: `pytest-timeout` is here not because a gate calls it but because the tree's
#: pytest config *sets* `timeout`. Without the plugin pytest warns and ignores
#: it, so the suite would be verified under a config the tree does not have.
#: `actionlint-py` is a pip wrapper around a Go binary, and it is the only entry
#: here that no generated tree installs. It checks what skeletor SHIPS rather
#: than what a tree runs on itself — see `actionlint_gate`. Pinned, so
#: `bin/skeletor-check-pins` reports it going stale like every other pin.
EXTRA_PACKAGES = ["pytest", "pytest-timeout", "click", "actionlint-py==1.7.12.24"]

#: Lint hooks whose args are read out of the generated tree's own
#: `.pre-commit-config.yaml` rather than repeated here. Copying the args would
#: mean verifying against a config the tree does not have, which is the exact
#: failure this file exists to catch — and it would go wrong silently, since
#: both copies would still be green.
LINT_HOOKS = ["black", "isort", "flake8"]

CLI_NAME = "probe"


@dataclass
class Result:
    label: str
    ok: bool
    seconds: float
    output: str = ""

    @property
    def mark(self) -> str:
        return "✅" if self.ok else "❌"


def load_scaffolder():
    """Import ``bin/skeletor-new`` for its TIERS and LANGUAGE_OVERLAYS maps.

    It has no ``.py`` suffix, so the import is by path. Everything at its module
    level is a definition; ``main()`` is guarded.
    """
    loader = importlib.machinery.SourceFileLoader("skeletor_new", str(SCAFFOLDER))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


#: A git identity for every subprocess — see `run()`. Held here rather than
#: inline so the values have one home.
GIT_IDENTITY = {
    "GIT_AUTHOR_NAME": "skeletor-verify",
    "GIT_AUTHOR_EMAIL": "verify@skeletor.invalid",
    "GIT_COMMITTER_NAME": "skeletor-verify",
    "GIT_COMMITTER_EMAIL": "verify@skeletor.invalid",
}


def run(cmd: List[str], cwd: Path, env_extra: Optional[dict] = None) -> Tuple[int, str]:
    import os

    env = dict(os.environ)
    # Every subprocess, not just the ones that obviously commit. Nothing here may
    # depend on the host having a git identity: a GitHub runner has none, and the
    # failure is not a git error but a *tree* that has a repository and no HEAD —
    # so it surfaces as 97 uncommitted files in an unrelated gate, pointing at
    # the wrong subsystem.
    #
    # `scaffold()` learned this on its first CI run and carried it alone. The
    # gates added later called `git commit` bare, or invoked the scaffolder
    # directly, and went red on CI while passing here — three sites, one rule,
    # applied once. Putting it in `run()` is the only version that cannot be
    # forgotten by the next gate, which is the same argument as `scanned()`.
    env.update(GIT_IDENTITY)
    if env_extra:
        env.update(env_extra)
    proc = subprocess.run(cmd, cwd=str(cwd), capture_output=True, text=True, env=env)
    return proc.returncode, (proc.stdout or "") + (proc.stderr or "")


def git_in(tree: Path, *args: str) -> Tuple[int, str]:
    """A git command in `tree`. The identity comes from `run()`."""
    return run(["git", *args], cwd=tree)


def toolchain() -> List[str]:
    """The template's own exact pins, so the gates run the versions it ships.

    Read from `template/core/scripts/requirements.txt` rather than listed here:
    a bump has to reach the verifier, and a second list is a second thing to
    forget.

    `pyright` used to be filtered out of this as uninstallable — a node package
    wearing a Python name, said to cost a toolchain download for one gate. The
    number was never measured. Its pip wrapper caches node in
    `~/.cache/pyright-python` keyed by version, so the download is once per
    machine rather than once per tree, and a warm run over a governed tree is
    about a second. What the exemption actually bought was two
    `reportAssignmentType` errors that shipped red in every `governed` and
    `agentic` scaffold while this file stayed green.
    """
    requirements = SKELETOR / "template" / "core" / "scripts" / "requirements.txt"
    pinned = [
        line.strip()
        for line in requirements.read_text(encoding="utf-8").splitlines()
        if re.match(r"^[A-Za-z0-9_.-]+==", line.strip())
    ]
    return pinned + EXTRA_PACKAGES


def make_venv(workdir: Path, quiet: bool) -> Path:
    """One venv, shared by every tree.

    The packages are tree-independent, and a venv per tier is three pip installs
    to learn the same thing once.
    """
    VENV_PACKAGES = toolchain()
    venv = workdir / ".venv-shared"
    if not quiet:
        print(f"   creating shared venv ({', '.join(VENV_PACKAGES)}) …")
    subprocess.run([sys.executable, "-m", "venv", str(venv)], check=True, capture_output=True)
    python = venv / "bin" / "python"
    proc = subprocess.run(
        [str(python), "-m", "pip", "install", "-q", "--disable-pip-version-check", *VENV_PACKAGES],
        capture_output=True,
        text=True,
    )
    if proc.returncode != 0:
        print(proc.stdout + proc.stderr)
        raise SystemExit("❌ could not install the verify toolchain")
    return python


def scaffold(tier: str, language: str, workdir: Path, name: Optional[str] = None) -> Tuple[Result, Path]:
    target = workdir / (name or f"{tier}-{language}")
    started = time.time()
    code, output = run(
        [
            sys.executable,
            str(SCAFFOLDER),
            str(target),
            "--name",
            "Probe",
            "--cli",
            CLI_NAME,
            "--tier",
            tier,
            "--language",
            language,
            "--tagline",
            "a scaffold under test",
            "--force",
        ],
        cwd=SKELETOR,
        # A git identity, because the machine may not have one and the scaffolder
        # makes a commit. A GitHub runner ships no `user.name`/`user.email`, so
        # without this the scaffolder takes its own "commit did not happen"
        # fallback and every tree arrives with a repository but no HEAD — which
        # is a real path it handles and warns about, and not the one the gates
        # below are written for. Controlling the variable is the same fix as
        # `--pythonpath` in `pyright_gate`: this was green here and red on the
        # first CI run, decided by config nobody set on purpose.
        env_extra={
            "GIT_AUTHOR_NAME": "skeletor-verify",
            "GIT_AUTHOR_EMAIL": "verify@skeletor.invalid",
            "GIT_COMMITTER_NAME": "skeletor-verify",
            "GIT_COMMITTER_EMAIL": "verify@skeletor.invalid",
        },
    )
    return Result(f"scaffold {tier}/{language}", code == 0, time.time() - started, output), target


def expected_command_names(tree: Path) -> List[str]:
    """The command names ``./probe --help`` must list, derived the way the tree
    derives them: one per ``cli/*.py`` that is neither private nor ``helpers``.

    The alias map is read out of the generated ``cli/__init__.py`` rather than
    copied here — a second copy of it would be the registry this whole shell
    exists to avoid.
    """
    init = (tree / "cli" / "__init__.py").read_text(encoding="utf-8")
    match = re.search(r"^_ALIASES = (\{[^}]*\})", init, re.MULTILINE)
    aliases = ast.literal_eval(match.group(1)) if match else {}

    names = []
    for module in sorted((tree / "cli").glob("*.py")):
        stem = module.stem
        if stem.startswith("_") or stem == "helpers":
            continue
        names.append(aliases.get(stem, stem))
    return names


def check_groups_register(tree: Path) -> Result:
    started = time.time()
    code, output = run([f"./{CLI_NAME}", "--help"], cwd=tree)
    if code != 0:
        return Result("cli --help", False, time.time() - started, output)

    expected = expected_command_names(tree)
    missing = [name for name in expected if not re.search(rf"^\s+{re.escape(name)}\b", output, re.MULTILINE)]
    ok = not missing
    detail = output if ok else f"{output}\n\nmodules present in cli/ but absent from --help: {missing}"
    return Result(f"cli --help registers {len(expected)} groups", ok, time.time() - started, detail)


def hook_args(tree: Path, hook: str) -> List[str]:
    """The args the tree's own pre-commit config passes to a lint hook."""
    config = (tree / ".pre-commit-config.yaml").read_text(encoding="utf-8")
    match = re.search(rf"- id: {re.escape(hook)}\b[^\n]*\n(?:\s+[^\n]*\n)*?\s+args: \[([^\]]*)\]", config)
    if not match:
        return []
    # Split on the YAML list's quotes, not on commas: `--select=E9,F63,F7` is
    # one argument that happens to contain commas, and splitting it produces a
    # flake8 invocation that fails in a way that looks like a broken gate.
    return [single or double for single, double in re.findall(r"'([^']*)'|\"([^\"]*)\"", match.group(1))]


#: Directories a fresh scaffold can contain that pre-commit would never hand a
#: hook, because git does not track them. Everything else that is a `.py` is.
UNTRACKED_DIRS = {".git", ".venv", ".venv-ci", "node_modules", "__pycache__", "tmp"}


def python_files(tree: Path) -> List[str]:
    """Every Python file in the tree, as the filenames pre-commit would pass."""
    return [
        str(path.relative_to(tree))
        for path in sorted(tree.rglob("*.py"))
        if not UNTRACKED_DIRS & set(path.relative_to(tree).parts)
    ]


def lint_gates(tree: Path, venv_python: Path) -> List[Result]:
    """The formatters and the linter, run exactly as the tree's hooks run them.

    This is the gate that was missing when a scaffold shipped 19 files black
    would rewrite and 20 unused imports flake8 rejects: `pre-commit run
    --all-files`, the first command the README tells a new user to run, was red
    on a tree nobody had touched.

    "Exactly" is carried by the **filenames**, and it used to be a lie: this ran
    each hook against `.`, which is how the tree's own `check lint` invokes
    them and not how pre-commit does. The difference is not cosmetic — flake8 applies its
    `exclude` list when it walks a directory and ignores it for a file named on
    the command line, so the two invocations answer differently about exactly
    the files somebody chose to exclude. A `docs` entry in `.flake8` matched the
    `scripts/docs/` component, and four dead imports shipped: green here and in
    `check lint`, red in the pre-commit hook that runs on a user's first commit.
    Passing filenames is also the strictly stronger of the two, since an exclude
    can only ever remove files — so this being green implies `flake8 .` is.
    """
    files = python_files(tree)
    results = [
        Result(
            f"lint sees {len(files)} python files",
            # A lint over nothing is green and worth nothing. The lower bound is
            # loose on purpose — it is here to catch an enumeration that broke,
            # not to be a file count somebody has to update.
            len(files) > 20 and any(f.startswith("scripts/docs/") for f in files),
            0.0,
            "\n".join(files),
        )
    ]
    for hook in LINT_HOOKS:
        args = hook_args(tree, hook)
        checkish = ["--check-only"] if hook == "isort" else ["--check"] if hook == "black" else []
        started = time.time()
        code, output = run([str(venv_python), "-m", hook, *args, *checkish, *files], cwd=tree)
        results.append(Result(f"{hook} {' '.join(args)}", code == 0, time.time() - started, output))
    return results


def pyright_entry(tree: Path) -> List[str]:
    """The arguments the tree's own pyright hook runs with.

    Read, not repeated, for the same reason as `hook_args`: the pyright hook
    names its config with `entry:` rather than `args:`, and a copy here would
    verify the template against an invocation the template does not use.
    """
    config = (tree / ".pre-commit-config.yaml").read_text(encoding="utf-8")
    match = re.search(r"- id: pyright\b[^\n]*\n(?:\s+[^\n]*\n)*?\s+entry: pyright ([^\n]*)", config)
    return match.group(1).split() if match else ["--project", "pyrightconfig.json"]


def warm_pyright(venv_python: Path) -> Tuple[bool, str]:
    """Fetch pyright's node toolchain once, before any tree is gated.

    The download happens on first run and is cached per machine, so doing it
    here keeps it out of the first tree's timing and — the point — turns "no
    network" into one honest skip rather than three type checks that fail for a
    reason that has nothing to do with the template.
    """
    code, output = run([str(venv_python), "-m", "pyright", "--version"], cwd=venv_python.parent)
    return code == 0, output.strip()


def pyright_gate(tree: Path, venv_python: Path, available: bool) -> List[Result]:
    """Whole-project type checking, the gate whose absence shipped red scaffolds.

    Skipped loudly, never silently, when the toolchain could not be fetched: a
    gate that quietly reports success when it did not run is worse than no gate,
    because it is indistinguishable from one that did.

    `filesAnalyzed` is asserted for the same reason the lint gate counts its
    files. pyright prints `0 errors` just as happily when its `include` paths
    match nothing, and this whole file exists because a check that inspected an
    empty set stayed green through the bug it was written to catch.
    """
    if not available:
        return [Result("pyright", True, 0.0, "skipped: toolchain unavailable (offline?)")]

    started = time.time()
    # The one gate that does not use `run()`, which merges the two streams.
    # `--outputjson` puts its report on stdout and everything else on stderr —
    # an unreadable config, an include path that resolves to nothing — so
    # merging them makes the JSON unparseable exactly when it carries the
    # explanation. Keeping them apart is what lets a bad config report itself.
    proc = subprocess.run(
        # `--pythonpath` is not optional here, and leaving it off is a green that
        # means nothing. pyright resolves imports against an interpreter it picks
        # off PATH — it does NOT read the tree's `.venv`, symlinked or otherwise
        # — so this gate silently checked whatever python the machine happened to
        # offer. On a developer box with `click` installed system-wide that is
        # every decorator resolved and a clean run; on a CI runner whose
        # setup-python has no `click` it is 24 errors, because
        # `reportMissingImports` is `none`, so an unresolved `click.group` leaves
        # the function undecorated and `@group.command()` becomes an attribute
        # access on a plain function. Same tree, same pyright, opposite answers,
        # decided by a package nobody installed on purpose.
        [str(venv_python), "-m", "pyright", *pyright_entry(tree), "--pythonpath", str(venv_python), "--outputjson"],
        cwd=str(tree),
        capture_output=True,
        text=True,
    )
    code, noise = proc.returncode, (proc.stderr or "").strip()
    try:
        report = json.loads(proc.stdout)
        summary = report["summary"]
        analyzed, errors = summary["filesAnalyzed"], summary["errorCount"]
    except (ValueError, KeyError):
        return [Result("pyright", False, time.time() - started, f"unreadable --outputjson:\n{noise}\n{proc.stdout}")]

    if errors:
        # Rendered from the JSON rather than dumped as it: the raw report is a
        # screenful of spans and rule metadata per finding, and a gate nobody
        # can read the output of is one people learn to skip.
        detail = "\n".join(
            f"{Path(d['file']).relative_to(tree)}:{d['range']['start']['line'] + 1} "
            f"{d.get('rule', 'error')} — {d['message'].splitlines()[0]}"
            for d in report.get("generalDiagnostics", [])
            if d.get("severity") == "error"
        )
    elif analyzed <= 20:
        detail = (
            f"pyright analyzed only {analyzed} files — its include paths have stopped matching the tree"
            f"{chr(10) + noise if noise else ''}"
        )
    else:
        detail = f"{analyzed} files analyzed, no errors"

    ok = code == 0 and errors == 0 and analyzed > 20
    return [Result(f"pyright ({analyzed} files)", ok, time.time() - started, detail)]


def node_gates(tree: Path) -> List[Result]:
    """eslint and prettier, once, on the one tree that has a package.json.

    The node overlay is identical across tiers, so this is one `npm install`
    rather than one per tier — and it is skipped loudly, never silently, when
    npm is absent.
    """
    if not shutil.which("npm"):
        return [Result("node gates", True, 0.0, "skipped: npm not on PATH")]

    started = time.time()
    code, output = run(["npm", "install", "--no-audit", "--no-fund", "--silent"], cwd=tree)
    if code != 0:
        return [Result("npm install", False, time.time() - started, output)]
    results = [Result("npm install", True, time.time() - started)]

    for script in ("lint:check", "format:check"):
        started = time.time()
        code, output = run(["npm", "run", "--silent", script], cwd=tree)
        results.append(Result(f"npm run {script}", code == 0, time.time() - started, output))
    return results


def gates(tree: Path, venv_python: Path, pyright_ok: bool) -> List[Result]:
    """The tree's own checks, run the way its user would run them."""
    results = []

    started = time.time()
    code, output = run(
        [str(venv_python), "-m", "pytest", "tests/", "-m", "unit", "-q"],
        cwd=tree,
        env_extra={"PYTHONPATH": str(tree)},
    )
    results.append(Result("pytest -m unit", code == 0, time.time() - started, output))

    # `check output` is here and not only in `pre-push` because it is the gate
    # that keeps every OTHER gate's `--json` readable, and pre-push is not one of
    # the commands this script runs.
    for command in (["check", "docs"], ["check", "merge-drivers"], ["check", "output"]):
        started = time.time()
        code, output = run([f"./{CLI_NAME}", *command], cwd=tree)
        results.append(Result(f"{CLI_NAME} {' '.join(command)}", code == 0, time.time() - started, output))

    results.append(check_docs_gate_sees_the_tree(tree))
    results += check_empty_suite_is_not_red(tree, venv_python)
    results.append(check_upgrade_is_noop(tree))
    results.append(check_groups_register(tree))
    results.append(check_script_targets(tree))
    results.append(check_version_resolves(tree))
    results.append(check_no_baked_paths(tree))
    results.append(check_setup_block_is_self_contained(tree))
    results.append(check_scaffold_is_its_own_repo(tree))
    results += lint_gates(tree, venv_python)
    results += pyright_gate(tree, venv_python, pyright_ok)
    results += actionlint_gate(tree, venv_python.parent)
    return results


def workflow_files(tree: Path) -> List[str]:
    """Every workflow a scaffold ships, as paths relative to the tree."""
    workflows = tree / ".github" / "workflows"
    return sorted(
        str(path.relative_to(tree))
        for path in list(workflows.glob("*.yml")) + list(workflows.glob("*.yaml"))
    )


def actionlint_gate(tree: Path, venv_bin: Path) -> List[Result]:
    """The workflows a scaffold ships are valid GitHub Actions.

    Four of them ship — `ci.yml`, `docs-validation.yml`, `pr-draft-discipline.yml`
    and, from `governed`, `coverage-nightly.yml` — and until this gate not one had
    ever been executed, or read by anything that understands Actions.
    `tests/test_ci_draft_gate.py` asserts the pieces of `ci.yml` that are
    load-bearing, but it does it with a regex over the file as text.

    What this adds, each one confirmed by planting it: an expression whose syntax
    is wrong, a `needs.<job>` naming a job that does not exist, a job output
    somebody renamed, an unknown runner label, and — where shellcheck is on PATH
    — the `run:` blocks.

    What it does not add, checked rather than assumed: it does not verify that an
    action reference resolves. `actions/checkout@v99` passes this green, because
    knowing better takes a network call. That belongs to an end-to-end test that
    actually runs these workflows, and its absence here is why this gate is
    milliseconds.

    This is the one lint here that does **not** read its arguments out of the
    tree's `.pre-commit-config.yaml`. Two reasons are available for that and only
    one of them survives: the tree has no actionlint hook to read (a fact about
    today, which shipping such a hook would falsify), and this gate is not asking
    the tree's question anyway (a fact about what it is for, which nothing
    falsifies). The second is the load-bearing one. black, isort, flake8 and
    pyright ask "does this tree govern itself", and are read from its config so
    the answer is the tree's own; this asks "is what skeletor ships valid at
    all" — the same question `check_no_baked_paths` asks, and equally not the
    tree's business. So shipping actionlint as a hook in the generated tree
    would be a different and also good change, since it would check a user's own
    edits to these files — and it would **not** make this gate read its
    arguments from there.

    The reasons are separated because the first kind expires silently. A rule
    whose stated reason names something broken or absent loses that reason the
    day somebody fixes it, and nothing goes red to say so — see the CI badge in
    `docs/DESIGN_RATIONALE.md`, which was pinned for a defect that no longer
    exists and is still pinned, correctly, for a different reason entirely.
    """
    started = time.time()
    workflows = workflow_files(tree)
    if not workflows:
        # The `filesAnalyzed` lesson, in the tool that has no equivalent field:
        # bare `actionlint` walks for workflows and exits 0 having found none.
        return [Result("actionlint", False, time.time() - started,
                       "no workflows under .github/workflows — a green here would mean nothing")]

    binary = venv_bin / "actionlint"
    if not binary.exists():
        return [Result("actionlint", True, 0.0, "skipped: toolchain unavailable (offline?)")]

    code, output = run([str(binary), *workflows], cwd=tree)
    # actionlint lints `run:` blocks by shelling out to shellcheck, and when it
    # is absent it simply does not, without saying so. GitHub's ubuntu runners
    # ship shellcheck and a developer box may not, so the two answer differently
    # about the same file — the pyright lesson wearing a different tool. Which
    # check actually ran goes in the label rather than being left to be assumed.
    depth = "with shellcheck" if shutil.which("shellcheck") else "no shellcheck"
    return [Result(f"actionlint ({len(workflows)} workflows, {depth})", code == 0,
                   time.time() - started, output)]

def check_docs_gate_sees_the_tree(tree: Path) -> Result:
    """`check docs` passing is worth nothing if its source→doc checker looked at
    no files.

    This exists because it happened. `check_source_doc_refs.py` matched its skip
    list against the ABSOLUTE path, and every tree this script generates lives
    under `/tmp` — so `tmp` matched an ancestor, every file was skipped, and the
    checker reported "0 references, all resolve" while the same tree in the
    user's home directory failed on three references the template itself ships.
    Verify was green for as long as that bug existed, which is the whole reason
    it reached a user's first CI run.

    A gate that cannot report how much it inspected cannot be trusted to have
    inspected anything, so the assertion here is on the count, not the exit code.
    """
    started = time.time()
    code, output = run([sys.executable, "scripts/check_source_doc_refs.py", "--json"], cwd=tree)
    match = re.search(r'"checked"\s*:\s*(\d+)', output)
    checked = int(match.group(1)) if match else 0
    passed = code == 0 and checked > 0
    if not match:
        output = f"--json emitted no `checked` count\n{output}"
    elif checked == 0:
        output = f"source -> doc refs inspected 0 references: the walk skipped the whole tree\n{output}"
    return Result(f"check docs inspects the tree ({checked} source refs)", passed, time.time() - started, output)


#: Print the markers whose row says a scaffold ships no tests for them. Read
#: from the tree rather than named here for the reason the lint arguments are:
#: a copy would verify the template against a registry the template does not
#: have, and would stay green while doing it.
_TOLERANT_SUITES = (
    "import sys; sys.path.insert(0, '.'); "
    "from cli.test_cmds import SUITES; "
    "print(' '.join(m for m, s in SUITES.items() if not s.ships_tests))"
)


def check_empty_suite_is_not_red(tree: Path, venv_python: Path) -> List[Result]:
    """Every suite the scaffold ships no tests for must not fail on arrival.

    pytest exits 5 when a marker selects nothing, and no scaffold can ship a
    test that needs a stack, a browser or a display it does not know about — so
    `test integration` and the CI job running the same selection were red on
    every fresh tree, and stayed red until somebody wrote their first
    integration test.

    This ran nowhere before: verify ran `pytest -m unit` directly and never the
    CLI's own suite commands, so the one selection guaranteed to be empty was
    the one nothing exercised.

    It named `integration` for as long as that was the only such suite, which is
    the shape Rule 2 is about: `ui` arrived, took the identical code path, and
    this gate would not have noticed either way. The set is discovered now, and
    an empty one fails — a loop over nothing passes every assertion in it.
    """
    started = time.time()
    code, listed = run([str(venv_python), "-c", _TOLERANT_SUITES], cwd=tree)
    markers = listed.split()
    if code != 0 or not markers:
        return [
            Result(
                "test on an empty suite: which suites tolerate one",
                False,
                time.time() - started,
                f"could not read SUITES out of the tree's cli/test_cmds.py\n{listed}",
            )
        ]

    results = []
    for marker in markers:
        started = time.time()
        code, output = run([f"./{CLI_NAME}", "test", marker], cwd=tree)
        results.append(Result(f"test {marker} on an empty suite", code == 0, time.time() - started, output))
    return results


def check_upgrade_is_noop(tree: Path) -> Result:
    """`skeletor-upgrade` against the checkout that just generated the tree must
    find nothing to do.

    It is the cheapest possible test of `.skeletor.json`, and it fails on the
    two things that actually break: the recorded arguments must round-trip
    through `substitutions()` to the same values — `--slug`, `--cli` and
    `--env-prefix` all default from the *target directory name*, and an upgrade
    renders into a temporary directory with a different one — and the render
    must be deterministic. A manifest that cannot reproduce its own tree makes
    every later upgrade a diff against the wrong base, which is worse than no
    upgrade at all because it looks like it worked.
    """
    started = time.time()
    code, output = run(
        [sys.executable, str(SKELETOR / "bin" / "skeletor-upgrade"), str(tree), "--dry-run", "--from-dir", str(SKELETOR)],
        cwd=tree,
    )
    passed = code == 0 and "already current" in output

    # And again from the recorded hashes alone, which is the path taken when
    # skeletor's history is out of reach. It exercises a different comparison
    # entirely, and it is the one nobody runs by hand — so it is the one that
    # would rot. A mismatch here means the manifest cannot describe the tree it
    # was written from, which is exactly when the fallback would misclassify an
    # edited file as untouched and overwrite it.
    offline_code, offline_output = run(
        [sys.executable, str(SKELETOR / "bin" / "skeletor-upgrade"), str(tree), "--dry-run", "--no-base"],
        cwd=tree,
    )
    passed = passed and offline_code == 0 and "already current" in offline_output
    return Result(
        "skeletor-upgrade is a no-op on a fresh tree (rendered and offline)",
        passed,
        time.time() - started,
        output + "\n" + offline_output,
    )


def check_version_resolves(tree: Path) -> Result:
    """`--version` reports a release, and never a tag that is not one.

    Nothing here exercised the generated tree's `--version`, and it was wrong on
    every scaffold from the first commit: `git describe --tags --always` returns
    an abbreviated sha when no tag exists, so a fresh tree reported
    `version 4f2a91c` while shipping a `VERSION` file that said `0.1.0` — the
    docstring's own fallback made unreachable by its own arguments.

    A fresh tree is exactly why the gap survived. It has no tags, so the sha path
    looked like a plausible answer rather than a broken one, and the two states
    that expose it — a non-release tag, and a release tag — need a repository
    with a history that no generated tree has. stash.flow found it by tagging
    `archive/v1` to mark where their v1 left off, and getting
    `version archive/v1-3-ga363012` back.

    So the gate manufactures the history: no tags, then a non-release tag, then a
    release tag. All three assertions are needed — with only the first, `--match`
    is unobservable; with only the last, `--always` is.
    """
    started = time.time()
    # On a COPY. This gate manufactures history — two tags and a commit — and the
    # tree is shared with every other gate in the sequence, one of which asserts
    # the scaffold is still at its first commit. It broke that one on the first
    # run. A gate that mutates shared state is order-dependent by construction,
    # which is a worse property than the bug it was written to catch.
    work = tree.parent / f"{tree.name}-version"
    shutil.rmtree(work, ignore_errors=True)
    shutil.copytree(tree, work, symlinks=True)

    def version() -> str:
        return run([f"./{CLI_NAME}", "--version"], cwd=work, env_extra={"PYTHONPATH": str(work)})[1].strip()

    declared = (work / "VERSION").read_text(encoding="utf-8").strip()

    untagged = version()
    git_in(work, "tag", "archive/v1")
    git_in(work, "commit", "-q", "--allow-empty", "-m", "chore: past the archive marker")
    non_release = version()
    git_in(work, "tag", f"v{declared}")
    released = version()

    ok = (
        declared in untagged  # the VERSION fallback is reachable
        and "archive/v1" not in non_release  # a non-release tag is not a version
        and declared in non_release
        and f"v{declared}" in released  # a release tag wins when there is one
    )
    return Result(
        f"--version reports a release, not any tag ({declared})",
        ok,
        time.time() - started,
        f"untagged: {untagged}\nnon-release tag: {non_release}\nreleased: {released}",
    )


def check_script_targets(tree: Path) -> Result:
    """Every `script(...)` call in the tree's CLI must name a file that exists.

    `script()` joins its first argument onto `PROJECT_ROOT`, so a *flag* passed
    to it — `script("-m", "pytest", ...)` — becomes the path `<root>/-m` and the
    command fails on a file that was never going to exist. That shipped: it made
    `check pre-push`, the first command the scaffolder tells a user to run,
    impossible to pass at every tier.

    Discovered by parsing, not listed here: any new `script()` call is checked by
    existing. `module()` is the door for flags, so its argument is only required
    not to look like one.
    """
    started = time.time()
    problems = []
    for source in sorted((tree / "cli").glob("*.py")):
        tree_ast = ast.parse(source.read_text(encoding="utf-8"))
        for node in ast.walk(tree_ast):
            if not isinstance(node, ast.Call) or not isinstance(node.func, ast.Name):
                continue
            if not node.args or not isinstance(node.args[0], ast.Constant):
                continue
            first = node.args[0].value
            if not isinstance(first, str):
                continue
            if node.func.id == "script" and not (tree / first).exists():
                problems.append(f"{source.name}:{node.lineno}: script({first!r}) → no such file in the tree")
            elif node.func.id == "module" and first.startswith("-"):
                problems.append(f"{source.name}:{node.lineno}: module({first!r}) is a flag, not a module")

    return Result(
        "cli script()/module() targets resolve",
        not problems,
        time.time() - started,
        "\n".join(problems),
    )


def check_no_baked_paths(tree: Path) -> Result:
    """No generated source may contain the tree's own absolute path.

    A substitution that bakes the scaffold-time location into a file is wrong
    the moment the repo is cloned or moved, and it fails silently — `CRON_CWD`
    shipped that way and would have written crontab lines pointing at a
    directory the user had renamed. Derive from `__file__` instead.

    This is the length-independent half of the guard. The formatter alone was
    not enough: `black` rewrites an over-long string assignment only when
    wrapping it in parentheses would actually fit, so the same bug is visible
    for one narrow band of path lengths and invisible on either side of it.
    """
    started = time.time()
    needle = str(tree)
    hits = []
    for path in sorted(tree.rglob("*")):
        if not path.is_file() or ".git" in path.parts or "node_modules" in path.parts:
            continue
        if path.suffix.lower() in {".png", ".jpg", ".jpeg", ".gif", ".pdf", ".ico", ".woff", ".woff2"}:
            continue
        try:
            text = path.read_text(encoding="utf-8")
        except (UnicodeDecodeError, OSError):
            continue
        if needle in text:
            line = next((i for i, ln in enumerate(text.splitlines(), 1) if needle in ln), 0)
            hits.append(f"{path.relative_to(tree)}:{line}: contains the scaffold-time absolute path")

    return Result("no scaffold-time paths baked into the tree", not hits, time.time() - started, "\n".join(hits))


#: Tools the generated Setup block is allowed to look up on PATH, with the
#: reason each one has no in-tree path to be run by.
#:
#: `python` only ever bootstraps the venv — at that line there is by definition
#: no `.venv/bin/python` to use instead. `npm` ships with node and has no
#: per-tree copy. Everything else must be run by path.
SETUP_PATH_LOOKUPS = {"npm"}


#: A fenced ``bash`` block that installs dependencies, and the two toolchains a
#: scaffold can carry. Kept in step with ``tests/test_setup_blocks_agree.py``,
#: which asks the *other* question about the same blocks — see below.
SETUP_FENCE = re.compile(r"```bash\n(?P<body>.*?)```", re.DOTALL)
SETUP_INSTALLS = re.compile(r"pip install\s+-r\s+[\w./-]+|npm install")
SETUP_REQUIREMENTS = re.compile(r"pip install\s+-r\s+(?P<target>[\w./-]+)")


def setup_blocks_in(tree: Path) -> Dict[str, List[str]]:
    """`{document: [command lines]}`, the same enrolment the shipped test uses."""
    found: Dict[str, List[str]] = {}
    code, listing = git_in(tree, "ls-files", "*.md")
    if code != 0:
        return found
    for name in listing.split():
        document = tree / name
        for match in SETUP_FENCE.finditer(document.read_text(encoding="utf-8")):
            lines = [line.split("#", 1)[0].rstrip() for line in match.group("body").splitlines()]
            lines = [line for line in lines if line.strip()]
            if not any(SETUP_INSTALLS.search(line) for line in lines):
                continue
            if any(line.strip().startswith("cd ") for line in lines):
                continue
            found[name] = lines
    return found


def check_setup_blocks_agree(tree: Path, tier: str, language: str) -> Result:
    """The shipped drift check's two inputs are right *for this language*.

    `tests/test_setup_blocks_agree.py` runs in the tree and is the real check.
    It cannot run here for every configuration — `gated_language` is `python`,
    so a node tree's own suite is never executed by this verifier — and both of
    its inputs vary along exactly the axis it does not cover.

    So this asks the generator's half of the question, which is the half no
    tree can ask about itself:

    * `{{SETUP_SHARED_PREFIX}}` is rendered from `len(setup_commands())` and the
      shipped ratchet asserts equality with the measured depth. If a document's
      first *unshared* line ever became shared, the rendered floor would sit one
      below the truth and every fresh scaffold would be red on arrival — the one
      outcome this repository refuses. That is an assumption about template
      prose, held here where all three languages are generated.
    * Every enrolled block installs the host toolchain. `cli/`, `tests/` and
      `scripts/` ship at the base tier, so a scaffold is a python project at
      every `--language`; `node` documented `npm install` alone and its own
      quick start could not run past line two.

    Both halves were established by planting the bug they claim to catch.
    """
    started = time.time()
    label = f"setup blocks: rendered floor and toolchain ({language})"
    blocks = setup_blocks_in(tree)
    if len(blocks) < 2:
        return Result(label, False, time.time() - started,
                      f"enrolled {len(blocks)} setup block(s) — a drift check needs at least two, "
                      "and a scan that finds nothing passes having looked at nothing")

    budget = tree / "tests" / "setup_block_budget.json"
    if not budget.exists():
        return Result(label, False, time.time() - started, "tests/setup_block_budget.json is missing")
    floor = json.loads(budget.read_text(encoding="utf-8"))["min_shared_prefix"]

    depth = 0
    for column in zip(*blocks.values()):
        if len(set(column)) != 1:
            break
        depth += 1

    problems = []
    if depth != floor:
        problems.append(
            f"the rendered floor is {floor} and the blocks actually agree on {depth} leading "
            f"line(s); a fresh {language} scaffold is red on arrival"
        )
    for name, lines in sorted(blocks.items()):
        installed = {
            match.group("target")
            for line in lines
            if (match := SETUP_REQUIREMENTS.search(line))
        }
        if "scripts/requirements.txt" not in installed:
            problems.append(
                f"{name} never installs scripts/requirements.txt — it installs "
                f"{sorted(installed) or 'nothing'}, so the CLI its next line calls is absent"
            )

    return Result(
        f"setup blocks: {len(blocks)} blocks, floor {floor} ({language})",
        not problems,
        time.time() - started,
        "\n".join(problems),
    )


def check_setup_block_is_self_contained(tree: Path) -> Result:
    """Every command in the generated README's Setup block runs a tool by path.

    This is the first thing a new reader runs, and it shipped failing on line
    one. The block said `pip install -r scripts/requirements.txt && pre-commit
    install --install-hooks`: on Arch, Debian 12+, Ubuntu 23.04+, Fedora or
    Homebrew macOS, pip refuses an externally-managed environment outright (PEP
    668) and the reader is stopped at the first line of the file that exists to
    onboard them; everywhere else it installs system-wide, and then `pre-commit`
    is not on PATH because the venv that would have provided it was never made.

    It is checked here rather than in `setup_commands()` because the README is
    the artifact — the thing a user reads and pastes — and because the failure
    is platform-dependent. Actually running the block would find this on this
    developer's box and never on a CI runner, whose `setup-python` is not
    externally managed. A static rule finds it on both.
    """
    started = time.time()
    readme = (tree / "README.md").read_text(encoding="utf-8")
    match = re.search(r"^## Setup\n+```bash\n(.*?)^```", readme, re.MULTILINE | re.DOTALL)
    if not match:
        return Result("README Setup block runs tools by path", False, time.time() - started,
                      "no '## Setup' bash block in the generated README")

    commands = [
        segment.strip()
        for line in match.group(1).splitlines()
        if line.strip() and not line.strip().startswith("#")
        for segment in line.split("&&")
        if segment.strip()
    ]
    if not commands:
        return Result("README Setup block runs tools by path", False, time.time() - started,
                      "the Setup block is empty — nothing was checked")

    bare = []
    for command in commands:
        tool = command.split()[0]
        if tool.startswith(("./", ".venv/bin/")) or tool in SETUP_PATH_LOOKUPS:
            continue
        if tool in ("python", "python3") and command.split()[1:3] == ["-m", "venv"]:
            continue
        bare.append(f"{command!r} resolves {tool!r} through PATH")

    return Result(
        f"README Setup block runs {len(commands)} commands by path",
        not bare,
        time.time() - started,
        "\n".join(bare),
    )


def check_scaffold_is_its_own_repo(tree: Path) -> Result:
    """A fresh scaffold is a repository of its own, with its first commit made.

    "Governs itself from its first commit" is not true of a tree that has none,
    and three shipped consequences say so. isort's `skip_gitignore` shells out
    to `git ls-files`, so the very first `check pre-push` a new user runs opened
    with `fatal: not a git repository` three times — on the run the setup guide
    prescribes specifically to show that a scaffold is green. The `regen-docs`
    merge driver is defined in `.git/config` and so cannot be installed at all.
    And `check reports` and every worktree command need a HEAD to diff against.

    All three came from the documented invocation carrying `--no-git`, which
    reads as the careful choice for scaffolding into a repo that already exists
    and is a no-op in exactly that case — the scaffolder skips a tree with a
    `.git` regardless. It only ever bit the empty directory it looked safest in.

    The toplevel assertion is the other half, and it is the one that would go
    unnoticed: a tree generated *inside* another repository has git answering
    every question about the parent, so `check merge-drivers` passes by reading
    a driver installed for something else entirely. Green, and about the wrong
    repository.
    """
    started = time.time()
    problems = []

    code, top = run(["git", "rev-parse", "--show-toplevel"], cwd=tree)
    if code != 0:
        problems.append("not a git repository at all — the scaffold made no `git init`")
    elif Path(top.strip()).resolve() != tree.resolve():
        problems.append(f"git resolves this tree to {top.strip()} — it is borrowing an enclosing repository")
    else:
        code, count = run(["git", "rev-list", "--count", "HEAD"], cwd=tree)
        if code != 0:
            problems.append(
                "the repository has no HEAD — the first commit was never made. "
                "Usually no git identity on this machine: the scaffolder warns and carries on, "
                "so check for `user.name`/`user.email` before suspecting the template"
            )
        elif count.strip() != "1":
            problems.append(f"expected exactly one scaffold commit, found {count.strip()}")

    return Result("scaffold is its own repo, at its first commit", not problems, time.time() - started,
                  "\n".join(problems))


def agentless_gate(tier: str, workdir: Path, venv_python: Path) -> List[Result]:
    """`--agent none` must produce a tree with no vendor directory that still
    passes its own gates.

    This is the separability claim, and it was false until it was checked. With
    the rule files under `.claude/rules/`, deleting that directory left six
    broken links in `docs/DEVELOPMENT.md`, `docs/README.md`, `.github/
    CONTRIBUTING.md` and a *generated* `docs/TODO/README.md` — so the tree could
    not survive losing tooling that nothing in it actually depended on, and the
    generator recreated one of the dead links on every run.

    Asserted at the fullest tier because that is where the vendor files are:
    lower tiers ship two, `agentic` ships seven.
    """
    results = []
    target = workdir / "agentless"
    started = time.time()
    code, output = run(
        [sys.executable, str(SCAFFOLDER), str(target), "--name", "Agentless", "--slug", "agentless",
         "--cli", CLI_NAME, "--tier", tier, "--language", "python", "--agent", "none", "--no-git"],
        cwd=workdir,
    )
    if code != 0:
        return [Result(f"--agent none: scaffold {tier}", False, time.time() - started, output)]
    results.append(Result(f"--agent none: scaffold {tier}", True, time.time() - started, output))

    started = time.time()
    stray = sorted(p.relative_to(target).as_posix() for p in target.rglob(".claude"))
    results.append(
        Result(
            "--agent none: no vendor directory",
            not stray,
            time.time() - started,
            f"unexpected: {stray}" if stray else "",
        )
    )

    # The rules are conventions, not tooling — they ship either way. A tree that
    # dropped them with the vendor directory would be the segmentation bug this
    # gate exists to catch, not a smaller tree.
    started = time.time()
    rules = sorted(p.name for p in (target / "docs" / "rules").glob("*.md"))
    results.append(
        Result(
            f"--agent none: keeps {len(rules)} rule file(s)",
            len(rules) >= 5,
            time.time() - started,
            f"found: {rules}",
        )
    )

    # The wrapper needs an interpreter with click on it, the same borrowed venv
    # every other generated tree here uses.
    (target / ".venv").symlink_to(venv_python.parents[1])
    started = time.time()
    code, output = run([f"./{CLI_NAME}", "check", "docs"], cwd=target, env_extra={"PYTHONPATH": str(target)})
    results.append(Result("--agent none: check docs", code == 0, time.time() - started, output))
    return results


#: A checker that cannot run on a bare host, in the three states that matter.
#: Written here rather than shipped, because a tree that SHIPPED one would be a
#: tree whose own `check pre-push` is red on arrival.
_CONTAINER_CHECKER = '''#!/usr/bin/env python3
"""A checker that only runs with the repository mounted in a container."""
{declaration}
import sys

sys.path.insert(0, "/nonexistent-container-mount")
import definitely_not_installed  # noqa: F401
'''


def host_exemption_gate(tier: str, workdir: Path, venv_python: Path) -> List[Result]:
    """`CANNOT_RUN_ON_HOST` excuses a checker, and only while it is true.

    `tests/test_output_contract.py` runs every `scripts/check_*.py` as a host
    subprocess, which is right for a fresh scaffold and false for a tree that
    grows a checker needing a container mount, a service, or a credential.
    jam.sense hit it on their first adoption and had nowhere to put the
    exemption: `output_allowlist.yaml` answers the *source-shape* question, and
    its staleness check deletes an entry the moment the source check passes — so
    a container-only checker that correctly declares `--json` has its exemption
    reported stale, and removing it re-breaks the behavioural test. One file,
    two consumers, two questions.

    Every branch of the fix ships untested in a scaffold, because a scaffold has
    no such checker — the exempt path exists for trees this repository cannot
    see. That is `declined_gate`'s lesson exactly: report text written for a
    branch nothing exercises. So it is planted here, in all three states.
    """
    results: List[Result] = []
    started = time.time()
    target = workdir / "host-exemption"
    code, output = run(
        [sys.executable, str(SCAFFOLDER), str(target), "--name", "Hosted", "--slug", "hosted",
         "--cli", CLI_NAME, "--tier", tier, "--language", "python"],
        cwd=workdir,
    )
    if code != 0:
        return [Result("host exemption: scaffold", False, time.time() - started, output)]
    (target / ".venv").symlink_to(venv_python.parents[1])

    planted = target / "scripts" / "check_planted_container_only.py"
    suite = ["-m", "pytest", "tests/test_output_contract.py", "-q", "--no-header"]

    def outcome(declaration: str) -> Tuple[bool, str]:
        planted.write_text(_CONTAINER_CHECKER.format(declaration=declaration), encoding="utf-8")
        assert planted.exists(), "the plant did not land"
        code, output = run([str(venv_python), *suite], cwd=target, env_extra={"PYTHONPATH": str(target)})
        return code == 0, output

    cases = [
        ("", False, "an undeclared container-only checker fails"),
        ('CANNOT_RUN_ON_HOST = "needs the container mount"', True, "a declared one is excused"),
        ('CANNOT_RUN_ON_HOST = ""', False, "an empty reason buys nothing"),
    ]
    for declaration, expected_green, label in cases:
        started = time.time()
        green, output = outcome(declaration)
        results.append(
            Result(
                f"host exemption: {label}",
                green is expected_green,
                time.time() - started,
                f"suite was {'green' if green else 'red'}, expected {'green' if expected_green else 'red'}\n{output}",
            )
        )

    # The staleness direction: the container dependency goes, the claim stays.
    started = time.time()
    planted.write_text(
        "#!/usr/bin/env python3\n"
        '"""It runs on the host now, and still says it cannot."""\n'
        'CANNOT_RUN_ON_HOST = "needs the container mount"\n'
        "import argparse, json, sys\n"
        'parser = argparse.ArgumentParser()\n'
        'parser.add_argument("--json", action="store_true")\n'
        "if parser.parse_args().json:\n"
        "    json.dump({\"ok\": True}, sys.stdout)\n",
        encoding="utf-8",
    )
    code, output = run([str(venv_python), *suite], cwd=target, env_extra={"PYTHONPATH": str(target)})
    results.append(
        Result(
            "host exemption: a claim that stopped being true is reported stale",
            code != 0 and "outlived its reason" in output,
            time.time() - started,
            output,
        )
    )
    planted.unlink()
    return results


def versioning_gate(tier: str, workdir: Path, venv_python: Path) -> List[Result]:
    """`--versioning tag` produces a tree that passes its own gates.

    The flag is a **subtraction and nothing else**, which is the only shape a
    scaffold flag gets here: the scaffold is skeletor's only test, so a mode
    that wrote files differently would need a verification grid this repository
    cannot afford, and it would put a conditional in every doc describing the
    workflow. What it removes is the machinery that owns a version — the Release
    Please config and manifest, `VERSION`, and the release-train skill, which is
    a state machine for a release PR nobody will open.

    Three things are asserted and the second is the one that would otherwise rot:

    * The omitted files are gone, **and present in the default mode**. Without
      the second half an empty omit set passes the first trivially, which is
      this repository's own rule about a negative over an empty set.
    * The prose swapped rather than merely shrank. `--versioning tag` still HAS
      a release procedure — `git tag -a`, which is how skeletor itself is
      versioned — so a `## Releases` heading with nothing under it would be a
      worse outcome than the wrong paragraph. `drop_absent_prose` ships the true
      half of each alternative.
    * The tree is green: `check docs`, and the unit suite, which is where a
      dangling link or a doc-table row for a file nobody shipped surfaces.

    Tier composition covers the references across all 36 configurations and
    cannot cover these: it asks whether a path resolves, not whether the
    sentence around it is true, and not whether the tree still runs.
    """
    results: List[Result] = []
    scaffolder = load_scaffolder()
    omitted = sorted(scaffolder.VERSIONING["tag"])

    started = time.time()
    target = workdir / "versioning-tag"
    code, output = run(
        [sys.executable, str(SCAFFOLDER), str(target), "--name", "Tagged", "--slug", "tagged",
         "--cli", CLI_NAME, "--tier", tier, "--language", "python", "--versioning", "tag"],
        cwd=workdir,
    )
    if code != 0:
        return [Result("--versioning tag: scaffold", False, time.time() - started, output)]
    results.append(Result("--versioning tag: scaffold", True, time.time() - started, output))

    started = time.time()
    default = workdir / "versioning-default"
    run(
        [sys.executable, str(SCAFFOLDER), str(default), "--name", "Default", "--slug", "defaulted",
         "--cli", CLI_NAME, "--tier", tier, "--language", "python"],
        cwd=workdir,
    )
    present = [rel for rel in omitted if (target / rel).exists()]
    missing_by_default = [rel for rel in omitted if not (default / rel).exists()]
    results.append(
        Result(
            f"--versioning tag: omits {len(omitted)} file(s) the default ships",
            bool(omitted) and not present and not missing_by_default,
            time.time() - started,
            f"still present under tag: {present}\nnever shipped by default: {missing_by_default}",
        )
    )

    # The swap, not the shrink. Both directions, because a `drop_absent_prose`
    # that dropped every block would leave the heading bare and pass a check
    # that only looked for the absence of the wrong words.
    started = time.time()
    development = (target / "docs" / "DEVELOPMENT.md").read_text(encoding="utf-8")
    default_dev = (default / "docs" / "DEVELOPMENT.md").read_text(encoding="utf-8")
    swapped = (
        "Release Please" not in development
        and "git tag -a" in development
        and "Release Please" in default_dev
        and "git tag -a" not in default_dev
    )
    results.append(
        Result(
            "--versioning tag: the release prose swapped, it did not just vanish",
            swapped,
            time.time() - started,
            f"tag tree names Release Please: {'Release Please' in development}\n"
            f"tag tree names `git tag -a`: {'git tag -a' in development}\n"
            f"default tree names Release Please: {'Release Please' in default_dev}",
        )
    )

    (target / ".venv").symlink_to(venv_python.parents[1])
    for command, label in (
        (["check", "docs"], "check docs"),
        (["test", "unit"], "unit suite"),
    ):
        started = time.time()
        code, output = run([f"./{CLI_NAME}", *command], cwd=target, env_extra={"PYTHONPATH": str(target)})
        results.append(Result(f"--versioning tag: {label}", code == 0, time.time() - started, output))

    # `unknown` is the honest answer before the first tag, and the tag after it.
    # A tree with no VERSION file to fall back on is exactly where `get_version`
    # had been describing a fallback it could not take.
    started = time.time()
    before = run([f"./{CLI_NAME}", "--version"], cwd=target)[1].strip()
    git_in(target, "tag", "-a", "v0.3.0", "-m", "first")
    after = run([f"./{CLI_NAME}", "--version"], cwd=target)[1].strip()
    results.append(
        Result(
            "--versioning tag: --version is `unknown` until tagged, then the tag",
            before.endswith("unknown") and after.endswith("v0.3.0"),
            time.time() - started,
            f"untagged: {before}\ntagged:   {after}",
        )
    )
    return results


def badge_gate(tier: str, workdir: Path, venv_python: Path) -> List[Result]:
    """`--org` decides whether the README carries badges, and the default is none.

    Both halves are the check, and the absent half is the one that matters. A
    badge names a repository; the `--org` default names one that does not exist,
    so a scaffold that shipped badges unconditionally would open every README
    with a broken image — a gate that is red on arrival, wearing a cosmetic hat.

    The CI badge is asserted to carry `?branch=<release branch>`, against a
    release branch deliberately NOT left at its default so that a hard-coded
    `main` in the scaffolder fails here. Without that parameter a workflow badge
    reports the repository's default branch — the `--base-branch` that
    `skeletor-new` creates with `git init -b` — where `ci.yml` has no `push`
    trigger at all, and the badge reads "no status" for the life of the project.

    The empty case is checked byte-for-byte rather than by absence, because the
    way it breaks is whitespace: a `{{BADGES}}` that renders to nothing on its
    own line leaves a double blank line under the title, which `prettier`
    rewrites on a tree nobody has touched.
    """
    results = []

    # The trees the main loop generated all take the `--org` default.
    plain = workdir / f"{tier}-python" / "README.md"
    started = time.time()
    if not plain.exists():
        results.append(Result("badges: absent without --org", True, 0.0, "skipped: no python tree at this tier"))
    else:
        head = plain.read_text()[:64]
        expected_head = "# Probe\n\na scaffold under test\n"
        results.append(
            Result(
                "badges: absent without --org",
                head.startswith(expected_head),
                time.time() - started,
                f"README opens with: {head!r}",
            )
        )

    target = workdir / "badged"
    started = time.time()
    code, output = run(
        [sys.executable, str(SCAFFOLDER), str(target), "--name", "Badged", "--slug", "badged",
         "--cli", CLI_NAME, "--tier", tier, "--language", "both", "--org", "acme",
         "--release-branch", "trunk", "--no-git"],
        cwd=workdir,
    )
    if code != 0:
        results.append(Result("badges: scaffold --org", False, time.time() - started, output))
        return results
    results.append(Result("badges: scaffold --org", True, time.time() - started, output))

    started = time.time()
    readme = (target / "README.md").read_text()
    required = [
        "https://img.shields.io/github/v/release/acme/badged",
        "https://github.com/acme/badged/releases",
        "/acme/badged/ci.yml?branch=trunk",
        "https://github.com/acme/badged/actions/workflows/ci.yml",
    ]
    missing = [needle for needle in required if needle not in readme]
    results.append(
        Result(
            "badges: present with --org, pinned to the release branch",
            not missing,
            time.time() - started,
            f"missing from README: {missing}" if missing else readme[:400],
        )
    )

    # A badge is markup in a file two checkers read. `check docs` is what says
    # the row did not cost the tree its own docs gate.
    (target / ".venv").symlink_to(venv_python.parents[1])
    started = time.time()
    code, output = run([f"./{CLI_NAME}", "check", "docs"], cwd=target, env_extra={"PYTHONPATH": str(target)})
    results.append(Result("badges: check docs", code == 0, time.time() - started, output))

    # The badge row is one very long markdown line, and every OTHER tree checked
    # here takes the `--org` default — so without this, `prettier` never forms an
    # opinion about the one line badges actually add. It is `proseWrap:
    # preserve` in `template/node/package.json` that makes the row survivable;
    # this is what would go red if that setting ever changed.
    if not shutil.which("npm"):
        results.append(Result("badges: prettier", True, 0.0, "skipped: npm not on PATH"))
        return results
    started = time.time()
    code, output = run(["npm", "install", "--no-audit", "--no-fund", "--silent"], cwd=target)
    if code != 0:
        results.append(Result("badges: npm install", False, time.time() - started, output))
        return results
    started = time.time()
    code, output = run(["npm", "run", "--silent", "format:check"], cwd=target)
    results.append(Result("badges: prettier accepts the badge row", code == 0, time.time() - started, output))
    return results


def long_path_gate(tier: str, workdir: Path, venv_python: Path) -> List[Result]:
    """Scaffold once into a long path and re-run the formatter on the result.

    Every other tree here is generated into a short temp path, which hides any
    line whose length depends on where the tree lives.

    The length is derived, not picked: `black` only rewrites an over-long string
    assignment when the parenthesised form would fit, so the bug is visible only
    while the path is longer than the limit minus the assignment and shorter
    than the limit minus an indent. A path of `line_length - 8` sits inside that
    band. A round number like 120 `d`s sits past it, and this gate was green
    against a reintroduced `CRON_CWD` until the length was worked out.
    """
    line_length = 120
    for arg in hook_args_for_tree(workdir, tier):
        if arg.startswith("--line-length="):
            line_length = int(arg.split("=", 1)[1])

    tail = "/tree"
    padding = line_length - 8 - len(str(workdir)) - len(tail) - 1
    deep = workdir / ("d" * max(padding, 1)) / "tree"
    result, target = scaffold(tier, "python", deep.parent, name=deep.name)
    label = f"long path ({len(str(deep))} chars)"
    results = [Result(f"{label}: {result.label}", result.ok, result.seconds, result.output)]
    if not result.ok:
        return results

    args = hook_args(target, "black")
    started = time.time()
    code, output = run([str(venv_python), "-m", "black", *args, "--check", "."], cwd=target)
    results.append(Result(f"{label}: black {' '.join(args)}", code == 0, time.time() - started, output))
    return results


def populated_tree_gate(tier: str, workdir: Path) -> List[Result]:
    """Scaffold into a directory that already has files in it, and require the
    manifest to describe skeletor's output and nothing else.

    Every other tree here is generated into a fresh directory, where every file
    present is by definition skeletor's — so the manifest was only ever built
    on the one path that cannot tell the two apart. `--force` into a populated
    repository is the other path, and `AGENTS.md` Step 2 calls it *the usual
    case*: the interesting target is a repo somebody already works in.

    It shipped broken, and an outside consumer found it in ten minutes.
    proto.pilot's manifest recorded 228 files of which 114 were its own source,
    tests and build artifacts, and `skeletor-upgrade` then refused on that tree
    forever — `cross_check` doing exactly its job against a manifest that could
    not describe its own base.

    The expected set is **recomputed, not listed**: the same arguments are
    scaffolded into an empty directory and the two manifests must have the same
    keys. A list of decoy paths would pin the decoys this file happens to plant
    and stay green for the next thing that leaks in. The decoys themselves are
    chosen to cover the three shapes that leaked: tracked source, a gitignored
    directory, and a file the scaffold overwrites — that last one must be
    *present*, since a collision is skeletor output and dropping it fails
    `cross_check` from the other direction.

    Both assertions below are needed, and planting each bug is how that was
    established rather than assumed. Comparing the two manifests catches what
    leaked *in* — but it is two readings of the same scaffolder, so a manifest
    that under-records leaves both sides equally short and the comparison stays
    green. Only the upgrade, which compares against an independently rendered
    base, sees that one. Two copies of a mistake agree with each other; that is
    the whole reason this gate exists at all.
    """
    results: List[Result] = []
    started = time.time()
    manifest_name = load_scaffolder().MANIFEST_NAME

    populated = workdir / "populated"
    (populated / "src").mkdir(parents=True, exist_ok=True)
    (populated / ".pytest_cache").mkdir(parents=True, exist_ok=True)
    (populated / "src" / "app.py").write_text("VALUE = 1\n", encoding="utf-8")
    (populated / ".pytest_cache" / "lastfailed").write_text("{}\n", encoding="utf-8")
    (populated / "README.md").write_text("# Theirs\n\nnot skeletor's.\n", encoding="utf-8")
    # The fourth shape, and the one the first three decoys could not reach: a
    # doc of the user's own, which `register_shipped_docs` correctly registers
    # into `.github/DOCS_INDEX.md`. That makes a SHIPPED file's content depend
    # on a file the base render has never heard of — so the manifest can hold a
    # hash no render of those arguments reproduces, which pruning cannot repair
    # and which only the upgrade below can see. proto.pilot hit it; the three
    # decoys above were all files skeletor ignores, and this one it reads.
    (populated / "docs").mkdir(parents=True, exist_ok=True)
    (populated / "docs" / "adopted.md").write_text("# Adopted\n\nours, from before.\n", encoding="utf-8")

    result, target = scaffold(tier, "python", workdir, name="populated")
    results.append(Result(f"populated: {result.label}", result.ok, result.seconds, result.output))
    if not result.ok:
        return results

    # `--force` writes over whatever is in its way and every loss is silent: a
    # file that is gone raises nothing. The guidance used to be "review the diff
    # file by file", which on a real repository points at ~100 files of which a
    # handful matter — sky.boss measured twelve overwrites, four of them
    # load-bearing, including a CLI wrapper that lost `PYTHONSAFEPATH` and a
    # conftest that lost the redirect keeping the suite out of the operator's
    # real state directory. Naming them is the fix, so the naming is asserted.
    #
    # Both directions. `README.md` is a decoy this gate plants *and* a file the
    # template ships, so it must be named; `src/app.py` is a decoy the template
    # never touches, so naming it would mean the report is reporting the tree
    # rather than the overwrites.
    overwrite_report = result.output[result.output.find("OVERWRITTEN") :] if "OVERWRITTEN" in result.output else ""
    results.append(
        Result(
            "populated: --force names the files it overwrote",
            "README.md" in overwrite_report and "src/app.py" not in overwrite_report,
            0.0,
            result.output,
        )
    )

    reference, clean = scaffold(tier, "python", workdir, name="populated-reference")
    results.append(Result(f"populated: reference {reference.label}", reference.ok, reference.seconds, reference.output))
    if not reference.ok:
        return results

    theirs = set(json.loads((target / manifest_name).read_text(encoding="utf-8"))["files"])
    expected = set(json.loads((clean / manifest_name).read_text(encoding="utf-8"))["files"])
    extra = sorted(theirs - expected)
    missing = sorted(expected - theirs)
    detail = ""
    if extra:
        detail += "recorded, but not part of a scaffold:\n  " + "\n  ".join(extra) + "\n"
    if missing:
        detail += "scaffolded, but not recorded:\n  " + "\n  ".join(missing) + "\n"
    results.append(
        Result(
            f"populated: the manifest records only what was scaffolded ({len(expected)} files)",
            not extra and not missing,
            time.time() - started,
            detail,
        )
    )

    # The consequence, not just the symptom: a manifest carrying the user's own
    # files fails `cross_check` and makes every later upgrade on that tree an
    # outright refusal. This is the assertion that would have caught it.
    results.append(check_upgrade_is_noop(target))
    results[-1].label = f"populated: {results[-1].label}"
    return results


def sidecar_gate(tier: str, workdir: Path) -> List[Result]:
    """`tmp/upgrade/` describes one run, and `--dry-run` says it wrote nothing.

    The conflict and collision reports are the only place this tool tells a
    reader to go **open a file**, and nothing here had ever executed them: every
    other upgrade gate runs against a fresh tree, where the answer is "already
    current" and neither branch is reached. So both of their sentences shipped
    unconditional. Under `--dry-run` the tool printed "what the template changed
    in each is in `tmp/upgrade/<path>.patch`" and then wrote nothing there — and
    the directory is not empty, because a real run never cleared it either. A
    reader following the instruction opened a four-day-old patch against a
    template HEAD that had since moved, with nothing in the output to say so.
    Reported by proto.pilot, from the reader's side, which is the only side it is
    visible from.

    Two halves, and they are the same bug. The prose half is asserted **by
    pattern, not by sentence**: every output line naming `tmp/upgrade/` must be
    hypothetical under a dry run and indicative under a real one. A list of the
    two sentences would pin the two and stay green for the third somebody adds.

    The skew is manufactured through `--no-base`, which classifies from the
    recorded hashes alone: tamper one recorded hash and the tool sees a file the
    template moved *and* the user edited (a conflict), delete another entry and
    it sees a path the user held before the template claimed it (a collision).
    That reaches both branches with no second checkout and no version skew to
    arrange — and `--no-base` skips `cross_check`, which is what makes tampering
    a legitimate way in rather than an immediate refusal.
    """
    results: List[Result] = []
    started = time.time()
    manifest_name = load_scaffolder().MANIFEST_NAME

    result, tree = scaffold(tier, "python", workdir, name="sidecars")
    results.append(Result(f"sidecars: {result.label}", result.ok, result.seconds, result.output))
    if not result.ok:
        return results

    manifest = json.loads((tree / manifest_name).read_text(encoding="utf-8"))
    files = manifest["files"]
    conflict, collision = sorted(files)[:2]
    files[conflict] = "0" * 64  # the template moved it — and so did the user, below
    del files[collision]  # never recorded, so it reads as a file they already had
    (tree / manifest_name).write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
    for rel in (conflict, collision):
        (tree / rel).write_text("theirs, edited\n", encoding="utf-8")

    # A previous run's sidecars, and one file that is not ours. The foreign file
    # is the point of the suffix rule: this deletes what it wrote and nothing else.
    patches = tree / "tmp" / "upgrade"
    (patches / "sub").mkdir(parents=True, exist_ok=True)
    (patches / "stale.patch").write_text("from a run four days ago\n", encoding="utf-8")
    (patches / "sub" / "gone.new").write_text("for a file not in today's plan\n", encoding="utf-8")
    (patches / "notes.md").write_text("mine, not skeletor's\n", encoding="utf-8")

    def snapshot() -> dict:
        return {
            str(f.relative_to(tree)): hashlib.sha256(f.read_bytes()).hexdigest()
            for f in sorted(tree.rglob("*"))
            if f.is_file() and ".git/" not in str(f.relative_to(tree))
        }

    def directions(output: str) -> List[str]:
        """Blank-line-separated blocks that direct the reader at a sidecar.

        `tmp/upgrade/<path>` — the *placeholder* form — is what a direction is:
        the bare directory appears in the footer and in the stale listing, which
        are statements about the run rather than instructions to open anything,
        and only a sentence sending somebody to a file of their own has to spell
        the file as a variable. That is the discriminator, and it holds by
        construction rather than by enumerating the two sentences that exist
        today, which would stay green for the third somebody adds.

        Blocks, not lines: these sentences wrap, and the tense sits on whichever
        line it fell on. A per-line rule flags the continuation of a correct
        sentence — which is how this predicate was found to be wrong.
        """
        return [b for b in output.split("\n\n") if "tmp/upgrade/<path>" in b]

    upgrade = [sys.executable, str(clean_skeletor(workdir) / "bin" / "skeletor-upgrade"), str(tree), "--no-base"]

    before = snapshot()
    code, output = run([*upgrade, "--dry-run"], cwd=tree)
    said = directions(output)
    reached = "merge conflicts" in output and "you already had" in output
    unwritten = snapshot() == before
    hypothetical = bool(said) and all("would" in block for block in said)
    results.append(
        Result(
            f"sidecars: --dry-run wrote nothing and said so ({len(said)} direction(s))",
            code == 1 and reached and unwritten and hypothetical,
            time.time() - started,
            f"reached both branches: {reached}\ntree unchanged: {unwritten}\n"
            f"all hypothetical: {hypothetical}\n{output}",
        )
    )

    # Committed, because an upgrade refuses a dirty tree — and rightly: the
    # tampering above is exactly the "in-progress edits" that refusal protects.
    git_in(tree, "add", "-A")
    git_in(tree, "commit", "-m", "tamper")

    started = time.time()
    code, output = run(upgrade, cwd=tree)
    said = directions(output)
    left = sorted(str(f.relative_to(patches)) for f in patches.rglob("*") if f.is_file())
    results.append(
        Result(
            "sidecars: a real run clears its own and keeps yours",
            code == 1
            and bool(said)
            and not any("would" in block for block in said)
            and "stale.patch" not in left
            and "sub/gone.new" not in left
            and "notes.md" in left
            and f"{collision}.new" in left,
            time.time() - started,
            "tmp/upgrade/ holds:\n  " + "\n  ".join(left) + "\n" + output,
        )
    )
    return results


def collect_diff_gate(tier: str, workdir: Path, venv_python: Path) -> List[Result]:
    """The footer that tells a reader not to verify an upgrade by counting.

    proto.pilot's v0.3.6 → v0.4.2 run collected 633 tests before and after, and
    five had changed — five removed, five added, the equality a coincidence. A
    total is a negative assertion over a set wearing a number's clothes, which
    is the rule `scanned()` states for enumerations, and nothing in the upgrade
    output said so.

    Three things are asserted, and the second and third are why this is a gate
    rather than a line of prose somebody eyeballed once:

    * A real run that wrote under `tests/` prints it, naming the target's HEAD
      **as it was before the run** — the value of the line is that it is
      paste-able, and a footer naming the wrong commit is worse than none.
    * A run that wrote nothing under `tests/` does not. Always-on prose in this
      output gets skimmed, and this instruction earns attention by being rare.
    * A dry run does not, for the reason the sidecar rule exists: a dry run must
      not send anybody to inspect a state it did not produce.

    The skew is `sidecar_gate`'s, one classification over. An `updated` needs the
    recorded hash to MATCH what is on disk — the user touched nothing — while the
    head render differs, so the tamper is to edit the file *and* record the edit.
    Editing without recording is a conflict, which is written nowhere and would
    reach none of this.

    ## Why the recipe is executed and not read

    The first draft of that footer printed a pipeline that fails silently, which
    is the joke this gate exists to stop repeating: a wrong interpreter path or a
    collection error leaves `grep` writing an empty file, `diff` reports no
    change, and the reader takes a clean bill off two files containing nothing.
    A negative assertion over an empty set — delivered by the command whose whole
    purpose is to say that counting is not looking.

    Reading the block would not have caught it and did not. Running it did, on
    the first try, and the fix is a `wc -l` line in the printed recipe. So the
    gate extracts the commands the tool actually printed and executes them,
    requiring a non-empty collection. `$PY` is repointed at the shared venv,
    which is the one substitution: a verify tree never runs the README's setup,
    so it has no `.venv` of its own.
    """
    results: List[Result] = []
    manifest_name = load_scaffolder().MANIFEST_NAME
    upgrade_bin = clean_skeletor(workdir) / "bin" / "skeletor-upgrade"

    def manufacture(tree: Path, rel: str) -> None:
        """Make `rel` read as "the template moved it, the user did not"."""
        path = tree / rel
        path.write_text(path.read_text(encoding="utf-8") + "\n# theirs, from the base render\n", encoding="utf-8")
        manifest = json.loads((tree / manifest_name).read_text(encoding="utf-8"))
        manifest["files"][rel] = hashlib.sha256(path.read_bytes()).hexdigest()
        (tree / manifest_name).write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")

    def written_marker(output: str) -> bool:
        return "do not verify by counting" in output

    started = time.time()
    result, tree = scaffold(tier, "python", workdir, name="collect-diff")
    results.append(Result(f"collect-diff: {result.label}", result.ok, result.seconds, result.output))
    if not result.ok:
        return results

    manifest = json.loads((tree / manifest_name).read_text(encoding="utf-8"))
    test_file = next(r for r in sorted(manifest["files"]) if r.startswith("tests/") and r.endswith(".py"))
    manufacture(tree, test_file)

    # Dry run first, while the tree is still dirty — a dry run is never refused.
    code, dry_output = run([sys.executable, str(upgrade_bin), str(tree), "--no-base", "--dry-run"], cwd=tree)
    reached = test_file in dry_output

    git_in(tree, "add", "-A")
    git_in(tree, "commit", "-m", "tamper")
    # The commit the footer must name: the scaffold's first commit is also
    # sitting right there, so naming *a* sha proves nothing.
    head = run(["git", "-C", str(tree), "rev-parse", "HEAD"], cwd=tree)[1].strip()

    real_code, real_output = run([sys.executable, str(upgrade_bin), str(tree), "--no-base"], cwd=tree)
    results.append(
        Result(
            "collect-diff: a real run that touched tests/ names the pre-upgrade commit",
            reached
            and written_marker(real_output)
            and head in real_output
            and not written_marker(dry_output)
            and "--allow-dirty" not in real_output,
            time.time() - started,
            f"the manufacture reached the tool: {reached}\n"
            f"real run printed it: {written_marker(real_output)}\n"
            f"named HEAD {head[:12]}: {head in real_output}\n"
            f"dry run stayed silent: {not written_marker(dry_output)}\n"
            f"--- dry ---\n{dry_output}\n--- real ---\n{real_output}",
        )
    )

    # The recipe, run. Its lines are the ones the tool printed, with `$PY`
    # repointed at the shared venv — a verify tree never runs the README's setup.
    started = time.time()
    recipe = [
        line.strip()
        for line in real_output.splitlines()
        if line.startswith("     ") and not line.strip().startswith("#") and line.strip()
    ]
    # `/tmp/` is the recipe's own suggestion and is wrong for a gate — two trees
    # would collide on it. Everything else is executed as printed.
    scratch = workdir / "collect-diff-run"
    scratch.mkdir(exist_ok=True)

    # The interpreter is NOT substituted. `$(pwd)/.venv/bin/python` is a path the
    # recipe names out loud, and a gate that swapped it in would be unable to
    # catch the one thing that actually went wrong first — a path pointing at
    # nothing. A verify tree never runs the README's setup, so the venv is
    # symlinked to the shared one and the line is executed exactly as printed.
    if not (tree / ".venv").exists():
        (tree / ".venv").symlink_to(venv_python.parent.parent)

    def rehome(line: str) -> str:
        """The recipe's own two scratch files, moved out of a shared `/tmp/`.

        By name, not by prefix: a blanket `/tmp/` rewrite also caught the
        interpreter path, since a verify workdir lives under `/tmp/` too. The
        gate then ran nothing and reported a clean comparison — the failure mode
        under test, arriving inside the thing testing for it.
        """
        for name in ("before.txt", "after.txt"):
            line = line.replace(f"/tmp/{name}", str(scratch / name))
        return line

    script = "\n".join(rehome(line) for line in recipe)
    code, ran = run(["bash", "-c", script], cwd=tree)
    before = scratch / "before.txt"
    collected = [ln for ln in before.read_text().splitlines() if "::" in ln] if before.exists() else []
    results.append(
        Result(
            f"collect-diff: the printed recipe runs and collects something ({len(collected)} ids)",
            code == 0 and len(collected) > 0 and len(recipe) >= 5,
            time.time() - started,
            f"{len(recipe)} command line(s) extracted, exit {code}, {len(collected)} collected ids\n"
            f"--- script ---\n{script}\n--- output ---\n{ran}",
        )
    )

    # And the other direction, which is the one an unconditional footer passes.
    started = time.time()
    result, other = scaffold(tier, "python", workdir, name="collect-diff-none")
    if not result.ok:
        results.append(Result(f"collect-diff: {result.label}", False, result.seconds, result.output))
        return results

    manifest = json.loads((other / manifest_name).read_text(encoding="utf-8"))
    doc = next(r for r in sorted(manifest["files"]) if r.endswith(".md") and not r.startswith("tests/"))
    manufacture(other, doc)
    git_in(other, "add", "-A")
    git_in(other, "commit", "-m", "tamper")

    code, output = run([sys.executable, str(upgrade_bin), str(other), "--no-base"], cwd=other)
    results.append(
        Result(
            "collect-diff: a run that touched no test file stays quiet",
            doc in output and not written_marker(output),
            time.time() - started,
            f"the manufacture reached the tool: {doc in output}\n{output}",
        )
    )
    return results


#: A reference to a file in this tree: at least one slash, and an extension
#: beginning with a letter. Both halves earn their place — without the slash a
#: version string (`1.2.3`) and a sentence-ending word match; without the letter
#: rule so does `v0.4.4`. The lookbehind keeps it off the tail of a URL, whose
#: path segments are preceded by `/`.
_TREE_REF = re.compile(r"(?<![\w/.-])((?:[\w.-]+/)+[\w.-]+\.[A-Za-z]\w*)")

#: A file declaring that it HANDLES a path's absence, rather than sending a
#: reader to it:
#:
#:     # SCAFFOLD-OPTIONAL .github/release-please-config.json
#:
#: The two are indistinguishable to a predicate over paths — `[ ! -f X ]` and
#: "see X" both mention X — and the difference is the whole finding. So the file
#: says which it is, at the site, in the comment syntax it already has.
#:
#: Beside a list here because that is the shape every other exemption in this
#: session settled on: an exemption held somewhere else is a question somebody
#: can finish without answering, and it goes stale where nobody is looking. Both
#: staleness directions are checked below, so a declaration cannot outlive its
#: reason quietly.
_OPTIONAL = re.compile(r"SCAFFOLD-OPTIONAL\s+(\S+)")


def configurations(scaffolder) -> List[Tuple[str, str, str, str]]:
    """Every (tier, language, agent, versioning) this scaffolder can produce.

    Read from its own maps, so an axis added to `bin/skeletor-new` is covered by
    this gate on the next run rather than the next time somebody remembers. Each
    one is a configuration a user is documented to pick, and a reference that
    only resolves when the omitted files ship is the same defect one axis over —
    which is how `--agent none` was found routing readers into `.claude/`.
    """
    return [
        (tier, language, agent, versioning)
        for tier in sorted(scaffolder.TIERS)
        for language in sorted(scaffolder.LANGUAGE_OVERLAYS)
        for agent in sorted(scaffolder.AGENTS)
        for versioning in sorted(scaffolder.VERSIONING)
    ]


def superset_of(scaffolder, a: Tuple[str, str, str, str], b: Tuple[str, str, str, str]) -> bool:
    """Does configuration `b` ship everything `a` does, and more?

    Containment of what each axis contributes — never a hand-written ordering,
    which would go stale the day a tier is inserted in the middle. Versioning is
    the one axis expressed as a SUBTRACTION, so its containment runs the other
    way: `b` ships more when it omits less.
    """
    if a == b:
        return False
    a_tier, a_lang, a_agent, a_version = a
    b_tier, b_lang, b_agent, b_version = b
    tiers = set(scaffolder.TIERS[a_tier]) <= set(scaffolder.TIERS[b_tier])
    langs = set(scaffolder.LANGUAGE_OVERLAYS[a_lang].split(",")) <= set(
        scaffolder.LANGUAGE_OVERLAYS[b_lang].split(",")
    )
    agents = scaffolder.AGENTS[a_agent] is None or scaffolder.AGENTS[a_agent] == scaffolder.AGENTS[b_agent]
    versions = scaffolder.VERSIONING[b_version] <= scaffolder.VERSIONING[a_version]
    return tiers and langs and agents and versions


def tier_composition_gate(workdir: Path) -> List[Result]:
    """A shipped file must not name a shipped file that is not shipped *here*.

    stash.flow reported the class: `template/core/AGENTS.md` and
    `template/core/scripts/paths.py` both cited `tests/test_state_paths.py`,
    which shipped only at `agentic`. A `core` reader following either citation
    finds nothing, and the sentence around it — "this test enforces it" — is
    then a claim about a file that is not there.

    No tree's own suite can see this. `check_source_doc_refs.py` runs inside one
    configuration, where a reference either resolves or does not; the defect is
    that it resolves in a *different* one. That makes it the generator's
    question, which is why the fix went here and not into the template.

    ## The predicate, and why it needs no allowlist

    A reference is a finding only when it is **absent here and present in a
    configuration that ships strictly more**. Everything else is out of scope by
    construction rather than by exemption:

    * `.env`, `tmp/upgrade/<path>`, a file the user is told to create — absent
      everywhere, so never flagged.
    * A URL, a version string, a dotted module name — not matched at all.
    * Another repository's path — absent from every configuration here.

    Measured, not asserted: the first run found 11 references across `core` and
    `governed`, all six distinct sites real, and every one had a fix better than
    an exemption. Four were live citations pointing a `core` reader at a module
    only `agentic` ships; two were history about the repository this was
    extracted from. The allowlist is empty and there is no mechanism to add one.

    ## The one thing it cannot see

    A path belonging to **another repo** that happens to collide with one of
    ours. `scripts/yaml_text.py` cited jam.sense's `cli/worktree.py`, which is
    not a file here at any tier — except that `agentic` ships a `cli/worktree.py`
    of its own, so the collision made it look like a local dangling reference.
    It was reworded rather than exempted, because spelling another repo's file
    as a repo-relative path is misleading in its own right. A predicate over
    paths cannot tell the two apart, and this is written down instead of guarded.
    """
    started = time.time()
    scaffolder = load_scaffolder()
    configs = configurations(scaffolder)

    trees: Dict[Tuple[str, str, str, str], Path] = {}
    for tier, language, agent, versioning in configs:
        name = f"compose-{tier}-{language}-{agent}-{versioning}"
        target = workdir / name
        code, output = run(
            [
                sys.executable,
                str(SCAFFOLDER),
                str(target),
                "--name",
                "Compose",
                "--cli",
                "cc",
                "--tagline",
                "composition",
                "--tier",
                tier,
                "--language",
                language,
                "--agent",
                agent,
                "--versioning",
                versioning,
            ],
            cwd=workdir,
        )
        if code != 0:
            return [Result(f"tier composition: scaffold {name}", False, time.time() - started, output)]
        trees[(tier, language, agent, versioning)] = target

    def shipped(root: Path) -> set:
        return {
            str(f.relative_to(root))
            for f in root.rglob("*")
            if f.is_file() and ".git" not in f.relative_to(root).parts
        }

    files = {config: shipped(root) for config, root in trees.items()}

    findings: Dict[str, List[str]] = {}
    declarations: Dict[str, set] = {}
    scanned_refs = 0
    for config, root in trees.items():
        mine = files[config]
        elsewhere = set().union(
            *(files[other] for other in configs if superset_of(scaffolder, config, other))
        ) or set()
        for rel in sorted(mine):
            path = root / rel
            try:
                text = path.read_text(encoding="utf-8")
            except (UnicodeDecodeError, OSError):
                continue
            handled = set(_OPTIONAL.findall(text))
            for declared in handled:
                declarations.setdefault(declared, set()).add(rel)
            for match in _TREE_REF.finditer(text):
                ref = match.group(1)
                scanned_refs += 1
                if ref in mine or ref not in elsewhere or ref in handled:
                    continue
                where = "/".join(config)
                findings.setdefault(f"{ref}  (missing at {where})", []).append(rel)

    # Every declaration is checked against the thing it exempts, both ways. One
    # naming a path no configuration omits is describing a hazard that no longer
    # exists; one naming a path its own file never mentions is describing a
    # reference somebody deleted. Both are stale, and a stale exemption is worse
    # than none — the path can come back for something else and arrive
    # pre-exempted, which is an exemption nobody chose.
    everywhere = set.intersection(*files.values()) if files else set()
    stale = []
    for declared, sites in sorted(declarations.items()):
        if declared in everywhere:
            stale.append(f"{declared} — shipped in every configuration, so nothing to handle")
        for site in sorted(sites):
            holder = next(root for cfg, root in trees.items() if site in files[cfg])
            if declared not in (holder / site).read_text(encoding="utf-8", errors="ignore"):
                stale.append(f"{declared} — declared in {site}, which does not mention it")

    # A negative over an empty scan is a tautology: a `_TREE_REF` that matched
    # nothing would report every configuration clean. The trees hold hundreds of
    # references between them, so a number this small means the extractor broke.
    enumerated = scanned_refs >= 100
    report = "\n".join(
        f"  {ref}\n" + "\n".join(f"      cited by {c}" for c in sorted(set(citers)))
        for ref, citers in sorted(findings.items())
    )
    return [
        Result(
            f"tier composition: every reference resolves where it is read "
            f"({len(configs)} configs, {scanned_refs} refs, {len(declarations)} handled)",
            not findings and not stale and enumerated,
            time.time() - started,
            (f"extracted only {scanned_refs} references — the extractor is broken\n" if not enumerated else "")
            + ("a shipped file names a file that is not shipped in that configuration:\n" + report if findings else "")
            + ("\nstale SCAFFOLD-OPTIONAL declaration(s):\n  " + "\n  ".join(stale) if stale else ""),
        )
    ]


def clean_skeletor(workdir: Path) -> Path:
    """A committed clone of this checkout, cloned once and reused.

    `skeletor-upgrade` refuses a dirty base on any run that writes, because the
    manifest it would record names a render that exists in no commit. This
    checkout is dirty whenever somebody is working in it, so every gate that
    performs a REAL upgrade has to come from somewhere clean.

    That is not a workaround for the refusal — it is the condition being tested.
    A user upgrades from a released skeletor; a gate that ran from the working
    tree would be exercising the refusal and calling it an upgrade.

    **The working tree's changes are carried in and committed inside the clone**,
    which is the part that took three repeats to get right. A plain clone holds
    only committed state, so every gate built on one silently tested the previous
    version: a new tool failed until it was committed, and a planted bug passed
    because the plant was not. Both happened here, twice each, and each time the
    gate was correct and the verification of it was not.

    `git stash create` is what makes this cheap — it writes a commit object for
    the working tree without touching it, so the clone can fetch that one object
    and check it out. The result is a checkout that is genuinely clean, carries
    the edits under test, and keeps the tags `describe` and `base_checkout` need.
    """
    clone = workdir / "skeletor-clean"
    if clone.exists():
        return clone
    run(["git", "clone", "--quiet", "--no-hardlinks", str(SKELETOR), str(clone)], cwd=workdir)
    working = run(["git", "-C", str(SKELETOR), "stash", "create"], cwd=SKELETOR)[1].strip()
    if working:
        run(["git", "-C", str(clone), "fetch", "--quiet", "origin", working], cwd=workdir)
        run(["git", "-C", str(clone), "checkout", "--quiet", working, "--", "."], cwd=workdir)
        git_in(clone, "commit", "--quiet", "-am", "verify: the working tree under test")
    return clone


def upgrade_applied(tree: Path, manifest_name: str) -> List[str]:
    """Which files an upgrade actually wrote — asked of git, not of its output.

    A scaffold is its own repository at its first commit, so anything the
    upgrade touched is a modification against it. Two exclusions, both because
    they would make the question answer itself: the manifest is rewritten
    *because* something applied, and `tmp/` holds the sidecars written for a
    conflict, which are a report about what was NOT applied.
    """
    lines = [line for line in git_in(tree, "status", "--porcelain")[1].splitlines() if line.strip()]
    paths = [line[3:].strip() for line in lines]
    return [path for path in paths if path != manifest_name and not path.startswith("tmp/")]


def dirty_ref_gate(workdir: Path) -> List[Result]:
    """A `-dirty` scaffold ref clears on the first upgrade that applies anything.

    `skeletor-upgrade` told users this was permanent. It is not, and the wrong
    claim shipped for the ordinary reason: it was written from the one case that
    had been exercised — a `cross_check` refusal, where nothing is written and so
    nothing clears — and generalised to every case. proto.pilot measured a tree
    going `v0.2.0-dirty` to a clean tag across a single upgrade and reported it.

    The scaffold is deliberately dirtied **outside `template/`**, which is the
    whole point: an uncommitted edit to a shipped file is a genuinely
    unreproducible base and `cross_check` refuses it, so that path can never
    reach the manifest rewrite. Only an edit to something the scaffold does not
    ship produces a `-dirty` ref that is safe to move past — and that is exactly
    the case nobody had run.

    A version gap is needed too, since the manifest is only rewritten when the
    upgrade applies something — and *which* tag provides one is measured rather
    than predicted. "Its `template/` differs from HEAD" was the whole selector
    once, and it is a broader question than this gate needs: a `core` scaffold
    ships none of `template/governed/`, so a release that moved only that is a
    version gap the tree cannot see. The upgrade was then correctly a no-op and
    the gate went red on a true statement about the wrong scenario — this
    repository's own recurring failure, in the gate for a report about it.

    So the scaffold is the fullest configuration, read from the scaffolder's own
    maps, which makes nearly every template change a shipped one; and each
    candidate tag is tried until one actually applies something, which is what
    makes that "nearly" harmless rather than load-bearing. Running out of
    candidates is a loud failure naming what it tried, never a silent pass.
    """
    started = time.time()
    scaffolder = load_scaffolder()
    tier = max(scaffolder.TIERS, key=lambda name: len(scaffolder.TIERS[name]))
    language = max(scaffolder.LANGUAGE_OVERLAYS, key=lambda name: len(scaffolder.LANGUAGE_OVERLAYS[name].split(",")))

    tags = run(["git", "-C", str(SKELETOR), "tag", "--sort=-creatordate"], cwd=SKELETOR)[1].split()
    # A cheap pre-filter, not the decision: a tag whose template is identical to
    # HEAD's cannot possibly apply anything, so it is not worth a scaffold.
    candidates = [
        tag
        for tag in tags
        if run(["git", "-C", str(SKELETOR), "diff", "--quiet", tag, "HEAD", "--", "template/"], cwd=SKELETOR)[0] != 0
    ]
    if not candidates:
        # Loudly, never silently: no tag differs from HEAD under `template/`, so
        # there is no version gap to upgrade across and this gate cannot run.
        #
        # And say *which* nothing it found. An empty tag list is a shallow clone,
        # not a repository without releases — `actions/checkout` fetches neither
        # tags nor history by default, which is how this failed on CI for three
        # releases while passing here. "Looked and saw nothing" and "could not
        # see" are the same red until the message separates them.
        why = "no tags are visible at all — a shallow clone?" if not tags else "no tag differs from HEAD under template/"
        return [Result(f"dirty ref: {why}", False, time.time() - started, f"{len(tags)} tag(s) visible")]

    clean = clean_skeletor(workdir)
    attempts: List[str] = []
    results: List[Result] = []
    for index, tag in enumerate(candidates):
        old_checkout = workdir / f"dirty-base-{index}"
        code, output = run(
            ["git", "-C", str(SKELETOR), "worktree", "add", "--detach", str(old_checkout), tag], cwd=SKELETOR
        )
        if code != 0:
            return [Result(f"dirty ref: check out {tag}", False, time.time() - started, output)]
        try:
            # Dirty, but nothing the scaffold ships — see the docstring.
            marker = old_checkout / "bin" / "skeletor-verify"
            marker.write_text(marker.read_text(encoding="utf-8") + "\n# scratch\n", encoding="utf-8")

            target = workdir / f"dirty-scaffold-{index}"
            run(
                [sys.executable, str(old_checkout / "bin" / "skeletor-new"), str(target),
                 "--name", "Probe", "--cli", CLI_NAME, "--tagline", "t",
                 "--tier", tier, "--language", language, "--force"],
                cwd=SKELETOR,
            )
            manifest = target / scaffolder.MANIFEST_NAME
            before = json.loads(manifest.read_text(encoding="utf-8"))["skeletor_ref"]

            # From a CLONE, because an upgrade now refuses a dirty skeletor — and
            # this checkout is dirty whenever somebody is working in it. That is not
            # a workaround: a user upgrading from a clean skeletor is the condition
            # being tested, and running it from here would test the refusal instead.
            _, upgrade_output = run([sys.executable, str(clean / "bin" / "skeletor-upgrade"), str(target)], cwd=target)
            after = json.loads(manifest.read_text(encoding="utf-8"))["skeletor_ref"]
            applied = upgrade_applied(target, scaffolder.MANIFEST_NAME)
        finally:
            run(["git", "-C", str(SKELETOR), "worktree", "remove", "--force", str(old_checkout)], cwd=SKELETOR)

        attempts.append(f"{tag}: the upgrade applied {len(applied)} file(s)")
        if applied:
            results = [
                Result(
                    "dirty ref: clears on the first upgrade that applies anything",
                    before.endswith("-dirty") and not after.endswith("-dirty"),
                    time.time() - started,
                    f"tried: {'; '.join(attempts)}\n"
                    f"a {tier}/{language} scaffold upgraded across {tag}, applying {len(applied)} file(s)\n"
                    f"scaffolded at: {before}\nafter upgrade: {after}\n{upgrade_output}",
                )
            ]
            break
    if not results:
        return [
            Result(
                "dirty ref: no tagged release changes anything this scaffold ships",
                False,
                time.time() - started,
                "\n".join(attempts),
            )
        ]

    # And the guard that makes the above the only outcome. Two properties,
    # not one: the assertion above passes with the guard removed, because it
    # upgrades from a clean clone by construction. Planting proved that —
    # the gate was written for the claim and assumed it covered the refusal.
    #
    # The clone is dirtied here rather than testing this checkout, which is
    # dirty only when somebody happens to be working in it. A gate that
    # passes or fails on that is not a gate.
    started = time.time()
    # Cloned from the CLEAN clone, not from this checkout, so it inherits the
    # working tree under test rather than the last commit. Cloning SKELETOR
    # here is what made this assertion pass on a guard that had not been
    # written yet — the same mistake, in the gate for the mistake.
    dirty_clone = workdir / "skeletor-dirtied"
    run(["git", "clone", "--quiet", "--no-hardlinks", str(clean), str(dirty_clone)], cwd=workdir)
    shipped = dirty_clone / "template" / "core" / "AGENTS.md"
    shipped.write_text(shipped.read_text(encoding="utf-8") + "\n<!-- uncommitted -->\n", encoding="utf-8")

    second = workdir / "dirty-scaffold-refusal"
    run(
        [sys.executable, str(clean / "bin" / "skeletor-new"), str(second),
         "--name", "Probe", "--cli", CLI_NAME, "--tagline", "t", "--force"],
        cwd=SKELETOR,
    )
    code, refused = run([sys.executable, str(dirty_clone / "bin" / "skeletor-upgrade"), str(second)], cwd=second)
    dry_code, _ = run(
        [sys.executable, str(dirty_clone / "bin" / "skeletor-upgrade"), str(second), "--dry-run"], cwd=second
    )
    results.append(
        Result(
            "dirty ref: an upgrade from a dirty skeletor is refused, but --dry-run is not",
            code == 1 and "uncommitted change" in refused and dry_code != 1,
            time.time() - started,
            f"real run exit {code}, dry-run exit {dry_code}\n{refused}",
        )
    )
    return results


def entangled_gate(workdir: Path) -> List[Result]:
    """A clean file that imports a conflicted one is named, not left quiet.

    The one reassuring line this tool prints — *"file(s) you never touched
    updated"* — is exactly wrong when the untouched file's behaviour is decided
    by one that conflicted. proto.pilot hit it: `check_doc_tables.py` conflicted,
    they kept theirs, and `tests/test_docs_pipeline.py` merged clean carrying a
    test written against a function that exists only here. Every step correct;
    the breakage one import away, in a file with no conflict *because they had
    never edited it*.

    Reproduced rather than simulated: scaffold at the newest tag whose template
    differs, rewrite the importee hard enough that the three-way merge cannot
    resolve it, and leave the importer alone so it takes the clean-update path.
    A hash-tampered version of this cannot exist — `updated` requires the live
    file to match the recorded hash while the head render does not, which no
    amount of manifest editing produces on a single HEAD.
    """
    started = time.time()
    tags = run(["git", "-C", str(SKELETOR), "tag", "--sort=-creatordate"], cwd=SKELETOR)[1].split()
    importer, importee = "tests/test_docs_pipeline.py", "scripts/check_doc_tables.py"
    def changed_py(t: str) -> List[str]:
        out = run(["git", "-C", str(SKELETOR), "diff", "--name-only", t, "HEAD", "--", "template/"], cwd=SKELETOR)[1]
        return [line for line in out.split() if line.endswith(".py")]

    # The pair must both have moved, AND at least one other Python file must
    # have moved with them. The `if hits:` filter — report only files that
    # actually import something conflicted — is unobservable when the upgrade
    # writes exactly one `.py`, because then "every written file" and "the
    # importer" are the same set. jam.sense's rule, met here as a fixture that
    # agrees with the real fix and the noisy one alike: the newest qualifying
    # tag is the convenient one, and it is the one that cannot discriminate.
    tag = next(
        (
            t
            for t in tags
            # BOTH must differ, checked one path at a time. `--quiet` over two
            # pathspecs is non-zero when *either* differs, so the pair predicate
            # silently became an "or" and picked a tag where the importee had
            # not moved — leaving nothing to conflict and the gate asserting
            # against an empty conflict set.
            if all(
                run(["git", "-C", str(SKELETOR), "diff", "--quiet", t, "HEAD", "--", f"template/core/{f}"],
                    cwd=SKELETOR)[0] != 0
                for f in (importer, importee)
            )
            and len(changed_py(t)) > 2
        ),
        "",
    )
    if not tag:
        why = (
            "no tags are visible at all — a shallow clone?"
            if not tags
            else f"no tag moves {importer}, {importee} and another .py"
        )
        return [Result(f"entangled: {why}", False, time.time() - started, f"{len(tags)} tag(s) visible")]

    old_checkout = workdir / "entangled-base"
    run(["git", "-C", str(SKELETOR), "worktree", "add", "--detach", str(old_checkout), tag], cwd=SKELETOR)
    try:
        target = workdir / "entangled-tree"
        run(
            [sys.executable, str(old_checkout / "bin" / "skeletor-new"), str(target),
             "--name", "Probe", "--cli", CLI_NAME, "--tagline", "t", "--force"],
            cwd=SKELETOR,
        )
        # Rewritten, not edited: a small change merges cleanly, and a clean merge
        # is not the case under test.
        clobber = target / importee
        clobber.write_text(
            "\n".join("### OURS ###" for _ in clobber.read_text(encoding="utf-8").splitlines()) + "\n",
            encoding="utf-8",
        )
        git_in(target, "add", "-A")
        git_in(target, "commit", "-m", "ours")

        code, output = run(
            [sys.executable, str(clean_skeletor(workdir) / "bin" / "skeletor-upgrade"), str(target), "--dry-run", "--json"],
            cwd=target,
        )
        payload = json.loads(output[output.index("{") : output.rindex("}") + 1]) if "{" in output else {}
        entangled = payload.get("entangled", {})
        return [
            Result(
                "entangled: a clean file importing a conflicted one is named",
                importee in payload.get("conflicted", [])
                and importer in payload.get("updated", [])
                and entangled == {importer: [importee]},
                time.time() - started,
                f"conflicted={payload.get('conflicted')}\nupdated={payload.get('updated')}\n"
                f"entangled={entangled}\n{output}",
            )
        ]
    finally:
        run(["git", "-C", str(SKELETOR), "worktree", "remove", "--force", str(old_checkout)], cwd=SKELETOR)


def components_gate(workdir: Path) -> List[Result]:
    """`skeletor-components` records what a tree copied, and reports what moved.

    It is the provenance half of adoption — for a repository that took files by
    hand and cannot honestly claim to be a skeletor scaffold. Nothing else here
    exercises it, and this repository's own history is that a path nothing
    generates ships broken: `--no-git`, `script()` taking a flag as a path, and a
    README setup block that had never once been executed.

    Two things are asserted and they need different setups.

    **`record` runs against a clone**, not against this checkout. It refuses a
    dirty skeletor — a recorded ref naming uncommitted work describes a source
    nobody else can resolve — and this checkout is usually dirty while somebody
    is working in it, so running it here would make the gate pass or fail on
    whether the author had saved. A clone at HEAD is deterministic.

    It used to test the committed tool rather than the working copy, which cost
    two false verifications before `clean_skeletor()` learned to carry the
    working tree in. See that function.

    **`report`'s four states are asserted by editing the record**, not by
    manufacturing history. The classification is two independent comparisons —
    `source_sha` against the template today, `local_sha` against the tree today —
    so falsifying either hash exercises exactly the branch it names, with no
    dependence on which template files happen to differ between two tags.
    """
    results: List[Result] = []
    started = time.time()

    clone = clean_skeletor(workdir)
    tool = clone / "bin" / "skeletor-components"

    # A consumer's tree: not a scaffold, holding copies taken by hand.
    consumer = workdir / "consumer"
    (consumer / "scripts").mkdir(parents=True, exist_ok=True)
    sources = ["template/core/scripts/output.py", "template/core/scripts/allowlist.py"]
    for source in sources:
        shutil.copy2(clone / source, consumer / "scripts" / Path(source).name)

    cmd = [sys.executable, str(tool), "record", str(consumer), "--component", "output-contract"]
    for source in sources:
        cmd += ["--file", source]
    code, output = run(cmd, cwd=workdir)
    recorded = consumer / ".skeletor-components.json"
    results.append(
        Result(
            "components: record writes a provenance file",
            code == 0 and recorded.exists(),
            time.time() - started,
            output,
        )
    )
    if not recorded.exists():
        return results

    def states() -> Dict[str, str]:
        code, out = run([sys.executable, str(tool), "report", str(consumer), "--json"], cwd=workdir)
        if code != 0 or "{" not in out:
            return {}
        payload = json.loads(out[out.index("{") : out.rindex("}") + 1])
        return {row["path"]: row["state"] for rows in payload["components"].values() for row in rows}

    started = time.time()
    fresh = states()

    data = json.loads(recorded.read_text(encoding="utf-8"))
    files = data["components"]["output-contract"]["files"]
    # Falsify one hash each, and both on nothing — so every state below is
    # produced by exactly the comparison it is named for.
    files["scripts/output.py"]["source_sha"] = "0" * 64  # upstream moved
    files["scripts/allowlist.py"]["local_sha"] = "0" * 64  # we edited ours
    recorded.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    falsified = states()

    data["components"]["output-contract"]["files"]["scripts/output.py"]["local_sha"] = "0" * 64
    recorded.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    both = states()

    # `--fail-on-drift` is what lets this be a pre-push or a CI job at all; the
    # default exits 0 like `skeletor-check-pins`. Drift means movement on
    # SKELETOR's side: a file this repo adapted while upstream stayed still is a
    # steady state, and failing it would make the gate red forever for every
    # repo doing the thing components adoption exists to allow.
    def drift_exit() -> int:
        return run([sys.executable, str(tool), "report", str(consumer), "--fail-on-drift"], cwd=workdir)[0]

    upstream_moved = drift_exit()

    # A clean re-record puts every file back to current; drift must clear.
    run([sys.executable, str(tool), "record", str(consumer), "--component", "output-contract"], cwd=workdir)
    after_rerecord = drift_exit()

    # The discriminating case, and the reason the two above cannot stand alone:
    # with any upstream movement present, "drift = upstream moved" and "drift =
    # anything not current" give the same exit, so a gate that only tests those
    # passes under either rule. Only a LOCAL-EDIT-ONLY tree separates them.
    clean = json.loads(recorded.read_text(encoding="utf-8"))
    first = sorted(clean["components"]["output-contract"]["files"])[0]
    clean["components"]["output-contract"]["files"][first]["local_sha"] = "0" * 64
    recorded.write_text(json.dumps(clean, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    local_edit_only = drift_exit()

    results.append(
        Result(
            "components: --fail-on-drift gates upstream movement, and a local edit is not drift",
            upstream_moved == 1 and after_rerecord == 0 and local_edit_only == 0,
            0.0,
            f"upstream moved -> {upstream_moved} (want 1); after re-record -> {after_rerecord} (want 0); "
            f"local edit only -> {local_edit_only} (want 0)",
        )
    )

    results.append(
        Result(
            "components: report separates upstream movement from a local edit",
            fresh == {"scripts/output.py": "current", "scripts/allowlist.py": "current"}
            and falsified.get("scripts/output.py") == "upstream"
            and falsified.get("scripts/allowlist.py") == "local"
            and both.get("scripts/output.py") == "both",
            time.time() - started,
            f"fresh: {fresh}\nfalsified: {falsified}\nboth: {both}",
        )
    )
    return results


def allowlist_gate(tree: Path, venv_python: Path) -> Result:
    """Every allowlist in the tree fails when it holds an entry nobody needs.

    This is a sweep, and it exists because the first pass at this rule was not.
    Two allowlists got a staleness check because they were the two in front of
    me; the tree shipped four, and the two I missed were the two nothing would
    have complained about — one with no check at all, one with a single
    direction. That is the failure this repository's Invariant 2 is about,
    committed while writing the sentence that states it.

    So the set is **discovered**, not listed: any `*_allowlist.yaml` anywhere in
    the generated tree is enrolled by existing. A fifth one added next year is
    covered without anybody remembering, and one deleted stops being checked
    without a stale entry here.

    The method is to plant the bug rather than to inspect the source. A grep for
    "does this file mention staleness" would pass on a check that mentions it
    and does not do it — which is precisely the shape of the drift allowlist,
    whose docstring promised an escape hatch its reader could not parse. So each
    allowlist gets a deliberately meaningless entry and the tree's own gates must
    go red. What turns red is not this gate's business; that a consumer notices
    is the whole assertion.

    Cost is one suite run per allowlist, which is why it runs on one tier.
    """
    started = time.time()
    found = sorted(tree.rglob("*_allowlist.yaml"))
    checks = sorted((tree / "scripts").glob("check_*.py"))
    failures: List[str] = []

    def gates_are_red() -> bool:
        """Any consumer objecting is enough. None of them objecting is the bug."""
        code, _ = run([str(venv_python), "-m", "pytest", "-m", "unit", "-q", "-x"], cwd=tree)
        if code != 0:
            return True
        return any(run([str(venv_python), str(check)], cwd=tree)[0] != 0 for check in checks)

    for path in found:
        original = path.read_text(encoding="utf-8")
        rel = path.relative_to(tree).as_posix()
        try:
            # A key nothing in the tree can possibly resolve, with a reason — so
            # the only thing wrong with it is that it exempts nothing. An entry
            # without a reason would be caught by a different rule and would
            # make this gate pass for the wrong cause.
            path.write_text(
                original + "\n__skeletor_verify_planted__: a deliberately meaningless exemption\n",
                encoding="utf-8",
            )
            if not gates_are_red():
                failures.append(f"{rel}: a meaningless entry was accepted — nothing checks this allowlist")
        finally:
            path.write_text(original, encoding="utf-8")

    # A sweep over zero files is green and worth nothing — the same reason the
    # lint gates assert they found the tree.
    if not found:
        failures.append("no *_allowlist.yaml found — the discovery is broken, not the tree")

    return Result(
        f"every allowlist rejects a stale entry ({len(found)} found)",
        not failures,
        time.time() - started,
        "\n".join(failures),
    )


def declined_gate(tier: str, workdir: Path) -> List[Result]:
    """A file skeletor wrote and the user deleted is not put back.

    `AGENTS.md` calls a `--force` scaffold into a repo somebody already works in
    *the usual case*, and the whole point of that path is partial adoption: take
    the rules, keep your own CI, drop the parts that do not fit. Every one of
    those drops is a deletion — and an absent file was classified purely on
    being absent, so all of them came back on the next upgrade, reported as a
    green "new file added" and written without asking. A decision that has to be
    re-made on a schedule is not a decision, and one auto-reverted with a tick
    beside it is worse than a conflict, which at least stops.

    Reported by sky.boss, weighing a retrofit and asking whether six settled
    declines would become six recurring merge conflicts. They would have become
    something worse than conflicts.

    The discriminator needs no new bookkeeping and no decline list: an entry in
    the manifest means skeletor *wrote* that file here, so its absence is a
    deletion; no entry means the template has only just started shipping it, and
    adding it is what an upgrade is for. Both directions are asserted, because
    the fix trades one silent wrong answer for the other if it over-applies —
    a genuinely new file that stopped arriving would be invisible.

    The fourth assertion is the one sky.boss actually asked for: run it twice.
    The manifest is re-copied from the head render on every applying run, so a
    decline persists — but only as long as that copy keeps recording the file,
    which is a property of a different function and nothing here would notice it
    changing.
    """
    results: List[Result] = []
    started = time.time()
    manifest_name = load_scaffolder().MANIFEST_NAME

    result, tree = scaffold(tier, "python", workdir, name="declined")
    results.append(Result(f"declined: {result.label}", result.ok, result.seconds, result.output))
    if not result.ok:
        return results

    manifest = json.loads((tree / manifest_name).read_text(encoding="utf-8"))
    # Three files, and the third exists because jam.sense named the trap: the
    # example you reach for first is the one that cannot discriminate. The first
    # two here were `sorted(...)[:2]` — the most convenient files in the tree —
    # and with them the "template moved since you declined it" branch could
    # never fire, because this gate scaffolds and upgrades from one HEAD, so
    # every recorded hash equals the head render's by construction. That branch
    # had report text written for it and nothing exercising it.
    dropped, arriving, moved = sorted(manifest["files"])[:3]
    # `arriving` is deleted AND unrecorded: the shape of a file the template has
    # only just started shipping, which must still be added.
    del manifest["files"][arriving]
    # Falsified, not manufactured: a recorded hash that disagrees with the head
    # render is exactly what "the template changed since you declined it" means,
    # and it is the only way to reach that state without a second checkout.
    manifest["files"][moved] = "0" * 64
    (tree / manifest_name).write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
    for rel in (dropped, arriving, moved):
        (tree / rel).unlink()
    git_in(tree, "add", "-A")
    git_in(tree, "commit", "-m", "decline")

    upgrade = [sys.executable, str(clean_skeletor(workdir) / "bin" / "skeletor-upgrade"), str(tree), "--no-base", "--json"]

    def report(extra: List[str]) -> dict:
        """The envelope, or an empty one — never an exception.

        A gate that raises takes the whole verifier down with it and loses the
        forty checks after it, which is a worse failure than the one it was
        looking for. An upgrade that printed no JSON has already failed every
        assertion below on the merits.
        """
        _, output = run([*upgrade, *extra], cwd=tree)
        try:
            return json.loads(output[output.index("{") : output.rindex("}") + 1])
        except (ValueError, json.JSONDecodeError):
            return {"added": [], "declined": [], "no_json": output}

    seen = report(["--dry-run"])
    results.append(
        Result(
            "declined: a deleted file is declined, an unrecorded one still arrives",
            dropped in seen["declined"]
            and dropped not in seen["added"]
            and arriving in seen["added"]
            and arriving not in seen["declined"]
            and moved in seen["declined"],
            time.time() - started,
            json.dumps(seen, indent=2),
        )
    )

    # The actionable subset, and the branch two convenient files could not reach.
    # A decline the template has since changed gets a sidecar to look at; one it
    # has not gets silence. Both directions, because writing a sidecar for every
    # standing decline on every run is the noise this report is shaped to avoid.
    started = time.time()
    _, human = run([*upgrade[:-1], "--dry-run"], cwd=tree)
    code, _ = run(upgrade[:-1], cwd=tree)
    sidecars = tree / "tmp" / "upgrade"
    results.append(
        Result(
            "declined: a decline the template has moved past is itemised, the rest are not",
            "the template has changed since" in human
            and moved in human.split("the template has changed since")[1]
            and (sidecars / f"{moved}.new").exists()
            and not (sidecars / f"{dropped}.new").exists(),
            time.time() - started,
            human + "\n" + "\n".join(str(p.relative_to(sidecars)) for p in sidecars.rglob("*") if p.is_file()),
        )
    )

    started = time.time()
    report([])
    again = report(["--dry-run"])
    results.append(
        Result(
            "declined: it stays declined across a real upgrade",
            not (tree / dropped).exists() and dropped in again["declined"] and (tree / arriving).exists(),
            time.time() - started,
            f"{dropped} restored: {(tree / dropped).exists()}\n"
            f"{arriving} arrived: {(tree / arriving).exists()}\n" + json.dumps(again, indent=2),
        )
    )
    return results


def hook_args_for_tree(workdir: Path, tier: str) -> List[str]:
    """black's args from any already-generated tree of this tier."""
    for candidate in (workdir / f"{tier}-python", workdir / f"{tier}-both"):
        if (candidate / ".pre-commit-config.yaml").exists():
            return hook_args(candidate, "black")
    return []


def main() -> int:
    scaffolder = load_scaffolder()
    all_tiers = sorted(scaffolder.TIERS)
    all_languages = sorted(scaffolder.LANGUAGE_OVERLAYS) + ["none"]

    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--tier", action="append", choices=all_tiers, help="limit to a tier (repeatable)")
    parser.add_argument("--language", action="append", choices=all_languages, help="limit to a language (repeatable)")
    parser.add_argument("--keep", action="store_true", help="do not delete the generated trees")
    parser.add_argument("--workdir", help="where to generate (default: a temp dir)")
    parser.add_argument("-q", "--quiet", action="store_true", help="summary only")
    args = parser.parse_args()

    tiers = args.tier or all_tiers
    languages = args.language or all_languages
    #: Gates run against the language the template's own tests are written in.
    #: The others are scaffolded anyway, because an unrendered placeholder in an
    #: overlay nobody generates is a `render()` failure a user finds first.
    gated_language = "python"

    workdir = Path(args.workdir).resolve() if args.workdir else Path(tempfile.mkdtemp(prefix="skeletor-verify-"))
    workdir.mkdir(parents=True, exist_ok=True)
    print(f"🔎 verifying {len(tiers)} tier(s) × {len(languages)} language(s) in {workdir}")

    results: List[Result] = []
    try:
        venv_python = make_venv(workdir, args.quiet)
        pyright_ok, pyright_note = warm_pyright(venv_python)
        if not args.quiet:
            print(f"   pyright {pyright_note}" if pyright_ok else f"   ⚠️  pyright unavailable: {pyright_note}")
        for tier in tiers:
            for language in languages:
                result, tree = scaffold(tier, language, workdir)
                results.append(result)
                if not result.ok:
                    continue
                # Runs for EVERY language, unlike everything below it: both of
                # its inputs vary with `--language`, so gating it on `python`
                # would check the one configuration that cannot be wrong.
                setup_gate = check_setup_blocks_agree(tree, tier, language)
                setup_gate.label = f"{tier}: {setup_gate.label}"
                results.append(setup_gate)
                if language != gated_language:
                    continue
                (tree / ".venv").symlink_to(venv_python.parents[1])
                for gate in gates(tree, venv_python, pyright_ok):
                    gate.label = f"{tier}: {gate.label}"
                    results.append(gate)
                if not args.quiet:
                    print(f"   {tier}/{language} … {sum(1 for r in results if r.ok)} checks green so far")

        # The fullest tier, not the alphabetically last one — sorted(TIERS)
        # puts `governed` after `agentic`, which would have quietly gated the
        # wrong tree.
        fullest = max(tiers, key=lambda t: len(scaffolder.TIERS[t]))
        for gate in versioning_gate(fullest, workdir, venv_python):
            results.append(gate)

        for gate in host_exemption_gate(fullest, workdir, venv_python):
            results.append(gate)

        for gate in agentless_gate(fullest, workdir, venv_python):
            results.append(gate)

        for gate in badge_gate(fullest, workdir, venv_python):
            results.append(gate)

        for gate in populated_tree_gate(fullest, workdir):
            gate.label = f"{fullest}: {gate.label}"
            results.append(gate)

        allow_tree = workdir / f"{fullest}-python"
        if allow_tree.exists():
            gate = allowlist_gate(allow_tree, venv_python)
            gate.label = f"{fullest}: {gate.label}"
            results.append(gate)

        for gate in dirty_ref_gate(workdir):
            results.append(gate)

        for gate in entangled_gate(workdir):
            results.append(gate)

        for gate in components_gate(workdir):
            results.append(gate)

        for gate in declined_gate(fullest, workdir):
            gate.label = f"{fullest}: {gate.label}"
            results.append(gate)

        for gate in sidecar_gate(fullest, workdir):
            gate.label = f"{fullest}: {gate.label}"
            results.append(gate)

        for gate in collect_diff_gate(fullest, workdir, venv_python):
            gate.label = f"{fullest}: {gate.label}"
            results.append(gate)

        # Not per-tier: it is a question ABOUT the tiers, so it scaffolds its own
        # grid and runs once.
        results += tier_composition_gate(workdir)

        for gate in long_path_gate(fullest, workdir, venv_python):
            gate.label = f"{fullest}: {gate.label}"
            results.append(gate)

        node_tree = workdir / f"{fullest}-both"
        if node_tree.exists():
            for gate in [*node_gates(node_tree), check_no_baked_paths(node_tree)]:
                gate.label = f"{fullest}/both: {gate.label}"
                results.append(gate)
    finally:
        if not args.keep:
            shutil.rmtree(workdir, ignore_errors=True)
        else:
            print(f"   trees kept in {workdir}")

    failed = [r for r in results if not r.ok]
    print()
    for result in results:
        print(f"  {result.mark} {result.label}  ({result.seconds:.1f}s)")
    print()

    if failed:
        for result in failed:
            print(f"── {result.label} ──")
            print(result.output.strip()[-4000:])
            print()
        print(f"❌ {len(failed)} of {len(results)} checks failed")
        return 1

    print(f"✅ {len(results)} checks green — every tier scaffolds and passes its own gates")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
