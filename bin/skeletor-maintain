#!/usr/bin/env python3
"""The weekly maintenance pass, run locally, waking an agent only if there is work.

`docs/MAINTENANCE.md` is the procedure. This is the part of it a machine can do
without judgement — establish whether anything needs doing — plus an optional
handoff to an agent for the part that needs some.

The order matters and is the whole point. Asking three cheap questions first is
what keeps an unattended weekly job from costing anything on the ~50 weeks a
year when the answer is "nothing":

    1. is `verify.yml` still green on `main`?   (one API call)
    2. is any pin behind or in disagreement?    (one registry sweep)
    3. has an upstream moved in a path we took? (one `git rev-list`)

The third is the only one that looks outside this repository, and it is the only
question here that no gate in this tree can ask: skeletor was extracted from a
mature production repository, that repository kept going, and whether it has
grown a mechanism worth taking is a fact about a checkout this one does not
contain. Like `check-pins`, it reports and never adopts.

That question reads two files with one job each, and `declared_upstreams()` has
the argument: `upstream.json` is the tracked, public RECORD — what was taken and
what was declined, with reasons — while `upstream.local.json` is the gitignored
CONFIGURATION naming the repository to watch and where it sits. A fresh clone
has the second of those to write, and this says so rather than reporting an
absence.

None of the three needs a model. If all are clean this exits having spent
nothing, and an agent is never invoked. If any is not, there is a specific thing to look at,
and `--agent` hands over with that context rather than asking a model to go
looking for work — which is how a maintenance bot becomes a thing people mute.

It refuses to run on a dirty tree or off the release branch. An unattended pass
that starts from uncommitted local edits cannot tell its own changes from the
ones already there, and the first thing it would do is commit somebody's
work-in-progress.

Usage:
    bin/skeletor-maintain                # report; exit 1 if there is work
    bin/skeletor-maintain --agent        # ... and hand the work to `claude`
    bin/skeletor-maintain --agent --dry-run
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Dict, List, Optional, Tuple

SKELETOR = Path(__file__).resolve().parent.parent
RELEASE_BRANCH = "main"
PROCEDURE = "docs/MAINTENANCE.md"
UPSTREAMS = SKELETOR / "upstream.json"
LOCAL_UPSTREAMS = SKELETOR / "upstream.local.json"


def run(cmd: List[str]) -> Tuple[int, str]:
    proc = subprocess.run(cmd, cwd=str(SKELETOR), capture_output=True, text=True)
    return proc.returncode, (proc.stdout or "") + (proc.stderr or "")


def refuse_if_unsafe() -> Optional[str]:
    """The preconditions an unattended run has no way to recover from."""
    code, branch = run(["git", "rev-parse", "--abbrev-ref", "HEAD"])
    if code != 0:
        return "not a git repository"
    if branch.strip() != RELEASE_BRANCH:
        return f"on branch {branch.strip()!r}, not {RELEASE_BRANCH!r} — refusing to maintain a feature branch"

    code, dirty = run(["git", "status", "--porcelain"])
    if dirty.strip():
        return (
            "the working tree has uncommitted changes:\n    "
            + dirty.strip().replace("\n", "\n    ")
            + "\n  an unattended pass cannot tell these from its own edits"
        )
    return None


def ci_verdict() -> Tuple[str, str]:
    """The last `verify.yml` conclusion on the release branch.

    Read from GitHub rather than by running the gates here: `verify.yml` already
    runs them weekly, and a second local run would answer about this machine's
    toolchain rather than the one that gates a merge. Where they disagree the
    CI answer is the one that matters, which is 1f899f4's whole lesson.
    """
    if not shutil.which("gh"):
        return "unknown", "gh is not on PATH — cannot read the last verify run"

    code, output = run([
        "gh", "run", "list", "--workflow", "verify.yml", "--branch", RELEASE_BRANCH,
        "--limit", "1", "--json", "conclusion,displayTitle,url",
    ])
    if code != 0:
        return "unknown", f"gh could not read the run list:\n{output.strip()}"
    try:
        runs = json.loads(output)
    except ValueError:
        return "unknown", f"unreadable gh output:\n{output.strip()}"
    if not runs:
        return "unknown", "no verify.yml runs recorded on this branch yet"

    last = runs[0]
    conclusion = last.get("conclusion") or "in_progress"
    return conclusion, f"{conclusion}: {last.get('displayTitle', '')}\n   {last.get('url', '')}"


def pin_verdict() -> Tuple[bool, str]:
    """Whether any pin is behind or disagreeing, via check-pins' own exit code."""
    code, output = run([sys.executable, str(SKELETOR / "bin" / "skeletor-check-pins"), "--fail-on-stale"])
    return code != 0, output.strip()


def normalise_origin(raw: str) -> str:
    """A remote URL reduced to `owner/repository`, so spellings compare equal.

    `git@host:owner/repo.git`, `https://host/owner/repo` and `.../repo.git/`
    are one repository, and an upstream recorded in one spelling must match a
    checkout configured in another. Deliberately not a URL parser: everything
    before the owner is what varies, and everything this needs is the last two
    non-empty components with any `.git` suffix removed.
    """
    trimmed = raw.strip()
    if not trimmed or any(character.isspace() for character in trimmed):
        return ""
    # Components first, THEN the suffix. Stripping `.git` off the raw string
    # leaves it in place whenever a trailing slash follows it — measured, on
    # `https://host/owner/repo.git/`, which normalised to `owner/repo.git` and
    # compared unequal to every other spelling of the same repository.
    parts = [part for part in trimmed.replace(":", "/").split("/") if part and part != "."]
    parts = [part.removesuffix(".git") for part in parts]
    return "/".join(parts[-2:]).lower() if len(parts) >= 2 else ""


def declared_upstreams() -> Tuple[Dict[str, dict], Path, str]:
    """What to watch and where to look for it — the operator's file if there is one.

    **Two files, one job each, and the split is the point.**

    `upstream.json` is tracked and PUBLIC: the decision record. What was
    harvested, what was declined, and why. Those rulings generalise, they are
    the half a reader of this repository benefits from, and they belong in git
    beside the code they justify.

    `upstream.local.json` is gitignored and is the CONFIGURATION: which
    repository, where to look for it, and how far it has been read. That half
    does not generalise. It names a checkout that exists on one machine, and
    here it names a *private* repository — so carrying it in a public repo was
    a disclosure nobody decided to make, and tracking it meant a fork could not
    change what it watches without diverging from our origin forever.

    Both were one file until 2026-09-08, which was fine while this repository
    was private and stopped being fine the day it was not. Same class as
    everything else in this project's notes: a fact that was safe when written,
    with the world moving underneath it.

    **The local `upstreams` map REPLACES the tracked one; it never merges.** A
    merge would be a second home for one fact, and — the reason that matters —
    it would leave a fork no way to *stop* watching an upstream they cannot
    see, which is the first thing a fork needs.

    `search_root` is here for the same reason. `find_checkout` scans the
    directory holding this checkout, which is this workspace's layout and not a
    fact about anybody else's.
    """
    root, source = SKELETOR.parent, UPSTREAMS.name
    declared: Dict[str, dict] = {}

    for path in (UPSTREAMS, LOCAL_UPSTREAMS):
        if not path.exists():
            continue
        try:
            parsed = json.loads(path.read_text(encoding="utf-8"))
        except ValueError as exc:
            raise SystemExit(f"❌ {path.name} does not parse as JSON: {exc}")
        # `_`-prefixed keys are commentary, here and in `sources_untracked`.
        # It is a JSON file with nowhere else to put a sentence.
        declared = {k: v for k, v in (parsed.get("upstreams") or {}).items() if not k.startswith("_")}
        if path is LOCAL_UPSTREAMS:
            source = path.name
            if given := parsed.get("search_root"):
                root = Path(given).expanduser().resolve()

    return declared, root, source


def find_checkout(origin: str, root: Path) -> Optional[Path]:
    """A checkout of `origin` directly under `root`, or None.

    **Located by remote, never by a recorded path.** A path is correct on the
    machine it was written on and wrong on every other one, which is the class
    `checkout_path_literal_gate` exists to keep out of tracked files — and it
    would be worse here than in prose, because a stale path resolves to *some*
    directory and this would read that one's history instead of failing.

    Immediate children of `root` only, never a recursive walk: that would make
    an unattended weekly pass a filesystem crawl. `root` defaults to the
    directory holding this checkout, which is one workspace's layout rather
    than a fact about anybody else's — an operator whose repositories live
    elsewhere sets `search_root` in `upstream.local.json`.

    **A linked worktree is skipped, and that is not a detail.** Every worktree
    of a repository reports the same `origin`, so the first alphabetical match
    is whichever one happens to sort first — and it is sitting on some feature
    branch. The first run of this found `jam-deps`, a dependency-bump worktree,
    and reported 11 commits of somebody's Dependabot branch as upstream
    movement. A worktree's `.git` is a *file* pointing into the main checkout;
    the repository's own root has it as a directory, and that is the whole
    distinction.
    """
    wanted = normalise_origin(origin)
    if not wanted:
        return None
    for candidate in sorted(root.iterdir()):
        if not (candidate / ".git").is_dir():
            continue
        proc = subprocess.run(
            ["git", "-C", str(candidate), "remote", "get-url", "origin"],
            capture_output=True,
            text=True,
        )
        if proc.returncode == 0 and normalise_origin(proc.stdout) == wanted:
            return candidate
    return None


def upstream_verdict() -> Tuple[bool, str]:
    """Has anything moved in a repository this template harvests mechanisms from?

    The third cheap question, and the only one that looks outside this
    repository. skeletor was extracted from a mature production repository and
    that repository kept going — so "am I current" has a second meaning here
    that no gate in this tree can ask, because the answer lives in a checkout
    this one does not contain.

    **It reports and never adopts, for the same reason `check-pins` does not
    bump.** Which of an upstream's changes generalises is a judgment every time:
    most of what moves there is that product's own work, and the fraction that
    is a reusable mechanism is decided by reading it. What a machine can do is
    say *where to look* and *how far you have already read*, which is what
    `declared_upstreams()` reads.

    Silence is never a pass. An upstream that cannot be located is reported as
    unreadable rather than as unchanged, since the two are the same output from
    here and only one of them means there is nothing to do.
    """
    declared, root, source = declared_upstreams()
    if not declared:
        # Not a failure, and not silence either. A checkout with nothing
        # declared is the ordinary state of a fresh clone — this repository
        # ships the RECORD and not the configuration — so it says what to write
        # rather than reporting an absence somebody has to go and interpret.
        return False, (
            f"   nothing declared. {UPSTREAMS.name} is the public record; the repositories to watch\n"
            f"   go in {LOCAL_UPSTREAMS.name} (gitignored) — see the `upstreams` comment in\n"
            f"   {UPSTREAMS.name} for the shape."
        )

    lines: List[str] = []
    work = False

    for name, record in sorted(declared.items()):
        checkout = find_checkout(record.get("origin", ""), root)
        if checkout is None:
            lines.append(
                f"   {name}: no checkout with that origin under {root} — cannot read it from here "
                f"(declared in {source}; set `search_root` there if the layout differs)"
            )
            continue

        watermark = record.get("read_through", "")
        code, _ = run(["git", "-C", str(checkout), "cat-file", "-e", f"{watermark}^{{commit}}"])
        if code != 0:
            lines.append(f"   {name}: watermark {watermark} is not a commit in that checkout — fetch it, or fix the record")
            work = True
            continue

        sources = record.get("sources", {})

        # Checked BEFORE the "nothing new" return below, because whether a
        # recorded path still exists upstream has nothing to do with whether
        # the upstream has moved since the watermark. It was written after that
        # return at first, and planting a vanished path proved nothing: the
        # common case returns early, so the check never ran and the plant came
        # back green. A plant that does not land is indistinguishable from a
        # gate that works.
        #
        # The rule itself is this repository's own, applied to the record that
        # decides what this report even looks at: an exemption is checked
        # against the thing it exempts, on every run. A vanished source expires
        # in silence otherwise — `git diff -- <gone>` reports nothing changed,
        # which is exactly what a path that held still reports.
        for path in sorted(sources):
            if run(["git", "-C", str(checkout), "cat-file", "-e", f"HEAD:{path}"])[0] != 0:
                lines.append(f"   {name}: {path} is recorded as harvested and git cannot see it there "
                             f"— the record has outlived its subject, or the path is ignored upstream "
                             f"and belongs under sources_untracked")
                work = True

        # Named, never measured, and never counted as work. A path gitignored
        # upstream has no history for a watermark to compare against, so this
        # report cannot say whether it moved — ever. That is a limit of the
        # instrument rather than a finding, and the only honest place for it is
        # inside the instrument, where somebody reading a clean row can see what
        # the row does not cover.
        #
        # It was found by planting a vanished path and watching the check fire
        # on a real entry instead: jam-sense ignores `.vscode/`, so the queries
        # this template's lanes came from live on one machine and are in nobody's
        # git. Ours are generated and tracked, which is most of why the port was
        # worth making rather than copying.
        for path in sorted(record.get("sources_untracked", {})):
            if not path.startswith("_"):
                lines.append(f"   {name}: {path} is ignored upstream — harvested, and not watchable from here")

        code, count = run(["git", "-C", str(checkout), "rev-list", "--count", f"{watermark}..HEAD"])
        moved = count.strip() if code == 0 else "?"
        if moved in ("0", ""):
            lines.append(f"   {name}: nothing new since {watermark[:9]}  ({checkout.name})")
            continue

        # The harvested paths are the ones with a decision behind them, so they
        # are itemised and everything else is a count. Reversing that would
        # bury the four paths somebody has already judged worth reading under
        # every commit the upstream made this week.
        code, changed = run(
            ["git", "-C", str(checkout), "diff", "--name-only", f"{watermark}..HEAD", "--", *sources]
        ) if sources else (0, "")
        touched = [path for path in changed.split() if path]

        lines.append(f"   {name}: {moved} commit(s) since {watermark[:9]}  ({checkout.name})")
        for path in touched:
            lines.append(f"      ↑ {path} — {sources.get(path, 'harvested from')}")
        if touched:
            work = True

    return work, "\n".join(lines)


AGENT_PROMPT = f"""\
You are running skeletor's scheduled weekly maintenance pass, unattended.

Read {PROCEDURE} and follow it. It is the procedure; do not work from memory of
it and do not improvise a different one.

What triggered this run:

{{trigger}}

Two things that file says and that matter most here, because nobody is watching:
do not merge anything, and if `bin/skeletor-verify` comes back red, stop and
report the actual failure output rather than a summary of it.
"""


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="skeletor-maintain",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--agent", action="store_true", help="hand any work to `claude` (headless)")
    parser.add_argument("--dry-run", action="store_true", help="with --agent: print the handoff, invoke nothing")
    args = parser.parse_args()

    if refusal := refuse_if_unsafe():
        print(f"⏸️  {refusal}")
        return 2

    code, output = run(["git", "fetch", "--quiet", "origin", RELEASE_BRANCH])
    if code != 0:
        print(f"⚠️  could not fetch origin/{RELEASE_BRANCH} — reporting on the local checkout:\n   {output.strip()}")

    code, behind = run(["git", "rev-list", "--count", f"HEAD..origin/{RELEASE_BRANCH}"])
    unpulled = behind.strip() if code == 0 else "0"

    conclusion, ci_detail = ci_verdict()
    stale, pins_detail = pin_verdict()
    upstream_moved, upstream_detail = upstream_verdict()

    print(f"skeletor maintenance — {RELEASE_BRANCH}")
    print(f"   CI:   {ci_detail}")
    print(f"   pins: {'something is behind or disagrees' if stale else 'all current or allowlisted'}")
    print("   from upstream:")
    print(upstream_detail)
    if unpulled not in ("0", ""):
        print(f"   git:  {unpulled} commit(s) on origin/{RELEASE_BRANCH} not pulled")
    print()

    work = []
    if conclusion not in ("success", "unknown"):
        work.append(f"`verify.yml` last concluded **{conclusion}** on {RELEASE_BRANCH}:\n{ci_detail}")
    if conclusion == "unknown":
        # Loud, never silent: an unreadable CI verdict is not a green one, and a
        # pass that quietly treats it as green is indistinguishable from one that
        # checked. It is not by itself work, so it does not wake an agent.
        print(f"⚠️  CI verdict unavailable — {ci_detail}")
    if stale:
        work.append(f"`bin/skeletor-check-pins` reports work:\n\n```\n{pins_detail}\n```")
    if upstream_moved:
        work.append(
            "A repository this template harvests from has moved in a path we have taken before:\n\n"
            f"```\n{upstream_detail}\n```\n"
            "Read the diff and decide. Most of what moves upstream is that product's own work; "
            "adopt only what generalises, and record the decision in `upstream.json` either way — "
            "advance `read_through`, and add a `_not_taken` entry for anything you looked at and declined."
        )

    if not work:
        print("✅ nothing to do — CI is green, every pin is current or allowlisted, "
              "and nothing has moved in a harvested path upstream")
        return 0

    print("── work ──")
    for item in work:
        print(item)
        print()

    if not args.agent:
        print(f"Follow {PROCEDURE}, or re-run with --agent to hand this over.")
        return 1

    prompt = AGENT_PROMPT.format(trigger="\n\n".join(work))

    if args.dry_run:
        print("── would invoke `claude` with ──")
        print(prompt)
        return 1

    if not shutil.which("claude"):
        print("❌ --agent needs `claude` on PATH, and it is not there")
        return 2

    print("→ handing over to claude …")
    sys.stdout.flush()
    # Inherits stdio rather than capturing: this is normally run by a timer whose
    # journal IS the record, and a captured transcript printed after the fact is
    # one nobody reads at the moment it would have mattered.
    return subprocess.run(["claude", "-p", prompt], cwd=str(SKELETOR), env=dict(os.environ)).returncode


if __name__ == "__main__":
    raise SystemExit(main())
