#!/usr/bin/env python3
"""What did this tree take from skeletor, and has any of it moved since?

A **provenance** contract, not an acquisition one — and that distinction is the
whole reason this exists beside `bin/skeletor-upgrade`.

`skeletor-upgrade` answers "carry the template's changes into a tree skeletor
generated". It needs `.skeletor.json`, which records the *arguments*, so the base
can be re-rendered and three-way merged. That contract is exact and it is also
all-or-nothing: it claims the tree reproduces a render.

Three consumers wanted something weaker in the same week. proto.pilot adopted and
pays for it in standing merge points; sky.boss measured twelve overwrites against
seventeen declines and declined adoption; jam.sense is skeletor's **ancestor**,
shares 89 paths, and has zero files byte-identical to any render. None of them
can honestly say "this tree is a skeletor scaffold". All of them can say "I
copied these files, from here, at this ref" — and want to know when the original
moves.

## Why a synthesised `.skeletor.json` is not the answer

It is the obvious shortcut and it is worse than nothing. `cross_check` compares
the manifest against the base **render**, never against the tree — so a manifest
synthesised from any render passes trivially, and the upgrade then three-way
merges with an ancestor that never existed. `git merge-file` does not refuse a
fictional base; it merges what it can. The conflicts would be harmless. **The
clean merges are the damage**, written silently under `✅ merged cleanly`.

So this tool never merges and never writes into the tree. It reports. Same
posture as `bin/skeletor-check-pins`, which reports a bump and never makes one.

## Why two hashes per file, and not one

The tempting design records one hash and compares it to the template. That is
meaningless: `template/core/scripts/paths.py` contains `{{...}}` placeholders and
the copy in somebody's tree does not — and it would be *silently* meaningless for
a file with no placeholders today, matching by luck until the day one is added.

So each file records both:

* `source_sha` — the template file at the ref it was taken from. Compared against
  the template today, this answers **has upstream moved?** Both sides are raw
  template, so rendering never enters it.
* `local_sha` — the file in the tree at the moment it was taken. Compared against
  that file today, this answers **have we edited ours?**

Two independent comparisons, four states, and the two questions never contaminate
each other. jam.sense asked for the second and offered to drop it if it were
expensive; it costs one extra hash, and without it a report cannot tell their
adaptation from skeletor's improvement — which is a report people learn to skim.

## Why the unit is a component and not a file

jam.sense's argument, taken whole: the thing you take is a *contract*, and
`output.py`, `allowlist.py`, `check_output_discipline.py` and
`test_output_contract.py` only mean anything together. **A change to the checker
with no change to the module is exactly the drift worth flagging loudest**, and
per-file granularity renders it as one quiet line among four.

Per-file is recoverable from per-component — the set names its paths. The reverse
needs somebody to re-derive the grouping by hand, at which point the grouping
lives in a person's head and rots. Take the lossless direction.

A ref is recorded **per file**, not per component, because components are
assembled over time: taking `paths.py` today and the output contract next week
under one ref would either backdate the second or falsely advance the first.

Usage:
    bin/skeletor-components report <tree> [--json]
    bin/skeletor-components record <tree> --component <name> \\
        --file <template-path>[:<tree-path>] [--file ...]
"""

from __future__ import annotations

import argparse
import hashlib
import importlib.machinery
import importlib.util
import json
import subprocess
import sys
from pathlib import Path
from typing import Dict, List, Optional, Tuple

SKELETOR = Path(__file__).resolve().parent.parent
COMPONENTS_NAME = ".skeletor-components.json"

#: What a file can be, and the mark it prints under. `both` is the one that
#: needs a person: upstream moved *and* the local copy was adapted, so neither
#: "take theirs" nor "keep ours" is automatically right.
MARKS = {"current": "✅", "upstream": "⬆️", "local": "✏️ ", "both": "❗", "gone": "❔"}


def say(symbol: str, message: str) -> None:
    print(f"{symbol} {message}", file=sys.stderr)


def item(message: str) -> None:
    print(f"   · {message}", file=sys.stderr)


def detail(message: str = "") -> None:
    print(f"   {message}" if message else "", file=sys.stderr)


def die(message: str) -> "NoReturn":  # type: ignore[valid-type]
    say("❌", message)
    raise SystemExit(1)


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: Path) -> Optional[str]:
    return sha256_bytes(path.read_bytes()) if path.is_file() else None


def template_at(ref: str, source: str) -> Optional[bytes]:
    """A template file's bytes at a skeletor ref, or None if it is not there.

    `git show` rather than a checkout: this reads one file per entry and a
    worktree would cost a full tree for each ref somebody has taken from.
    """
    result = subprocess.run(
        ["git", "-C", str(SKELETOR), "show", f"{ref}:{source}"],
        capture_output=True,
    )
    return result.stdout if result.returncode == 0 else None


def relocated(source: str) -> Optional[str]:
    """Where a template file of this name lives now, if exactly one does.

    Only ever a pointer. Two matches or none is silence, because a guess in a
    report that exists to be trusted is worse than an absent sentence — and this
    tool merges nothing, so the adopter is the one who rules.
    """
    name = Path(source).name
    result = subprocess.run(
        ["git", "-C", str(SKELETOR), "ls-files", "template/"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return None
    matches = [line for line in result.stdout.splitlines() if line.endswith("/" + name)]
    return matches[0] if len(matches) == 1 else None


def current_ref() -> str:
    """What `record` stamps. Tagged where possible, because a bare sha is
    strippable by a rebase and unreadable to the person reading the report."""
    result = subprocess.run(
        ["git", "-C", str(SKELETOR), "describe", "--tags", "--always", "--dirty"],
        capture_output=True,
        text=True,
    )
    return result.stdout.strip() or "unknown"


def load(tree: Path) -> dict:
    path = tree / COMPONENTS_NAME
    if not path.exists():
        return {"components": {}}
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        die(f"{path} is not valid JSON: {exc}")


def save(tree: Path, data: dict) -> Path:
    data["_comment"] = (
        "Written by skeletor-components; read by skeletor-components report. It records what "
        "this tree COPIED from skeletor and when — it does NOT claim this tree was scaffolded "
        "by skeletor. Nothing here is ever merged or written back; see bin/skeletor-components."
    )
    path = tree / COMPONENTS_NAME
    path.write_text(json.dumps(data, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return path


def scaffolder():
    """Import ``bin/skeletor-new`` for its marker constants.

    It has no ``.py`` suffix, so the import is by path; everything at its module
    level is a definition and ``main()`` is guarded. Same loader
    ``bin/skeletor-verify`` uses, for the same reason.
    """
    loader = importlib.machinery.SourceFileLoader("skeletor_new", str(SKELETOR / "bin" / "skeletor-new"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


#: What the scaffolder does to a template file on its way into a tree:
#: `render()` substitutes `{{NAME}}`, and `drop_absent_prose` removes marked
#: blocks whose condition the tree does not satisfy. A file carrying neither is
#: copied byte for byte, and that is the whole basis of `taken_verbatim` below.
#:
#: **Read from `bin/skeletor-new`, not repeated.** The comment here used to say
#: that and the line below it was a hand-written tuple — a claim about a
#: mechanism that did not exist, in the one place where being wrong is silent:
#: an unlisted marker makes a *rendered* file look verbatim, which promotes
#: `baseline` from "unknowable" to "provably clean" and reports a fork as
#: unchanged. It was found the only way that is ever found, by somebody adding
#: a fourth marker and having to edit two files.
TRANSFORMS = ("{{",) + scaffolder().OPENERS


def rendered_verbatim(blob: bytes) -> bool:
    """Would the scaffolder copy this template file unchanged?

    The one sound half of a discriminator that is otherwise impossible. Hashes
    cannot tell a fork from a rendering, because rendering and editing are the
    same signal — but **for a file the scaffolder does not transform, they are
    not**: `source_sha != local_sha` at record time then means somebody changed
    it, and nothing else can produce that difference.

    sky.boss proposed the general rule, found the counter-example in their own
    manifest — `docs/rules/commits.md`, fourteen placeholders, never edited —
    and retracted it. This is what survives the retraction, and it is the shape
    their own tree measures: of four files a hash comparison flags there, three
    are real forks and the fourth is rendering, and the three are exactly the
    ones with nothing to render.

    Conservative by construction. A file it cannot vouch for is reported as
    undetermined rather than as untouched, which is the direction the original
    defect ran the wrong way.
    """
    try:
        text = blob.decode("utf-8")
    except UnicodeDecodeError:
        return False
    return not any(marker in text for marker in TRANSFORMS)


def classify(tree: Path, entry: dict) -> Tuple[str, str]:
    """One file's state, and the sentence explaining it.

    Two comparisons that never touch each other — see the module docstring on
    why one hash cannot serve both.

    **Every sentence here says "since you recorded it", and the words are the
    fix.** They used to say *"this copy is untouched"*, which is accurate about
    what the hash measures and wrong about what a reader takes from it: the
    baseline is the file at `record` time, so a file forked *before* being
    recorded is indistinguishable from one taken verbatim, for ever. sky.boss
    read `⬆️ scripts/paths.py — this copy is untouched` about a file they had cut
    from 159 lines to 63 before recording, and it reproduces in jam.sense at a
    different ref for a different adopter — two of three "untouched" lines false
    there.

    **Adoption is when nearly all forking happens**, so the blind case is the
    common one, and the consequence runs the wrong way: on a fork, *"upstream
    moved"* usually means *check whether the change even applies to what you
    kept*, and a reader trusting "untouched" pulls back in a block they deleted
    on purpose. sky.boss's `paths.py` was exactly that — the state-root fix,
    which they had already answered by deleting the block.

    The state that reads worst is the green one. A fork showing `✅` is the same
    false claim on a line a reader skimming for `⬆️` never stops at, which is why
    that sentence changed too.

    **What this deliberately does not do is guess which it was.** The obvious
    discriminator — `source_sha != local_sha` at record time — is unsound, and
    the module docstring already says why: `source_sha` is raw template and
    `local_sha` is the adapted copy, so the two differ for every file carrying a
    `{{...}}` placeholder however faithfully it was taken. `scripts/paths.py`
    has two. Adopting that rule would report a fork for every verbatim take of a
    templated file — the same false reading facing the other way, and harder to
    doubt because it fires on real forks too. Telling the two apart needs a fact
    the record does not hold, and saying less is better than saying it wrongly.

    **But not guessing is not the same as not saying**, and the first version of
    this ran the two together. The baseline has THREE states and it shipped with
    two spellings: `source_sha == local_sha` is a file that provably matched the
    template at record time, and a placeholder file that differed is one nothing
    here can rule on — and both printed *"unchanged on both sides since you
    recorded it"*. **A green that means checked-and-clean and a green that means
    could-not-check were the same pixel**, which is this project's own
    null-result rule landing on its own instrument. It costs most exactly where
    it is silent: a `⬆️` line at least sends a reader to a diff, and nobody
    investigates a `✅`.

    So the third state is named. `baseline` is on every JSON row as `matched`,
    `forked` or `unknown`, because a consumer that had to parse the sentence to
    recover it would be re-deriving a fact this function already holds.

    jam.sense found it in an evaluation of six files, and named the case: their
    `test_pyright_scope.py` is a real fork — `jam check docs` became
    `jam check markdown`, and a `# noqa: E402` was dropped — and rendered green
    beside `allowlist.py`, which is provably identical. Same mark, opposite
    facts.
    """
    ref = entry["ref"]
    source = entry["source"]

    upstream_then = entry.get("source_sha")
    upstream_now_bytes = template_at("HEAD", source)
    if upstream_now_bytes is None:
        # What is known is that the PATH is gone. `skeletor no longer ships
        # <source>` said the file was retired, and v0.15.0 made that false for a
        # live consumer: `test_pyright_scope.py` moved `template/python/` ->
        # `template/core/`, so jam.sense was told a gate had been dropped when it
        # had been promoted to a tier they take more readily. **A move is
        # indistinguishable from a deletion at a fixed path**, so the note says
        # the true half and names a candidate when exactly one file of that name
        # survives — a pointer to look at, never a re-record, which only the
        # adopter can decide.
        moved_to = relocated(source)
        if moved_to:
            return "gone", "unknown", f"{source} is gone from the template — same filename now at {moved_to}"
        return "gone", "unknown", f"{source} is gone from the template"
    moved = sha256_bytes(upstream_now_bytes) != upstream_then

    local_now = sha256_file(tree / entry["path"])
    if local_now is None:
        return "gone", "unknown", f"not in this tree any more (was {entry['path']})"
    edited = local_now != entry.get("local_sha")

    # The one thing that CAN be said about the record baseline, said only where
    # it is provable. For a template file the scaffolder copies byte for byte, a
    # `source_sha != local_sha` at record time is a change somebody made and
    # nothing else — so the fork is certain rather than guessed, and the file is
    # named as one. Everything else stays silent about it.
    taken = entry.get("source_sha") is not None and entry.get("local_sha") != entry.get("source_sha")
    source_then = template_at(ref, source)
    # The baseline clause is appended to every state rather than folded into
    # the middle of one, because it qualifies the same word each time — what
    # "unchanged" and "changed" are measured FROM. Trailing also keeps the
    # three spellings adjacent to each other in the output, where a reader
    # comparing two lines can see that they differ.
    since = "since you recorded it"
    if not taken:
        baseline = "matched"
        aside = "it matched the template exactly when you recorded it"
    elif source_then is not None and rendered_verbatim(source_then):
        baseline = "forked"
        aside = "it ALREADY differed from the template when you recorded it"
    else:
        baseline = "unknown"
        aside = (
            "whether it already differed from the template then is not knowable from this "
            "record (it renders placeholders, so rendering and an edit look identical)"
        )

    if moved and edited:
        head = f"upstream moved since {ref}, and this copy changed {since}"
    elif moved:
        head = f"upstream moved since {ref}; your copy is unchanged {since}"
    elif edited:
        head = f"this copy changed {since}; upstream unchanged since {ref}"
    else:
        head = f"unchanged on both sides {since}, at {ref}"
    state = "both" if (moved and edited) else "upstream" if moved else "local" if edited else "current"
    return state, baseline, f"{head} — {aside}"


def report(tree: Path, as_json: bool, fail_on_drift: bool = False) -> int:
    data = load(tree)
    components = data.get("components", {})
    if not components:
        die(f"{tree / COMPONENTS_NAME} records no components — nothing to report on")

    payload: Dict[str, list] = {}
    interesting = 0
    for name in sorted(components):
        rows = []
        for path in sorted(components[name].get("files", {})):
            entry = dict(components[name]["files"][path], path=path)
            state, baseline, why = classify(tree, entry)
            rows.append(
                {
                    "path": path,
                    "source": entry["source"],
                    "ref": entry["ref"],
                    "state": state,
                    # What the record can say about the moment it was taken:
                    # `matched`, `forked`, or `unknown`. In JSON because a
                    # consumer parsing it back out of `note` would be
                    # re-deriving what this row already knows.
                    "baseline": baseline,
                    "note": why,
                }
            )
            # Drift is movement on SKELETOR's side. A file this repo adapted and
            # upstream has not touched is a steady state, not a pending decision
            # — failing on it would make the gate red forever for every repo
            # that did the thing components adoption exists to allow.
            if state in ("upstream", "both", "gone"):
                interesting += 1
        payload[name] = rows

    if as_json:
        print(json.dumps({"tree": str(tree), "components": payload}, indent=2, sort_keys=True))

    for name, rows in payload.items():
        moved = sum(1 for r in rows if r["state"] in ("upstream", "both"))
        # The component headline first, because the component is the unit: a
        # checker that moved while its module did not is the drift worth seeing,
        # and it is invisible in a flat list of files.
        gone = sum(1 for r in rows if r["state"] == "gone")
        summary = f"{len(rows)} file(s)"
        if moved:
            summary += f", {moved} moved upstream"
        if gone:
            summary += f", {gone} unresolvable"
        # `gone` outranks `moved`, and both outrank clean. The headline was a
        # binary on `moved`, so a component whose every file was unresolvable
        # summarised as `✅` — the clean mark over a row that says the opposite,
        # two lines apart. **Declining to rule is correct; rendering the
        # declined case as the clean case is a claim**, which is the same
        # sentence this tool already earned once at `b0f527b`, for `baseline`
        # rather than for the headline. One field over, and the fix that landed
        # there did not generalise because nothing made it.
        say(MARKS["gone"] if gone else MARKS["upstream"] if moved else MARKS["current"], f"{name} — {summary}")
        for row in rows:
            item(f"{MARKS[row['state']]} {row['path']} — {row['note']}")

    if interesting:
        detail()
        detail("Nothing here was changed and nothing will be: this reports, it never merges.")
        detail(f"{MARKS['both']} is the one needing a person — both sides moved.")

    # The exact commands, with the ref and the source filled in. This printed a
    # template — `git -C <skeletor> diff <ref> HEAD -- <source>` — which is an
    # instruction the reader has to complete from three places: where skeletor
    # is, which ref this file was taken at, and what its source path is. All
    # three are in the manifest, so asking for them back is the tool making the
    # reader do its lookup. The re-record line matters most: it is the step that
    # advances the baseline, and a step you must retype is a step you skip.
    for name, rows in payload.items():
        for row in rows:
            if row["state"] in ("upstream", "both"):
                detail()
                detail(f"{row['path']} — what moved:")
                detail(f"  git -C {SKELETOR} diff {row['ref']} HEAD -- {row['source']}")
                detail("  then, once you have taken what you want:")
                detail(f"  {sys.argv[0]} record {tree} --component {name} --file {row['source']}")

    return 1 if (fail_on_drift and interesting) else 0


def record(tree: Path, component: str, files: Optional[List[str]]) -> int:
    """Record files, or re-record every file already in a component.

    Omitting `--file` re-records the whole component at today's ref. It is the
    "I have taken the upstream changes" step, and it is **deliberately loud**,
    because the tool cannot tell whether you took them: re-recording without
    taking them silences a true report rather than resolving it. That is the one
    way this tool can lie, so it says so and names what it is about to advance.
    """
    if not files:
        existing = load(tree).get("components", {}).get(component, {}).get("files", {})
        if not existing:
            die(f"no component named {component!r} in {tree / COMPONENTS_NAME} — nothing to re-record")
        files = [f"{entry['source']}:{path}" for path, entry in sorted(existing.items())]
        say("⚠️ ", f"re-recording all {len(files)} file(s) in {component} at today's ref")
        detail("This marks them current. Do it AFTER taking the upstream changes — doing it")
        detail("instead of taking them silences the report rather than resolving it.")

    ref = current_ref()
    if ref.endswith("-dirty"):
        # The same refusal skeletor-upgrade makes, for the same reason: a ref
        # that names uncommitted work describes a source nobody else can read,
        # so every later report would compare against a fiction.
        die(f"skeletor is at {ref} — commit first, or the recorded ref names a source nobody can resolve")

    data = load(tree)
    entry = data.setdefault("components", {}).setdefault(component, {}).setdefault("files", {})
    for spec in files:
        source, _, dest = spec.partition(":")
        dest = dest or source.split("/", 2)[-1]  # template/<overlay>/<path> → <path>
        blob = template_at(ref, source)
        if blob is None:
            die(f"skeletor at {ref} has no {source}")
        local = sha256_file(tree / dest)
        if local is None:
            die(f"{tree / dest} does not exist — copy it before recording it")
        entry[dest] = {"source": source, "ref": ref, "source_sha": sha256_bytes(blob), "local_sha": local}
        say("✅", f"{component}: {dest} ← {source} @ {ref}")

    path = save(tree, data)
    detail(f"recorded in {path.relative_to(tree)}")
    detail("Re-record a file after you take an upstream change, so the next report starts there.")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__.splitlines()[0], formatter_class=argparse.RawDescriptionHelpFormatter
    )
    sub = parser.add_subparsers(dest="action")

    rep = sub.add_parser("report", help="what has moved since it was taken (the default)")
    rep.add_argument("tree")
    rep.add_argument("--json", action="store_true")
    rep.add_argument(
        "--fail-on-drift",
        action="store_true",
        help="exit 1 if anything moved upstream — for a pre-push or a CI job",
    )

    rec = sub.add_parser("record", help="record files copied out of skeletor")
    rec.add_argument("tree")
    rec.add_argument("--component", required=True, help="the named set these files belong to")
    rec.add_argument(
        "--file",
        action="append",
        dest="files",
        metavar="TEMPLATE_PATH[:TREE_PATH]",
        help="e.g. template/core/scripts/output.py, or ...:lib/output.py if you renamed it",
    )

    args = parser.parse_args()
    if args.action is None:
        parser.print_help()
        return 0

    tree = Path(args.tree).expanduser().resolve()
    if not tree.is_dir():
        die(f"{tree} is not a directory")

    if args.action == "record":
        return record(tree, args.component, args.files)
    return report(tree, args.json, args.fail_on_drift)


if __name__ == "__main__":
    raise SystemExit(main())
