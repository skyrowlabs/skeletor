#!/usr/bin/env python3
"""Carry a template change into a tree that was scaffolded from an older one.

The problem this exists for is the multi-repo one: skeletor improves, and the
twelve repositories generated from it do not. Re-running `skeletor-new --force`
would overwrite the half of each tree that is the *user's* — the services table
in `CLAUDE.md`, the real health probes in `cli/check.py` — so nobody runs it,
and the improvement never lands anywhere.

## How it decides

Three texts per file, which is the classic three-way merge:

* **base** — what skeletor rendered when this tree was scaffolded, reproduced
  by checking out `skeletor_ref` from `.skeletor.json` and running *that*
  version of the scaffolder with the arguments it recorded.
* **theirs** — what is in the tree now.
* **ours** — what skeletor renders today.

From which:

| base vs theirs | base vs ours | What happens                        |
| -------------- | ------------ | ----------------------------------- |
| same           | same         | nothing                             |
| same           | changed      | applied — the user never touched it |
| changed        | same         | left alone — only the user's edit   |
| changed        | changed      | three-way merged, **if it is clean** |

**A conflict is never written.** `git merge-file` can emit markers; this does
not let it. On conflict the file is left exactly as it was and the template's
own base→ours diff is written to `tmp/upgrade/`, because a conflict marker
inside somebody's `CLAUDE.md` is a broken file that looks like a merge, and the
tree it lands in is one nobody is watching.

Nothing is committed, nothing is deleted, and a file the template dropped is
reported rather than removed — the same posture as `bin/skeletor-check-pins`,
which reports a bump and never makes one.

## When the base is out of reach

Rendering the base needs skeletor's git history, and there are ordinary reasons
it is not there: a `--depth 1` clone, a tarball, a collected ref, a rewritten
branch. Rather than refuse, this falls back to the `files` hashes in the
manifest, which answer the one question that still matters — *has anybody
touched this file?*

The fallback applies a file only when its hash matches, and that is a proof
rather than a guess: an equal hash means the file **is** byte-for-byte what
skeletor generated, so replacing it with a newer render cannot lose an edit
that was never made. What the fallback cannot do is merge — merging needs the
base *text* — so an edited file is reported and left alone.

The hashes are a derived value with a second home, which is normally the thing
this project refuses. They earn it by being checked against their source on
every ordinary run: when the base *is* rendered, it is re-hashed and a manifest
that disagrees is a hard failure. A cache validated against its source every
time it is bypassed cannot rot unnoticed.

Usage:
    bin/skeletor-upgrade ../orders
    bin/skeletor-upgrade ../orders --dry-run
    bin/skeletor-upgrade ../orders --no-base      # what have I edited?
    bin/skeletor-upgrade ../orders --from-dir /path/to/another/skeletor
"""

from __future__ import annotations

import argparse
import hashlib
import json
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Dict, List, Optional, Tuple

SKELETOR = Path(__file__).resolve().parents[1]
MANIFEST_NAME = ".skeletor.json"

#: Regenerated from their sources by `scripts/docs/regen.py`, and routed
#: through a merge driver precisely because merging them is never correct. They
#: are rebuilt at the end instead of being merged here.
GENERATED = {
    "docs/todo_index.json",
    "docs/TODO/README.md",
    "docs/implementation_index.json",
    "docs/implementations/README.md",
}

#: Never rendered by the scaffolder into a comparable state: scratch, history,
#: and installed dependencies.
SKIP_PREFIXES = ("tmp/", ".git/", "node_modules/", ".venv/")


def say(symbol: str, message: str) -> None:
    print(f"{symbol} {message}", file=sys.stderr)


def item(message: str) -> None:
    print(f"   · {message}", file=sys.stderr)


def detail(message: str = "") -> None:
    print(f"   {message}" if message else "", file=sys.stderr)


def die(message: str) -> "NoReturn":  # type: ignore[valid-type]
    say("❌", message)
    raise SystemExit(1)


def uncommitted(target: Path, *, untracked: bool = False) -> Optional[List[str]]:
    """Paths with uncommitted changes — or None if git cannot say.

    The `untracked` flag is not a preference, it is the difference between two
    questions. For the **target**, untracked files do not matter: one does not
    appear in `git diff` and nothing here will remove it, so it cannot make the
    result unreadable — only tracked work interleaves. For the **base**, they
    matter most of all: `copy_overlay` walks the template directory, so an
    untracked file under `template/` is rendered into the base as readily as a
    committed one, and is exactly as absent from history.
    """
    result = subprocess.run(
        ["git", "-C", str(target), "status", "--porcelain", f"--untracked-files={'all' if untracked else 'no'}"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return None
    return sorted(line[3:] for line in result.stdout.splitlines() if line.strip())


def refuse_a_dirty_base(base: Path, writing: str) -> None:
    """A base render nobody can reproduce must not be written into a manifest.

    Everything the `files` map promises rests on the base being re-renderable.
    `cross_check` re-derives those hashes on every ordinary run precisely so the
    fallback cannot rot — a cache validated every time it is bypassed. Render
    the base from a checkout carrying uncommitted edits and the hashes describe
    a state that exists on one machine, at one moment, and in no commit. The
    next run resolves the recorded ref, renders something different, and
    refuses. The manifest is then permanently unusable, and the file it
    disagrees about is whichever one you happened to have open.

    This is not hypothetical. It is how proto.pilot's tree ended up blocked on
    `ci.yml`: their manifest was repaired on a day skeletor had uncommitted
    changes to exactly that file, so the recorded hash is of a render that has
    never existed in this history.

    Untracked files count here, unlike on the target. `copy_overlay` walks
    `template/`, so an untracked file there is rendered into the base and is
    just as unreachable from a ref.

    `--dry-run` writes nothing and is never refused, which is also what keeps
    `bin/skeletor-verify` running `--from-dir .` against this checkout while it
    is being edited.
    """
    dirty = uncommitted(base, untracked=True)
    if not dirty:
        return
    say("❌", f"the base checkout has {len(dirty)} uncommitted change(s):")
    for path in dirty[:10]:
        item(path)
    if len(dirty) > 10:
        item(f"... and {len(dirty) - 10} more")
    detail()
    detail(f"{writing} would record hashes of a render that exists in no commit, so the")
    detail("next run resolves the recorded ref, renders something else, and refuses —")
    detail("permanently. Commit the base checkout first, or use --dry-run to look.")
    raise SystemExit(1)


def refuse_a_dirty_tree(target: Path) -> None:
    """An upgrade whose result cannot be read, or undone, must not start.

    This is **not** protecting somebody from their own git. Everything is
    committed or it is not, and this tool endangers neither.

    It is that the whole safety model here is *you read the diff*. Nothing is
    committed, conflicts go to `tmp/upgrade/`, and the user decides. On a dirty
    tree `git diff` can no longer answer "what did the upgrade change", because
    the template's changes and the user's are interleaved in one output — so the
    tool would produce an answer nobody can read.

    The undo is worse, and it is the half that decides this. A merged file is
    neither the old render nor the new one, so the ordinary way back —
    `git checkout -- .` — discards the user's uncommitted work along with the
    upgrade. There is no gesture that reverts one and keeps the other.

    Hence a refusal rather than a warning, and hence `--allow-dirty` named in
    the message: "I am mid-edit and want the template's version to merge
    against" is a real workflow, and refusing *with the escape hatch in the
    sentence* is a different act from refusing.

    `--dry-run` writes nothing and is never refused; `--repair-manifest` touches
    only `.skeletor.json`, which stays legible in a diff and reverts on its own.
    """
    dirty = uncommitted(target)
    if not dirty:
        return
    say("❌", f"{len(dirty)} tracked file(s) have uncommitted changes:")
    for path in dirty[:10]:
        item(path)
    if len(dirty) > 10:
        item(f"... and {len(dirty) - 10} more")
    detail()
    detail("An upgrade here would interleave with that work: `git diff` could no longer")
    detail("say what the template changed, and `git checkout -- .` would discard both.")
    detail("Commit or stash first — or pass --allow-dirty if merging into your")
    detail("in-progress edits is what you actually want.")
    raise SystemExit(1)


def read_manifest(target: Path) -> dict:
    path = target / MANIFEST_NAME
    if not path.exists():
        die(
            f"{target} has no {MANIFEST_NAME} — it predates the manifest, so there is no "
            "base to merge against.\n   Scaffold-time provenance cannot be recovered after "
            "the fact without guessing, and a guessed base merges the wrong thing silently."
        )
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        die(f"{path} is not valid JSON: {exc}")


def render_with(checkout: Path, args: List[str], into: Path) -> None:
    """Run a given skeletor checkout's scaffolder into an empty directory.

    The *old* scaffolder, deliberately — the post-copy steps are part of what a
    tree looks like, and they change too. Reproducing the base with today's
    scaffolder would attribute this release's behaviour to the previous one.
    """
    scaffolder = checkout / "bin" / "skeletor-new"
    if not scaffolder.exists():
        die(f"{scaffolder} does not exist — that checkout is not a skeletor")
    result = subprocess.run(
        [sys.executable, str(scaffolder), str(into), *args, "--no-git", "--force"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        die(f"rendering with {checkout} failed:\n{result.stdout}\n{result.stderr}")


def base_checkout(ref: str, workdir: Path, *, fatal: bool = True) -> Tuple[Optional[Path], Optional[Path], str]:
    """A detached worktree of skeletor at `ref`: the tree, what to clean up, and
    the ref actually used — which is not `ref` when the scaffold was dirty."""
    if ref.endswith("-dirty"):
        ref = ref[: -len("-dirty")]
        say("⚠️ ", f"the tree was scaffolded from a dirty checkout — using the committed part ({ref})")
        detail("Uncommitted template edits at that time will read as template changes now.")
    tree = workdir / "base-checkout"
    result = subprocess.run(
        ["git", "-C", str(SKELETOR), "worktree", "add", "--detach", str(tree), ref],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        if fatal:
            die(
                f"cannot check out skeletor at '{ref}':\n   {result.stderr.strip()}\n"
                "   A shallow clone or a rewritten history cannot reproduce the base. "
                "Pass --from-dir with a checkout that can."
            )
        return None, None, ref
    return tree, tree, ref


def files_under(root: Path) -> Dict[str, Path]:
    out: Dict[str, Path] = {}
    for path in sorted(root.rglob("*")):
        if not path.is_file():
            continue
        rel = path.relative_to(root).as_posix()
        if rel == MANIFEST_NAME or rel.startswith(SKIP_PREFIXES) or "__pycache__" in path.parts:
            continue
        out[rel] = path
    return out


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def cross_check(base_files: Dict[str, Path], recorded: Dict[str, str]) -> List[str]:
    """Every recorded hash must match the base render it claims to describe.

    This is what lets the fallback exist. The hashes are only consulted when the
    render is unreachable, so if they were never checked they could drift for
    months and then, on the one run that needed them, quietly classify an edited
    file as untouched. Checking them on every run that does NOT need them is the
    cheapest possible guard, and it fails on the run where it is safe to fail.
    """
    disagreements = []
    for rel, expected in sorted(recorded.items()):
        rendered = base_files.get(rel)
        if rendered is None:
            disagreements.append(f"{rel}: recorded, but the base render does not produce it")
        elif sha256(rendered) != expected:
            disagreements.append(f"{rel}: recorded hash does not match the base render")
    for rel in sorted(set(base_files) - set(recorded)):
        disagreements.append(f"{rel}: the base render produces it, but it is not recorded")
    return disagreements


def repair_manifest(target: Path, manifest: dict, base_files: Dict[str, Path], args) -> int:
    """Rewrite the `files` map from the base render, and stop.

    For one situation only: a manifest written by a version of skeletor that
    recorded the wrong thing. The first release recorded a walk of the target
    directory, so a `--force` scaffold into a populated repository recorded the
    user's own files as skeletor output, and — one layer subtler — recorded a
    hash for `.github/DOCS_INDEX.md` that included a row for a doc of theirs.

    A surplus entry can be deleted by hand. A *wrong* one cannot: the correct
    value is a hash of a render, and only skeletor can produce that render. So
    the repair is not a repair of the file, it is a re-derivation — the base
    render is standing right here, having just been produced from the arguments
    the manifest itself records, and hashing it is the definition of the value
    that belongs in the map.

    It deliberately does no upgrading. Repair, look at what it says, then run
    the upgrade: a flag that silently fixed the manifest on its way past would
    make `cross_check` unable to refuse anything, which is the one guarantee the
    fallback rests on.
    """
    recorded: Dict[str, str] = manifest.get("files") or {}
    rebuilt = {rel: sha256(path) for rel, path in sorted(base_files.items())}

    surplus = sorted(set(recorded) - set(rebuilt))
    missing = sorted(set(rebuilt) - set(recorded))
    wrong = sorted(rel for rel in set(recorded) & set(rebuilt) if recorded[rel] != rebuilt[rel])

    if not (surplus or missing or wrong):
        say("✅", f"{MANIFEST_NAME} already matches the base render — nothing to repair")
        return 0

    say("→", f"{MANIFEST_NAME}: {len(recorded)} recorded → {len(rebuilt)} from the base render")
    for label, entries in (("not produced by the render", surplus), ("wrong hash", wrong),
                           ("produced but unrecorded", missing)):
        if entries:
            detail(f"{len(entries)} {label}:")
            for rel in entries[:10]:
                item(rel)
            if len(entries) > 10:
                detail(f"… and {len(entries) - 10} more")

    if args.json:
        print(json.dumps({"ok": True, "repaired": not args.dry_run, "surplus": surplus,
                          "wrong": wrong, "missing": missing}, indent=2))
    if args.dry_run:
        say("⏸️ ", "dry run — the manifest was not written")
        return 0

    manifest["files"] = rebuilt
    (target / MANIFEST_NAME).write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
    say("✅", f"{MANIFEST_NAME} rewritten. Run the upgrade now; nothing else was touched.")
    return 0


def read(path: Optional[Path]) -> Optional[str]:
    if path is None or not path.exists():
        return None
    try:
        return path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        return None  # binary: compared by bytes below, never merged


def merge(base: str, theirs: str, ours: str, workdir: Path) -> Optional[str]:
    """Three-way merge, or `None` if it conflicts. Markers are never returned."""
    paths = {}
    for name, text in (("base", base), ("theirs", theirs), ("ours", ours)):
        paths[name] = workdir / f"merge-{name}"
        paths[name].write_text(text, encoding="utf-8")
    result = subprocess.run(
        ["git", "merge-file", "-p", "--quiet", str(paths["theirs"]), str(paths["base"]), str(paths["ours"])],
        capture_output=True,
        text=True,
    )
    # Exit code is the number of conflicts, or negative on error.
    return result.stdout if result.returncode == 0 else None


def unified(base: str, ours: str, rel: str) -> str:
    import difflib

    return "".join(
        difflib.unified_diff(
            base.splitlines(keepends=True),
            ours.splitlines(keepends=True),
            fromfile=f"a/{rel} (template, as you scaffolded it)",
            tofile=f"b/{rel} (template, today)",
        )
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("target", help="the scaffolded tree to upgrade")
    parser.add_argument("--dry-run", action="store_true", help="report what would change, write nothing")
    parser.add_argument("--from-dir", help="use this skeletor checkout as the base instead of the recorded ref")
    parser.add_argument(
        "--no-base",
        action="store_true",
        help="skip the base render: classify from the recorded hashes alone. Answers "
        "'what have I edited?' without git, but cannot merge.",
    )
    parser.add_argument(
        "--allow-dirty",
        action="store_true",
        help="upgrade into a tree with uncommitted changes. The result will be interleaved "
        "with your work in `git diff`, and reverting it discards both.",
    )
    parser.add_argument("--json", action="store_true", help="emit the result on stdout as well")
    parser.add_argument(
        "--repair-manifest",
        action="store_true",
        help="rewrite the manifest's `files` map from the base render, then stop. "
        "For a manifest written by a version of skeletor that recorded the wrong thing.",
    )
    args = parser.parse_args()

    target = Path(args.target).expanduser().resolve()
    if not target.is_dir():
        die(f"{target} is not a directory")

    if not (args.dry_run or args.repair_manifest or args.allow_dirty):
        refuse_a_dirty_tree(target)

    manifest = read_manifest(target)
    recorded = manifest.get("args") or []
    ref = manifest.get("skeletor_ref") or ""
    if not recorded:
        die(f"{target / MANIFEST_NAME} records no arguments — it cannot be re-rendered")

    hashes: Dict[str, str] = manifest.get("files") or {}

    workdir = Path(tempfile.mkdtemp(prefix="skeletor-upgrade-"))
    cleanup_worktree: Optional[Path] = None
    try:
        base_src: Optional[Path] = None
        if args.no_base and args.repair_manifest:
            # The correct hashes ARE the base render's. Without one there is
            # nothing to derive them from, and the alternative — keeping what is
            # there and calling it repaired — is the only outcome worse than
            # refusing, since it would look like the manifest had been checked.
            die("--repair-manifest needs the base render it repairs from; drop --no-base")
        if args.no_base:
            if not hashes:
                die("--no-base needs the `files` hashes, and this manifest has none")
            say("⏸️ ", "no base render — classifying from the recorded hashes, and not merging")
        elif args.from_dir:
            base_src = Path(args.from_dir).expanduser().resolve()
            if not args.dry_run:
                refuse_a_dirty_base(
                    base_src, "--repair-manifest" if args.repair_manifest else "The upgrade"
                )
            say("→", f"base: {base_src}")
        elif not ref:
            die(f"{MANIFEST_NAME} records no skeletor_ref — pass --from-dir or --no-base")
        else:
            reachable, cleanup_worktree, ref = base_checkout(ref, workdir, fatal=not hashes)
            if reachable is None:
                # The history is gone, but the hashes can still say what is
                # untouched. Degraded on purpose, and it says so.
                say("⚠️ ", f"skeletor has no reachable '{ref}' — falling back to the recorded hashes")
                detail("Files you never touched are still updated. Files you edited cannot be")
                detail("merged without the base text, so they are reported and left alone.")
                args.no_base = True
            else:
                base_src = reachable
                say("→", f"base: skeletor @ {ref}")

        head_tree = workdir / "head"
        render_with(SKELETOR, recorded, head_tree)
        head_files = files_under(head_tree)

        base_files: Dict[str, Path] = {}
        if base_src is not None:
            base_tree = workdir / "base"
            render_with(base_src, recorded, base_tree)
            base_files = files_under(base_tree)
            if args.repair_manifest:
                return repair_manifest(target, manifest, base_files, args)
            if hashes:
                drift = cross_check(base_files, hashes)
                if drift:
                    say("❌", f"{MANIFEST_NAME} disagrees with the base it names ({len(drift)} file(s)):")
                    for entry in drift[:20]:
                        item(entry)
                    if len(drift) > 20:
                        detail(f"… and {len(drift) - 20} more")
                    detail()
                    detail("The recorded hashes are the fallback used when history is unreachable,")
                    detail("so a manifest that cannot describe its own base would silently classify")
                    detail("an edited file as untouched. Refusing rather than guessing.")
                    detail()
                    if args.from_dir and ref:
                        # The likeliest cause here is not a stale manifest at
                        # all: --from-dir overrides the base, so naming a
                        # checkout that is not this tree's ref makes every
                        # entry disagree by construction. Recommending
                        # --repair-manifest in that state is actively harmful —
                        # it would write hashes of the wrong base while leaving
                        # `skeletor_ref` naming the right one, so the two halves
                        # of the manifest would describe different skeletors and
                        # only --no-base would ever act on the lie.
                        detail(f"--from-dir overrode the base, and this tree records {ref}.")
                        detail("If that checkout is not at that ref, the base is wrong rather than the")
                        detail("manifest — drop --from-dir and let the recorded ref be resolved.")
                        detail("Do NOT --repair-manifest to silence this: it rewrites the hashes from")
                        detail("whatever base you named and leaves the ref alone.")
                    else:
                        detail("If the manifest was written by an older skeletor rather than edited by")
                        detail("hand, --repair-manifest rewrites it from this base render.")
                    # The full list on stdout when something is parsing this. A
                    # consumer that reads the truncated human list sees a fifth
                    # of the problem and believes it has all of it.
                    if args.json:
                        print(json.dumps({"ok": False, "error": "manifest-drift", "drift": drift}, indent=2))
                    return 1

        added, updated, merged, conflicted, collided, kept, dropped = [], [], [], [], [], [], []
        patches = target / "tmp" / "upgrade"

        for rel in sorted(set(base_files) | set(head_files)):
            if rel in GENERATED or rel == MANIFEST_NAME:
                continue
            ours = read(head_files.get(rel))
            base = read(base_files.get(rel))
            live_path = target / rel
            theirs = read(live_path) if live_path.exists() else None

            if ours is None:
                # The template stopped shipping it. Never delete somebody's file.
                if live_path.exists():
                    dropped.append(rel)
                continue

            if theirs is None:
                added.append(rel)
                if not args.dry_run:
                    live_path.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(head_files[rel], live_path)
                continue

            if base is None:
                # No base text for this file — either it is absent from the base
                # render, or there is no base render at all. Fall back to the
                # recorded hash, which answers "untouched?" and nothing else.
                recorded_hash = hashes.get(rel)
                if recorded_hash is None:
                    # Never recorded, so skeletor never wrote it: the user had a
                    # file here before the template claimed the path. Handled the
                    # same as a conflict and named differently, because the name
                    # is what the reader acts on. "You edited this" sends them to
                    # `git log` for a change they never made; the truth sends them
                    # to the question that is actually in front of them, which is
                    # whether two files written for the same purpose should now be
                    # one — a choice between implementations, not a hunk to port.
                    # The manifest draws the line exactly: an entry with a
                    # different hash is an edit, no entry at all is a collision.
                    if theirs != ours:
                        collided.append(rel)
                        if not args.dry_run:
                            sidecar = patches / f"{rel}.new"
                            sidecar.parent.mkdir(parents=True, exist_ok=True)
                            sidecar.write_text(ours, encoding="utf-8")
                    continue

                # The recorded hash is the hash of the OLD RENDER, so it answers
                # both halves of the matrix — not just "did the user touch it".
                edited = sha256(live_path) != recorded_hash
                changed = sha256(head_files[rel]) != recorded_hash

                if not changed:
                    # The template did not move. Whatever the user did here is
                    # theirs, and there is nothing to carry over — reporting it
                    # would be noise on every single run.
                    continue
                if not edited:
                    # Proof, not a guess: an equal hash means the file IS the old
                    # render, so there is no edit here to lose.
                    updated.append(rel)
                    if not args.dry_run:
                        live_path.write_text(ours, encoding="utf-8")
                    continue
                conflicted.append(rel)
                if not args.dry_run:
                    sidecar = patches / f"{rel}.new"
                    sidecar.parent.mkdir(parents=True, exist_ok=True)
                    sidecar.write_text(ours, encoding="utf-8")
                continue

            edited = theirs != base
            changed = ours != base
            if not changed:
                continue
            if not edited:
                updated.append(rel)
                if not args.dry_run:
                    live_path.write_text(ours, encoding="utf-8")
                continue

            resolved = merge(base, theirs, ours, workdir)
            if resolved is None:
                conflicted.append(rel)
                if not args.dry_run:
                    patch = patches / f"{rel}.patch"
                    patch.parent.mkdir(parents=True, exist_ok=True)
                    patch.write_text(unified(base, ours, rel), encoding="utf-8")
            else:
                merged.append(rel)
                if not args.dry_run:
                    live_path.write_text(resolved, encoding="utf-8")

        for rel in sorted(set(base_files)):
            if rel in head_files or rel in GENERATED:
                continue
            if (target / rel).exists() and rel not in dropped:
                dropped.append(rel)

        # The generated docs are rebuilt, never merged.
        if not args.dry_run and (added or updated or merged):
            regen = target / "scripts" / "docs" / "regen.py"
            if regen.exists():
                subprocess.run([sys.executable, str(regen)], cwd=str(target), capture_output=True)
            # The head render's manifest, verbatim — the hashes recorded are of
            # what skeletor PRODUCES, never of what is on disk. The difference
            # decides whether the next upgrade destroys work: a merged file is
            # neither the old render nor the new one, so hashing the tree would
            # record it as pristine and the next run would overwrite the merge.
            # Recording the render's hash makes it read as edited, which it is.
            shutil.copy2(head_tree / MANIFEST_NAME, target / MANIFEST_NAME)

        if args.json:
            print(
                json.dumps(
                    {
                        "target": str(target),
                        "base_ref": ref,
                        "dry_run": args.dry_run,
                        "added": added,
                        "updated": updated,
                        "merged": merged,
                        "conflicted": conflicted,
                        "collided": collided,
                        "dropped": dropped,
                    },
                    indent=2,
                    sort_keys=True,
                )
            )

        verb = "would be" if args.dry_run else ""
        for label, group, symbol in (
            (f"new file(s) {verb} added".strip(), added, "✅"),
            (f"file(s) you never touched {verb} updated".strip(), updated, "✅"),
            (f"file(s) you edited {verb} merged cleanly".strip(), merged, "✅"),
        ):
            if group:
                say(symbol, f"{len(group)} {label}")
                for rel in group[:20]:
                    item(rel)
                if len(group) > 20:
                    detail(f"… and {len(group) - 20} more")

        if conflicted:
            say("❌", f"{len(conflicted)} file(s) you edited — merge conflicts, LEFT ALONE")
            for rel in conflicted:
                item(rel)
            detail()
            detail("Nothing was written to these. What the template changed in each is in")
            if args.no_base:
                detail("tmp/upgrade/<path>.new — today's template file, to diff against yours.")
                detail("A real base→ours patch needs the base text, which this run had no way to get.")
            else:
                detail("tmp/upgrade/<path>.patch — port it by hand.")

        if collided:
            say("❌", f"{len(collided)} file(s) you already had where the template now ships one")
            for rel in collided:
                item(rel)
            detail()
            detail("Not an edit — these were never in your manifest, so skeletor never wrote")
            detail("them. Two files written for the same purpose now want the same path, and")
            detail("which one survives is a judgement only you can make. The template's is in")
            detail("tmp/upgrade/<path>.new; yours is untouched where it has always been.")

        if dropped:
            say("⚠️ ", f"{len(dropped)} file(s) the template no longer ships — NOT deleted")
            for rel in dropped:
                item(rel)
            detail("Delete them yourself if you agree. This never removes your files.")

        if not any((added, updated, merged, conflicted, collided, dropped)):
            say("✅", "already current — nothing to carry over")
            return 0

        detail()
        if args.dry_run:
            say("⏸️ ", "dry run — nothing was written")
        else:
            say("✅", "nothing was committed. Read the diff, then commit as one `chore(skeletor):` change")
        return 1 if (conflicted or collided) else 0
    finally:
        if cleanup_worktree is not None:
            subprocess.run(
                ["git", "-C", str(SKELETOR), "worktree", "remove", "--force", str(cleanup_worktree)],
                capture_output=True,
            )
        shutil.rmtree(workdir, ignore_errors=True)


if __name__ == "__main__":
    raise SystemExit(main())
