#!/usr/bin/env python3
"""Carry a template change into a tree that was scaffolded from an older one.

The problem this exists for is the multi-repo one: skeletor improves, and the
twelve repositories generated from it do not. Re-running `skeletor-new --force`
would overwrite the half of each tree that is the *user's* — the services table
in `CLAUDE.md`, the real health probes in `cli/check.py` — so nobody runs it,
and the improvement never lands anywhere.

## How it decides

Three texts per file, which is the classic three-way merge:

* **base** — what skeletor rendered when this tree was scaffolded, reproduced
  by checking out `skeletor_ref` from `.skeletor.json` and running *that*
  version of the scaffolder with the arguments it recorded.
* **theirs** — what is in the tree now.
* **ours** — what skeletor renders today.

From which:

| base vs theirs | base vs ours | What happens                        |
| -------------- | ------------ | ----------------------------------- |
| same           | same         | nothing                             |
| same           | changed      | applied — the user never touched it |
| changed        | same         | left alone — only the user's edit   |
| changed        | changed      | three-way merged, **if it is clean** |

**A conflict is never written.** `git merge-file` can emit markers; this does
not let it. On conflict the file is left exactly as it was and the template's
own base→ours diff is written to `tmp/upgrade/`, because a conflict marker
inside somebody's `CLAUDE.md` is a broken file that looks like a merge, and the
tree it lands in is one nobody is watching.

`tmp/upgrade/` describes **one** run: a real run clears its own sidecars before
writing, and `--dry-run` writes none and says so. Both halves are the same bug,
which proto.pilot reported from the reader's side. The instruction "port what is
in `tmp/upgrade/<path>.patch`" is only true if that file belongs to the plan
just printed, and by default it did not — a dry run printed the instruction
while writing nothing, and a real run left every earlier run's sidecars beside
today's, against a template HEAD that had since moved. Neither is visible from
the directory. A patch that is stale and a patch that is fresh look identical at
exactly the moment somebody is trusting one.

Nothing is committed, nothing is deleted, and a file the template dropped is
reported rather than removed — the same posture as `bin/skeletor-check-pins`,
which reports a bump and never makes one.

## When the base is out of reach

Rendering the base needs skeletor's git history, and there are ordinary reasons
it is not there: a `--depth 1` clone, a tarball, a collected ref, a rewritten
branch. Rather than refuse, this falls back to the `files` hashes in the
manifest, which answer the one question that still matters — *has anybody
touched this file?*

The fallback applies a file only when its hash matches, and that is a proof
rather than a guess: an equal hash means the file **is** byte-for-byte what
skeletor generated, so replacing it with a newer render cannot lose an edit
that was never made. What the fallback cannot do is merge — merging needs the
base *text* — so an edited file is reported and left alone.

The hashes are a derived value with a second home, which is normally the thing
this project refuses. They earn it by being checked against their source on
every ordinary run: when the base *is* rendered, it is re-hashed and a manifest
that disagrees is a hard failure. A cache validated against its source every
time it is bypassed cannot rot unnoticed.

Usage:
    bin/skeletor-upgrade ../orders
    bin/skeletor-upgrade ../orders --dry-run
    bin/skeletor-upgrade ../orders --no-base      # what have I edited?
    bin/skeletor-upgrade ../orders --from-dir /path/to/another/skeletor
"""

from __future__ import annotations

import argparse
import ast
import hashlib
import json
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Dict, List, Optional, Tuple

SKELETOR = Path(__file__).resolve().parents[1]
MANIFEST_NAME = ".skeletor.json"

#: Regenerated from their sources by `scripts/docs/regen.py`, and routed
#: through a merge driver precisely because merging them is never correct. They
#: are rebuilt at the end instead of being merged here.
GENERATED = {
    "docs/todo_index.json",
    "docs/TODO/README.md",
    "docs/implementation_index.json",
    "docs/implementations/README.md",
}

#: Never rendered by the scaffolder into a comparable state: scratch, history,
#: and installed dependencies.
SKIP_PREFIXES = ("tmp/", ".git/", "node_modules/", ".venv/")


def say(symbol: str, message: str) -> None:
    print(f"{symbol} {message}", file=sys.stderr)


def item(message: str) -> None:
    print(f"   · {message}", file=sys.stderr)


def detail(message: str = "") -> None:
    print(f"   {message}" if message else "", file=sys.stderr)


#: What this tool writes into `tmp/upgrade/`, and the only thing it will remove
#: from there. Anything else in that directory is somebody's, not ours.
SIDECAR_SUFFIXES = (".patch", ".new")


def sidecars(patches: Path) -> List[Path]:
    """Every sidecar a previous run left behind, by our own suffixes."""
    if not patches.is_dir():
        return []
    return sorted(
        p for p in patches.rglob("*") if p.is_file() and p.suffix in SIDECAR_SUFFIXES
    )


def clear_sidecars(patches: Path) -> int:
    """Remove the previous run's sidecars, so the directory describes this run.

    The reader is told to go open `tmp/upgrade/<path>` and port what is in it.
    That instruction is only true if the directory holds this run's plan — and
    it does not, by default: a real run writes a sidecar per conflict *today*
    and leaves every sidecar from every earlier run in place, so the directory
    accumulates into a superset of a plan that no longer exists. A four-day-old
    patch against a different template HEAD is indistinguishable from a fresh
    one at the moment somebody is trusting it.

    So each real run clears what it wrote before writing again. A conflict that
    is still a conflict gets its sidecar back in the same breath; one that is
    gone had a sidecar describing work that is done. Deleting is the thing this
    tool refuses everywhere else, which is why the suffixes are ours alone, why
    nothing outside `tmp/upgrade/` is touched, and why the count is reported.
    """
    removed = 0
    for path in sidecars(patches):
        path.unlink()
        removed += 1
    # Leave no empty scaffolding behind either; `rmdir` refuses a non-empty one,
    # so anything of the user's keeps its directory.
    for path in sorted(patches.rglob("*"), reverse=True) if patches.is_dir() else []:
        if path.is_dir():
            try:
                path.rmdir()
            except OSError:
                pass
    return removed


def die(message: str) -> "NoReturn":  # type: ignore[valid-type]
    say("❌", message)
    raise SystemExit(1)


def uncommitted(target: Path, *, untracked: bool = False) -> Optional[List[str]]:
    """Paths with uncommitted changes — or None if git cannot say.

    The `untracked` flag is not a preference, it is the difference between two
    questions. For the **target**, untracked files do not matter: one does not
    appear in `git diff` and nothing here will remove it, so it cannot make the
    result unreadable — only tracked work interleaves. For the **base**, they
    matter most of all: `copy_overlay` walks the template directory, so an
    untracked file under `template/` is rendered into the base as readily as a
    committed one, and is exactly as absent from history.
    """
    result = subprocess.run(
        ["git", "-C", str(target), "status", "--porcelain", f"--untracked-files={'all' if untracked else 'no'}"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        return None
    return sorted(line[3:] for line in result.stdout.splitlines() if line.strip())


def head_commit(target: Path) -> Optional[str]:
    """The target's HEAD, or None if git cannot say.

    Worth recording because this tool refuses a dirty tree: on an ordinary run
    HEAD is the pre-upgrade state *exactly*, and this is the only moment anybody
    gets that for free. By the time the footer's reader acts on it they have
    committed the upgrade and possibly a fixup, and the answer has become
    `HEAD~2` if they can remember how many. proto.pilot's point, and it is the
    difference between a procedure somebody reconstructs and one they paste.

    Nothing here commits, so HEAD does not move during a run and reading it
    early is tidiness rather than correctness. `uncommitted()` beside it is the
    opposite: writing makes the tree dirty, so that one must be read first or it
    answers about this run's own output.
    """
    result = subprocess.run(
        ["git", "-C", str(target), "rev-parse", "HEAD"], capture_output=True, text=True
    )
    return result.stdout.strip() or None if result.returncode == 0 else None


def refuse_a_dirty_base(base: Path, writing: str) -> None:
    """A base render nobody can reproduce must not be written into a manifest.

    Everything the `files` map promises rests on the base being re-renderable.
    `cross_check` re-derives those hashes on every ordinary run precisely so the
    fallback cannot rot — a cache validated every time it is bypassed. Render
    the base from a checkout carrying uncommitted edits and the hashes describe
    a state that exists on one machine, at one moment, and in no commit. The
    next run resolves the recorded ref, renders something different, and
    refuses. The manifest is then permanently unusable, and the file it
    disagrees about is whichever one you happened to have open.

    This is not hypothetical. It is how proto.pilot's tree ended up blocked on
    `ci.yml`: their manifest was repaired on a day skeletor had uncommitted
    changes to exactly that file, so the recorded hash is of a render that has
    never existed in this history.

    Untracked files count here, unlike on the target. `copy_overlay` walks
    `template/`, so an untracked file there is rendered into the base and is
    just as unreachable from a ref.

    `--dry-run` writes nothing and is never refused, which is also what keeps
    `bin/skeletor-verify` running `--from-dir .` against this checkout while it
    is being edited.

    **The teeth are in "unreproducible", not in "write"** — worth stating,
    because this reasoning now backs three guards and the short version of it
    would over-apply. A merely *wrong* write is not this: the next correct run
    overwrites it and nothing is lost. What cannot be undone is recording a hash
    of a render nobody can re-derive, because from then on every run is
    internally correct and disagrees forever, and no amount of re-running gets
    you out. A guard is owed to a write with that property and not to writes in
    general. (proto.pilot's narrowing, and a fair one — the first draft of this
    argued from "write".)
    """
    dirty = uncommitted(base, untracked=True)
    if not dirty:
        return
    say("❌", f"the base checkout has {len(dirty)} uncommitted change(s):")
    for path in dirty[:10]:
        item(path)
    if len(dirty) > 10:
        item(f"... and {len(dirty) - 10} more")
    detail()
    detail(f"{writing} would record hashes of a render that exists in no commit, so the")
    detail("next run resolves the recorded ref, renders something else, and refuses —")
    detail("permanently. Commit the base checkout first, or use --dry-run to look.")
    detail()
    detail("If the base is somebody else's checkout and they are mid-pass, clone it at a")
    detail("tag and run THAT copy with no flags:")
    detail()
    detail(f"  git clone {base} /tmp/skeletor-clean && git -C /tmp/skeletor-clean checkout <tag>")
    detail("  python /tmp/skeletor-clean/bin/skeletor-upgrade <your tree>")
    detail()
    detail("Not `--from-dir <that clone>`. That overrides the BASE, which your manifest")
    detail("already names — you would render the base at the new tag, mismatch every")
    detail("recorded hash, and the flag that then looks right (`--repair-manifest`) is")
    detail("the one that destroys the record. With no flags the clone resolves your")
    detail("recorded ref out of its own history and renders today from its tree, which")
    detail("is what you want. proto.pilot reached for the wrong flag first.")
    raise SystemExit(1)


def refuse_a_dirty_tree(target: Path) -> None:
    """An upgrade whose result cannot be read, or undone, must not start.

    This is **not** protecting somebody from their own git. Everything is
    committed or it is not, and this tool endangers neither.

    It is that the whole safety model here is *you read the diff*. Nothing is
    committed, conflicts go to `tmp/upgrade/`, and the user decides. On a dirty
    tree `git diff` can no longer answer "what did the upgrade change", because
    the template's changes and the user's are interleaved in one output — so the
    tool would produce an answer nobody can read.

    The undo is worse, and it is the half that decides this. A merged file is
    neither the old render nor the new one, so the ordinary way back —
    `git checkout -- .` — discards the user's uncommitted work along with the
    upgrade. There is no gesture that reverts one and keeps the other.

    Hence a refusal rather than a warning, and hence `--allow-dirty` named in
    the message: "I am mid-edit and want the template's version to merge
    against" is a real workflow, and refusing *with the escape hatch in the
    sentence* is a different act from refusing.

    `--dry-run` writes nothing and is never refused; `--repair-manifest` touches
    only `.skeletor.json`, which stays legible in a diff and reverts on its own.
    """
    dirty = uncommitted(target)
    if not dirty:
        return
    say("❌", f"{len(dirty)} tracked file(s) have uncommitted changes:")
    for path in dirty[:10]:
        item(path)
    if len(dirty) > 10:
        item(f"... and {len(dirty) - 10} more")
    detail()
    detail("An upgrade here would interleave with that work: `git diff` could no longer")
    detail("say what the template changed, and `git checkout -- .` would discard both.")
    detail("Commit or stash first — or pass --allow-dirty if merging into your")
    detail("in-progress edits is what you actually want.")
    raise SystemExit(1)


def read_manifest(target: Path) -> dict:
    path = target / MANIFEST_NAME
    if not path.exists():
        die(
            f"{target} has no {MANIFEST_NAME} — it predates the manifest, so there is no "
            "base to merge against.\n   Scaffold-time provenance cannot be recovered after "
            "the fact without guessing, and a guessed base merges the wrong thing silently."
        )
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        die(f"{path} is not valid JSON: {exc}")


def render_with(checkout: Path, args: List[str], into: Path) -> None:
    """Run a given skeletor checkout's scaffolder into an empty directory.

    The *old* scaffolder, deliberately — the post-copy steps are part of what a
    tree looks like, and they change too. Reproducing the base with today's
    scaffolder would attribute this release's behaviour to the previous one.
    """
    scaffolder = checkout / "bin" / "skeletor-new"
    if not scaffolder.exists():
        die(f"{scaffolder} does not exist — that checkout is not a skeletor")
    result = subprocess.run(
        [sys.executable, str(scaffolder), str(into), *args, "--no-git", "--force"],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        die(f"rendering with {checkout} failed:\n{result.stdout}\n{result.stderr}")


def base_checkout(ref: str, workdir: Path, *, fatal: bool = True) -> Tuple[Optional[Path], Optional[Path], str]:
    """A detached worktree of skeletor at `ref`: the tree, what to clean up, and
    the ref actually used — which is not `ref` when the scaffold was dirty."""
    if ref.endswith("-dirty"):
        ref = ref[: -len("-dirty")]
        say("⚠️ ", f"the tree was scaffolded from a dirty checkout — using the committed part ({ref})")
        detail("Uncommitted template edits at that time will read as template changes now.")
        # This said "does not clear", flatly, and that was wrong. proto.pilot
        # measured a tree going `v0.2.0-dirty` → a clean tag across one upgrade
        # and told me. The claim had been written from the one case that had
        # been tested — a refusal, where nothing is written and so nothing
        # clears — and generalised to every case, which is the shape of mistake
        # this repository is mostly about.
        #
        # Three outcomes, and only the first is permanent:
        #   * the edit touched a file this scaffold SHIPS — `cross_check`
        #     refuses below, no manifest is written, and the ref stays. Correct:
        #     the recorded base genuinely is unreproducible.
        #   * the upgrade APPLIES something — the manifest is rewritten from the
        #     head render, which exists in a commit, and the ref is clean from
        #     then on.
        #   * the upgrade applies nothing — already current, or only conflicts
        #     and declines — the manifest is untouched and this returns next run.
        detail("Whether it clears depends on what happens next, and only one outcome is")
        detail("permanent: if those edits touched a file this scaffold ships, the refusal")
        detail("below is that, and the recorded base really is unreproducible. Otherwise the")
        detail("first upgrade that APPLIES anything rewrites the manifest from a render that")
        detail("does exist in a commit, and the ref is clean from then on.")
        detail("--repair-manifest does not do it — it rewrites the hashes, never the ref.")
        detail("It can also be *bounded* right now: if the recorded hashes match this base")
        detail("render, the edits touched nothing this scaffold ships. Watch for that line.")
    tree = workdir / "base-checkout"
    result = subprocess.run(
        ["git", "-C", str(SKELETOR), "worktree", "add", "--detach", str(tree), ref],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        if fatal:
            die(
                f"cannot check out skeletor at '{ref}':\n   {result.stderr.strip()}\n"
                "   A shallow clone or a rewritten history cannot reproduce the base. "
                "Pass --from-dir with a checkout that can."
            )
        return None, None, ref
    return tree, tree, ref


def files_under(root: Path) -> Dict[str, Path]:
    out: Dict[str, Path] = {}
    for path in sorted(root.rglob("*")):
        if not path.is_file():
            continue
        rel = path.relative_to(root).as_posix()
        if rel == MANIFEST_NAME or rel.startswith(SKIP_PREFIXES) or "__pycache__" in path.parts:
            continue
        out[rel] = path
    return out


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def importers_of(needs_review: List[str], written: List[str], head_files: Dict[str, Path]) -> Dict[str, List[str]]:
    """Files that were written cleanly but import one that was not.

    A merge status describes **one file**. It says nothing about what that file
    depends on — so the single most reassuring line this tool prints, *"file(s)
    you never touched updated"*, is exactly wrong for a clean file whose
    behaviour is decided by a conflicted one.

    proto.pilot hit it on the run that proves it is not theoretical.
    `check_doc_tables.py` conflicted, they kept their own, and
    `tests/test_docs_pipeline.py` merged clean — listed as untouched, nothing
    asking them to look — carrying a test written against a `referenced()` that
    exists only here. Three of its four cases failed on arrival. Every step was
    correct: the conflict was in one file and the breakage was one import away,
    in a file with no conflict *because they had never edited it*.

    Their point about the quiet version is the sharper half: had that test been
    permissive rather than strict, it would have merged clean, passed, and
    asserted nothing about their tree forever.

    This reports and never refuses. It cannot know whether an import actually
    matters, only that the pair is worth one look — and the cost of a false
    name in that list is ten seconds, against a silent failure that survives a
    green suite.

    Python only, deliberately: `scripts/`, `cli/` and `tests/` are where the
    coupling is, and inventing a resolver for every language the template might
    someday ship is how this would become wrong rather than incomplete.
    """
    review = set(needs_review)
    out: Dict[str, List[str]] = {}
    for rel in written:
        source = head_files.get(rel)
        if source is None or not rel.endswith(".py"):
            continue
        try:
            tree = ast.parse(source.read_text(encoding="utf-8"))
        except (SyntaxError, OSError, UnicodeDecodeError):
            continue
        modules = set()
        for node in ast.walk(tree):
            if isinstance(node, ast.ImportFrom) and node.module and not node.level:
                # `from scripts.docs import plans` reaches both `scripts/docs/plans.py`
                # and a name inside `scripts/docs/__init__.py` — try each.
                modules.add(node.module)
                modules |= {f"{node.module}.{a.name}" for a in node.names}
            elif isinstance(node, ast.Import):
                modules |= {a.name for a in node.names}
        hits = sorted(
            {
                target
                for module in modules
                for target in (module.replace(".", "/") + ".py", module.replace(".", "/") + "/__init__.py")
                if target in review
            }
        )
        if hits:
            out[rel] = hits
    return out


def cross_check(base_files: Dict[str, Path], recorded: Dict[str, str]) -> List[str]:
    """Every recorded hash must match the base render it claims to describe.

    This is what lets the fallback exist. The hashes are only consulted when the
    render is unreachable, so if they were never checked they could drift for
    months and then, on the one run that needed them, quietly classify an edited
    file as untouched. Checking them on every run that does NOT need them is the
    cheapest possible guard, and it fails on the run where it is safe to fail.
    """
    disagreements = []
    for rel, expected in sorted(recorded.items()):
        rendered = base_files.get(rel)
        if rendered is None:
            disagreements.append(f"{rel}: recorded, but the base render does not produce it")
        elif sha256(rendered) != expected:
            disagreements.append(f"{rel}: recorded hash does not match the base render")
    for rel in sorted(set(base_files) - set(recorded)):
        disagreements.append(f"{rel}: the base render produces it, but it is not recorded")
    return disagreements


def repair_manifest(target: Path, manifest: dict, base_files: Dict[str, Path], args) -> int:
    """Rewrite the `files` map from the base render, and stop.

    For one situation only: a manifest written by a version of skeletor that
    recorded the wrong thing. The first release recorded a walk of the target
    directory, so a `--force` scaffold into a populated repository recorded the
    user's own files as skeletor output, and — one layer subtler — recorded a
    hash for `.github/DOCS_INDEX.md` that included a row for a doc of theirs.

    A surplus entry can be deleted by hand. A *wrong* one cannot: the correct
    value is a hash of a render, and only skeletor can produce that render. So
    the repair is not a repair of the file, it is a re-derivation — the base
    render is standing right here, having just been produced from the arguments
    the manifest itself records, and hashing it is the definition of the value
    that belongs in the map.

    It deliberately does no upgrading. Repair, look at what it says, then run
    the upgrade: a flag that silently fixed the manifest on its way past would
    make `cross_check` unable to refuse anything, which is the one guarantee the
    fallback rests on.
    """
    recorded: Dict[str, str] = manifest.get("files") or {}
    rebuilt = {rel: sha256(path) for rel, path in sorted(base_files.items())}

    surplus = sorted(set(recorded) - set(rebuilt))
    missing = sorted(set(rebuilt) - set(recorded))
    wrong = sorted(rel for rel in set(recorded) & set(rebuilt) if recorded[rel] != rebuilt[rel])

    if not (surplus or missing or wrong):
        say("✅", f"{MANIFEST_NAME} already matches the base render — nothing to repair")
        return 0

    say("→", f"{MANIFEST_NAME}: {len(recorded)} recorded → {len(rebuilt)} from the base render")
    for label, entries in (("not produced by the render", surplus), ("wrong hash", wrong),
                           ("produced but unrecorded", missing)):
        if entries:
            detail(f"{len(entries)} {label}:")
            for rel in entries[:10]:
                item(rel)
            if len(entries) > 10:
                detail(f"… and {len(entries) - 10} more")

    if args.json:
        print(json.dumps({"ok": True, "repaired": not args.dry_run, "surplus": surplus,
                          "wrong": wrong, "missing": missing}, indent=2))
    if args.dry_run:
        say("⏸️ ", "dry run — the manifest was not written")
        return 0

    manifest["files"] = rebuilt
    (target / MANIFEST_NAME).write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
    say("✅", f"{MANIFEST_NAME} rewritten. Run the upgrade now; nothing else was touched.")
    return 0


def read(path: Optional[Path]) -> Optional[str]:
    if path is None or not path.exists():
        return None
    try:
        return path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        return None  # binary: compared by bytes below, never merged


def merge(base: str, theirs: str, ours: str, workdir: Path) -> Optional[str]:
    """Three-way merge, or `None` if it conflicts. Markers are never returned."""
    paths = {}
    for name, text in (("base", base), ("theirs", theirs), ("ours", ours)):
        paths[name] = workdir / f"merge-{name}"
        paths[name].write_text(text, encoding="utf-8")
    result = subprocess.run(
        ["git", "merge-file", "-p", "--quiet", str(paths["theirs"]), str(paths["base"]), str(paths["ours"])],
        capture_output=True,
        text=True,
    )
    # Exit code is the number of conflicts, or negative on error.
    return result.stdout if result.returncode == 0 else None


def unified(base: str, ours: str, rel: str) -> str:
    import difflib

    return "".join(
        difflib.unified_diff(
            base.splitlines(keepends=True),
            ours.splitlines(keepends=True),
            fromfile=f"a/{rel} (template, as you scaffolded it)",
            tofile=f"b/{rel} (template, today)",
        )
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("target", help="the scaffolded tree to upgrade")
    parser.add_argument("--dry-run", action="store_true", help="report what would change, write nothing")
    parser.add_argument("--from-dir", help="use this skeletor checkout as the base instead of the recorded ref")
    parser.add_argument(
        "--no-base",
        action="store_true",
        help="skip the base render: classify from the recorded hashes alone. Answers "
        "'what have I edited?' without git, but cannot merge.",
    )
    parser.add_argument(
        "--allow-dirty",
        action="store_true",
        help="upgrade into a tree with uncommitted changes. The result will be interleaved "
        "with your work in `git diff`, and reverting it discards both.",
    )
    parser.add_argument("--json", action="store_true", help="emit the result on stdout as well")
    parser.add_argument(
        "--repair-manifest",
        action="store_true",
        help="rewrite the manifest's `files` map from the base render, then stop. "
        "For a manifest written by a version of skeletor that recorded the wrong thing.",
    )
    parser.add_argument(
        "--ported",
        action="store_true",
        help="assert every conflict and collision is resolved as you want it, and advance "
        "the recorded base to this skeletor. Without it, a run that leaves anything "
        "pending holds the base where it is.",
    )
    args = parser.parse_args()

    target = Path(args.target).expanduser().resolve()
    if not target.is_dir():
        die(f"{target} is not a directory")

    if not (args.dry_run or args.repair_manifest or args.allow_dirty):
        refuse_a_dirty_tree(target)

    pre_upgrade = head_commit(target)
    # This one before a single byte is written, or it answers about the upgrade's
    # own output rather than about work that was already here.
    interleaved = bool(args.allow_dirty and uncommitted(target))

    manifest = read_manifest(target)
    recorded = manifest.get("args") or []
    ref = manifest.get("skeletor_ref") or ""
    if not recorded:
        die(f"{target / MANIFEST_NAME} records no arguments — it cannot be re-rendered")

    hashes: Dict[str, str] = manifest.get("files") or {}

    workdir = Path(tempfile.mkdtemp(prefix="skeletor-upgrade-"))
    cleanup_worktree: Optional[Path] = None
    try:
        base_src: Optional[Path] = None
        scaffolded_dirty = False
        if args.no_base and args.repair_manifest:
            # The correct hashes ARE the base render's. Without one there is
            # nothing to derive them from, and the alternative — keeping what is
            # there and calling it repaired — is the only outcome worse than
            # refusing, since it would look like the manifest had been checked.
            die("--repair-manifest needs the base render it repairs from; drop --no-base")
        if args.no_base:
            if not hashes:
                die("--no-base needs the `files` hashes, and this manifest has none")
            say("⏸️ ", "no base render — classifying from the recorded hashes, and not merging")
        elif args.from_dir:
            base_src = Path(args.from_dir).expanduser().resolve()
            if not args.dry_run:
                refuse_a_dirty_base(
                    base_src, "--repair-manifest" if args.repair_manifest else "The upgrade"
                )
            say("→", f"base: {base_src}")
        elif not ref:
            die(f"{MANIFEST_NAME} records no skeletor_ref — pass --from-dir or --no-base")
        else:
            scaffolded_dirty = ref.endswith("-dirty")
            reachable, cleanup_worktree, ref = base_checkout(ref, workdir, fatal=not hashes)
            if reachable is None:
                # The history is gone, but the hashes can still say what is
                # untouched. Degraded on purpose, and it says so.
                say("⚠️ ", f"skeletor has no reachable '{ref}' — falling back to the recorded hashes")
                detail("Files you never touched are still updated. Files you edited cannot be")
                detail("merged without the base text, so they are reported and left alone.")
                args.no_base = True
            else:
                base_src = reachable
                say("→", f"base: skeletor @ {ref}")

        head_tree = workdir / "head"
        # `ours` is rendered from the LIVE checkout, not from a committed ref —
        # which is the point, since an upgrade exists to carry today's template
        # in. But that makes a dirty skeletor a source of exactly the defect
        # `--from-dir` has refused since 5230a7c, on the path everybody actually
        # uses: uncommitted template edits get written into somebody's tree, and
        # the manifest records `vX.Y.Z-dirty`, naming a render nobody can
        # resolve. The next upgrade of that tree then renders its base from the
        # committed part and reports the difference as template changes.
        #
        # Found by the gate written to pin a *different* corrected claim: it
        # scaffolded dirty, upgraded, and got `-dirty` back — refreshed, and
        # still unresolvable, because verify runs from a working checkout.
        if not args.dry_run:
            refuse_a_dirty_base(SKELETOR, "The upgrade")
        render_with(SKELETOR, recorded, head_tree)
        head_files = files_under(head_tree)

        base_files: Dict[str, Path] = {}
        if base_src is not None:
            base_tree = workdir / "base"
            render_with(base_src, recorded, base_tree)
            base_files = files_under(base_tree)
            if args.repair_manifest:
                return repair_manifest(target, manifest, base_files, args)
            if hashes:
                drift = cross_check(base_files, hashes)
                if drift:
                    say("❌", f"{MANIFEST_NAME} disagrees with the base it names ({len(drift)} file(s)):")
                    for entry in drift[:20]:
                        item(entry)
                    if len(drift) > 20:
                        detail(f"… and {len(drift) - 20} more")
                    detail()
                    detail("The recorded hashes are the fallback used when history is unreachable,")
                    detail("so a manifest that cannot describe its own base would silently classify")
                    detail("an edited file as untouched. Refusing rather than guessing.")
                    detail()
                    if args.from_dir and ref:
                        # The likeliest cause here is not a stale manifest at
                        # all: --from-dir overrides the base, so naming a
                        # checkout that is not this tree's ref makes every
                        # entry disagree by construction. Recommending
                        # --repair-manifest in that state is actively harmful —
                        # it would write hashes of the wrong base while leaving
                        # `skeletor_ref` naming the right one, so the two halves
                        # of the manifest would describe different skeletors and
                        # only --no-base would ever act on the lie.
                        detail(f"--from-dir overrode the base, and this tree records {ref}.")
                        detail("If that checkout is not at that ref, the base is wrong rather than the")
                        detail("manifest — drop --from-dir and let the recorded ref be resolved.")
                        detail("Do NOT --repair-manifest to silence this: it rewrites the hashes from")
                        detail("whatever base you named and leaves the ref alone.")
                    else:
                        detail("If the manifest was written by an older skeletor rather than edited by")
                        detail("hand, --repair-manifest rewrites it from this base render.")
                    # The full list on stdout when something is parsing this. A
                    # consumer that reads the truncated human list sees a fifth
                    # of the problem and believes it has all of it.
                    if args.json:
                        print(json.dumps({"ok": False, "error": "manifest-drift", "drift": drift}, indent=2))
                    return 1
                if scaffolded_dirty:
                    # The dirty-scaffold warning above is unconditional, because
                    # it is printed before anything can know better. Here we know
                    # better, and it is worth saying, because that warning tells
                    # a reader their conflict count may be partly an artefact and
                    # gives them no way to size it.
                    #
                    # A pass here settles it. `cross_check` is a bijection with
                    # equal hashes in both directions, so it holds exactly when
                    # the base render reproduces what was scaffolded, file for
                    # file — an uncommitted edit that changed a shipped file
                    # would move a hash, one that added a file would be recorded
                    # and unrendered, one that removed a file would be rendered
                    # and unrecorded. All three are refusals above. What is left
                    # is an uncommitted edit to something the scaffold does not
                    # ship, which by definition changes no classification below.
                    #
                    # So the number is real. This is the only run that can say
                    # so: in the `--no-base` fallback the hashes came from the
                    # dirty render and there is nothing to check them against.
                    say("✅", "…and the manifest matches that base exactly, so those edits touched")
                    detail("no file this scaffold ships. Nothing below is an artefact of them.")

        added, updated, merged, conflicted, collided, declined, dropped = [], [], [], [], [], [], []
        patches = target / "tmp" / "upgrade"
        # A dry run writes nothing, `tmp/upgrade/` included — so it must not be
        # allowed to imply otherwise. It reads what is there instead, and says
        # whose plan it is; the real run makes the directory true by clearing it.
        stale = sidecars(patches) if args.dry_run else []
        cleared = 0 if args.dry_run else clear_sidecars(patches)

        for rel in sorted(set(base_files) | set(head_files)):
            if rel in GENERATED or rel == MANIFEST_NAME:
                continue
            ours = read(head_files.get(rel))
            base = read(base_files.get(rel))
            live_path = target / rel
            theirs = read(live_path) if live_path.exists() else None

            if ours is None:
                # The template stopped shipping it. Never delete somebody's file.
                if live_path.exists():
                    dropped.append(rel)
                continue

            if theirs is None:
                # Absent from the tree — but there are two ways to be absent, and
                # they want opposite handling. The manifest tells them apart with
                # no new bookkeeping: an entry means skeletor WROTE this file
                # here, so its absence now is a deletion somebody performed on
                # purpose. No entry means the template has only just started
                # shipping it, and adding it is the whole point of an upgrade.
                #
                # Restoring both was the same mistake as overwriting an edit,
                # wearing a friendlier symbol: a partial adoption — take the
                # rules, drop Release Please — had every declined file returned
                # on every upgrade, reported as a green "new file added" and
                # written without asking. A decision that has to be re-made on a
                # schedule is not a decision, and one auto-reverted with a tick
                # beside it is worse than a conflict, which at least stops.
                #
                # The tree's own state is the record. A list of declines in the
                # manifest would be a second home for a fact the filesystem
                # already states, and would go stale the moment somebody changed
                # their mind by restoring the file.
                if hashes and rel in hashes:
                    declined.append(rel)
                    # Only worth a sidecar if there is something new to look at:
                    # the template has moved since they declined it. Unchanged,
                    # they already saw this file and said no.
                    # `.get`, matching the report below: the two are the same
                    # question and a subscript here would make them disagree if
                    # the guard above ever loosened.
                    if sha256(head_files[rel]) != hashes.get(rel) and not args.dry_run:
                        sidecar = patches / f"{rel}.new"
                        sidecar.parent.mkdir(parents=True, exist_ok=True)
                        shutil.copy2(head_files[rel], sidecar)
                    continue
                added.append(rel)
                if not args.dry_run:
                    live_path.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(head_files[rel], live_path)
                continue

            if base is None:
                # No base text for this file — either it is absent from the base
                # render, or there is no base render at all. Fall back to the
                # recorded hash, which answers "untouched?" and nothing else.
                recorded_hash = hashes.get(rel)
                if recorded_hash is None:
                    # Never recorded, so skeletor never wrote it: the user had a
                    # file here before the template claimed the path. Handled the
                    # same as a conflict and named differently, because the name
                    # is what the reader acts on. "You edited this" sends them to
                    # `git log` for a change they never made; the truth sends them
                    # to the question that is actually in front of them, which is
                    # whether two files written for the same purpose should now be
                    # one — a choice between implementations, not a hunk to port.
                    # The manifest draws the line exactly: an entry with a
                    # different hash is an edit, no entry at all is a collision.
                    if theirs != ours:
                        collided.append(rel)
                        if not args.dry_run:
                            sidecar = patches / f"{rel}.new"
                            sidecar.parent.mkdir(parents=True, exist_ok=True)
                            sidecar.write_text(ours, encoding="utf-8")
                    continue

                # The recorded hash is the hash of the OLD RENDER, so it answers
                # both halves of the matrix — not just "did the user touch it".
                edited = sha256(live_path) != recorded_hash
                changed = sha256(head_files[rel]) != recorded_hash

                if not changed:
                    # The template did not move. Whatever the user did here is
                    # theirs, and there is nothing to carry over — reporting it
                    # would be noise on every single run.
                    continue
                if not edited:
                    # Proof, not a guess: an equal hash means the file IS the old
                    # render, so there is no edit here to lose.
                    updated.append(rel)
                    if not args.dry_run:
                        live_path.write_text(ours, encoding="utf-8")
                    continue
                conflicted.append(rel)
                if not args.dry_run:
                    sidecar = patches / f"{rel}.new"
                    sidecar.parent.mkdir(parents=True, exist_ok=True)
                    sidecar.write_text(ours, encoding="utf-8")
                continue

            edited = theirs != base
            changed = ours != base
            if not changed:
                continue
            if not edited:
                updated.append(rel)
                if not args.dry_run:
                    live_path.write_text(ours, encoding="utf-8")
                continue

            resolved = merge(base, theirs, ours, workdir)
            if resolved is None:
                conflicted.append(rel)
                if not args.dry_run:
                    patch = patches / f"{rel}.patch"
                    patch.parent.mkdir(parents=True, exist_ok=True)
                    patch.write_text(unified(base, ours, rel), encoding="utf-8")
            else:
                merged.append(rel)
                if not args.dry_run:
                    live_path.write_text(resolved, encoding="utf-8")

        for rel in sorted(set(base_files)):
            if rel in head_files or rel in GENERATED:
                continue
            if (target / rel).exists() and rel not in dropped:
                dropped.append(rel)

        # The generated docs are rebuilt, never merged.
        pending = conflicted + collided
        if not args.dry_run and (added or updated or merged):
            regen = target / "scripts" / "docs" / "regen.py"
            if regen.exists():
                subprocess.run([sys.executable, str(regen)], cwd=str(target), capture_output=True)
            # The head render's manifest, verbatim — the hashes recorded are of
            # what skeletor PRODUCES, never of what is on disk. The difference
            # decides whether the next upgrade destroys work: a merged file is
            # neither the old render nor the new one, so hashing the tree would
            # record it as pristine and the next run would overwrite the merge.
            # Recording the render's hash makes it read as edited, which it is.
            #
            # **But not while anything is still pending.** The manifest is a
            # single-version snapshot — `cross_check` requires its hashes to be
            # exactly the render at `skeletor_ref` — and a run that applied some
            # files and refused others leaves a tree that is not at one version.
            # Copying the head manifest anyway records the head render's hash
            # for a file the head render never reached, so the next run takes
            # that change as already in the base, the base→ours diff no longer
            # contains it, and it is never offered again. Reported by
            # stash.flow, reproduced here: conflict on AGENTS.md, four other
            # files applied, ref advanced, and the second run said "already
            # current — nothing to carry over" for a change that had never been
            # made. Silent, permanent, and green.
            #
            # Holding the ref back is sound in the direction that matters. The
            # applied files now differ from their recorded hash, so the next run
            # reads them as edited and merges rather than replaces — and that
            # merge is clean, because theirs and ours already share exactly the
            # hunks that were applied. A superfluous merge is the cheap error
            # here; a lost template change is the expensive one.
            if pending and not args.ported:
                say("⏸️ ", f"{MANIFEST_NAME} left at {ref} — {len(pending)} file(s) still pending")
                detail("Advancing it would record the new render as this tree's base for files")
                detail("the new render never reached, and their changes would stop being offered.")
                detail("Port them from tmp/upgrade/, then run this again to advance the base.")
                detail("Until then the files that DID apply read as edited, which is what they are.")
                detail()
                detail("If your version of these IS the resolution — an adopter's file the")
                detail("template also ships, and you are not taking ours — say so with --ported")
                detail("and the base advances. That is an assertion nothing can check for you.")
            else:
                # `--ported` is the user asserting the tree is now at this
                # version: they took our change, or they took their own and mean
                # it. Either way the base is head from here.
                #
                # It has to be a flag rather than a default because nothing can
                # verify a hand-port. A three-way merge cannot tell "already
                # applied" from "never applied" — re-merging an applied hunk
                # conflicts exactly like an unapplied one — so the tool would be
                # guessing, and the wrong guess is the silent loss this whole
                # branch exists to stop. Named and listed, it is a decision;
                # inferred, it is the bug wearing a flag.
                if pending:
                    say("→", f"--ported: taking {len(pending)} unresolved file(s) on trust")
                    for rel in pending:
                        item(rel)
                    detail()
                    detail("The base advances to this skeletor. If any of these was NOT resolved,")
                    detail("its template change is now part of your base and will not be offered")
                    detail("again — that is what the flag asserts, and it cannot be undone by")
                    detail("re-running.")
                shutil.copy2(head_tree / MANIFEST_NAME, target / MANIFEST_NAME)

        # One call, two renderings. It was computed separately for the JSON and
        # for the human report — two call sites for one answer, which is the
        # duplication this repository refuses everywhere else, and it hid a
        # planted bug: the plant changed one site and the gate asserted on the
        # other.
        entangled = importers_of(conflicted + collided, added + updated + merged, head_files)

        if args.json:
            print(
                json.dumps(
                    {
                        "target": str(target),
                        "base_ref": ref,
                        "dry_run": args.dry_run,
                        # What is on disk in tmp/upgrade/, so a machine consumer
                        # is not left inferring it from `dry_run` the way a human
                        # reader was left inferring it from prose.
                        "sidecars_cleared": cleared,
                        "sidecars_stale": [str(pth.relative_to(target)) for pth in stale],
                        "added": added,
                        "updated": updated,
                        "merged": merged,
                        "conflicted": conflicted,
                        "collided": collided,
                        "entangled": entangled,
                        "declined": declined,
                        "dropped": dropped,
                    },
                    indent=2,
                    sort_keys=True,
                )
            )

        if cleared:
            say("→", f"cleared {cleared} sidecar(s) an earlier run left in tmp/upgrade/")
            detail("What is there when this finishes describes this run and nothing else.")

        verb = " would be" if args.dry_run else ""
        for label, group, symbol in (
            (f"new file(s){verb} added", added, "✅"),
            (f"file(s) you never touched{verb} updated", updated, "✅"),
            (f"file(s) you edited{verb} merged cleanly", merged, "✅"),
        ):
            if group:
                say(symbol, f"{len(group)} {label}")
                for rel in group[:20]:
                    item(rel)
                if len(group) > 20:
                    detail(f"… and {len(group) - 20} more")

        if conflicted:
            say("❌", f"{len(conflicted)} file(s) you edited — merge conflicts, LEFT ALONE")
            for rel in conflicted:
                item(rel)
            detail()
            detail("Nothing was written to these.")
            if args.dry_run:
                detail("A real run would put what the template changed in each in")
            else:
                detail("What the template changed in each is in")
            if args.no_base:
                detail("tmp/upgrade/<path>.new — today's template file, to diff against yours.")
                detail("A real base→ours patch needs the base text, which this run had no way to get.")
            else:
                detail("tmp/upgrade/<path>.patch — port it by hand.")
            if not args.dry_run:
                # The window in which this is recoverable closes at the next
                # run, and nothing used to say so at the moment it opened. A
                # sidecar is the only copy — tmp/ is gitignored — and a real run
                # clears the directory before writing its own. So the output for
                # a tree where somebody ports these in the next minute was
                # identical to the output for a tree that loses them. That a
                # STALE sidecar gets a warning while an unapplied one about to
                # be overwritten got none was stash.flow's tell, and it is the
                # right one: the two look the same on disk.
                #
                # The two halves are said separately because only one of them is
                # true on any given run, and printing both would be this
                # repository's own invariant 7 — a sentence about a mechanism,
                # emitted on the path where the mechanism is not operating.
                detail()
                detail("These patches are the only copy. tmp/ is not tracked, and the next real")
                detail("run clears this directory before writing its own.")
                if args.ported:
                    detail("--ported already advanced the base past them, so re-running will NOT")
                    detail("regenerate these: what is in tmp/upgrade/ now is the last copy there is.")
                else:
                    detail("Port them before then, or re-run to regenerate them. The base stays")
                    detail("where it is until they are gone, so nothing expires while you decide.")

        if collided:
            say("❌", f"{len(collided)} file(s) you already had where the template now ships one")
            for rel in collided:
                item(rel)
            detail()
            detail("Not an edit — these were never in your manifest, so skeletor never wrote")
            detail("them. Two files written for the same purpose now want the same path, and")
            detail("which one survives is a judgement only you can make. Yours is untouched")
            if args.dry_run:
                detail("where it has always been, and a real run would put the template's in")
                detail("tmp/upgrade/<path>.new.")
            else:
                detail("where it has always been; the template's is in tmp/upgrade/<path>.new.")

        if declined:
            # Deliberately a one-line standing state, not a roll-call. This is
            # permanent — the manifest is re-copied from the head render every
            # run, so a declined file stays recorded and stays declined — and a
            # six-line block that can never be resolved is what teaches somebody
            # to skim the whole report. The count keeps it honest; `--json`
            # carries the names for anything that needs them.
            say("⏭️ ", f"{len(declined)} file(s) skeletor wrote and you deleted — NOT restored")
            detail("Recorded in the manifest, absent from the tree: a decision you made, which")
            detail("an upgrade does not re-make for you. Standing state, reported every run.")
            # The subset that is actually actionable: the template has moved
            # since the decline, so there is something new to say no to.
            fresh = [rel for rel in declined if sha256(head_files[rel]) != hashes.get(rel)]
            if fresh:
                detail()
                detail(f"{len(fresh)} the template has changed since — worth a second look, and the")
                detail("current version is in tmp/upgrade/<path>.new:")
                for rel in fresh:
                    item(rel)

        # After the two blocks that name files needing a decision, because this
        # is about those files — and before `dropped`, which is unrelated.
        if entangled:
            say("⚠️ ", f"{len(entangled)} file(s) applied cleanly import one that did NOT")
            for rel, targets in sorted(entangled.items()):
                item(f"{rel} → {', '.join(targets)}")
            detail()
            detail("A merge status describes one file and says nothing about what it depends")
            detail("on. These were written because you had never edited them — which is the")
            detail("reassuring case, and the wrong one here: their behaviour is decided by a")
            detail("file above that you kept or must resolve by hand. Check the pair.")

        if dropped:
            say("⚠️ ", f"{len(dropped)} file(s) the template no longer ships — NOT deleted")
            for rel in dropped:
                item(rel)
            detail("Delete them yourself if you agree. This never removes your files.")

        # Only when this run actually wrote a test file, and only on a real run.
        # Always-on prose in this output gets skimmed, and this instruction earns
        # attention precisely because it is rare — proto.pilot's point, and the
        # reason it is conditional rather than a standing line in the footer.
        touched_tests = sorted(r for r in added + updated + merged if r.startswith("tests/"))
        if touched_tests and not args.dry_run:
            say("ℹ️ ", f"{len(touched_tests)} file(s) under tests/ changed — do not verify by counting")
            detail()
            detail("A collected-test total is a negative assertion over a set wearing a number's")
            detail("clothes. One measured upgrade came back 633 before and 633 after with five")
            detail("tests removed and five added; another went 642 to 641 while coverage rose,")
            detail("two hand-written guards having become registry-driven ones. A reader")
            detail("watching the number drew no conclusion from the first and would have drawn")
            detail("the wrong one from the second. Diff the collected IDs instead:")
            detail()
            commit = pre_upgrade or "<the commit you were on before this run>"
            detail("  PY=$(pwd)/.venv/bin/python          # the worktree gets none of its own")
            detail(f"  git worktree add tmp/pre-upgrade {commit}")
            detail("  $PY -m pytest --collect-only -q | grep :: | sort > /tmp/after.txt")
            detail("  (cd tmp/pre-upgrade && $PY -m pytest --collect-only -q | grep :: | sort) > /tmp/before.txt")
            detail("  git worktree remove tmp/pre-upgrade")
            detail("  wc -l /tmp/before.txt /tmp/after.txt   # two zeros = neither collection ran")
            detail("  diff /tmp/before.txt /tmp/after.txt")
            detail()
            detail("Under `tmp/`, which this tree already gitignores, and not `../` — stash.flow")
            detail("followed it into a workspace root holding every repo as a sibling, where a")
            detail("leftover `pre-upgrade/` reads as one more project. The location says what it")
            detail("is even if the removal line gets skipped.")
            detail()
            detail("That `wc` is not decoration. If the interpreter path is wrong or collection")
            detail("errors, `grep` writes an empty file, `diff` reports no change, and you have")
            detail("read a clean bill off two files that contain nothing — which is this")
            detail("paragraph's own mistake, committed by the command meant to prevent it.")
            detail()
            detail("EXPECT REMOVALS, and read the list rather than its length. A guard moving")
            detail("into a wrapper deletes the companion test that used to stand beside it, and")
            detail("that is this upgrade working correctly — in the measured case three of five")
            detail("removals were exactly that and a fourth was a relocation. Somebody running")
            detail("this expecting a clean bill either panics or decides the check is noisy, and")
            detail("the second one costs more.")
            if interleaved:
                detail()
                detail("--allow-dirty: the commit above is the last COMMIT, not the tree this run")
                detail("started from. Your own uncommitted edits are in that diff too.")

        if not any((added, updated, merged, conflicted, collided, declined, dropped)):
            say("✅", "already current — nothing to carry over")
            return 0

        detail()
        if args.dry_run:
            say("⏸️ ", "dry run — nothing was written, tmp/upgrade/ included")
            if stale:
                detail(f"{len(stale)} file(s) are already in tmp/upgrade/ from an earlier run.")
                detail("They describe that run's plan against that template, not this one — a real")
                detail("run clears them before writing. Nothing above refers to them.")
                for path in stale[:10]:
                    item(str(path.relative_to(target)))
                if len(stale) > 10:
                    detail(f"… and {len(stale) - 10} more")
        else:
            say("✅", "nothing was committed. Read the diff, then commit as one `chore(skeletor):` change")
        return 1 if (conflicted or collided) else 0
    finally:
        if cleanup_worktree is not None:
            subprocess.run(
                ["git", "-C", str(SKELETOR), "worktree", "remove", "--force", str(cleanup_worktree)],
                capture_output=True,
            )
        shutil.rmtree(workdir, ignore_errors=True)


if __name__ == "__main__":
    raise SystemExit(main())
