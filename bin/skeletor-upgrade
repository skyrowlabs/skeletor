#!/usr/bin/env python3
"""Carry a template change into a tree that was scaffolded from an older one.

The problem this exists for is the multi-repo one: skeletor improves, and the
twelve repositories generated from it do not. Re-running `skeletor-new --force`
would overwrite the half of each tree that is the *user's* — the services table
in `CLAUDE.md`, the real health probes in `cli/check.py` — so nobody runs it,
and the improvement never lands anywhere.

## How it decides

Three texts per file, which is the classic three-way merge:

* **base** — what skeletor rendered when this tree was scaffolded, reproduced
  by checking out `skeletor_ref` from `.skeletor.json` and running *that*
  version of the scaffolder with the arguments it recorded.
* **theirs** — what is in the tree now.
* **ours** — what skeletor renders today.

From which:

| base vs theirs | base vs ours | What happens                        |
| -------------- | ------------ | ----------------------------------- |
| same           | same         | nothing                             |
| same           | changed      | applied — the user never touched it |
| changed        | same         | left alone — only the user's edit   |
| changed        | changed      | three-way merged, **if it is clean** |

**A conflict is never written.** `git merge-file` can emit markers; this does
not let it. On conflict the file is left exactly as it was and the template's
own base→ours diff is written to `tmp/upgrade/`, because a conflict marker
inside somebody's `CLAUDE.md` is a broken file that looks like a merge, and the
tree it lands in is one nobody is watching.

`tmp/upgrade/` describes **one** run: a real run clears its own sidecars before
writing, and `--dry-run` writes none and says so. Both halves are the same bug,
which proto.pilot reported from the reader's side. The instruction "port what is
in `tmp/upgrade/<path>.patch`" is only true if that file belongs to the plan
just printed, and by default it did not — a dry run printed the instruction
while writing nothing, and a real run left every earlier run's sidecars beside
today's, against a template HEAD that had since moved. Neither is visible from
the directory. A patch that is stale and a patch that is fresh look identical at
exactly the moment somebody is trusting one.

Nothing is committed, nothing is deleted, and a file the template dropped is
reported rather than removed — the same posture as `bin/skeletor-check-pins`,
which reports a bump and never makes one.

## When the base is out of reach

Rendering the base needs skeletor's git history, and there are ordinary reasons
it is not there: a `--depth 1` clone, a tarball, a collected ref, a rewritten
branch. Rather than refuse, this falls back to the `files` hashes in the
manifest, which answer the one question that still matters — *has anybody
touched this file?*

The fallback applies a file only when its hash matches, and that is a proof
rather than a guess: an equal hash means the file **is** byte-for-byte what
skeletor generated, so replacing it with a newer render cannot lose an edit
that was never made. What the fallback cannot do is merge — merging needs the
base *text* — so an edited file is reported and left alone.

The hashes are a derived value with a second home, which is normally the thing
this project refuses. They earn it by being checked against their source on
every ordinary run: when the base *is* rendered, it is re-hashed and a manifest
that disagrees is a hard failure. A cache validated against its source every
time it is bypassed cannot rot unnoticed.

Usage:
    bin/skeletor-upgrade ../orders
    bin/skeletor-upgrade ../orders --dry-run
    bin/skeletor-upgrade ../orders --no-base      # what have I edited?
    bin/skeletor-upgrade ../orders --from-dir /path/to/another/skeletor
"""

from __future__ import annotations

import argparse
import ast
import hashlib
import json
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Dict, List, Optional, Tuple

sys.path.insert(0, str(Path(__file__).resolve().parent))

from render_guard import head_standing, render_dirt, uncommitted  # noqa: E402

SKELETOR = Path(__file__).resolve().parents[1]
MANIFEST_NAME = ".skeletor.json"

#: Regenerated from their sources by `scripts/docs/regen.py`, and routed
#: through a merge driver precisely because merging them is never correct. They
#: are rebuilt at the end instead of being merged here.
GENERATED = {
    "docs/todo_index.json",
    "docs/TODO/README.md",
    "docs/implementation_index.json",
    "docs/implementations/README.md",
}

#: Never rendered by the scaffolder into a comparable state: scratch, history,
#: and installed dependencies.
SKIP_PREFIXES = ("tmp/", ".git/", "node_modules/", ".venv/")


def say(symbol: str, message: str) -> None:
    print(f"{symbol} {message}", file=sys.stderr)


def item(message: str) -> None:
    print(f"   · {message}", file=sys.stderr)


def detail(message: str = "") -> None:
    print(f"   {message}" if message else "", file=sys.stderr)


#: What this tool writes into `tmp/upgrade/`, and the only thing it will remove
#: from there. Anything else in that directory is somebody's, not ours.
SIDECAR_SUFFIXES = (".patch", ".new")


def sidecars(patches: Path) -> List[Path]:
    """Every sidecar a previous run left behind, by our own suffixes."""
    if not patches.is_dir():
        return []
    return sorted(
        p for p in patches.rglob("*") if p.is_file() and p.suffix in SIDECAR_SUFFIXES
    )


def report_stale(stale: List[Path], target: Path, because: List[str]) -> None:
    """List the sidecars an earlier run left, and say whose plan they are.

    Two callers, because there are two ways for a dry run to end with that
    directory holding somebody else's patches, and only the *reason* differs:
    one has a plan above to contrast them against and one has no plan at all.
    The listing was written for the first and the second went without, which is
    why the reason is the parameter — it is the only part a reader acts on.
    """
    detail(f"{len(stale)} file(s) are already in tmp/upgrade/ from an earlier run.")
    for line in because:
        detail(line)
    for path in stale[:10]:
        item(str(path.relative_to(target)))
    if len(stale) > 10:
        detail(f"… and {len(stale) - 10} more")


def clear_sidecars(patches: Path) -> int:
    """Remove the previous run's sidecars, so the directory describes this run.

    The reader is told to go open `tmp/upgrade/<path>` and port what is in it.
    That instruction is only true if the directory holds this run's plan — and
    it does not, by default: a real run writes a sidecar per conflict *today*
    and leaves every sidecar from every earlier run in place, so the directory
    accumulates into a superset of a plan that no longer exists. A four-day-old
    patch against a different template HEAD is indistinguishable from a fresh
    one at the moment somebody is trusting it.

    So each real run clears what it wrote before writing again. A conflict that
    is still a conflict gets its sidecar back in the same breath; one that is
    gone had a sidecar describing work that is done. Deleting is the thing this
    tool refuses everywhere else, which is why the suffixes are ours alone, why
    nothing outside `tmp/upgrade/` is touched, and why the count is reported.
    """
    removed = 0
    for path in sidecars(patches):
        path.unlink()
        removed += 1
    # Leave no empty scaffolding behind either; `rmdir` refuses a non-empty one,
    # so anything of the user's keeps its directory.
    for path in sorted(patches.rglob("*"), reverse=True) if patches.is_dir() else []:
        if path.is_dir():
            try:
                path.rmdir()
            except OSError:
                pass
    return removed


def die(message: str) -> "NoReturn":  # type: ignore[valid-type]
    say("❌", message)
    raise SystemExit(1)


#: What a base render reads, and therefore the only dirt that can make one
#: unreproducible. `render_with` runs `<checkout>/bin/skeletor-new`, which walks
#: `template/`; nothing else in this repository is opened by that process.
#: A short list rather than a pattern because it is a fact about another
#: program's behaviour, which no predicate here can discover — so
#: `bin/skeletor-verify` asserts dirt inside and outside is classified
#: oppositely, on a real run.
def head_commit(target: Path) -> Optional[str]:
    """The target's HEAD, or None if git cannot say.

    Worth recording because this tool refuses a dirty tree: on an ordinary run
    HEAD is the pre-upgrade state *exactly*, and this is the only moment anybody
    gets that for free. By the time the footer's reader acts on it they have
    committed the upgrade and possibly a fixup, and the answer has become
    `HEAD~2` if they can remember how many. proto.pilot's point, and it is the
    difference between a procedure somebody reconstructs and one they paste.

    Nothing here commits, so HEAD does not move during a run and reading it
    early is tidiness rather than correctness. `uncommitted()` beside it is the
    opposite: writing makes the tree dirty, so that one must be read first or it
    answers about this run's own output.
    """
    result = subprocess.run(
        ["git", "-C", str(target), "rev-parse", "HEAD"], capture_output=True, text=True
    )
    return result.stdout.strip() or None if result.returncode == 0 else None


#: Checkouts `warn_a_dirty_base` has already reported on, so a dry run that
#: reads the same directory twice says it once.
_WARNED_DIRTY: set = set()


def _list_dirty(dirty: List[str]) -> None:
    """The paths, capped. One home, because three guards report this set."""
    for path in dirty[:10]:
        item(path)
    if len(dirty) > 10:
        item(f"... and {len(dirty) - 10} more")


def warn_a_dirty_base(base: Path, role: str) -> None:
    """The dry run's half of `refuse_a_dirty_base`: say it, do not refuse it.

    Never refusing is right and the silence was not. `--dry-run` writes nothing,
    so the unreproducible-render hazard cannot land — and that is what keeps
    `bin/skeletor-verify` running `--from-dir .` against this checkout mid-edit.
    But a dry run is the thing somebody *reads to decide*, so a plan computed
    from a base that exists in no commit is precisely where the difference
    matters most, and it arrived looking like any other plan.

    proto.pilot hit it from the far side: this checkout was mid-pass, their dry
    run planned two files, and the real run from a clean tag correctly left both
    alone. Nothing was damaged and nothing in the output could have told them.

    Said once per checkout. A dry run reaches this twice — for the base and for
    the head render — and with `--from-dir .` those are one directory, so the
    unguarded version printed the same four lines about the same two files. The
    refusal never showed that because it exits on the first call.

    **`role` because two different checkouts arrive here and the noun was
    hardcoded.** `:902` really is the base; `:938` is the checkout that renders
    `ours`, which is a different tree whenever the base is a worktree at a tag —
    and *"the base checkout"* cannot be right at both. node-zero printed the
    contradiction in one invocation: this line naming their dirty
    `bin/skeletor-new` as "the base checkout" while the base was a clean
    worktree at `v0.9.0`, three lines above a sentence that had to say *"the
    checkout that rendered this"* in order to be true. The fix for one and the
    proof of the other were in the same output.
    """
    dirty = render_dirt(base)
    if not dirty or base in _WARNED_DIRTY:
        return
    _WARNED_DIRTY.add(base)
    say("⚠️ ", f"the {role} has {len(dirty)} uncommitted change(s) — this plan includes them")
    _list_dirty(dirty)
    detail()
    detail("A real run from a committed base will differ, and is refused from this one.")
    detail("Read the plan as a statement about a tree that exists on one machine.")


def refuse_a_dirty_base(base: Path, writing: str, role: str) -> None:
    """A base render nobody can reproduce must not be written into a manifest.

    Everything the `files` map promises rests on the base being re-renderable.
    `cross_check` re-derives those hashes on every ordinary run precisely so the
    fallback cannot rot — a cache validated every time it is bypassed. Render
    the base from a checkout carrying uncommitted edits and the hashes describe
    a state that exists on one machine, at one moment, and in no commit. The
    next run resolves the recorded ref, renders something different, and
    refuses. The manifest is then permanently unusable, and the file it
    disagrees about is whichever one you happened to have open.

    This is not hypothetical. It is how proto.pilot's tree ended up blocked on
    `ci.yml`: their manifest was repaired on a day skeletor had uncommitted
    changes to exactly that file, so the recorded hash is of a render that has
    never existed in this history.

    Untracked files count here, unlike on the target. `copy_overlay` walks
    `template/`, so an untracked file there is rendered into the base and is
    just as unreachable from a ref.

    `--dry-run` writes nothing and is never refused, which is also what keeps
    `bin/skeletor-verify` running `--from-dir .` against this checkout while it
    is being edited.

    **The teeth are in "unreproducible", not in "write"** — worth stating,
    because this reasoning now backs three guards and the short version of it
    would over-apply. A merely *wrong* write is not this: the next correct run
    overwrites it and nothing is lost. What cannot be undone is recording a hash
    of a render nobody can re-derive, because from then on every run is
    internally correct and disagrees forever, and no amount of re-running gets
    you out. A guard is owed to a write with that property and not to writes in
    general. (proto.pilot's narrowing, and a fair one — the first draft of this
    argued from "write".)
    """
    dirty = render_dirt(base)
    if not dirty:
        return
    say("❌", f"the {role} has {len(dirty)} uncommitted change(s) to what it renders:")
    _list_dirty(dirty)
    detail()
    detail(f"{writing} would record hashes of a render that exists in no commit, so the")
    detail("next run resolves the recorded ref, renders something else, and refuses —")
    detail(f"permanently. Commit the {role} first, or use --dry-run to look.")
    detail()
    detail(f"If the {role} is somebody else's and they are mid-pass, clone it at a")
    detail("tag and run THAT copy with no flags:")
    detail()
    detail(f"  git clone {base} /tmp/skeletor-clean && git -C /tmp/skeletor-clean checkout <tag>")
    detail("  python /tmp/skeletor-clean/bin/skeletor-upgrade <your tree>")
    detail()
    detail("Not `--from-dir <that clone>`. That overrides the BASE, which your manifest")
    detail("already names — you would render the base at the new tag, mismatch every")
    detail("recorded hash, and the flag that then looks right (`--repair-manifest`) is")
    detail("the one that destroys the record. With no flags the clone resolves your")
    detail("recorded ref out of its own history and renders today from its tree, which")
    detail("is what you want. proto.pilot reached for the wrong flag first.")
    raise SystemExit(1)


def refuse_a_dirty_tree(target: Path, ported: bool = False) -> None:
    """An upgrade whose result cannot be read, or undone, must not start.

    This is **not** protecting somebody from their own git. Everything is
    committed or it is not, and this tool endangers neither.

    It is that the whole safety model here is *you read the diff*. Nothing is
    committed, conflicts go to `tmp/upgrade/`, and the user decides. On a dirty
    tree `git diff` can no longer answer "what did the upgrade change", because
    the template's changes and the user's are interleaved in one output — so the
    tool would produce an answer nobody can read.

    The undo is worse, and it is the half that decides this. A merged file is
    neither the old render nor the new one, so the ordinary way back —
    `git checkout -- .` — discards the user's uncommitted work along with the
    upgrade. There is no gesture that reverts one and keeps the other.

    Hence a refusal rather than a warning, and hence `--allow-dirty` named in
    the message: "I am mid-edit and want the template's version to merge
    against" is a real workflow, and refusing *with the escape hatch in the
    sentence* is a different act from refusing.

    `--dry-run` writes nothing and is never refused; `--repair-manifest` touches
    only `.skeletor.json`, which stays legible in a diff and reverts on its own.

    **`--ported` is exempt, because the documented flow guarantees the state it
    would refuse.** That flag is warranted only *after* a run left conflicts and
    you ported them by hand — and that run already wrote every file it could
    apply, so the tree is dirty from this tool's own output before your first
    hand-edit. Refusing left two exits and both are bad, which is how proto.pilot
    found it: commit with the manifest knowingly at the old ref, which is the
    record corruption every other guard here exists to prevent and which a
    careful person reaches for *because* they are being careful; or pass
    `--allow-dirty`, whose help describes merging into in-progress edits of your
    own. There are none — the dirty tree is the tool's output — so the flag that
    works reads wrong, and they backed three files up by hand before trusting it.

    Nothing is put at risk that the flag has not already put there. A conflicted
    file is **never written** by this tool, so `--ported` cannot overwrite a
    hand-port: it advances the record and leaves the bytes alone. That is the
    sentence the help was missing, and it is why a warning is the right shape
    here rather than a refusal with an escape hatch that does not fit.

    Two guards, each right, jointly making a documented flow unreachable — the
    class `docs/DESIGN_RATIONALE.md` records as the defect that lives in what
    two files jointly imply.
    """
    dirty = uncommitted(target)
    if not dirty:
        return
    if ported:
        say("⚠️ ", f"--ported into a tree with {len(dirty)} uncommitted change(s) — expected here")
        detail("A run that left conflicts had already written every file it could apply, so")
        detail("this tree is dirty before you port anything. Your hand-ports are safe: a")
        detail("conflicted file is never written by this tool, and --ported moves the record")
        detail("rather than the bytes. `git checkout -- .` still discards both at once.")
        return
    say("❌", f"{len(dirty)} tracked file(s) have uncommitted changes:")
    _list_dirty(dirty)
    detail()
    detail("An upgrade here would interleave with that work: `git diff` could no longer")
    detail("say what the template changed, and `git checkout -- .` would discard both.")
    detail("Commit or stash first — or pass --allow-dirty if merging into your")
    detail("in-progress edits is what you actually want.")
    raise SystemExit(1)


def read_manifest(target: Path) -> dict:
    path = target / MANIFEST_NAME
    if not path.exists():
        die(
            f"{target} has no {MANIFEST_NAME} — it predates the manifest, so there is no "
            "base to merge against.\n   Scaffold-time provenance cannot be recovered after "
            "the fact without guessing, and a guessed base merges the wrong thing silently."
        )
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        die(f"{path} is not valid JSON: {exc}")


def render_with(checkout: Path, args: List[str], into: Path) -> None:
    """Run a given skeletor checkout's scaffolder into an empty directory.

    The *old* scaffolder, deliberately — the post-copy steps are part of what a
    tree looks like, and they change too. Reproducing the base with today's
    scaffolder would attribute this release's behaviour to the previous one.
    """
    scaffolder = checkout / "bin" / "skeletor-new"
    if not scaffolder.exists():
        die(f"{scaffolder} does not exist — that checkout is not a skeletor")
    # `--allow-dirty` because this call has already been ruled on. The
    # scaffolder refuses a dirty render to protect the manifest it writes; here
    # nothing is written to a manifest — the render goes to a scratch directory
    # and this tool has made its own decision above, refusing for a real run and
    # warning for a dry one. Without it a dry run from a working checkout dies
    # at render time, which is the one path the fleet actually uses. An older
    # scaffolder that has no such flag never sees it: it is appended only when
    # that checkout's parser knows it.
    flags = ["--no-git", "--force"]
    # Both appended only when that checkout's parser knows them, which is the
    # same idiom for the same reason: a base render runs an OLD scaffolder.
    #
    # `--reproducing` suppresses the checks that are about creating a tree. The
    # line-length floor shipped in v0.18.0 and immediately blocked the only
    # adopter recording a value below it — from an upgrade carrying a fix for a
    # gap they were already carrying unguarded, on the strength of a premise
    # ("red on arrival") that cannot apply to a tree three releases old.
    help_text = subprocess.run(
        [sys.executable, str(scaffolder), "--help"], capture_output=True, text=True
    ).stdout
    for flag in ("--allow-dirty", "--reproducing"):
        if flag in help_text:
            flags.append(flag)
    result = subprocess.run(
        [sys.executable, str(scaffolder), str(into), *args, *flags],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        die(f"rendering with {checkout} failed:\n{result.stdout}\n{result.stderr}")


def base_checkout(ref: str, workdir: Path, *, fatal: bool = True) -> Tuple[Optional[Path], Optional[Path], str]:
    """A detached worktree of skeletor at `ref`: the tree, what to clean up, and
    the ref actually used — which is not `ref` when the scaffold was dirty."""
    if ref.endswith("-dirty"):
        ref = ref[: -len("-dirty")]
        say("⚠️ ", f"the tree was scaffolded from a dirty checkout — using the committed part ({ref})")
        detail("Uncommitted template edits at that time will read as template changes now.")
        # This said "does not clear", flatly, and that was wrong. proto.pilot
        # measured a tree going `v0.2.0-dirty` → a clean tag across one upgrade
        # and told me. The claim had been written from the one case that had
        # been tested — a refusal, where nothing is written and so nothing
        # clears — and generalised to every case, which is the shape of mistake
        # this repository is mostly about.
        #
        # Three outcomes, and only the first is permanent:
        #   * the edit touched a file this scaffold SHIPS — `cross_check`
        #     refuses below, no manifest is written, and the ref stays. Correct:
        #     the recorded base genuinely is unreproducible.
        #   * the upgrade APPLIES something — the manifest is rewritten from the
        #     head render, which exists in a commit, and the ref is clean from
        #     then on.
        #   * the upgrade applies nothing — already current, or only conflicts
        #     and declines — the manifest is untouched and this returns next run.
        detail("Whether it clears depends on what happens next, and only one outcome is")
        detail("permanent: if those edits touched a file this scaffold ships, the refusal")
        detail("below is that, and the recorded base really is unreproducible. Otherwise the")
        detail("first upgrade that APPLIES anything rewrites the manifest from a render that")
        detail("does exist in a commit, and the ref is clean from then on.")
        detail("--repair-manifest does not do it — it rewrites the hashes, never the ref.")
        detail("It can also be *bounded* right now: if the recorded hashes match this base")
        detail("render, the edits touched nothing this scaffold ships. Watch for that line.")
    tree = workdir / "base-checkout"
    result = subprocess.run(
        ["git", "-C", str(SKELETOR), "worktree", "add", "--detach", str(tree), ref],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        if fatal:
            die(
                f"cannot check out skeletor at '{ref}':\n   {result.stderr.strip()}\n"
                "   A shallow clone or a rewritten history cannot reproduce the base. "
                "Pass --from-dir with a checkout that can."
            )
        return None, None, ref
    return tree, tree, ref


def files_under(root: Path) -> Dict[str, Path]:
    out: Dict[str, Path] = {}
    for path in sorted(root.rglob("*")):
        if not path.is_file():
            continue
        rel = path.relative_to(root).as_posix()
        if rel == MANIFEST_NAME or rel.startswith(SKIP_PREFIXES) or "__pycache__" in path.parts:
            continue
        out[rel] = path
    return out


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def standing_divergence(target: Path, reference: Dict[str, str]) -> List[str]:
    """Files skeletor wrote here that no longer match `reference`.

    `reference` is `{repo-relative path: sha256 of what skeletor produces}` —
    the *base in force*. Which base that is depends on the run, and is the
    caller's decision rather than this function's: the recorded manifest for a
    dry run or a run that holds it back, the head render for a run that
    advances. Both callers ask the identical question of a different base,
    which is why this is one function and not two blocks that drift.

    A file absent from the tree is not divergence — that is a decline, reported
    separately and for a different reason. Generated artifacts and the manifest
    are excluded because their content is a function of the tree, so comparing
    them to a render says nothing about what anybody edited.
    """
    return sorted(
        rel
        for rel, digest in reference.items()
        if rel not in GENERATED
        and rel != MANIFEST_NAME
        and (target / rel).exists()
        and sha256(target / rel) != digest
    )


def importers_of(needs_review: List[str], written: List[str], head_files: Dict[str, Path]) -> Dict[str, List[str]]:
    """Files that were written cleanly but import one that was not.

    A merge status describes **one file**. It says nothing about what that file
    depends on — so the single most reassuring line this tool prints, *"file(s)
    you never touched updated"*, is exactly wrong for a clean file whose
    behaviour is decided by a conflicted one.

    proto.pilot hit it on the run that proves it is not theoretical.
    `check_doc_tables.py` conflicted, they kept their own, and
    `tests/test_docs_pipeline.py` merged clean — listed as untouched, nothing
    asking them to look — carrying a test written against a `referenced()` that
    exists only here. Three of its four cases failed on arrival. Every step was
    correct: the conflict was in one file and the breakage was one import away,
    in a file with no conflict *because they had never edited it*.

    Their point about the quiet version is the sharper half: had that test been
    permissive rather than strict, it would have merged clean, passed, and
    asserted nothing about their tree forever.

    This reports and never refuses. It cannot know whether an import actually
    matters, only that the pair is worth one look — and the cost of a false
    name in that list is ten seconds, against a silent failure that survives a
    green suite.

    Python only, deliberately: `scripts/`, `cli/` and `tests/` are where the
    coupling is, and inventing a resolver for every language the template might
    someday ship is how this would become wrong rather than incomplete.
    """
    review = set(needs_review)
    out: Dict[str, List[str]] = {}
    for rel in written:
        source = head_files.get(rel)
        if source is None or not rel.endswith(".py"):
            continue
        try:
            tree = ast.parse(source.read_text(encoding="utf-8"))
        except (SyntaxError, OSError, UnicodeDecodeError):
            continue
        modules = set()
        for node in ast.walk(tree):
            if isinstance(node, ast.ImportFrom) and node.module and not node.level:
                # `from scripts.docs import plans` reaches both `scripts/docs/plans.py`
                # and a name inside `scripts/docs/__init__.py` — try each.
                modules.add(node.module)
                modules |= {f"{node.module}.{a.name}" for a in node.names}
            elif isinstance(node, ast.Import):
                modules |= {a.name for a in node.names}
        hits = sorted(
            {
                target
                for module in modules
                for target in (module.replace(".", "/") + ".py", module.replace(".", "/") + "/__init__.py")
                if target in review
            }
        )
        if hits:
            out[rel] = hits
    return out


def cross_check(base_files: Dict[str, Path], recorded: Dict[str, str]) -> List[str]:
    """Every recorded hash must match the base render it claims to describe.

    This is what lets the fallback exist. The hashes are only consulted when the
    render is unreachable, so if they were never checked they could drift for
    months and then, on the one run that needed them, quietly classify an edited
    file as untouched. Checking them on every run that does NOT need them is the
    cheapest possible guard, and it fails on the run where it is safe to fail.
    """
    disagreements = []
    for rel, expected in sorted(recorded.items()):
        rendered = base_files.get(rel)
        if rendered is None:
            disagreements.append(f"{rel}: recorded, but the base render does not produce it")
        elif sha256(rendered) != expected:
            disagreements.append(f"{rel}: recorded hash does not match the base render")
    for rel in sorted(set(base_files) - set(recorded)):
        disagreements.append(f"{rel}: the base render produces it, but it is not recorded")
    return disagreements


def repair_manifest(target: Path, manifest: dict, base_files: Dict[str, Path], args) -> int:
    """Rewrite the `files` map from the base render, and stop.

    For one situation only: a manifest written by a version of skeletor that
    recorded the wrong thing. The first release recorded a walk of the target
    directory, so a `--force` scaffold into a populated repository recorded the
    user's own files as skeletor output, and — one layer subtler — recorded a
    hash for `.github/DOCS_INDEX.md` that included a row for a doc of theirs.

    A surplus entry can be deleted by hand. A *wrong* one cannot: the correct
    value is a hash of a render, and only skeletor can produce that render. So
    the repair is not a repair of the file, it is a re-derivation — the base
    render is standing right here, having just been produced from the arguments
    the manifest itself records, and hashing it is the definition of the value
    that belongs in the map.

    It deliberately does no upgrading. Repair, look at what it says, then run
    the upgrade: a flag that silently fixed the manifest on its way past would
    make `cross_check` unable to refuse anything, which is the one guarantee the
    fallback rests on.
    """
    recorded: Dict[str, str] = manifest.get("files") or {}
    rebuilt = {rel: sha256(path) for rel, path in sorted(base_files.items())}

    surplus = sorted(set(recorded) - set(rebuilt))
    missing = sorted(set(rebuilt) - set(recorded))
    wrong = sorted(rel for rel in set(recorded) & set(rebuilt) if recorded[rel] != rebuilt[rel])

    if not (surplus or missing or wrong):
        say("✅", f"{MANIFEST_NAME} already matches the base render — nothing to repair")
        return 0

    say("→", f"{MANIFEST_NAME}: {len(recorded)} recorded → {len(rebuilt)} from the base render")
    for label, entries in (("not produced by the render", surplus), ("wrong hash", wrong),
                           ("produced but unrecorded", missing)):
        if entries:
            detail(f"{len(entries)} {label}:")
            for rel in entries[:10]:
                item(rel)
            if len(entries) > 10:
                detail(f"… and {len(entries) - 10} more")

    if args.json:
        print(json.dumps({"ok": True, "repaired": not args.dry_run, "surplus": surplus,
                          "wrong": wrong, "missing": missing}, indent=2))
    if args.dry_run:
        say("⏸️ ", "dry run — the manifest was not written")
        return 0

    manifest["files"] = rebuilt
    (target / MANIFEST_NAME).write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
    say("✅", f"{MANIFEST_NAME} rewritten. Run the upgrade now; nothing else was touched.")
    return 0


def report_reach(
    checkout: Path,
    recorded: List[str],
    workdir: Path,
    target: Path,
    hashes: Dict[str, str],
    head_files: Dict[str, Path],
    applied: Dict[str, Tuple[str, str]],
) -> None:
    """What a `--set-arg` actually reaches, and the two things it cannot promise.

    ## Why this is said BEFORE the run and not after

    The values ride the manifest, and the manifest is held back by any pending
    file. So the whole question — *will this stick?* — is decided by whether the
    files this argument renders into are files that will conflict, and that is
    knowable now.

    **A mechanism keyed to a file cannot serve the tree that has opted out of
    that file, and the tree that opted out is the likeliest to need it.**
    sky.boss reached that from two directions a round apart: the consequence
    check that justified an earlier design could never fire in their tree
    because the only file `PYTHON_MATRIX` reaches is one they declined, and then
    `--set-arg` run bare was a no-op there for the same reason one layer out. A
    declined file is not an exotic state — it is what the `standing state` line
    exists to keep visible — and two mechanisms in a row assumed it away.

    So when every reached file is one the adopter has diverged from, this says
    so up front and names `--ported` as the only route, rather than letting the
    run print a plan and quietly record nothing.

    ## The diff, and why a well-formed result is the dangerous one

    A rendered value that *reduces* what CI does produces a perfectly
    well-formed artefact and a manifest that agrees with it. sky.boss again:

    > A halved matrix looks correct in both of the artefacts a person would
    > naturally check.

    `python: ['3.12']` is a valid one-element list and `.skeletor.json` would
    record the argument that produced it, so nothing on either side of the
    reconciliation shows the loss. **No in-tree check can catch that**, which
    makes it the tool's obligation at the moment it writes the value rather than
    a documentation one. The changed lines are printed for exactly that: the
    operator is the only instrument, and they need the before and after rather
    than a reassurance.

    The second render is the cost — one subprocess, only when `--set-arg` is
    passed — and it buys both halves, since the reached set and the diff are the
    same computation.
    """
    unamended = workdir / "head-unamended"
    render_with(checkout, recorded, unamended)
    was = files_under(unamended)

    reached = sorted(
        rel
        for rel in set(was) | set(head_files)
        if (sha256(was[rel]) if rel in was else None) != (sha256(head_files[rel]) if rel in head_files else None)
    )
    if not reached:
        say("⚠️ ", "this argument renders into nothing — no file differs under the new value")
        detail("A legitimate outcome for a flag whose value only reaches a file this tier does not")
        detail("ship, and indistinguishable from a typo in the value. Reported rather than passed")
        detail("over, because the run below will otherwise look like it did what you asked.")
        return

    declined = [rel for rel in reached if rel in hashes and not (target / rel).exists()]
    edited = [
        rel
        for rel in reached
        if rel in hashes and (target / rel).exists() and sha256(target / rel) != hashes[rel]
    ]

    say("→", f"{len(reached)} file(s) render differently under the new value(s)")
    for rel in reached[:8]:
        state = "you deleted this" if rel in declined else "you have edited this" if rel in edited else "pristine"
        item(f"{rel}  ({state})")
    if len(reached) > 8:
        detail(f"… and {len(reached) - 8} more")

    for rel in reached[:3]:
        before = (was[rel].read_text(encoding="utf-8", errors="replace").splitlines()) if rel in was else []
        after = (head_files[rel].read_text(encoding="utf-8", errors="replace").splitlines()) if rel in head_files else []
        changed = [(old, new) for old, new in zip(before, after) if old != new]
        # Line-for-line, so this only speaks when the render substituted in
        # place. A value that changes the SHAPE of a file shifts every line
        # after it and there is no honest pair to print, so nothing is printed
        # rather than a hundred spurious ones.
        if changed and len(before) == len(after):
            detail()
            detail(f"{rel} — what the value does, since you are the only check on whether it is right:")
            for old, new in changed[:4]:
                item(f"- {old.strip()}")
                item(f"+ {new.strip()}")
            if len(changed) > 4:
                detail(f"… and {len(changed) - 4} more changed line(s)")

    detail()
    detail("A value that REDUCES what this does is the dangerous one and it is invisible from")
    detail("here: the rendered file stays well-formed and the manifest agrees with it, so both")
    detail("artefacts anybody would check look correct. Read the lines above rather than the")
    detail("exit code.")

    if declined and len(declined) == len(reached):
        detail()
        say("⚠️ ", "every file this argument reaches is one you deleted — nothing will change on disk")
        detail("A declined file is never restored, so this run touches no file at all. The RECORD")
        detail("still moves: the new value is what future renders of that file would use, which")
        detail("matters if you ever take it back. Nothing else in this tree is affected.")
    elif edited:
        detail()
        say("⚠️ ", f"{len(edited)} reached file(s) are ones you have edited — they may conflict")
        detail("The values are recorded only if this run applies EVERYTHING. One conflict here")
        detail("holds the manifest back and the argument stays at its old value, with the rest of")
        detail("this report reading like an ordinary success.")


def join_set_arg(argv: List[str]) -> List[str]:
    """`--set-arg --base-branch=develop` — the spelling everybody reaches for.

    argparse reads the next token as a new option because it starts with `--`,
    and dies on *expected one argument* naming the flag rather than the problem.
    The escapes are `--set-arg=--base-branch=develop` or dropping the dashes,
    and neither is discoverable from the error.

    **Every branch-shaped argument has this problem**, because the thing being
    named is itself a flag: `--base-branch`, `--release-branch`, `--python-ceiling`
    and `--line-length` are exactly what an adopter reaches for. mind.head hit
    it moving to a `develop`/`main` split, which is the change most likely to
    need this verb at all.

    Joining it here rather than documenting the escape, because a workaround in
    a help string is a rule somebody has to have read. `set_args` already strips
    leading dashes off the name, so all three spellings converge on one path.

    Only ever joins a token that contains `=`. `--set-arg --dry-run` stays two
    arguments and still fails, which is right — that is a missing value, not
    this shape, and silently swallowing the next flag would be worse than the
    error it replaced.
    """
    joined: List[str] = []
    pending = False
    for token in argv:
        if pending and token.startswith("--") and "=" in token:
            joined[-1] = f"{joined[-1]}={token}"
            pending = False
            continue
        pending = token == "--set-arg"
        joined.append(token)
    return joined


#: Arguments `--set-arg` refuses, because they rename a **path** rather than
#: change a value inside one.
#:
#: Everything this tool does is "render the base, render ours, merge them file by
#: file", and that is exactly the wrong instrument for a rename: the head render
#: puts the file under its new name, so it arrives as a *new* file while the old
#: one is reported as no longer shipped and — correctly, since this tool never
#: deletes — left exactly where it is. The result is both, which for
#: `--shell-package` is a tree whose own `scripts/paths.py` refuses to say which
#: directory is the shell.
#:
#: The predicate is not "flags somebody thought of", and sky.boss put it better
#: than the mechanical version did: **`--set-arg` is safe for an argument whose
#: effect is WITHIN files, and unsafe for one whose effect is the SET OF PATHS.**
#: That is a property of the argument rather than a list of two, and it is what a
#: future flag will trip over by looking harmless — the operational test is
#: whether `copy_overlay` in `bin/skeletor-new` consumes the value as a
#: destination name.
#:
#: `bin/skeletor-verify`'s `shell_package_gate` asserts each entry is still
#: refused and still recorded by a scaffold, so one that stopped renaming
#: anything fails rather than sitting here as a decision nobody re-made.
RENAMES_A_PATH = {"--shell-package", "--cli"}


def set_args(recorded: List[str], args) -> Tuple[List[str], Dict[str, Tuple[str, str]]]:
    """The arguments the HEAD render uses, with `--set-arg` applied.

    ## The gap

    A scaffolded tree scaffolds **once**. Every argument it will ever record is
    fixed at that moment, so a flag the template gains later is unreachable to
    it: `ci.yml`'s own comment offered a second matrix leg as *"a scaffold
    argument rather than a workflow edit"*, and for all six existing adopters
    that described a door which closed before the feature existed. node-zero
    measured it; sky.boss arrived at the same place from a tree whose matrix
    has been two legs since before the flag was written and whose record
    therefore says one. The two routes without this were hand-editing a file
    whose header says not to, or editing the workflow — the very thing the
    comment offers as the alternative you are being spared, and which becomes
    a standing three-way-merge conflict on every future upgrade.

    ## Why it moves the HEAD render and not the base

    The first design amended the **record**, re-derived every hash from a
    re-render at the recorded ref, and asserted *this tree was rendered as
    though the flag had this value*. Built, and it refused the first honest
    case it was given: a pristine `ci.yml`, a real change to `--python-ceiling`,
    and the amended render correctly did not match the disk — **because the
    tree genuinely was not rendered with that value.** The refusal was right and
    it made the verb useless: an amendment that changes nothing is accepted, and
    one that changes something cannot be.

    The record was never the wrong thing. `--python-ceiling 3.12` is the honest
    account of how that tree was made, and rewriting it would be deleting the
    only true statement in the file. What an adopter wants is not a corrected
    past, it is a **different future** — and this tool already has a mechanism
    for delivering one: render the base from the recorded arguments, render
    ours from the new ones, three-way merge. A new argument is a template change
    that happens to originate with the adopter rather than with the template.

    So this is a one-line transformation of the head render's arguments, and
    every guarantee downstream is untouched. The base still reproduces the tree
    byte-for-byte, so `cross_check` still refuses a manifest that disagrees. A
    file you edited still merges or conflicts. A file you declined stays
    declined — which is sky.boss's case, and it needs no special handling at
    all. The manifest records the new arguments only where it already records
    the new render: on a run that applied everything, never on one that left a
    conflict.

    proto.pilot's re-base hazard evaporates with the design rather than being
    guarded against: **nothing moves the base, so no file's next merge is
    computed against a base it never had.** Their naming point stands and is
    why this is `--set-arg` and not `--amend-record`: it does set an argument
    for this run, which was the misleading reading of the first design and is
    the literal truth of this one.
    """
    updated = list(recorded)
    applied: Dict[str, Tuple[str, str]] = {}
    for raw in args.set_arg:
        if "=" not in raw:
            die(f"--set-arg takes flag=value, got {raw!r}")
        flag, value = raw.split("=", 1)
        flag = "--" + flag.lstrip("-")
        if flag in RENAMES_A_PATH:
            die(
                f"{flag} cannot be set on an upgrade.\n"
                "   This tool is safe for an argument whose effect is WITHIN files and unsafe for one\n"
                "   whose effect is the SET OF PATHS. It renders two trees and merges them file by\n"
                "   file, so a rename arrives as new files under the new name while the old ones are\n"
                "   reported as no longer shipped and left where they are — this tool never deletes.\n"
                "   You get both, and for --shell-package that is a tree whose own scripts/paths.py\n"
                "   then refuses to say which directory is the shell.\n"
                "   Two routes, and they are NOT equivalent — the difference is what the tree is\n"
                "   afterwards, and the earlier version of this message presented them as a pair.\n"
                "   `git mv` and leave the record alone: every recorded entry under the old name\n"
                "   becomes absent-from-tree, which this tool reads as a deliberate deletion and\n"
                "   never restores. The renamed files stop receiving template updates for good,\n"
                "   and nothing under the new name is recorded either, so neither side is tracked.\n"
                "   The run afterwards still says `already current`, correctly — current and\n"
                "   receiving updates are different facts and only one of them is on screen.\n"
                "   Re-scaffolding with the new value keeps the tree a full adopter. Reported by\n"
                "   node-zero, who took the first route on a throwaway clone and measured it.\n"
                "   A three-way merge is for a value inside a file; a name is what git is for."
            )
        if flag not in updated:
            die(
                f"{flag} is not among this tree's recorded arguments, so there is nothing to change.\n"
                f"   Recorded: {' '.join(sorted(a for a in updated if a.startswith('--')))}\n"
                "   A flag the record does not carry arrives by upgrading to a template that ships it."
            )
        index = updated.index(flag) + 1
        applied[flag] = (updated[index], value)
        updated[index] = value
    return updated, applied


#: How to run a formatter over one file, keyed by the hook id a tree declares in#: How to run a formatter over one file, keyed by the hook id a tree declares in
#: `.pre-commit-config.yaml`. Not a policy list and not an allowlist — it is a
#: capability map, and there is nothing to derive it from: knowing that `isort`
#: takes `--settings-path` and `black` takes `--config` is not a fact any
#: repository states about itself. A hook that is not here is reported by name
#: rather than ignored, so an adopter who swapped their formatter learns that
#: their files are not being normalised instead of assuming they are.
#:
#: `--config`/`--settings-path` is what keeps this out of the tree: the file
#: being formatted lives in a scratch directory, so a dry run writes nothing
#: into somebody's repository, and the tool still reads their settings rather
#: than inventing defaults.
FORMATTERS = {
    "isort": lambda exe, cfg, path: [exe, "--settings-path", str(cfg), str(path)],
    "black": lambda exe, cfg, path: [exe, "--config", str(cfg), "--quiet", str(path)],
    "ruff-format": lambda exe, cfg, path: [exe, "format", "--config", str(cfg), str(path)],
    "ruff": lambda exe, cfg, path: [exe, "check", "--fix", "--config", str(cfg), str(path)],
}

#: Where each tool's settings live, in preference order. A tree that has none of
#: them for a declared hook is one this cannot normalise, and says so.
CONFIG_FILES = {
    "isort": (".isort.cfg", "setup.cfg", "pyproject.toml"),
    "black": ("pyproject.toml",),
    "ruff-format": ("ruff.toml", ".ruff.toml", "pyproject.toml"),
    "ruff": ("ruff.toml", ".ruff.toml", "pyproject.toml"),
}


class Normaliser:
    """The adopter's own formatters, applied to the two sides skeletor renders.

    **A formatter is a second author with commit rights and no changelog.**
    mind.head's only conflict taking `v0.9.0` was a single blank line between
    two imports, written by `ruff check --fix` during adoption — never decided,
    never noticed, and adjacent to the line the template then rewrote. Measured
    both ways in that tree and reproduced here: the merge as shipped conflicts,
    and the merge with both *rendered* sides run through their formatter is
    clean and correct.

    What it does is narrower than it sounds, and the narrowness is what makes it
    safe. It touches **merge inputs only** — never a hash, never the manifest.
    `cross_check` and the `--no-base` fallback both compare `sha256` of the raw
    render, so neither can disagree with a normalised merge, because neither
    sees one. That was the second of two reasons this was held back, and it
    dissolves once the scope is stated: a normalised *render* is not a
    normalised *record*.

    The first reason was that running a command out of the target tree is a new
    trust boundary, and that was simply wrong — the upgrade already runs the
    target's own `scripts/docs/regen.py` as a subprocess. The boundary was
    crossed before this existed, and this crosses it more narrowly: not an
    arbitrary command string, but the hooks that tree already declares.

    Opt-in via `--normalise`, and advertised rather than silent: a plain run that
    conflicts re-tries those files normalised, and says so when it would have
    worked. An opt-in flag nobody hears about is a feature that never runs, and
    the counterfactual costs one formatter pass over the conflicted set.
    """

    def __init__(self, target: Path, workdir: Path) -> None:
        self.workdir = workdir
        self.steps: List[Tuple[str, str, Path]] = []
        self.unsupported: List[str] = []
        self.reason = ""
        config = target / ".pre-commit-config.yaml"
        if not config.exists():
            self.reason = "the tree declares no .pre-commit-config.yaml"
            return
        declared = re.findall(r"^\s*-?\s*id:\s*([\w.-]+)", config.read_text(encoding="utf-8"), re.MULTILINE)
        for hook in dict.fromkeys(declared):
            if hook not in FORMATTERS:
                continue
            exe = self._executable(target, hook.split("-")[0])
            settings = next((target / name for name in CONFIG_FILES[hook] if (target / name).exists()), None)
            if exe and settings:
                self.steps.append((hook, exe, settings))
            else:
                self.unsupported.append(f"{hook} ({'no config' if exe else 'not installed'})")
        if not self.steps and not self.reason:
            self.reason = "no formatter the tree declares is runnable here"

    @staticmethod
    def _executable(target: Path, name: str) -> Optional[str]:
        local = target / ".venv" / "bin" / name
        if local.exists():
            return str(local)
        return shutil.which(name)

    def __bool__(self) -> bool:
        return bool(self.steps)

    def applies(self, rel: str) -> bool:
        return rel.endswith(".py")

    def __call__(self, text: str, rel: str) -> str:
        """The text a formatter would leave. Unchanged if anything goes wrong.

        Failing closed matters more here than reporting: a normalisation that
        half-ran would put one side of a three-way merge through a tool the
        other side never saw, which manufactures exactly the divergence this
        exists to remove.
        """
        if not self.applies(rel):
            return text
        scratch = self.workdir / "normalise" / rel
        scratch.parent.mkdir(parents=True, exist_ok=True)
        scratch.write_text(text, encoding="utf-8")
        for _hook, exe, settings in self.steps:
            command = FORMATTERS[_hook](exe, settings, scratch)
            if subprocess.run(command, capture_output=True).returncode not in (0, 1):
                return text
        return scratch.read_text(encoding="utf-8")


def read(path: Optional[Path]) -> Optional[str]:
    if path is None or not path.exists():
        return None
    try:
        return path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        return None  # binary: compared by bytes below, never merged


def merge(base: str, theirs: str, ours: str, workdir: Path) -> Optional[str]:
    """Three-way merge, or `None` if it conflicts. Markers are never returned."""
    paths = {}
    for name, text in (("base", base), ("theirs", theirs), ("ours", ours)):
        paths[name] = workdir / f"merge-{name}"
        paths[name].write_text(text, encoding="utf-8")
    result = subprocess.run(
        ["git", "merge-file", "-p", "--quiet", str(paths["theirs"]), str(paths["base"]), str(paths["ours"])],
        capture_output=True,
        text=True,
    )
    # Exit code is the number of conflicts, or negative on error.
    return result.stdout if result.returncode == 0 else None


def unified(base: str, ours: str, rel: str) -> str:
    import difflib

    return "".join(
        difflib.unified_diff(
            base.splitlines(keepends=True),
            ours.splitlines(keepends=True),
            fromfile=f"a/{rel} (template, as you scaffolded it)",
            tofile=f"b/{rel} (template, today)",
        )
    )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("target", help="the scaffolded tree to upgrade")
    parser.add_argument("--dry-run", action="store_true", help="report what would change, write nothing")
    parser.add_argument("--from-dir", help="use this skeletor checkout as the base instead of the recorded ref")
    parser.add_argument(
        "--no-base",
        action="store_true",
        help="skip the base render: classify from the recorded hashes alone. Answers "
        "'what have I edited?' without git, but cannot merge.",
    )
    parser.add_argument(
        "--allow-dirty",
        action="store_true",
        help="upgrade into a tree with uncommitted changes. The result will be interleaved "
        "with your work in `git diff`, and reverting it discards both.",
    )
    parser.add_argument(
        "--normalise",
        action="store_true",
        help="run the tree's own formatters over both rendered sides before merging",
    )
    parser.add_argument("--json", action="store_true", help="the machine-readable result on stdout")
    parser.add_argument(
        "--repair-manifest",
        action="store_true",
        help="rewrite the manifest's `files` map from the base render, then stop. "
        "For a manifest written by a version of skeletor that recorded the wrong thing.",
    )
    parser.add_argument(
        "--set-arg",
        action="append",
        default=[],
        metavar="FLAG=VALUE",
        help="change a `skeletor-new` argument for THIS upgrade's render, and carry the "
        "difference in as a template change. Repeatable. For a flag the template gained "
        "after this tree was scaffolded — a tree scaffolds once, so there is no other way "
        "to reach one. The base still renders from the recorded arguments, so nothing about "
        "how the tree was made is rewritten; the new value is recorded only if the run applies "
        "cleanly, exactly like any other upgrade.",
    )
    parser.add_argument(
        "--ported",
        action="store_true",
        help="assert every conflict and collision is resolved as you want it, and advance "
        "the recorded base to this skeletor. Without it, a run that leaves anything "
        "pending holds the base where it is. Safe on the dirty tree hand-porting leaves, "
        "and not refused on one: a conflicted file is never written, so this moves the "
        "record and not your bytes.",
    )
    args = parser.parse_args(join_set_arg(sys.argv[1:]))

    target = Path(args.target).expanduser().resolve()
    if not target.is_dir():
        die(f"{target} is not a directory")

    if not (args.dry_run or args.repair_manifest or args.allow_dirty):
        refuse_a_dirty_tree(target, ported=args.ported)

    pre_upgrade = head_commit(target)
    # This one before a single byte is written, or it answers about the upgrade's
    # own output rather than about work that was already here.
    interleaved = bool(args.allow_dirty and uncommitted(target))

    manifest = read_manifest(target)
    recorded = manifest.get("args") or []
    ref = manifest.get("skeletor_ref") or ""
    if not recorded:
        die(f"{target / MANIFEST_NAME} records no arguments — it cannot be re-rendered")

    hashes: Dict[str, str] = manifest.get("files") or {}

    workdir = Path(tempfile.mkdtemp(prefix="skeletor-upgrade-"))
    cleanup_worktree: Optional[Path] = None
    try:
        base_src: Optional[Path] = None
        scaffolded_dirty = False
        if args.no_base and args.set_arg:
            # `--no-base` classifies from recorded hashes and never merges, so
            # it can report that a file changed and cannot deliver the change.
            # A new argument is only ever delivered by a merge.
            die("--set-arg needs a base render to merge against; drop --no-base")
        if args.set_arg and args.repair_manifest:
            die("--repair-manifest re-derives from the RECORDED arguments; --set-arg changes the new ones")
        if args.no_base and args.repair_manifest:
            # The correct hashes ARE the base render's. Without one there is
            # nothing to derive them from, and the alternative — keeping what is
            # there and calling it repaired — is the only outcome worse than
            # refusing, since it would look like the manifest had been checked.
            die("--repair-manifest needs the base render it repairs from; drop --no-base")
        if args.no_base:
            if not hashes:
                die("--no-base needs the `files` hashes, and this manifest has none")
            say("⏸️ ", "no base render — classifying from the recorded hashes, and not merging")
        elif args.from_dir:
            base_src = Path(args.from_dir).expanduser().resolve()
            if args.dry_run:
                warn_a_dirty_base(base_src, "base checkout")
            else:
                refuse_a_dirty_base(
                    base_src, "--repair-manifest" if args.repair_manifest else "The upgrade", "base checkout"
                )
            say("→", f"base: {base_src}")
        elif not ref:
            die(f"{MANIFEST_NAME} records no skeletor_ref — pass --from-dir or --no-base")
        else:
            scaffolded_dirty = ref.endswith("-dirty")
            reachable, cleanup_worktree, ref = base_checkout(ref, workdir, fatal=not hashes)
            if reachable is None:
                # The history is gone, but the hashes can still say what is
                # untouched. Degraded on purpose, and it says so.
                say("⚠️ ", f"skeletor has no reachable '{ref}' — falling back to the recorded hashes")
                detail("Files you never touched are still updated. Files that differ cannot be")
                detail("merged without the base text, so they are reported and left alone.")
                args.no_base = True
            else:
                base_src = reachable
                say("→", f"base: skeletor @ {ref}")

        head_tree = workdir / "head"
        # `ours` is rendered from the LIVE checkout, not from a committed ref —
        # which is the point, since an upgrade exists to carry today's template
        # in. But that makes a dirty skeletor a source of exactly the defect
        # `--from-dir` has refused since 5230a7c, on the path everybody actually
        # uses: uncommitted template edits get written into somebody's tree, and
        # the manifest records `vX.Y.Z-dirty`, naming a render nobody can
        # resolve. The next upgrade of that tree then renders its base from the
        # committed part and reports the difference as template changes.
        #
        # Found by the gate written to pin a *different* corrected claim: it
        # scaffolded dirty, upgraded, and got `-dirty` back — refreshed, and
        # still unresolvable, because verify runs from a working checkout.
        if args.dry_run:
            warn_a_dirty_base(SKELETOR, "checkout this renders from")
        else:
            refuse_a_dirty_base(SKELETOR, "The upgrade", "checkout this renders from")
        # **The head render, and the only place `--set-arg` reaches.** The base
        # above rendered from `recorded` and must keep doing so: it is the
        # statement of how this tree was actually made, and every classification
        # in this tool is a comparison against it.
        ours_args, set_args_applied = set_args(recorded, args)
        if set_args_applied:
            say("→", f"{len(set_args_applied)} argument(s) changed for this render")
            for flag, (was, now) in sorted(set_args_applied.items()):
                item(f"{flag}  {was!r} → {now!r}")
            detail("The base still renders from the recorded values, so this arrives as an ordinary")
            detail("template change: a file you never touched is replaced, one you edited merges or")
            detail("conflicts, one you declined stays declined. The new values are recorded only if")
            detail("this run applies everything — the same rule as the ref.")
        render_with(SKELETOR, ours_args, head_tree)
        head_files = files_under(head_tree)
        if set_args_applied:
            report_reach(SKELETOR, recorded, workdir, target, hashes, head_files, set_args_applied)
        # The version this run is comparing the tree against, read out of the
        # render rather than asked of git a second time — it is the value that
        # would be recorded if this run applied anything, so there is one source
        # for "what is skeletor now" and the report cannot disagree with the
        # manifest it writes.
        head_ref = (
            json.loads((head_tree / MANIFEST_NAME).read_text(encoding="utf-8")).get("skeletor_ref") or "?"
        )

        # Where the render's own source stands, said plainly, because until now
        # this report answered "is it dirty" and nothing else — and committing
        # the work is enough to satisfy that question while changing nothing
        # about whether an adopter can reach what they are being handed.
        # stash.flow's two runs had identical plans, row for row, and only the
        # first carried a caveat.
        past_tag, unpushed, tracking = head_standing(SKELETOR)
        # BOTH facts on this line, and the split is the one drawn a paragraph
        # below: the `⚠️` is a judgement and belongs where the act is, the
        # facts are not and belong where the decision is made. A dry run is
        # what a peer session reads; the writing path is read by somebody who
        # has already chosen. stash.flow asked for the second clause after
        # taking the first — the position line said `2 past the last release
        # tag`, which has an acceptable policy behind it, and stayed silent on
        # `2 not on origin/main`, which by this tool's own argument has none.
        notes = []
        if past_tag:
            notes.append(f"{past_tag} past the last release tag")
        if tracking is None:
            notes.append("no upstream")
        elif unpushed:
            notes.append(f"{unpushed} not on {tracking}")
        standing = f"head: skeletor @ {head_ref}" + (f" ({', '.join(notes)})" if notes else "")
        say("→", standing)
        # The ⚠️ is on the writing path alone, and the split is the same one
        # `warn_a_dirty_base`/`refuse_a_dirty_base` already make: a dry run
        # reports, and stamping somebody's manifest is the act. Warning on every
        # dry run would fire through this repository's own grid, where an
        # unpushed HEAD is the ordinary state between a commit and a push —
        # which is how a true warning becomes one nobody reads.
        if not args.dry_run:
            if tracking is None:
                # `None` means *I cannot count*, and this said *nothing is
                # reachable* — a larger claim than the measurement supports, and
                # false in the case it fires hardest on. A detached clone at a
                # pushed tag tracks no branch BY CONSTRUCTION, and that clone is
                # exactly what `refuse_a_dirty_base` tells an adopter to make.
                # stash.flow took v0.15.0 that way, from a public tag, and was
                # told their manifest named a commit only their machine had.
                #
                # The honest sentence, not a network call: `git ls-remote` would
                # answer it and costs a round trip on every run to correct a line
                # the reader can check in one command. Third instance from this
                # seam of a predicate that is right about what it measures wired
                # to prose that claims more — and all three were the sentence.
                #
                # The command names the **commit**, and the first version named
                # `head_ref`, which is wrong in three ways at once and node-zero
                # and proto.pilot each found it independently. `git ls-remote
                # origin v0.16.0` answers with the *annotated tag object*
                # (`96c2ccf`), never the commit the manifest records
                # (`b8c337b`) — so a reader who runs it compares two shas that
                # are not meant to match and concludes the tag was never
                # pushed. A dirty or offset describe (`v0.16.0-dirty`,
                # `v0.16.0-2-gabc1234`) is not a ref at all and matches
                # nothing, which reads as the same wrong answer. A sha matches
                # the peeled `^{}` line, and it is what `base_checkout()`
                # actually resolves.
                #
                # Still a tip check rather than a reachability one, and the
                # sentence says `identified by` for that reason: a commit in the
                # middle of a pushed branch is reachable and appears in no row.
                # A false negative here is the safe direction — it under-claims,
                # which is the failure mode this whole block exists to correct.
                sha = subprocess.run(
                    ["git", "-C", str(SKELETOR), "rev-parse", "HEAD"],
                    capture_output=True,
                    text=True,
                ).stdout.strip()
                say("⚠️ ", f"this checkout tracks no branch — whether {head_ref} is reachable")
                detail("elsewhere cannot be determined from here. If it is a pushed tag, it is fine;")
                detail(f"`git ls-remote origin | grep {sha[:12] or head_ref}` is the check this")
                detail("declines to make for you — a row means some pushed ref identifies it.")
            elif unpushed:
                say("⚠️ ", f"{unpushed} commit(s) here are not on {tracking} — stamping {head_ref} anyway")
                detail("`base_checkout()` resolves a recorded ref with `git worktree add`, so until")
                detail("these are pushed the base this records is reproducible on this machine only.")
                detail("An amend or a rebase makes it unreproducible everywhere.")

        base_files: Dict[str, Path] = {}
        if base_src is not None:
            base_tree = workdir / "base"
            render_with(base_src, recorded, base_tree)
            base_files = files_under(base_tree)
            if args.repair_manifest:
                return repair_manifest(target, manifest, base_files, args)

            if hashes:
                drift = cross_check(base_files, hashes)
                if drift:
                    say("❌", f"{MANIFEST_NAME} disagrees with the base it names ({len(drift)} file(s)):")
                    for entry in drift[:20]:
                        item(entry)
                    if len(drift) > 20:
                        detail(f"… and {len(drift) - 20} more")
                    detail()
                    detail("The recorded hashes are the fallback used when history is unreachable,")
                    detail("so a manifest that cannot describe its own base would silently classify")
                    detail("an edited file as untouched. Refusing rather than guessing.")
                    detail()
                    if args.from_dir and ref:
                        # The likeliest cause here is not a stale manifest at
                        # all: --from-dir overrides the base, so naming a
                        # checkout that is not this tree's ref makes every
                        # entry disagree by construction. Recommending
                        # --repair-manifest in that state is actively harmful —
                        # it would write hashes of the wrong base while leaving
                        # `skeletor_ref` naming the right one, so the two halves
                        # of the manifest would describe different skeletors and
                        # only --no-base would ever act on the lie.
                        detail(f"--from-dir overrode the base, and this tree records {ref}.")
                        detail("If that checkout is not at that ref, the base is wrong rather than the")
                        detail("manifest — drop --from-dir and let the recorded ref be resolved.")
                        detail("Do NOT --repair-manifest to silence this: it rewrites the hashes from")
                        detail("whatever base you named and leaves the ref alone.")
                    else:
                        detail("If the manifest was written by an older skeletor rather than edited by")
                        detail("hand, --repair-manifest rewrites it from this base render.")
                    # The full list on stdout when something is parsing this. A
                    # consumer that reads the truncated human list sees a fifth
                    # of the problem and believes it has all of it.
                    if args.json:
                        print(json.dumps({"ok": False, "error": "manifest-drift", "drift": drift}, indent=2))
                    return 1
                if scaffolded_dirty:
                    # The dirty-scaffold warning above is unconditional, because
                    # it is printed before anything can know better. Here we know
                    # better, and it is worth saying, because that warning tells
                    # a reader their conflict count may be partly an artefact and
                    # gives them no way to size it.
                    #
                    # A pass here settles it. `cross_check` is a bijection with
                    # equal hashes in both directions, so it holds exactly when
                    # the base render reproduces what was scaffolded, file for
                    # file — an uncommitted edit that changed a shipped file
                    # would move a hash, one that added a file would be recorded
                    # and unrendered, one that removed a file would be rendered
                    # and unrecorded. All three are refusals above. What is left
                    # is an uncommitted edit to something the scaffold does not
                    # ship, which by definition changes no classification below.
                    #
                    # So the number is real. This is the only run that can say
                    # so: in the `--no-base` fallback the hashes came from the
                    # dirty render and there is nothing to check them against.
                    say("✅", "…and the manifest matches that base exactly, so those edits touched")
                    detail("no file this scaffold ships. Nothing below is an artefact of them.")

        added, updated, merged, conflicted, collided, declined, dropped = [], [], [], [], [], [], []
        #: Conflicts that a run of the tree's own formatters over both rendered
        #: sides would have resolved. Reported, never acted on without the flag.
        formatting_only: List[str] = []
        #: What `render_dirt` found in the checkout that renders `ours` — the
        #: same predicate the warning and the refusal use, published so a
        #: machine consumer is not left reading `-dirty` off a version string.
        renderer_dirt = render_dirt(SKELETOR)
        #: The actionable half of `declined`, set inside its report block below
        #: and read by the currency test after it. Empty is the honest default:
        #: with no declines there is nothing the template can have changed.
        fresh: List[str] = []
        normaliser = Normaliser(target, workdir)
        if args.normalise and not normaliser:
            die(f"--normalise: {normaliser.reason}")
        if args.normalise and args.no_base:
            # Silence here would be the flag's own failure mode: a run that
            # normalises nothing looks exactly like a run whose normalisation
            # found nothing to do. There is no base TEXT in this mode, only
            # recorded hashes, and a hash of the raw render is what those are.
            say("⚠️ ", "--normalise needs the base render's text, which --no-base does not have")
            detail("Classification here is by recorded hash, so nothing was normalised.")
        patches = target / "tmp" / "upgrade"
        # A dry run writes nothing, `tmp/upgrade/` included — so it must not be
        # allowed to imply otherwise. It reads what is there instead, and says
        # whose plan it is; the real run makes the directory true by clearing it.
        stale = sidecars(patches) if args.dry_run else []
        cleared = 0 if args.dry_run else clear_sidecars(patches)

        # **Measured against the base that will be in force when this is read.**
        #
        # `sha256` of what is on disk against the hash of what skeletor
        # produced. An entry means skeletor wrote the file here, so a different
        # hash means somebody has edited it — the same comparison the fallback
        # path already makes, asked about the whole tree instead of one file.
        #
        # Which render to compare against is the whole question, and getting it
        # wrong is not a rounding error: it is a heading that says *you decided
        # this* over files the tool itself wrote. Against the RECORDED base this
        # is right for a dry run and for a run that holds the manifest back,
        # because that base is still the tree's. It is wrong for a run that
        # advances, and wrong in the worst direction for the flow this tool
        # documents: run once, port the conflicts by hand, re-run `--ported`.
        # Everything the first run applied still differs from the base the
        # second run has not yet replaced, so it is listed as the reader's own
        # divergence — node-zero measured 15 named, 11 of them the previous
        # run's output; dream.doll saw the same list evaporate on the next dry
        # run, which is the tell that it was never standing state.
        #
        # So it is computed twice, from one function, and the second call is
        # made only where the answer changes. See `advanced` below.
        diverged = standing_divergence(target, hashes or {})

        for rel in sorted(set(base_files) | set(head_files)):
            if rel in GENERATED or rel == MANIFEST_NAME:
                continue
            ours = read(head_files.get(rel))
            base = read(base_files.get(rel))
            live_path = target / rel
            theirs = read(live_path) if live_path.exists() else None

            if ours is None:
                # The template stopped shipping it. Never delete somebody's file.
                if live_path.exists():
                    dropped.append(rel)
                continue

            if theirs is None:
                # Absent from the tree — but there are two ways to be absent, and
                # they want opposite handling. The manifest tells them apart with
                # no new bookkeeping: an entry means skeletor WROTE this file
                # here, so its absence now is a deletion somebody performed on
                # purpose. No entry means the template has only just started
                # shipping it, and adding it is the whole point of an upgrade.
                #
                # Restoring both was the same mistake as overwriting an edit,
                # wearing a friendlier symbol: a partial adoption — take the
                # rules, drop Release Please — had every declined file returned
                # on every upgrade, reported as a green "new file added" and
                # written without asking. A decision that has to be re-made on a
                # schedule is not a decision, and one auto-reverted with a tick
                # beside it is worse than a conflict, which at least stops.
                #
                # The tree's own state is the record. A list of declines in the
                # manifest would be a second home for a fact the filesystem
                # already states, and would go stale the moment somebody changed
                # their mind by restoring the file.
                if hashes and rel in hashes:
                    declined.append(rel)
                    # Only worth a sidecar if there is something new to look at:
                    # the template has moved since they declined it. Unchanged,
                    # they already saw this file and said no.
                    # `.get`, matching the report below: the two are the same
                    # question and a subscript here would make them disagree if
                    # the guard above ever loosened.
                    if sha256(head_files[rel]) != hashes.get(rel) and not args.dry_run:
                        sidecar = patches / f"{rel}.new"
                        sidecar.parent.mkdir(parents=True, exist_ok=True)
                        shutil.copy2(head_files[rel], sidecar)
                    continue
                added.append(rel)
                if not args.dry_run:
                    live_path.parent.mkdir(parents=True, exist_ok=True)
                    shutil.copy2(head_files[rel], live_path)
                continue

            if base is None:
                # No base text for this file — either it is absent from the base
                # render, or there is no base render at all. Fall back to the
                # recorded hash, which answers "untouched?" and nothing else.
                recorded_hash = hashes.get(rel)
                if recorded_hash is None:
                    # Never recorded, so skeletor never wrote it: the user had a
                    # file here before the template claimed the path. Handled the
                    # same as a conflict and named differently, because the name
                    # is what the reader acts on. "You edited this" sends them to
                    # `git log` for a change they never made; the truth sends them
                    # to the question that is actually in front of them, which is
                    # whether two files written for the same purpose should now be
                    # one — a choice between implementations, not a hunk to port.
                    # The manifest draws the line exactly: an entry with a
                    # different hash is an edit, no entry at all is a collision.
                    if theirs != ours:
                        collided.append(rel)
                        if not args.dry_run:
                            sidecar = patches / f"{rel}.new"
                            sidecar.parent.mkdir(parents=True, exist_ok=True)
                            sidecar.write_text(ours, encoding="utf-8")
                    continue

                # The recorded hash is the hash of the OLD RENDER, so it answers
                # both halves of the matrix — not just "did the user touch it".
                #
                # Which is why `edited` is a variable name and not a sentence.
                # It means "differs from what skeletor rendered", and the user
                # is the usual author of that difference but not the only one:
                # `register_shipped_docs` and `regen.py` read the tree they
                # write into, so on a `--force` adoption they see the user's own
                # docs and plans, while the manifest records
                # `pristine_post_copy()`'s render, which by construction cannot.
                # Those files then differ for a reason nobody hand-typed. The
                # handling is right either way — a merge preserves the row the
                # step exists to add, and recording the target's hash instead
                # would read as "template moved, user untouched" and drop it
                # silently — so what was wrong was only ever the report saying
                # "you edited this" to somebody who did not.
                #
                # Measured, at `agentic`, into a tree holding one doc and one
                # plan: `.github/DOCS_INDEX.md`, `docs/TODO/README.md` and
                # `docs/todo_index.json` all diverge, and an empty target
                # diverges on nothing — 135/135 hashes match. The count is one
                # per post-copy generator that finds pre-existing content, so it
                # is a property of the adopter's tree rather than of this tool.
                #
                # Not auto-classified, because the honest predicate does not
                # exist here: the three files carry three different generated
                # markers and `.github/DOCS_INDEX.md` carries none at all, so a
                # banner scan would quietly find the convenient subset. Naming
                # the paths would be the list Rule 2 forbids — it goes stale the
                # next time `regen.py` learns to emit an index, and silently.
                # The label states what is provable and stops there.
                edited = sha256(live_path) != recorded_hash
                changed = sha256(head_files[rel]) != recorded_hash

                if not changed:
                    # The template did not move. Whatever the user did here is
                    # theirs, and there is nothing to carry over — reporting it
                    # would be noise on every single run.
                    continue
                if not edited:
                    # Proof, not a guess: an equal hash means the file IS the old
                    # render, so there is no edit here to lose.
                    updated.append(rel)
                    if not args.dry_run:
                        live_path.write_text(ours, encoding="utf-8")
                    continue
                conflicted.append(rel)
                if not args.dry_run:
                    sidecar = patches / f"{rel}.new"
                    sidecar.parent.mkdir(parents=True, exist_ok=True)
                    sidecar.write_text(ours, encoding="utf-8")
                continue

            if args.normalise and normaliser.applies(rel):
                # Both rendered sides, never the user's file. Theirs is the one
                # thing here nobody else authored, and reformatting it would be
                # this tool editing a file it was not asked to edit.
                base, ours = normaliser(base, rel), normaliser(ours, rel)

            edited = theirs != base
            changed = ours != base
            if not changed:
                continue
            if not edited:
                updated.append(rel)
                if not args.dry_run:
                    live_path.write_text(ours, encoding="utf-8")
                continue

            resolved = merge(base, theirs, ours, workdir)
            if resolved is None:
                conflicted.append(rel)
                # The counterfactual, computed only for a file that already
                # failed, so the cost is bounded by the thing that went wrong.
                # Without it `--normalise` is a flag whose existence is known to
                # the person who wrote it, and the population that needs it is
                # exactly the population that has never read the help text.
                if normaliser and not args.normalise and normaliser.applies(rel):
                    if merge(normaliser(base, rel), theirs, normaliser(ours, rel), workdir) is not None:
                        formatting_only.append(rel)
                if not args.dry_run:
                    patch = patches / f"{rel}.patch"
                    patch.parent.mkdir(parents=True, exist_ok=True)
                    patch.write_text(unified(base, ours, rel), encoding="utf-8")
            else:
                merged.append(rel)
                if not args.dry_run:
                    live_path.write_text(resolved, encoding="utf-8")

        for rel in sorted(set(base_files)):
            if rel in head_files or rel in GENERATED:
                continue
            if (target / rel).exists() and rel not in dropped:
                dropped.append(rel)

        # The generated docs are rebuilt, never merged.
        pending = conflicted + collided
        if not args.dry_run and (added or updated or merged):
            regen = target / "scripts" / "docs" / "regen.py"
            if regen.exists():
                subprocess.run([sys.executable, str(regen)], cwd=str(target), capture_output=True)

        # `advanced` is set by the write itself, a few lines down, and every
        # sentence in this run that claims the base moved reads it. It used to
        # be inferred from `args.ported` at the far end of the report, and the
        # deed and the claim were then gated on different conditions: the write
        # sat inside `(added or updated or merged)` above, and a conflict is in
        # none of those three. So an upgrade where **nothing applied and one
        # file conflicted** — the ordinary shape of a small upgrade, and the
        # shape this fleet had never had — printed "--ported already advanced
        # the base past them, so re-running will NOT regenerate these" while the
        # manifest sat untouched. Told not to re-run, which was the one action
        # that would have got the sidecars back; and the port unrecorded, so the
        # same conflict returns for ever.
        #
        # mind.head stated the general form after finding the same shape in a
        # gate that printed ❌ and exited 0: **a report and the deed it reports
        # must not be separated by a condition**, and when they are the failure
        # is always in the same direction, because the reporting path is the
        # cheap one to reach and the acting path is the guarded one. The remedy
        # is not a matching condition — that is the bug with a second copy — but
        # to let the acting path produce the message. The advance knows whether
        # it advanced; nothing outside it does.
        advanced = False
        # `set_args_applied` is the fourth reason to advance and it took a
        # measurement to find. The other three are all *something happened to a
        # file*, and `--set-arg` in a tree that has DECLINED every file the
        # argument reaches makes nothing happen to any file by construction —
        # nothing to add, update, merge, or leave pending. So the record could
        # not move, `--ported` could not move it either (it only chooses which
        # branch of an advance that never ran), and the verb was a silent no-op
        # in exactly the tree it was built for.
        #
        # sky.boss's rule, and this is sharper than the version they sent:
        # **a mechanism keyed to a file cannot serve the tree that opted out of
        # that file.** They diagnosed it as needing `--ported`; measured, it
        # needed nothing at all, because there was no advance for `--ported` to
        # qualify. Their two trees closed their own cases with `--ported` and
        # were right to — theirs CONFLICT on that file, which is pending, which
        # is an advance. A decline is the case with no occupant to notice it.
        #
        # Safe because "nothing pending" means the tree is reconciled with the
        # head render for every file it holds, and the manifest copied is that
        # render's — including the declined entries, which is how a decline
        # stays detectable.
        if not args.dry_run and (added or updated or merged or pending or set_args_applied):
            # The head render's manifest, verbatim — the hashes recorded are of
            # what skeletor PRODUCES, never of what is on disk. The difference
            # decides whether the next upgrade destroys work: a merged file is
            # neither the old render nor the new one, so hashing the tree would
            # record it as pristine and the next run would overwrite the merge.
            # Recording the render's hash makes it read as edited, which it is.
            #
            # **But not while anything is still pending.** The manifest is a
            # single-version snapshot — `cross_check` requires its hashes to be
            # exactly the render at `skeletor_ref` — and a run that applied some
            # files and refused others leaves a tree that is not at one version.
            # Copying the head manifest anyway records the head render's hash
            # for a file the head render never reached, so the next run takes
            # that change as already in the base, the base→ours diff no longer
            # contains it, and it is never offered again. Reported by
            # stash.flow, reproduced here: conflict on AGENTS.md, four other
            # files applied, ref advanced, and the second run said "already
            # current — nothing to carry over" for a change that had never been
            # made. Silent, permanent, and green.
            #
            # Holding the ref back is sound in the direction that matters. The
            # applied files now differ from their recorded hash, so the next run
            # reads them as edited and merges rather than replaces — and that
            # merge is clean, because theirs and ours already share exactly the
            # hunks that were applied. A superfluous merge is the cheap error
            # here; a lost template change is the expensive one.
            if pending and not args.ported:
                say("⏸️ ", f"{MANIFEST_NAME} left at {ref} — {len(pending)} file(s) still pending")
                detail("Advancing it would record the new render as this tree's base for files")
                detail("the new render never reached, and their changes would stop being offered.")
                detail("Port them from tmp/upgrade/, then re-run with --ported to advance the base.")
                detail("Not a plain re-run: a three-way merge cannot tell an applied hunk from an")
                detail("unapplied one, so a hand-ported file conflicts again and the base never")
                detail("moves. The dirty tree the porting leaves is expected and not refused.")
                if added or updated or merged:
                    # Conditional because this block is now reached with nothing
                    # applied — which is the case that carried the bug above —
                    # and a sentence about "the files that DID apply" is then a
                    # claim about an empty set, printed as reassurance.
                    detail("Until then the files that DID apply read as edited, which is what they are.")
                detail()
                detail("If your version of these IS the resolution — an adopter's file the")
                detail("template also ships, and you are not taking ours — say so with --ported")
                detail("and the base advances. That is an assertion nothing can check for you.")
                if set_args_applied:
                    # The contract fact `--set-arg` rests on, said at the moment
                    # it bites instead of only in a docstring. The new values
                    # ride the manifest, and the manifest is held back here — so
                    # a run that plans the change, applies most of it, and stops
                    # on one conflict leaves the record exactly as it was, while
                    # every line above it reads like progress. proto.pilot
                    # declined to bundle `--set-arg` with a conflicted merge for
                    # this reason and then verified the record afterwards;
                    # **an operator who does not check cannot tell a partial
                    # apply from a success**, which makes this the tool's
                    # sentence to say rather than theirs to know.
                    say("⚠️ ", f"the {len(set_args_applied)} --set-arg value(s) were NOT recorded")
                    for flag, (was, now) in sorted(set_args_applied.items()):
                        item(f"{flag}  still recorded as {was!r}, not {now!r}")
                    detail("They ride the manifest, and the manifest is held back above. Whatever")
                    detail("this run wrote into your tree is there; the RECORD still says the old")
                    detail("value, so the next upgrade renders the old base and offers the change")
                    detail("again. Resolve the conflicts, then re-run with the same --set-arg.")
            else:
                # `--ported` is the user asserting the tree is now at this
                # version: they took our change, or they took their own and mean
                # it. Either way the base is head from here.
                #
                # It has to be a flag rather than a default because nothing can
                # verify a hand-port. A three-way merge cannot tell "already
                # applied" from "never applied" — re-merging an applied hunk
                # conflicts exactly like an unapplied one — so the tool would be
                # guessing, and the wrong guess is the silent loss this whole
                # branch exists to stop. Named and listed, it is a decision;
                # inferred, it is the bug wearing a flag.
                if pending:
                    say("→", f"--ported: taking {len(pending)} unresolved file(s) on trust")
                    for rel in pending:
                        item(rel)
                    detail()
                    detail("The base advances to this skeletor. If any of these was NOT resolved,")
                    detail("its template change is now part of your base and will not be offered")
                    detail("again — that is what the flag asserts, and it cannot be undone by")
                    detail("re-running.")
                shutil.copy2(head_tree / MANIFEST_NAME, target / MANIFEST_NAME)
                advanced = True
                # The manifest just written is the head render's, so the head
                # render is what "skeletor wrote this" now means. Re-asking the
                # same question of the new base is what stops this run's own
                # output being reported back as the reader's edits: a file that
                # was replaced wholesale matches it and drops out, correctly,
                # because it was never edited; a file that was MERGED is neither
                # render and stays, correctly, because the adopter's hunks are
                # still in it. The old comment here argued the opposite — that a
                # post-write reading "under-counts on the runs that changed the
                # most" — which is true only if you take every applied file to
                # be a divergence, and an applied file is the opposite of one.
                diverged = standing_divergence(target, {rel: sha256(path) for rel, path in head_files.items()})

        # One call, two renderings. It was computed separately for the JSON and
        # for the human report — two call sites for one answer, which is the
        # duplication this repository refuses everywhere else, and it hid a
        # planted bug: the plant changed one site and the gate asserted on the
        # other.
        entangled = importers_of(conflicted + collided, added + updated + merged, head_files)

        if args.json:
            print(
                json.dumps(
                    {
                        "target": str(target),
                        "base_ref": ref,
                        # The version the tree is being compared *against*. A
                        # consumer reading an empty diff off `base_ref` alone has
                        # the same ambiguity the human line had: current with
                        # what?
                        "head_ref": head_ref,
                        # The other three rungs of the ladder `render_dirt`
                        # answers one of. `head_unpushed` is null when the
                        # checkout tracks nothing, which is not zero — see
                        # `head_standing`.
                        "head_past_tag": past_tag,
                        "head_unpushed": unpushed,
                        "head_upstream": tracking,
                        # The predicate, not a suffix inside a version string.
                        # `head_ref` is the render's stamped `git describe
                        # --tags --always --dirty`, so its `-dirty` answers *is
                        # this checkout modified* — untracked-blind and
                        # repo-wide, which is the guard deleted from this tool
                        # one release ago, still reachable through the API. A
                        # consumer filtering on that suffix inherits both of its
                        # errors with nothing in the envelope to say the
                        # predicate moved. stash.flow's, and the standing rule
                        # here is that a `--json` field with a second reader is
                        # exactly where these live: the string answers *which
                        # version*, this answers *does unversioned content reach
                        # it*, and they are different questions that happened to
                        # share a spelling.
                        "render_dirt": renderer_dirt,
                        "dry_run": args.dry_run,
                        # What is on disk in tmp/upgrade/, so a machine consumer
                        # is not left inferring it from `dry_run` the way a human
                        # reader was left inferring it from prose.
                        "sidecars_cleared": cleared,
                        "sidecars_stale": [str(pth.relative_to(target)) for pth in stale],
                        "added": added,
                        "updated": updated,
                        "merged": merged,
                        "conflicted": conflicted,
                        # A subset of `conflicted`, so a machine consumer can
                        # tell a decision to port from a formatter's opinion
                        # without re-running the merge to find out.
                        "formatting_only": formatting_only,
                        "collided": collided,
                        "entangled": entangled,
                        "declined": declined,
                        # The machine half of the `standing state` block. It was
                        # human-only for a release, which is the asymmetry
                        # `head_ref` was added here to close: a consumer that has
                        # to infer a field the report already prints will infer
                        # it differently, and this one is measured against a base
                        # that depends on whether the run advanced.
                        "diverged": diverged,
                        "dropped": dropped,
                    },
                    indent=2,
                    sort_keys=True,
                )
            )

        if cleared:
            say("→", f"cleared {cleared} sidecar(s) an earlier run left in tmp/upgrade/")
            detail("What is there when this finishes describes this run and nothing else.")

        verb = " would be" if args.dry_run else ""
        for label, group, symbol in (
            (f"new file(s){verb} added", added, "✅"),
            (f"file(s) you never touched{verb} updated", updated, "✅"),
            (f"file(s) that differ from the template{verb} merged cleanly", merged, "✅"),
        ):
            if group:
                say(symbol, f"{len(group)} {label}")
                for rel in group[:20]:
                    item(rel)
                if len(group) > 20:
                    detail(f"… and {len(group) - 20} more")

        if conflicted:
            say("❌", f"{len(conflicted)} file(s) that differ from the template — merge conflicts, LEFT ALONE")
            for rel in conflicted:
                item(rel)
            detail()
            detail("Nothing was written to these.")
            if args.dry_run:
                detail("A real run would put what the template changed in each in")
            else:
                detail("What the template changed in each is in")
            if args.no_base:
                detail("tmp/upgrade/<path>.new — today's template file, to diff against yours.")
                detail("A real base→ours patch needs the base text, which this run had no way to get.")
            else:
                detail("tmp/upgrade/<path>.patch — port it by hand.")

            if formatting_only:
                # Said here rather than in `--help`, because the population that
                # needs it is the population that has already hit the conflict.
                # A formatter is a second author with commit rights and no
                # changelog: the divergence it wrote was never decided by
                # anybody, so an adopter reading this hunk is looking for a
                # choice they did not make.
                detail()
                detail(f"Formatting your own tools would settle accounts for {len(formatting_only)}")
                detail("of these. Re-run with --normalise to put both rendered sides through the")
                detail("formatters this tree declares before merging — yours is never touched:")
                for rel in formatting_only:
                    item(rel)
            if not args.dry_run:
                # The window in which this is recoverable closes at the next
                # run, and nothing used to say so at the moment it opened. A
                # sidecar is the only copy — tmp/ is gitignored — and a real run
                # clears the directory before writing its own. So the output for
                # a tree where somebody ports these in the next minute was
                # identical to the output for a tree that loses them. That a
                # STALE sidecar gets a warning while an unapplied one about to
                # be overwritten got none was stash.flow's tell, and it is the
                # right one: the two look the same on disk.
                #
                # The two halves are said separately because only one of them is
                # true on any given run, and printing both would be this
                # repository's own invariant 7 — a sentence about a mechanism,
                # emitted on the path where the mechanism is not operating.
                detail()
                detail("These patches are the only copy. tmp/ is not tracked, and the next real")
                detail("run clears this directory before writing its own.")
                if advanced:
                    detail("--ported already advanced the base past them, so re-running will NOT")
                    detail("regenerate these: what is in tmp/upgrade/ now is the last copy there is.")
                else:
                    detail("Port them before then, or re-run to regenerate them. The base stays")
                    detail("where it is until they are gone, so nothing expires while you decide.")

        if args.normalise and normaliser.unsupported:
            say("⚠️ ", f"{len(normaliser.unsupported)} declared formatter(s) could not be run here")
            for hook in normaliser.unsupported:
                item(hook)
            detail("Those files were merged unnormalised. Silence about a tool is not coverage by it.")

        if collided:
            say("❌", f"{len(collided)} file(s) you already had where the template now ships one")
            for rel in collided:
                item(rel)
            detail()
            detail("Not an edit — these were never in your manifest, so skeletor never wrote")
            detail("them. Two files written for the same purpose now want the same path, and")
            detail("which one survives is a judgement only you can make. Yours is untouched")
            if args.dry_run:
                detail("where it has always been, and a real run would put the template's in")
                detail("tmp/upgrade/<path>.new.")
            else:
                detail("where it has always been; the template's is in tmp/upgrade/<path>.new.")

        if declined:
            # Deliberately a one-line standing state, not a roll-call. This is
            # permanent — the manifest is re-copied from the head render every
            # run, so a declined file stays recorded and stays declined — and a
            # six-line block that can never be resolved is what teaches somebody
            # to skim the whole report. The count keeps it honest; `--json`
            # carries the names for anything that needs them.
            say("⏭️ ", f"{len(declined)} file(s) skeletor wrote and you deleted — NOT restored")
            detail("Recorded in the manifest, absent from the tree: a decision you made, which")
            detail("an upgrade does not re-make for you. Standing state, reported every run.")
            # A rename is indistinguishable from a deletion when only one side is
            # recorded, and `--shell-package`'s own refusal sends people here by
            # recommending `git mv`. "A decision you made" is then the wrong
            # sentence — the sentence is what the reader acts on, which is why a
            # collision is already reported apart from an edit. This does not
            # assert a rename happened: deleting the shell outright is a real
            # partial adoption. The consequence is the same either way.
            shell = recorded[recorded.index("--shell-package") + 1] if "--shell-package" in recorded[:-1] else "cli"
            under_shell = [rel for rel in hashes if rel.startswith(f"{shell}/")]
            if under_shell and all(rel in declined for rel in under_shell):
                detail()
                detail(f"Every recorded file under {shell}/ is among them — the whole shell package.")
                detail("That is also what a `git mv` of it looks like from here, and if that is what")
                detail("happened the tree now tracks neither side: not the old name, which is this")
                detail("list, and not the new one, which the manifest never learned. Re-scaffold")
                detail("with --shell-package to be a full adopter under the new name.")
            # The subset that is actually actionable: the template has moved
            # since the decline, so there is something new to say no to. It is
            # also the only part of `declined` the currency test below may look
            # at — see the reason there.
            fresh = [rel for rel in declined if sha256(head_files[rel]) != hashes.get(rel)]
            if fresh:
                detail()
                detail(f"{len(fresh)} the template has changed since — worth a second look, and the")
                detail("current version is in tmp/upgrade/<path>.new:")
                for rel in fresh:
                    item(rel)

        if diverged:
            # The symmetric half of the block above, and it took an adopter to
            # notice the asymmetry. A deletion was standing state — reported
            # every run, permanently, because it is a decision the tool does not
            # re-make and does not let you forget. An edit was not, once
            # `--ported` advanced the base: the tree went from naming two
            # conflicted files to "already current — nothing to carry over",
            # with both files still differing from what skeletor ships and both
            # differing ON PURPOSE.
            #
            # `disk hash != recorded hash` is exactly as computable after
            # `--ported` as before and means the same thing both times: this
            # tree has edited a file skeletor wrote. sky.boss's argument is that
            # the reason for reporting the deletion applies to the edit
            # unchanged, and it does. Without this, a feature doc is the only
            # record that those files are theirs by decision — which is the
            # thing that goes stale, and the failure this whole tool exists to
            # avoid, one turn over.
            #
            # A count and a list rather than a count alone, because unlike a
            # decline there is nothing further to say about each one: no sidecar,
            # no second look, no action. The names ARE the report.
            say("📝", f"{len(diverged)} file(s) skeletor wrote and you have edited — standing state")
            detail("Yours by decision, reported every run. An upgrade merges into these rather")
            detail("than replacing them, and `--ported` advances the base without erasing that.")
            for rel in diverged:
                item(rel)
            # The one class of standing edit that is not a decision to keep, and
            # it is invisible from inside the list. If you edited one of these to
            # change a value skeletor RENDERS — a python version, a line length —
            # then the record still says the old value, the base still renders
            # it, and that hunk conflicts on every upgrade forever. Green,
            # current, and re-fighting the same lines.
            #
            # Two of six trees were in that state and **neither was found by an
            # instrument**: one by resolving the recurring conflict, one because
            # the tree said so in prose. `--set-arg` is the exit and nothing
            # pointed at it from the place somebody actually reads.
            detail()
            detail("If one of these is a file you edited to change a value skeletor RENDERS, the")
            detail("record still says the old one and that hunk will conflict on every upgrade.")
            detail("Move the record instead: skeletor-upgrade . --set-arg <flag>=<value> --dry-run")

        # After the two blocks that name files needing a decision, because this
        # is about those files — and before `dropped`, which is unrelated.
        if entangled:
            say("⚠️ ", f"{len(entangled)} file(s) applied cleanly import one that did NOT")
            for rel, targets in sorted(entangled.items()):
                item(f"{rel} → {', '.join(targets)}")
            detail()
            detail("A merge status describes one file and says nothing about what it depends")
            detail("on. These were written because you had never edited them — which is the")
            detail("reassuring case, and the wrong one here: their behaviour is decided by a")
            detail("file above that you kept or must resolve by hand. Check the pair.")

        if dropped:
            say("⚠️ ", f"{len(dropped)} file(s) the template no longer ships — NOT deleted")
            for rel in dropped:
                item(rel)
            detail("Delete them yourself if you agree. This never removes your files.")

        # Only when this run actually wrote a test file, and only on a real run.
        # Always-on prose in this output gets skimmed, and this instruction earns
        # attention precisely because it is rare — proto.pilot's point, and the
        # reason it is conditional rather than a standing line in the footer.
        touched_tests = sorted(r for r in added + updated + merged if r.startswith("tests/"))
        if touched_tests and not args.dry_run:
            say("ℹ️ ", f"{len(touched_tests)} file(s) under tests/ changed — do not verify by counting")
            detail()
            detail("A collected-test total is a negative assertion over a set wearing a number's")
            detail("clothes. One measured upgrade came back 633 before and 633 after with five")
            detail("tests removed and five added; another went 642 to 641 while coverage rose,")
            detail("two hand-written guards having become registry-driven ones. A reader")
            detail("watching the number drew no conclusion from the first and would have drawn")
            detail("the wrong one from the second. Diff the collected IDs instead:")
            detail()
            commit = pre_upgrade or "<the commit you were on before this run>"
            detail("  PY=$(pwd)/.venv/bin/python          # the worktree gets none of its own")
            detail(f"  git worktree add tmp/pre-upgrade {commit}")
            detail("  $PY -m pytest tests/ --collect-only -q > /tmp/after.raw || echo '!! after: collection FAILED'")
            detail("  (cd tmp/pre-upgrade && $PY -m pytest tests/ --collect-only -q) > /tmp/before.raw \\")
            detail("     || echo '!! before: collection FAILED'")
            detail("  git worktree remove tmp/pre-upgrade")
            detail("  grep :: /tmp/before.raw | sort > /tmp/before.txt")
            detail("  grep :: /tmp/after.raw | sort > /tmp/after.txt")
            detail("  diff /tmp/before.txt /tmp/after.txt")
            detail()
            detail("Under `tmp/`, which this tree already gitignores, and not `../` — stash.flow")
            detail("followed it into a workspace root holding every repo as a sibling, where a")
            detail("leftover `pre-upgrade/` reads as one more project. The location says what it")
            detail("is even if the removal line gets skipped.")
            detail()
            detail("The `tests/` scope and the exit-code check are one fix, not two. An unscoped")
            detail("`pytest` descends into tmp/pre-upgrade while the worktree is there, finds every")
            detail("module basename twice, and Interrupts — after writing the right IDs. `grep |")
            detail("sort` then discards the exit code, so both files are correct, non-empty, and")
            detail("one of them came out of a run that failed. `diff` reports no change and is")
            detail("telling the truth about them. A length check cannot see that; the exit code")
            detail("sees it AND the empty case a length check was written for.")
            detail()
            detail("And the same collision one layer up, which `tests/` scoping does NOT prevent:")
            detail("if any suite here PARAMETRISES over a filesystem walk — a `check every file")
            detail("for X` gate, which is an ordinary way to write one — its skip set must exclude")
            detail("`tmp/` before this comparison means anything. sky.boss ran it and got 210")
            detail("additions of which 205 were spurious: their walk had `.git`, `.venv`, `vendor`,")
            detail("`node_modules`, `__pycache__` and `dist`, so it collected `tmp/pre-upgrade/**`")
            detail("— the worktree THIS RECIPE creates — plus `.pytest_cache/README.md`, read for")
            detail("prose about a product pytest has never heard of. Nothing was ever red. What")
            detail("was wrong is the population: a parametrised set that moves with whatever")
            detail("scratch is on disk changes run to run, so the comparison measures the")
            detail("filesystem rather than the tree. A gate whose subject set is unstable cannot")
            detail("be diffed, and diffing it is what this recipe asks you to do.")
            detail()
            detail("This paragraph used to check the length, and the recipe above used to cause")
            detail("the failure it could not see — a recipe and its own guard written by one")
            detail("hand, so the guard was written against the failure that was imagined rather")
            detail("than the one the recipe produces. Reported by node-zero, who ran it.")
            detail()
            detail("EXPECT REMOVALS, and read the list rather than its length. A guard moving")
            detail("into a wrapper deletes the companion test that used to stand beside it, and")
            detail("that is this upgrade working correctly — in the measured case three of five")
            detail("removals were exactly that and a fourth was a relocation. Somebody running")
            detail("this expecting a clean bill either panics or decides the check is noisy, and")
            detail("the second one costs more.")
            if interleaved:
                detail()
                detail("--allow-dirty: the commit above is the last COMMIT, not the tree this run")
                detail("started from. Your own uncommitted edits are in that diff too.")

        # **Standing state is not work, and this test is about work.** `declined`
        # and `dropped` are both permanent by construction — a file you deleted
        # is not restored, a file the template stopped shipping is not removed,
        # and both are reported on every run for ever. Counting them as
        # this-run activity suppressed "already current" **permanently** for any
        # tree carrying one, which is exactly the tree that most needs the
        # sentence: an adopter whose manifest will read `v0.9.0` for ever cannot
        # otherwise tell "I upgraded and there was nothing in it" from "I never
        # ran the upgrade", and that ambiguity is the whole reason the sentence
        # was written. mind.head reported it with a control — same render, same
        # upgrade, four standing declines the only difference, and the message
        # present in one run and absent in the other.
        #
        # `fresh` rather than `declined`, because the actionable half of a
        # decline is real work: the template has moved since, and there is
        # something new to say no to. `dropped` has no such half — nothing
        # records that you were told, so it cannot become news again.
        #
        # This is the `--ported` guard one release later, and the same mistake:
        # a condition whose term set does not match the question it is asking.
        # There the set was too small and excluded a conflict; here it is too
        # large and includes two things that are not work.
        if not any((added, updated, merged, conflicted, collided, fresh)):
            # Name the version it is current *with*. This compares the tree
            # against a render of skeletor's HEAD, so that is the claim — but the
            # manifest is only re-copied by a run that applies something, so a
            # tree that is already identical keeps recording whatever ref it was
            # scaffolded at, indefinitely. Both are true, the bare sentence
            # carried neither, and a reader holding it next to `.skeletor.json`
            # could not tell "current with HEAD" from "current with the ref
            # recorded there" — the reassuring reading of a line that is already
            # the most reassuring one this tool prints. Reported by stash.flow,
            # at base v0.6.0 against skeletor v0.6.1, which is exactly the pair
            # the sentence could not distinguish.
            say("✅", f"already current with skeletor @ {head_ref} — nothing to carry over")
            if not _WARNED_DIRTY and head_ref.endswith("-dirty"):
                # The suffix without the hazard. `-dirty` is the most prominent
                # token in the one line this round agrees reads as a settled
                # conclusion, and here it means somebody touched a README — so
                # the line said nothing about why and left the reader to assume
                # the worse of the two readings. Naming the case costs one line
                # and only in the case that needs it.
                detail("The `-dirty` suffix is git's and repo-wide: this checkout is modified,")
                detail("but nothing uncommitted reaches what it renders, so the comparison stands.")
            if _WARNED_DIRTY:
                # The dirty-base warning above says *this plan includes
                # uncommitted edits*, which is the right thing to say about a
                # plan and the wrong shape for this line: "already current" does
                # not read as part of a plan. It reads as a conclusion, wears a
                # ✅, and the manifest note below it is stated as settled fact —
                # with a `-dirty` suffix inside a version string as the only
                # signal that any of it is provisional. stash.flow hit it
                # against a base whose `bin/skeletor-new` carried 17 uncommitted
                # insertions, got this verdict, and could only find out it was
                # right by cloning the tag and asking again. **"Do nothing" is
                # the only verdict with no next step to fail**, so a wrong one
                # is permanently invisible, and it is the answer a reader most
                # wants to receive.
                #
                # **Conditioned on `_WARNED_DIRTY`, which is the set the
                # warning above put there — so this note cannot disagree with
                # it, by construction rather than by assertion.** The first
                # version keyed on `head_ref.endswith("-dirty")`, and stash.flow
                # showed both directions of what that costs: a tracked edit to
                # `docs/` printed "includes uncommitted template edits" when
                # there were none, and an untracked file under `template/` —
                # which a render really does read — printed nothing, not even
                # the `-dirty` suffix this paragraph had called the only signal.
                # `git describe --dirty` is untracked-blind and repo-wide, the
                # two properties `reaches_a_render` exists to remove, arriving
                # back through a version string.
                #
                # The tell is worth more than the fix: **the guard was derived
                # from the text of the line rather than from the claim the line
                # makes.** `head_ref` was already in that sentence, so reaching
                # for it cost nothing and read as consistent.
                #
                # An earlier comment here claimed the note was kept safe by the
                # dirty-base refusal, and that coupling did not exist: the
                # refusal used one predicate and this line another, so they
                # could already disagree. Now there is one predicate and this is
                # a rendering of the warning's own finding, so the dependency is
                # real. What it buys is still the same: a real run is refused,
                # so a provisional verdict can never be recorded.
                detail("Provisional: uncommitted content reaches this render, so the comparison")
                detail("includes it. Commit it, or ask a clean clone at a tag, before treating")
                detail("'nothing to carry over' as settled.")
            if ref and ref != head_ref:
                detail(f"{MANIFEST_NAME} still records {ref}, and will keep doing so: it is")
                detail("re-copied only by a run that applies something. Being behind by a ref and")
                detail("being behind by a file are different, and only the second is work.")
            if args.dry_run and stale:
                # The dry-run footer below is unreachable from here, and this is
                # the case that needed it most. That warning is conditioned on
                # there being a plan to contrast against, and absence-of-plan is
                # not absence-of-hazard: here there is nothing above for any of
                # these files to belong to, so every one of them is stale by
                # definition rather than merely possibly. `stale` is only ever
                # populated on a dry run — a real run cleared them and reported
                # the count — and the condition says so rather than relying on it.
                detail()
                say("⏸️ ", "dry run — nothing was written, tmp/upgrade/ included")
                report_stale(
                    stale,
                    target,
                    [
                        "Nothing is being carried over, so there is no plan above for them to",
                        "belong to: every one is stale, not merely possibly stale. A real run",
                        "clears them; this one wrote nothing at all.",
                    ],
                )
            return 0

        detail()
        if args.dry_run:
            say("⏸️ ", "dry run — nothing was written, tmp/upgrade/ included")
            if stale:
                report_stale(
                    stale,
                    target,
                    [
                        "They describe that run's plan against that template, not this one — a real",
                        "run clears them before writing. Nothing above refers to them.",
                    ],
                )
        else:
            say("✅", "nothing was committed. Read the diff, then commit as one `chore(skeletor):` change")
        return 1 if (conflicted or collided) else 0
    finally:
        if cleanup_worktree is not None:
            subprocess.run(
                ["git", "-C", str(SKELETOR), "worktree", "remove", "--force", str(cleanup_worktree)],
                capture_output=True,
            )
        shutil.rmtree(workdir, ignore_errors=True)


if __name__ == "__main__":
    raise SystemExit(main())
