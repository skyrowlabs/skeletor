{
  "name": "{{PROJECT_SLUG}}",
  "private": true,
  "type": "module",
  "scripts": {
    "//lint:check": "The --max-warnings number is the RATCHET. It may only go down. Never raise it to make a commit pass — fix the warning, or suppress it inline with a written reason.",
    "lint:check": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "arrowParens": "always",
    "proseWrap": "preserve",
    "endOfLine": "lf",
    "overrides": [
      { "files": "*.md", "options": { "proseWrap": "preserve", "singleQuote": false } }
    ]
  }
}
