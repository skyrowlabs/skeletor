# protogen talks to the Claude API to generate the app-specific slice.
# Either export a key here, or run `ant auth login` and leave this unset --
# the SDK resolves an `ant` profile automatically.
ANTHROPIC_API_KEY=

# Override the model / effort if you want (defaults: claude-opus-5, high).
# PROTOGEN_MODEL=claude-opus-5
# PROTOGEN_EFFORT=high

# Set to "offline" to use the deterministic baseline generator and make
# no API calls at all.
# PROTOGEN_LLM=offline
